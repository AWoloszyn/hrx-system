+// Signed constant arithmetic must not execute undefined host operations.
+template <typename Integer>
+auto checkedSignedBinary(TokenKind op, Integer left, Integer right)
+    -> std::optional<ConstValue> {
+  constexpr auto minimum = std::numeric_limits<Integer>::min();
+  constexpr auto maximum = std::numeric_limits<Integer>::max();
+  switch (op) {
+    case TokenKind::T_PLUS:
+      if ((right > 0 && left > maximum - right) ||
+          (right < 0 && left < minimum - right))
+        return std::nullopt;
+      return ConstValue{std::intmax_t(left + right)};
+    case TokenKind::T_MINUS:
+      if ((right > 0 && left < minimum + right) ||
+          (right < 0 && left > maximum + right))
+        return std::nullopt;
+      return ConstValue{std::intmax_t(left - right)};
+    case TokenKind::T_STAR:
+      if (left > 0 ? (right > 0 ? left > maximum / right
+                               : right < minimum / left)
+                   : (right > 0 ? left < minimum / right
+                                : left != 0 && right < maximum / left))
+        return std::nullopt;
+      return ConstValue{std::intmax_t(left * right)};
+    case TokenKind::T_SLASH:
+    case TokenKind::T_PERCENT:
+      if (right == 0 || (left == minimum && right == -1))
+        return std::nullopt;
+      return ConstValue{std::intmax_t(op == TokenKind::T_SLASH ? left / right
+                                                             : left % right)};
+    default:
+      return std::nullopt;
+  }
+}
