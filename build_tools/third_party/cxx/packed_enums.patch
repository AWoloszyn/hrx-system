+auto packedEnumTypeForRange(Control* control, const TypeTraits& traits,
+                            std::intmax_t minimum, std::uintmax_t maximum)
+    -> const Type* {
+  const Type* candidates[] = {
+      minimum < 0 ? static_cast<const Type*>(control->getSignedCharType())
+                  : control->getUnsignedCharType(),
+      minimum < 0 ? static_cast<const Type*>(control->getShortIntType())
+                  : control->getUnsignedShortIntType(),
+      minimum < 0 ? static_cast<const Type*>(control->getIntType())
+                  : control->getUnsignedIntType(),
+      minimum < 0 ? static_cast<const Type*>(control->getLongIntType())
+                  : control->getUnsignedLongIntType(),
+      minimum < 0 ? static_cast<const Type*>(control->getLongLongIntType())
+                  : control->getUnsignedLongLongIntType(),
+  };
+  for (auto type : candidates) {
+    if (representsEnumValues(traits, type, minimum, maximum)) return type;
+  }
+  return nullptr;
+}
