+#include <cxx/ast.h>
+#include <cxx/attributes.h>
+#include <cxx/binder.h>
+#include <cxx/decl.h>
+#include <cxx/symbols.h>
+
+namespace cxx {
+
+void Binder::applyLayoutAttributes(Symbol* symbol,
+                                   List<AttributeSpecifierAST*>* attributes) {
+  if (!attributes) return;
+  static constexpr AttributeSpelling spellings[] = {
+      {AttributeSyntax::kGnu, "", "packed"},
+      {AttributeSyntax::kCxx, "gnu", "packed"},
+  };
+  visitAttributesBySpelling(
+      unit_, attributes, spellings, [&](AttributeRef attribute) {
+        if (attribute.argumentClause) {
+          error(attribute.location, "'packed' attribute takes no arguments");
+          return true;
+        }
+        if (auto record = symbol_cast<ClassSymbol>(symbol)) {
+          if (record->isComplete() && !record->isPacked()) {
+            error(attribute.location,
+                  "'packed' attribute must precede record completion");
+            return true;
+          }
+          record->setPacked(true);
+        } else if (auto field = symbol_cast<FieldSymbol>(symbol);
+                   field && !field->isStatic()) {
+          field->setPacked(true);
+        } else {
+          error(
+              attribute.location,
+              "'packed' attribute requires a record or non-static data member");
+        }
+        return true;
+      });
+}
+
+void Binder::applyDeclaratorLayoutAttributes(Symbol* symbol, const Decl& decl) {
+  applyLayoutAttributes(symbol, decl.specs.attributeList);
+  if (decl.declaratorId)
+    applyLayoutAttributes(symbol, decl.declaratorId->attributeList);
+}
+
+}  // namespace cxx
