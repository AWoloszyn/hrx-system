-auto roundFloat16(long double value) -> float {
+namespace {
+
+auto roundFloatingPoint(long double value, int precision, int minimumExponent,
+                        int maximumExponent) -> float {
   if (!std::isfinite(value) || value == 0) return static_cast<float>(value);

   const auto magnitude = std::abs(value);
   int exponent;
   std::frexp(magnitude, &exponent);
-  if (exponent > 16)
+  if (exponent > maximumExponent)
     return std::copysign(std::numeric_limits<float>::infinity(), value);

-  // Normal values have eleven significant bits. Subnormals share a fixed
-  // quantum of 2^-24, including rounding across zero and the normal boundary.
-  const auto quantum = std::max(exponent - 11, -24);
+  // Subnormals share the minimum normal spacing. Scaling by this exact
+  // power of two preserves the rounding decision without an intermediate
+  // float conversion (which can double-round a wider source).
+  const auto quantum = std::max(exponent, minimumExponent) - precision;
   const auto scaled = std::ldexp(magnitude, -quantum);
   auto integral = std::floor(scaled);
   const auto remainder = scaled - integral;
