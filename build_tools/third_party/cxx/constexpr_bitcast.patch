+// SOFTWARE.
+
+#include <cxx/ast_interpreter.h>
+#include <cxx/constant_bits.h>
+#include <cxx/control.h>
+#include <cxx/memory_layout.h>
+#include <cxx/translation_unit.h>
+#include <cxx/types.h>
+
+#include <bit>
+
+namespace cxx {
+namespace {
+
+struct ConstantShape {
+  // Unqualified scalar type of each stored element.
+  const Type* elementType;
+  // Bytes per element, with no padding or packed Boolean lanes.
+  std::size_t elementSize;
+  // Element count, or one for a scalar object.
+  std::size_t count;
+  // Present only when the object is a vector.
+  const VectorType* vectorType;
+};
+
+auto shapeOf(const Type* type, const TypeTraits& traits,
+             const MemoryLayout& layout) -> std::optional<ConstantShape> {
+  type = traits.remove_cv(type);
+  auto* vector = type_cast<VectorType>(type);
+  auto* element = vector ? traits.remove_cv(vector->elementType()) : type;
+  auto size = layout.sizeOf(element);
+  if (!size || *size == 0 || *size > sizeof(std::uint64_t)) return std::nullopt;
+  if (auto integral = traits.integral_representation(element)) {
+    if (element->kind() == TypeKind::kBool) {
+      if (vector) return std::nullopt;
+    } else if (integral->bits != *size * 8) {
+      return std::nullopt;
+    }
+  } else if (auto format = ConstFloat::formatFor(element->kind())) {
+    if (ConstFloat::fromBits(*format, 0).bitWidth() != *size * 8)
+      return std::nullopt;
+  } else {
+    return std::nullopt;
+  }
+  const auto count = vector ? vector->elementCount() : 1;
+  const auto objectSize = layout.sizeOf(type);
+  if (!objectSize || count == 0 || *objectSize % *size != 0 ||
+      *objectSize / *size != count)
+    return std::nullopt;
+  return ConstantShape{element, *size, count, vector};
+}
+
+auto scalarBits(ASTInterpreter& interpreter, const ConstValue& value,
+                const Type* type) -> std::optional<std::uint64_t> {
+  if (ConstFloat::formatFor(type->kind())) {
+    auto converted = interpreter.toArithmeticType(value, type);
+    if (!converted) return std::nullopt;
+    return std::get<ConstFloat>(*converted).bits();
+  }
+  if (auto integer = std::get_if<std::intmax_t>(&value))
+    return std::bit_cast<std::uintmax_t>(*integer);
+  return std::nullopt;
+}
+
+auto scalarValue(ASTInterpreter& interpreter, std::uint64_t bits,
+                 const Type* type) -> std::optional<ConstValue> {
+  if (auto format = ConstFloat::formatFor(type->kind()))
+    return ConstFloat::fromBits(*format, bits);
+  if (type->kind() == TypeKind::kBool && bits > 1) return std::nullopt;
+  return interpreter.toIntegralType(std::bit_cast<std::intmax_t>(bits), type);
+}
+
+}  // namespace
+
+auto bitCastConstant(ASTInterpreter& interpreter, const ConstValue& value,
+                     const Type* sourceType, const Type* targetType)
+    -> std::optional<ConstValue> {
+  const auto& traits = interpreter.translationUnit()->typeTraits();
+  const auto& layout = *interpreter.control()->memoryLayout();
+  auto source = shapeOf(sourceType, traits, layout);
+  auto target = shapeOf(targetType, traits, layout);
+  if (!source || !target ||
+      source->elementSize * source->count !=
+          target->elementSize * target->count)
+    return std::nullopt;
+  const InitializerList* elements = nullptr;
+  if (source->vectorType) {
+    auto list = std::get_if<std::shared_ptr<InitializerList>>(&value);
+    if (!list || !*list || (*list)->elements.size() != source->count)
+      return std::nullopt;
+    elements = list->get();
+  }
+  std::shared_ptr<InitializerList> result;
+  if (target->vectorType) {
+    result = std::make_shared<InitializerList>();
+    result->elements.reserve(target->count);
+  }
+  // Walk object bytes once. Scalar casts allocate nothing; vector casts only
+  // allocate the destination value, without an intermediate byte buffer.
+  std::uint64_t input = 0;
+  std::size_t offset = 0;
+  const bool littleEndian =
+      layout.byteOrder() == MemoryLayout::ByteOrder::kLittleEndian;
+  for (std::size_t lane = 0; lane < target->count; ++lane) {
+    std::uint64_t output = 0;
+    for (std::size_t byte = 0; byte < target->elementSize; ++byte, ++offset) {
+      const auto inputByte = offset % source->elementSize;
+      if (inputByte == 0) {
+        const auto& element =
+            elements
+                ? std::get<0>(elements->elements[offset / source->elementSize])
+                : value;
+        auto bits = scalarBits(interpreter, element, source->elementType);
+        if (!bits) return std::nullopt;
+        input = *bits;
+      }
+      const auto inputShift =
+          (littleEndian ? inputByte : source->elementSize - inputByte - 1) * 8;
+      const auto outputShift =
+          (littleEndian ? byte : target->elementSize - byte - 1) * 8;
+      output |= ((input >> inputShift) & 0xff) << outputShift;
+    }
+    auto element = scalarValue(interpreter, output, target->elementType);
+    if (!element) return std::nullopt;
+    if (!result) return element;
+    result->elements.emplace_back(std::move(*element), target->elementType);
+  }
+  return ConstValue{std::move(result)};
+}
+
+}  // namespace cxx
