+namespace cxx {
+class ASTInterpreter;
+
+// Reinterprets the target object representation of an arithmetic scalar or an
+// unpadded fixed vector. Unsupported object representations, indeterminate
+// values and invalid Boolean representations are not constant expressions.
+[[nodiscard]] auto bitCastConstant(ASTInterpreter& interpreter,
+                                   const ConstValue& value,
+                                   const Type* sourceType,
+                                   const Type* targetType)
