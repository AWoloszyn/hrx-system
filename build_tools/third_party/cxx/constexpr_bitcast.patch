 #ifndef CXX_FLOATING_POINT_H
 #define CXX_FLOATING_POINT_H

+#include <cxx/types_fwd.h>
+
+#include <cstdint>
+#include <optional>
+
 namespace cxx {
+
+// A typed floating constant retains its object representation independently of
+// the host floating-point environment. Numeric queries are arithmetic values;
+// copying, negation and bit casts use the stored bits instead.
+class ConstFloat {
+ public:
+  enum class Format : std::uint8_t {
+    kFloat16,
+    kBFloat16,
+    kFloat8E4M3FN,
+    kFloat8E5M2,
+    kFloat,
+    kDouble,
+  };
+
+  [[nodiscard]] static auto formatFor(TypeKind kind) -> std::optional<Format>;
+  [[nodiscard]] static auto fromValue(Format format, long double value)
+      -> ConstFloat;
+
+  // Bits are the complete representation of format, with no high padding bits.
+  [[nodiscard]] static auto fromBits(Format format, std::uint64_t bits)
+      -> ConstFloat {
+    return ConstFloat(format, bits);
+  }
+
+  [[nodiscard]] auto format() const -> Format { return format_; }
+  [[nodiscard]] auto bits() const -> std::uint64_t { return bits_; }
+  [[nodiscard]] auto bitWidth() const -> unsigned;
+  [[nodiscard]] auto isNaN() const -> bool;
+  [[nodiscard]] auto toDouble() const -> double;
+  [[nodiscard]] auto negated() const -> ConstFloat {
+    return fromBits(format_, bits_ ^ (std::uint64_t{1} << (bitWidth() - 1)));
+  }
+  auto operator==(const ConstFloat&) const -> bool = default;
+
+ private:
+  ConstFloat(Format format, std::uint64_t bits)
+      : bits_(bits), format_(format) {}
+
+  // Target representation bits, including signed zero and NaN payloads.
+  std::uint64_t bits_;
+  // Source format owning the interpretation and width of bits_.
+  Format format_;
+};

