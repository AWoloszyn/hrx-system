+namespace cxx {
+namespace {
+// Integer constants use a signed carrier even for unsigned source values.
+// Keep the negative minimum and unsigned maximum separate until storage is set.
+auto representsEnumValues(const TypeTraits& traits, const Type* type,
+                          std::intmax_t minimum, std::uintmax_t maximum)
+    -> bool {
+  if (type->kind() == TypeKind::kBool) return minimum == 0 && maximum <= 1;
+  const auto [bits, isSigned] = *traits.integral_representation(type);
+  constexpr auto storageBits = std::numeric_limits<std::uintmax_t>::digits;
+  if (!isSigned) {
+    return minimum == 0 &&
+           (bits >= storageBits || maximum < (std::uintmax_t{1} << bits));
+  }
+  if (bits > storageBits) return true;
+  const auto limit = std::uintmax_t{1} << (bits - 1);
+  return maximum < limit &&
+         (bits == storageBits || minimum >= -std::intmax_t(limit));
+}
+
+auto enumTypeForRange(const TypeTraits& traits, std::intmax_t minimum,
+                      std::uintmax_t maximum) -> const Type* {
+  for (auto type : traits.integralPromotionCandidates()) {
+    if (representsEnumValues(traits, type, minimum, maximum)) return type;
+  }
+  return nullptr;
+}
+}  // namespace
+
+void Binder::bind(EnumeratorAST* ast, EnumeratorSymbol* previous) {
+  const Type* fixedType = nullptr;
+  if (auto scoped = symbol_cast<ScopedEnumSymbol>(scope())) {
+    fixedType = scoped->underlyingType();
+  } else if (auto unscoped = symbol_cast<EnumSymbol>(scope());
+             unscoped && unscoped->hasFixedUnderlyingType()) {
+    fixedType = unscoped->underlyingType();
+  }
+
+  const Type* type = fixedType ? fixedType : control()->getIntType();
+  std::optional<ConstValue> value;
+  if (auto expression = ast->expression) {
+    auto sourceType =
+        traits.remove_cv(traits.remove_reference(expression->type));
+    sourceType = traits.underlying_type(sourceType);
+    if (!fixedType) type = sourceType;
+    if (!isDependent(unit_, expression) && !isDependent(unit_, fixedType)) {
+      if (!traits.is_integral_or_unscoped_enum(expression->type)) {
+        error(
+            ast->identifierLoc,
+            "enumerator initializer must have integral or unscoped enum type");
+      } else {
+        value = ASTInterpreter{unit_}.evaluate(expression);
+        if (!value) {
+          error(ast->identifierLoc,
+                "enumerator initializer is not a constant expression");
+        } else if (fixedType) {
+          const auto integer = std::get<std::intmax_t>(*value);
+          const auto negative = integer < 0 && !traits.is_unsigned(sourceType);
+          if (!representsEnumValues(traits, fixedType, negative ? integer : 0,
+                                    negative ? 0 : std::uintmax_t(integer))) {
+            error(
+                ast->identifierLoc,
+                "enumerator value is not representable in the underlying type");
+            value.reset();
+          }
+        }
+      }
+    }
+  } else if (!previous) {
+    value = std::intmax_t{0};
+  } else {
+    if (!fixedType) type = previous->type();
+    if (previous->value() && !isDependent(unit_, type)) {
+      const auto integer = std::get<std::intmax_t>(*previous->value());
+      const auto negative =
+          integer < 0 && !traits.is_unsigned(previous->type());
+      if (!negative && std::uintmax_t(integer) ==
+                           std::numeric_limits<std::uintmax_t>::max()) {
+        error(ast->identifierLoc,
+              "implicit enumerator value exceeds the integer range");
+      } else {
+        const auto next =
+            negative
+                ? integer + 1
+                : std::bit_cast<std::intmax_t>(std::uintmax_t(integer) + 1);
+        const auto minimum = negative && next < 0 ? next : 0;
+        const auto maximum = minimum < 0 ? 0 : std::uintmax_t(next);
+        if (!representsEnumValues(traits, type, minimum, maximum)) {
+          if (!fixedType) type = enumTypeForRange(traits, minimum, maximum);
+          if (fixedType || !type) {
+            error(ast->identifierLoc,
+                  "implicit enumerator value is not representable in the "
+                  "underlying type");
+          } else {
+            value = next;
+          }
+        } else {
+          value = next;
+        }
+      }
+    }
+  }
+
+  if (isCxx()) {
+    auto symbol = control()->newEnumeratorSymbol(scope(), ast->identifierLoc);
+    ast->symbol = symbol;
+
+    symbol->setName(ast->identifier);
+    symbol->setType(type);
+    ast->symbol->setValue(value);
+    if (auto enclosingEnum = symbol_cast<EnumSymbol>(scope()))
+      symbol->setAccessSpecifier(enclosingEnum->accessSpecifier());
+    if (auto enclosingEnum = symbol_cast<ScopedEnumSymbol>(scope()))
+      symbol->setAccessSpecifier(enclosingEnum->accessSpecifier());
+    scope()->addSymbol(symbol);
+
+    if (auto enumSymbol = symbol_cast<EnumSymbol>(scope())) {
+      auto parentScope = enumSymbol->parent();
+
+      auto usingDeclaration =
+          control()->newUsingDeclarationSymbol(parentScope, ast->identifierLoc);
+      usingDeclaration->setName(ast->identifier);
+      usingDeclaration->setTarget(symbol);
+      parentScope->addSymbol(usingDeclaration);
+      applyAccessSpecifier(usingDeclaration);
+    }
+
+    return;
+  }
+
+  if (auto enumSymbol = symbol_cast<EnumSymbol>(scope())) {
+    auto parentScope = enumSymbol->parent();
+
+    auto enumeratorSymbol =
+        control()->newEnumeratorSymbol(parentScope, ast->identifierLoc);
+    ast->symbol = enumeratorSymbol;
+
+    enumeratorSymbol->setName(ast->identifier);
+    enumeratorSymbol->setType(type);
+    enumeratorSymbol->setValue(value);
+
+    parentScope->addSymbol(enumeratorSymbol);
+  }
+}
+
+void Binder::complete(EnumSpecifierAST* ast) {
+  if (auto unscoped = symbol_cast<EnumSymbol>(ast->symbol);
+      unscoped && !unscoped->hasFixedUnderlyingType()) {
+    auto minimum = std::intmax_t{0};
+    auto maximum = std::uintmax_t{0};
+    bool resolved = true;
+    for (auto enumerator : ListView{ast->enumeratorList}) {
+      auto symbol = enumerator->symbol;
+      if (!symbol->value()) {
+        resolved = false;
+        continue;
+      }
+      auto integer = std::get<std::intmax_t>(*symbol->value());
+      if (integer < 0 && !traits.is_unsigned(symbol->type())) {
+        minimum = std::min(minimum, integer);
+      } else {
+        maximum = std::max(maximum, std::uintmax_t(integer));
+      }
+    }
+    if (resolved) {
+      // Choosing from the promotion candidates makes the underlying type also
+      // the canonical promotion result, without rescanning the enum at each
+      // use.
+      if (auto type = enumTypeForRange(traits, minimum, maximum)) {
+        unscoped->setUnderlyingType(type);
+      } else {
+        error(ast->enumLoc,
+              "no integer type can represent all enumerator values");
+      }
+    }
+  }
+  for (auto enumerator : ListView{ast->enumeratorList}) {
+    enumerator->symbol->setType(ast->symbol->type());
+  }
+}
+
+}  // namespace cxx
