+// RUN: %cxx -verify -fsyntax-only %s
+
+enum Wide { wide = 1ULL << 40, following, after = following + 1 };
+enum Mixed { low = -1, high = 0xffffffffu };
+enum Full { full = 0xffffffffffffffffULL };
+enum Step { last = 9223372036854775807LL, next };
+enum class Byte : unsigned char { first = 254, final };
+enum Temporary { initial = 0u, unsigned_type = __is_same(decltype(initial), unsigned) };
+static_assert(sizeof(Wide) == 8 && after == (1ULL << 40) + 2);
+static_assert(sizeof(Mixed) == 8 && low < 0 && high == 0xffffffffULL);
+static_assert(sizeof(Full) == 8 && full > 0);
+static_assert(full == 0xffffffffffffffffULL);
+static_assert(next == 0x8000000000000000ULL);
+static_assert(sizeof(Byte) == 1 && unsigned(Byte::final) == 255);
+static_assert(unsigned_type == 1);
+static_assert(__is_same(decltype(+wide), __underlying_type(Wide)));
+
+template <unsigned long long V>
+constexpr auto value() {
+  enum E { first = V, next, last = next + 1 };
+  return last;
+}
+template <class T, T V>
+constexpr T fixed() {
+  enum class E : T { first = V, next };
+  return T(E::next);
+}
+static_assert(value<(1ULL << 40)>() == (1ULL << 40) + 2);
+static_assert(fixed<unsigned char, 254>() == 255);
