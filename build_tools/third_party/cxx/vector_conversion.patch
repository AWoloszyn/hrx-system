+auto Codegen::ExpressionVisitor::operator()(
+    BuiltinConvertVectorExpressionAST* ast) -> ExpressionResult {
+  auto source = gen.expression(ast->expression);
+  if (!source.value) return source;
+  auto loc = ast->convertLoc;
+  auto sourceType = unqualified_cast<VectorType>(ast->expression->type);
+  auto targetType = unqualified_cast<VectorType>(ast->type);
+  auto inputElement = sourceType->elementType();
+  auto outputElement = targetType->elementType();
+  if (inputElement == outputElement) return source;
+  auto resultType = gen.convertType(ast->type);
+  auto inputBits = is_bool(inputElement)
+                       ? 1
+                       : *control()->memoryLayout()->sizeOf(inputElement) * 8;
+  auto outputBits = is_bool(outputElement)
+                        ? 1
+                        : *control()->memoryLayout()->sizeOf(outputElement) * 8;
+  const bool inputFloating = gen.traits.is_floating_point(inputElement);
+  const bool outputFloating = gen.traits.is_floating_point(outputElement);
+  if (is_bool(outputElement)) {
+    auto zero =
+        gen.emitter_.constantZero(loc, gen.emitter_.typeOf(source.value));
+    return {inputFloating
+                ? gen.emitter_.compareFloat(
+                      loc, ir::FloatPredicate::UnorderedNotEqual, source.value,
+                      zero)
+                : gen.emitter_.compareInt(loc, ir::IntPredicate::NotEqual,
+                                          source.value, zero)};
+  }
+  const bool unsignedInput = !gen.traits.is_signed(inputElement);
+  if (inputFloating && outputFloating) {
+    if (inputBits == outputBits) {
+      auto intermediate = gen.emitter_.vectorType(
+          gen.emitter_.floatingType(ir::FloatKind::Single),
+          sourceType->elementCount());
+      auto widened = gen.emitter_.floatExtend(loc, source.value, intermediate);
+      return {gen.emitter_.floatTruncate(loc, widened, resultType)};
+    }
+    return {inputBits < outputBits
+                ? gen.emitter_.floatExtend(loc, source.value, resultType)
+                : gen.emitter_.floatTruncate(loc, source.value, resultType)};
+  }
+  if (outputFloating) {
+    return {unsignedInput
+                ? gen.emitter_.unsignedIntToFloat(loc, source.value, resultType)
+                : gen.emitter_.signedIntToFloat(loc, source.value, resultType)};
+  }
+  if (inputFloating) {
+    return {gen.traits.is_unsigned(outputElement)
+                ? gen.emitter_.floatToUnsignedInt(loc, source.value, resultType)
+                : gen.emitter_.floatToSignedInt(loc, source.value, resultType)};
+  }
+  if (inputBits == outputBits) return source;
+  if (inputBits > outputBits)
+    return {gen.emitter_.truncate(loc, source.value, resultType)};
+  return {unsignedInput
+              ? gen.emitter_.zeroExtend(loc, source.value, resultType)
+              : gen.emitter_.signExtend(loc, source.value, resultType)};
+}
