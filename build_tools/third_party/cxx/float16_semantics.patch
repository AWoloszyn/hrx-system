+#ifndef CXX_FLOATING_POINT_H
+#define CXX_FLOATING_POINT_H
+
+namespace cxx {
+
+// Rounds to IEEE binary16 using round-to-nearest, ties-to-even. The result is
+// represented exactly in float, independent of host half-precision support.
+[[nodiscard]] auto roundFloat16(long double value) -> float;
+
+}  // namespace cxx
+
+#endif  // CXX_FLOATING_POINT_H
