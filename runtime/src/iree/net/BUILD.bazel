load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_fuzz.bzl", "iree_runtime_cc_fuzz")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

# Transport-independent networking primitives.
#
# Layering:
#   Layer 3: Connections and message endpoints - framed message multiplexing
#   Layer 2: Carriers - asynchronous byte and message transport
#   Layer 1: Proactor (iree/async/) - completion-based I/O

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

#===------------------------------------------------------------------------===#
# Public API
#===------------------------------------------------------------------------===#

iree_runtime_cc_library(
    name = "net",
    hdrs = ["api.h"],
    deps = [
        ":carrier",
        ":connection",
        ":message_endpoint",
        ":transport_factory",
        ":transport_registry",
    ],
)

#===------------------------------------------------------------------------===#
# Core abstractions
#===------------------------------------------------------------------------===#

iree_runtime_cc_library(
    name = "carrier",
    hdrs = ["carrier.h"],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_library(
    name = "buffer_lease",
    srcs = ["buffer_lease.c"],
    hdrs = ["buffer_lease.h"],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_library(
    name = "message_endpoint",
    hdrs = ["message_endpoint.h"],
    deps = [
        ":carrier",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_library(
    name = "endpoint_lifecycle",
    srcs = ["endpoint_lifecycle.c"],
    hdrs = ["endpoint_lifecycle.h"],
    deps = [
        ":connection",
        ":message_endpoint",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/threading",
    ],
)

iree_runtime_cc_library(
    name = "connection",
    hdrs = ["connection.h"],
    deps = [
        ":message_endpoint",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_library(
    name = "transport_factory",
    hdrs = ["transport_factory.h"],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
    ],
)

#===------------------------------------------------------------------------===#
# Message framing
#===------------------------------------------------------------------------===#

iree_runtime_cc_library(
    name = "frame_accumulator",
    srcs = ["frame_accumulator.c"],
    hdrs = ["frame_accumulator.h"],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_library(
    name = "framing_adapter",
    srcs = ["framing_adapter.c"],
    hdrs = ["framing_adapter.h"],
    deps = [
        ":buffer_lease",
        ":carrier",
        ":endpoint_lifecycle",
        ":frame_accumulator",
        ":message_endpoint",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_library(
    name = "transport_registry",
    srcs = ["transport_registry.c"],
    hdrs = ["transport_registry.h"],
    deps = [
        ":transport_factory",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
    ],
)

