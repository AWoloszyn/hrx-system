load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_fuzz.bzl", "iree_runtime_cc_fuzz")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//runtime/src/iree/net/carrier/shm:__subpackages__"],
    features = ["layering_check"],
    licenses = ["notice"],
)

iree_runtime_cc_library(
    name = "region",
    srcs = ["region.c"],
    hdrs = ["region.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:atomic_freelist",
        "//runtime/src/iree/base/internal:mpsc_queue",
    ],
)

iree_runtime_cc_library(
    name = "bootstrap",
    srcs = ["bootstrap.c"],
    hdrs = ["bootstrap.h"],
    deps = [
        ":region",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
    ],
)

iree_runtime_cc_test(
    name = "region_test",
    srcs = ["region_test.cc"],
    deps = [
        ":region",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:atomic_freelist",
        "//runtime/src/iree/base/internal:mpsc_queue",
        "//runtime/src/iree/base/internal:shm",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_test(
    name = "bootstrap_test",
    srcs = ["bootstrap_test.cc"],
    deps = [
        ":bootstrap",
        ":region",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_fuzz(
    name = "bootstrap_fuzz",
    srcs = ["bootstrap_fuzz.cc"],
    deps = [
        ":bootstrap",
        ":region",
        "//runtime/src/iree/base",
    ],
)
