load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

KFD_COMPATIBILITY = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

amdf_cc_library(
    name = "file",
    hdrs = ["file.h"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = ["//libamdf/src/platform/linux:file"],
)

amdf_cc_library(
    name = "topology",
    srcs = ["topology.c"],
    hdrs = ["topology.h"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = [
        "//libamdf/src/gpu:endpoint_profile",
        "//libamdf/src/platform",
        "//libamdf/src/platform/linux:endpoint",
        "//libamdf/src/platform/linux:file",
    ],
)

amdf_cc_library(
    name = "device_state",
    hdrs = ["device.h"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = [
        ":topology",
        "//libamdf/src/gpu/umd:device",
    ],
)

amdf_cc_library(
    name = "device",
    srcs = ["device.c"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = [
        ":device_state",
        ":file",
        ":topology",
        "//libamdf/src:allocator",
        "//libamdf/src/platform/linux:endpoint",
        "//libamdf/src/platform/linux:file",
        "//libamdf/src/platform/linux:host_cache",
    ],
)

amdf_cc_library(
    name = "memory",
    srcs = ["memory.c"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = [
        ":device_state",
        ":topology",
        "//libamdf/src:allocator",
        "//libamdf/src/gpu/umd:memory",
        "//libamdf/src/platform/linux:dma_buf",
        "//libamdf/src/platform/linux:file",
    ],
)

amdf_cc_test(
    name = "memory_test",
    srcs = ["memory_test.cc"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = [
        ":device_state",
        ":memory",
        "//libamdf/src/gpu/umd:memory",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_library(
    name = "endpoint_profile",
    srcs = ["endpoint_profile.c"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = [
        ":file",
        ":topology",
        "//libamdf/src/gpu:endpoint_profile",
        "//libamdf/src/gpu/umd:endpoint_profile",
        "//libamdf/src/platform/linux:file",
    ],
)

amdf_cc_library(
    name = "kernel_queue",
    srcs = ["kernel_queue.c"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = ["//libamdf/src/gpu/umd:kernel_queue"],
)

amdf_cc_library(
    name = "kfd",
    target_compatible_with = KFD_COMPATIBILITY,
    visibility = ["//libamdf/src/gpu/umd:__pkg__"],
    deps = [
        ":device",
        ":endpoint_profile",
        ":kernel_queue",
        ":memory",
    ],
)
