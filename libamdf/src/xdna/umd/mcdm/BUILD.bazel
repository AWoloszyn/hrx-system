load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

MCDM_COMPATIBILITY = ["@platforms//os:windows"]

amdf_cc_library(
    name = "bootstrap_image",
    srcs = ["npu5_legacy_bootstrap_image.c"],
    hdrs = ["npu5_legacy_bootstrap_image.h"],
    target_compatible_with = MCDM_COMPATIBILITY,
)

amdf_cc_library(
    name = "legacy_context",
    srcs = ["legacy_context.c"],
    hdrs = ["legacy_context.h"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        ":bootstrap_image",
        "//libamdf/src:allocator",
    ],
)

amdf_cc_library(
    name = "device_state",
    hdrs = ["device.h"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        "//libamdf/src/platform/windows:device_status",
        "//libamdf/src/platform/windows:kmt_api",
        "//libamdf/src/xdna/umd:device",
    ],
)

amdf_cc_library(
    name = "context_state",
    hdrs = ["context.h"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        ":device_state",
        "//libamdf/src/xdna/umd:context",
    ],
)

amdf_cc_library(
    name = "private_allocation",
    srcs = ["private_allocation.c"],
    hdrs = ["private_allocation.h"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        ":device_state",
        "//libamdf/src/platform/windows:host_cache",
    ],
)

amdf_cc_library(
    name = "memory_profile",
    srcs = ["memory_profile.c"],
    hdrs = ["memory_profile.h"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        "//libamdf/src:memory_profile",
        "//libamdf/src/platform/windows:endpoint",
        "//libamdf/src/xdna:endpoint_profile",
        "//libamdf/src/xdna/umd:memory_profile",
    ],
)

amdf_cc_library(
    name = "memory",
    srcs = ["memory.c"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        ":device_state",
        ":memory_profile",
        "//libamdf/src:allocator",
        "//libamdf/src/platform/windows:host_cache",
        "//libamdf/src/xdna/umd:memory",
    ],
)

amdf_cc_library(
    name = "device",
    srcs = ["device.c"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        ":device_state",
        "//libamdf/src:allocator",
        "//libamdf/src/platform/windows:endpoint",
        "//libamdf/src/xdna/umd:device",
    ],
)

amdf_cc_library(
    name = "context",
    srcs = ["context.c"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        ":context_state",
        ":device_state",
        ":legacy_context",
        "//libamdf/src:allocator",
        "//libamdf/src/xdna/umd:context",
    ],
)

amdf_cc_library(
    name = "mcdm",
    target_compatible_with = MCDM_COMPATIBILITY,
    visibility = ["//libamdf/src/xdna:__pkg__"],
    deps = [
        ":context",
        ":device",
        ":memory",
    ],
)

amdf_cc_test(
    name = "device_test",
    srcs = ["device_test.cc"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        ":context",
        ":context_state",
        ":device",
        "//libamdf/src:allocator",
        "//libamdf/src/platform/windows:endpoint",
        "//libamdf/src/xdna:endpoint_profile",
        "//libamdf/src/xdna/umd:context",
        "//libamdf/src/xdna/umd:device",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "context_test",
    srcs = ["context_test.cc"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        ":context",
        ":context_state",
        ":device_state",
        "//libamdf/src:allocator",
        "//libamdf/src/xdna:endpoint_profile",
        "//libamdf/src/xdna/umd:context",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "legacy_context_test",
    srcs = ["legacy_context_test.cc"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        ":legacy_context",
        "//libamdf/src:allocator",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "memory_test",
    srcs = ["memory_test.cc"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        ":device_state",
        ":memory",
        "//libamdf/src:allocator",
        "//libamdf/src/xdna/umd:memory",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "private_allocation_test",
    srcs = ["private_allocation_test.cc"],
    target_compatible_with = MCDM_COMPATIBILITY,
    deps = [
        ":device_state",
        ":private_allocation",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
