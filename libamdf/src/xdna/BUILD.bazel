load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "endpoint_profile",
    srcs = ["endpoint_profile.c"],
    hdrs = ["endpoint_profile.h"],
    visibility = [
        "//libamdf/src/provider:__pkg__",
        "//libamdf/src/xdna:__subpackages__",
    ],
    deps = [
        "//libamdf/src:pci",
        "//libamdf/src/xdna/target/npu5:ert_packet",
    ],
)

amdf_cc_library(
    name = "device",
    srcs = [
        "device.c",
        "memory.c",
    ],
    hdrs = [
        "device.h",
        "memory.h",
    ],
    deps = [
        ":endpoint_profile",
        "//libamdf/src:allocator",
        "//libamdf/src:device",
        "//libamdf/src:endpoint",
        "//libamdf/src:host_mapping",
        "//libamdf/src:memory",
        "//libamdf/src:structure",
        "//libamdf/src/xdna/umd:device",
        "//libamdf/src/xdna/umd:memory",
    ],
)

amdf_cc_library(
    name = "context",
    srcs = ["context.c"],
    hdrs = ["context.h"],
    deps = [
        ":device",
        ":endpoint_profile",
        "//libamdf/src:allocator",
        "//libamdf/src:child_tracker",
        "//libamdf/src:device",
        "//libamdf/src:structure",
        "//libamdf/src/xdna/umd:context",
    ],
)

amdf_cc_library(
    name = "extension",
    srcs = ["extension.c"],
    hdrs = ["extension.h"],
    visibility = ["//libamdf/src/provider:__pkg__"],
    deps = [
        ":context",
        ":device",
        ":endpoint_profile",
        "//libamdf/src:endpoint",
        "//libamdf/src:structure",
        "//libamdf/src/platform",
    ],
)

amdf_cc_library(
    name = "xdna",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//libamdf/src/provider:__pkg__"],
    deps = [":extension"] + select({
        "@platforms//os:linux": ["//libamdf/src/xdna/umd/drm"],
        "@platforms//os:windows": ["//libamdf/src/xdna/umd/mcdm"],
        "//conditions:default": [],
    }),
)

amdf_cc_test(
    name = "endpoint_profile_test",
    srcs = ["endpoint_profile_test.cc"],
    deps = [
        ":endpoint_profile",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

