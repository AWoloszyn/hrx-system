load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "gpu_device_fixture",
    testonly = True,
    hdrs = ["gpu_device_fixture.h"],
    deps = [
        "//libamdf/cts/util:device_cache",
        "//libamdf/cts/util:provider_headers",
        "//third_party:google_test",
    ],
)

amdf_cc_library(
    name = "linux_tests",
    testonly = True,
    srcs = [
        "memory_linux_test.cc",
        "memory_xdna_interop_linux_test.cc",
        "target/gfx1151/user_queue_memory_test.cc",
    ],
    hdrs = ["target/gfx1151/user_queue_memory_test.h"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        ":gpu_device_fixture",
        "//libamdf/cts/util:device_cache",
        "//libamdf/cts/util:provider_headers",
        "//third_party:google_test",
    ],
    alwayslink = True,
)

amdf_cc_library(
    name = "windows_tests",
    testonly = True,
    srcs = [
        "kernel_queue_test.cc",
        "memory_interop_test.cc",
        "windows/memory_test.cc",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":gpu_device_fixture",
        "//third_party:google_test",
    ],
    alwayslink = True,
)

amdf_cc_library(
    name = "gpu_tests",
    testonly = True,
    srcs = ["gpu_extension_test.cc"],
    target_compatible_with = ["@platforms//cpu:x86_64"] + select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libamdf/cts/util:device_cache",
        "//libamdf/cts/util:provider_headers",
        "//third_party:google_test",
    ] + select({
        "@platforms//os:linux": [":linux_tests"],
        "@platforms//os:windows": [":windows_tests"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)

amdf_cts_test_suite(
    name = "gpu",
    suites = [":gpu_tests"],
    target_compatible_with = ["@platforms//cpu:x86_64"] + select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)
