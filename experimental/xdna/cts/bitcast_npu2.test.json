{
  "version": 1,
  "cases": [
    {
      "name": "scalar/vector bit casts preserve payloads and lane order on NPU2",
      "steps": [
        {
          "name": "fixtures",
          "run": {
            "tool": "generate-cases",
            "args": [
              "{tmp}/fixtures"
            ]
          }
        },
        {
          "name": "import",
          "run": {
            "tool": "loom-import-cxx",
            "args": [
              "--builtin-includes=false",
              "--root=bitcast_blocks",
              "--to=bc",
              "--output={tmp}/bitcast.loombc",
              "{srcdir}/testdata/bitcast.cxx"
            ]
          }
        },
        {
          "name": "link",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/bitcast.loom",
              "--library={tmp}/bitcast.loombc",
              "--root=@bitcast_packets",
              "--to=bc",
              "--output={tmp}/module.loombc"
            ]
          }
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/module.loombc",
              "--root=@bitcast_packets",
              "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
              "--output={tmp}/bitcast.xdna"
            ]
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "iree-xdna-run",
            "args": [
              "--image={tmp}/bitcast.xdna",
              "--columns=1",
              "--entry=bitcast_packets",
              "--invocation_count=3",
              "--binding_memory=system",
              "--binding={tmp}/fixtures/input.bin",
              "--binding={tmp}/fixtures/output.bin",
              "--output=0={tmp}/input-readback.bin",
              "--output=1={tmp}/output-readback.bin"
            ]
          },
          "files": [
            {
              "path": "{tmp}/input-readback.bin",
              "equals": "{tmp}/fixtures/input.bin"
            },
            {
              "path": "{tmp}/output-readback.bin",
              "equals": "{tmp}/fixtures/expected.bin"
            }
          ]
        }
      ]
    }
  ]
}
