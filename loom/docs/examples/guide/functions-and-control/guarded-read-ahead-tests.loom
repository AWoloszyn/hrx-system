kernel.decl @sum_guarded_rows() launch(%row_count: index, %column_count: index, %lane_count: index, %input: buffer, %output: buffer)

template.decl @guide.sum_guarded_rows(%values: view<63x32x4xf32>, %count: index, %columns: index, %lane: index, %active_lanes: index, %depth: index, %factor: index, %inner_depth: index) -> (f32)

// Serial, outer-pipelined and doubly pipelined instantiations coexist.
kernel.def @guarded_rows_composed() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%row_count: index, %column_count: index, %lane_count: index, %input: buffer, %serial_output: buffer, %pipeline_output: buffer, %nested_output: buffer) {
  %count = index.assume %row_count [range(%row_count, 0, 63)] : index
  %columns = index.assume %column_count [range(%column_count, 0, 4)] : index
  %active_lanes = index.assume %lane_count [range(%lane_count, 0, 32)] : index
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %aligned_serial_output = buffer.assume.alignment %serial_output {minimum_alignment = 4} : buffer
  %aligned_pipeline_output = buffer.assume.alignment %pipeline_output {minimum_alignment = 4} : buffer
  %aligned_nested_output = buffer.assume.alignment %nested_output {minimum_alignment = 4} : buffer
  %values = buffer.view %aligned_input[%base] : buffer -> view<63x32x4xf32>
  %serial_view = buffer.view %aligned_serial_output[%base] : buffer -> view<32xf32>
  %pipeline_view = buffer.view %aligned_pipeline_output[%base] : buffer -> view<32xf32>
  %nested_view = buffer.view %aligned_nested_output[%base] : buffer -> view<32xf32>
  %serial_policy = index.constant 1 : index
  %pair_policy = index.constant 2 : index
  %triple_policy = index.constant 3 : index
  %deep_policy = index.constant 4 : index
  %serial = template.apply<@guide.sum_guarded_rows>(%values, %count, %columns, %lane, %active_lanes, %serial_policy, %serial_policy, %serial_policy) : (view<63x32x4xf32>, index, index, index, index, index, index, index) -> (f32)
  %pipelined = template.apply<@guide.sum_guarded_rows>(%values, %count, %columns, %lane, %active_lanes, %triple_policy, %pair_policy, %serial_policy) : (view<63x32x4xf32>, index, index, index, index, index, index, index) -> (f32)
  %nested = template.apply<@guide.sum_guarded_rows>(%values, %count, %columns, %lane, %active_lanes, %deep_policy, %triple_policy, %pair_policy) : (view<63x32x4xf32>, index, index, index, index, index, index, index) -> (f32)
  view.store %serial, %serial_view[%lane] : f32, view<32xf32>
  view.store %pipelined, %pipeline_view[%lane] : f32, view<32xf32>
  view.store %nested, %nested_view[%lane] : f32, view<32xf32>
  kernel.return
}

check.case public @guarded_rows_random {
  %count = check.param.choice values([0, 1, 2, 3, 4, 5, 8, 62, 63]) : index
  %columns = check.param.choice values([0, 1, 2, 3, 4]) : index
  %lanes = check.param.choice values([0, 1, 17, 32]) : index
  %seed = check.param.seed base(1000) count(2) name("seed") : i64
  %input = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<63x32x4xf32>
  %serial = check.generate.fill value(-1.0) : tensor<32xf32>
  %pipelined = check.generate.fill value(-2.0) : tensor<32xf32>
  %nested = check.generate.fill value(-3.0) : tensor<32xf32>
  kernel.launch @guarded_rows_composed(%count, %columns, %lanes, %input, %serial, %pipelined, %nested) : (index, index, index, tensor<63x32x4xf32>, tensor<32xf32>, tensor<32xf32>, tensor<32xf32>)
  check.expect.bitwise actual(%pipelined) expected(%serial) : tensor<32xf32>
  check.expect.bitwise actual(%nested) expected(%serial) : tensor<32xf32>
  check.return
}

// All active lanes sum 63 rows of four ones. Padding adds row 63, outside
// the input allocation; its false guard must suppress every load.
check.case public @guarded_rows_exact {
  %count = check.literal value(63) : index
  %columns = check.literal value(4) : index
  %lanes = check.literal value(32) : index
  %input = check.generate.fill value(1.0) : tensor<63x32x4xf32>
  %output = check.generate.fill value(-1.0) : tensor<32xf32>
  %expected = check.generate.fill value(252.0) : tensor<32xf32>
  kernel.launch @sum_guarded_rows(%count, %columns, %lanes, %input, %output) : (index, index, index, tensor<63x32x4xf32>, tensor<32xf32>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<32xf32>
  check.return
}

check.benchmark<@guarded_rows_exact> @guarded_rows_time
