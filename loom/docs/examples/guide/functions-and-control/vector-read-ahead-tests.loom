kernel.decl @sum_vector_rows() launch(%row_count: index, %input: buffer, %output: buffer)

template.decl @guide.sum_vector_rows(%values: view<64x32x4xf32>, %count: index, %lane: index, %depth: index, %factor: index) -> (f32)

// Both schedules coexist in one compiled kernel.
kernel.def @sum_vector_rows_composed() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%row_count: index, %input: buffer, %pipelined_output: buffer, %serial_output: buffer) {
  %count = index.assume %row_count [range(%row_count, 0, 64)] : index
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %aligned_pipelined = buffer.assume.alignment %pipelined_output {minimum_alignment = 4} : buffer
  %aligned_serial = buffer.assume.alignment %serial_output {minimum_alignment = 4} : buffer
  %values = buffer.view %aligned_input[%base] : buffer -> view<64x32x4xf32>
  %pipelined_sums = buffer.view %aligned_pipelined[%base] : buffer -> view<32xf32>
  %serial_sums = buffer.view %aligned_serial[%base] : buffer -> view<32xf32>
  %depth = index.constant 4 : index
  %factor = index.constant 6 : index
  %pipelined = template.apply<@guide.sum_vector_rows>(%values, %count, %lane, %depth, %factor) : (view<64x32x4xf32>, index, index, index, index) -> (f32)
  %serial_depth = index.constant 1 : index
  %serial_factor = index.constant 2 : index
  %serial = template.apply<@guide.sum_vector_rows>(%values, %count, %lane, %serial_depth, %serial_factor) : (view<64x32x4xf32>, index, index, index, index) -> (f32)
  view.store %pipelined, %pipelined_sums[%lane] : f32, view<32xf32>
  view.store %serial, %serial_sums[%lane] : f32, view<32xf32>
  kernel.return
}

// For N rows, lane L sums N * (10 + 16 * L + 256 * (N - 1)).
check.case public @sum_vector_rows_0 {
  %count = check.literal value(0) : index
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<64x32x4xf32>
  %output = check.generate.fill value(-1.0) : tensor<32xf32>
  %expected = check.generate.iota offset(0.0) step(0.0) : tensor<32xf32>
  kernel.launch @sum_vector_rows(%count, %input, %output) : (index, tensor<64x32x4xf32>, tensor<32xf32>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<32xf32>
  check.return
}

