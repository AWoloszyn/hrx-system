check.case public @independent_motif_schedules {
  %count = check.param.choice values([0, 1, 2, 3, 4, 5, 6, 7, 8, 63, 64]) : index
  %seed = check.param.seed base(1000) count(4) name("seed") : i64
  %input = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<64x32x4xf32>
  %pipelined = check.generate.fill value(-1.0) : tensor<32xf32>
  %serial = check.generate.fill value(1.0) : tensor<32xf32>
  kernel.launch @sum_vector_rows_composed(%count, %input, %pipelined, %serial) : (index, tensor<64x32x4xf32>, tensor<32xf32>, tensor<32xf32>)
  check.expect.bitwise actual(%pipelined) expected(%serial) : tensor<32xf32>
  check.return
}

check.benchmark<@sum_vector_rows_64> @sum_vector_rows_time
