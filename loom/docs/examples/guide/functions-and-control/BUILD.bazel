# bazel-to-cmake: skip

load("@hrx//loom/build_tools/bazel:defs.bzl", "loom_execution_profile", "loom_library", "loom_test")
load("@hrx//loom/requirements:defs.bzl", "TARGET_ARCH_VM")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],
)

loom_library(
    name = "rotation",
    srcs = ["rotating-views.loom"],
)

loom_test(
    name = "tests",
    srcs = ["tests.loom"],
    execution_profile = loom_execution_profile(
        name = "vm",
        build_requirements = [TARGET_ARCH_VM],
        executor = "reference",
        target_class = "cpu",
        target_family = "vm",
    ),
    deps = [":rotation"],
)
