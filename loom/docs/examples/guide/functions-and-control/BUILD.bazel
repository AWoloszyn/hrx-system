# bazel-to-cmake: skip

load("@hrx//loom/build_tools/bazel:defs.bzl", "loom_execution_profile", "loom_kernel_library", "loom_library", "loom_test")
load("@hrx//loom/requirements:defs.bzl", "TARGET_ARCH_VM")
load("@hrx//loom/src/loom/tooling/target/spirv:execution_profiles.bzl", "SPIRV_VULKAN_HARDWARE_PROFILE")
load("@hrx//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_HARDWARE_PROFILE")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],
)

loom_library(
    name = "rotation",
    srcs = ["rotating-views.loom"],
)

loom_test(
    name = "tests",
    srcs = ["tests.loom"],
    execution_profile = loom_execution_profile(
        name = "vm",
        build_requirements = [TARGET_ARCH_VM],
        executor = "reference",
        target_class = "cpu",
        target_family = "vm",
    ),
    deps = [":rotation"],
)

loom_kernel_library(
    name = "read_ahead",
    srcs = [
        "read-ahead.loom",
        "read-ahead-tests.loom",
    ],
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
    targets = [
        "@hrx//loom/target/amdgpu:gfx11-generic",
        "@hrx//loom/target/amdgpu:gfx1250-a0",
        "@hrx//loom/target/spirv:vulkan1.3+bda",
    ],
)

loom_test(
    name = "read_ahead_serial_test",
    srcs = ["read-ahead-tests.loom"],
    args = [
        "--config=read_ahead.depth=1",
        "--config=read_ahead.unroll=2",
    ],
    execution_profile = AMDGPU_HARDWARE_PROFILE,
    deps = [":read_ahead"],
)

loom_test(
    name = "read_ahead_unroll1_test",
    srcs = ["read-ahead-tests.loom"],
    args = [
        "--config=read_ahead.depth=3",
        "--config=read_ahead.unroll=1",
    ],
    execution_profile = AMDGPU_HARDWARE_PROFILE,
    deps = [":read_ahead"],
)

loom_kernel_library(
    name = "vector_read_ahead",
    srcs = [
        "vector-read-ahead.loom",
        "vector-read-ahead-tests.loom",
    ],
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        SPIRV_VULKAN_HARDWARE_PROFILE,
    ],
    targets = [
        "@hrx//loom/target/amdgpu:gfx11-generic",
        "@hrx//loom/target/amdgpu:gfx1250-a0",
        "@hrx//loom/target/spirv:vulkan1.3+bda",
    ],
)

loom_test(
    name = "vector_read_ahead_access_test",
    srcs = ["vector-read-ahead-tests.loom"],
    args = ["--sanitizer=access"],
    execution_profile = AMDGPU_HARDWARE_PROFILE,
    deps = [":vector_read_ahead"],
)

loom_kernel_library(
    name = "guarded_read_ahead",
    srcs = [
        "guarded-read-ahead.loom",
        "guarded-read-ahead-tests.loom",
    ],
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        SPIRV_VULKAN_HARDWARE_PROFILE,
    ],
    targets = [
        "@hrx//loom/target/amdgpu:gfx11-generic",
        "@hrx//loom/target/amdgpu:gfx1250-a0",
        "@hrx//loom/target/spirv:vulkan1.3+bda",
    ],
)

loom_test(
    name = "guarded_read_ahead_access_test",
    srcs = ["guarded-read-ahead-tests.loom"],
    args = ["--sanitizer=access"],
    execution_profile = AMDGPU_HARDWARE_PROFILE,
    deps = [":guarded_read_ahead"],
)

loom_kernel_library(
    name = "paired_read_ahead",
    srcs = [
        "paired-read-ahead.loom",
        "paired-read-ahead-tests.loom",
    ],
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        SPIRV_VULKAN_HARDWARE_PROFILE,
    ],
    targets = [
        "@hrx//loom/target/amdgpu:gfx11-generic",
        "@hrx//loom/target/amdgpu:gfx1250-a0",
        "@hrx//loom/target/spirv:vulkan1.3+bda",
    ],
    deps = [":vector_read_ahead"],
)

loom_test(
    name = "paired_read_ahead_serial_access_test",
    srcs = ["paired-read-ahead-tests.loom"],
    args = [
        "--sanitizer=access",
        "--config=paired_rows.left_lookahead=0",
        "--config=paired_rows.left_unroll=1",
        "--config=paired_rows.right_lookahead=0",
        "--config=paired_rows.right_unroll=1",
    ],
    execution_profile = AMDGPU_HARDWARE_PROFILE,
    deps = [":paired_read_ahead"],
)

loom_test(
    name = "paired_read_ahead_swapped_access_test",
    srcs = ["paired-read-ahead-tests.loom"],
    args = [
        "--sanitizer=access",
        "--config=paired_rows.left_lookahead=0",
        "--config=paired_rows.left_unroll=1",
        "--config=paired_rows.right_lookahead=3",
        "--config=paired_rows.right_unroll=4",
    ],
    execution_profile = AMDGPU_HARDWARE_PROFILE,
    deps = [":paired_read_ahead"],
)

loom_test(
    name = "paired_read_ahead_both_access_test",
    srcs = ["paired-read-ahead-tests.loom"],
    args = [
        "--sanitizer=access",
        "--config=paired_rows.left_lookahead=3",
        "--config=paired_rows.left_unroll=4",
        "--config=paired_rows.right_lookahead=3",
        "--config=paired_rows.right_unroll=4",
    ],
    execution_profile = AMDGPU_HARDWARE_PROFILE,
    deps = [":paired_read_ahead"],
)

loom_test(
    name = "paired_read_ahead_deep_access_test",
    srcs = ["paired-read-ahead-tests.loom"],
    args = [
        "--sanitizer=access",
        "--config=paired_rows.left_lookahead=31",
        "--config=paired_rows.left_unroll=4",
        "--config=paired_rows.right_lookahead=31",
        "--config=paired_rows.right_unroll=4",
    ],
    execution_profile = AMDGPU_HARDWARE_PROFILE,
    deps = [":paired_read_ahead"],
)
