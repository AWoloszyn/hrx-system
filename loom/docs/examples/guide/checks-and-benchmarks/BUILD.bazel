# bazel-to-cmake: skip

load(
    "@hrx//loom/build_tools/bazel:defs.bzl",
    "loom_library",
    "loom_test",
)
load("@hrx//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

loom_library(
    name = "kernel",
    srcs = ["kernel.loom"],
)

loom_test(
    name = "tests",
    srcs = ["tests.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    tags = ["manual"],
    deps = [":kernel"],
)
