func.def @signed_varying_word(%input: vector<2xi32>, %table: buffer) -> (i32) {
  %raw = vector.extract %input[0] : vector<2xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -128, 127)] : i32
  %bias = scalar.constant 128 : i32
  %ordinal = scalar.addi %signed, %bias : i32
  %position = index.cast %ordinal : i32 to index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<256xi32>
  %value = view.load %view[%position] : view<256xi32> -> i32
  func.return %value : i32
}

// ====

func.def @signed_varying_byte(%input: vector<2xi32>, %table: buffer) -> (i8) {
  %raw = vector.extract %input[0] : vector<2xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -128, 127)] : i32
  %position = index.cast %signed : i32 to index
  %base = index.constant 128 : offset
  %view = buffer.view %table[%base] : buffer -> view<256xi8>
  %bias = index.constant 128 : index
  %ordinal = index.add %position, %bias : index
  %value = view.load %view[%ordinal] : view<256xi8> -> i8
  func.return %value : i8
}

// ====

func.def @signed_irregular_stride(%input: vector<2xi32>, %table: buffer) -> (i32) {
  %raw = vector.extract %input[0] : vector<2xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -128, 127)] : i32
  %position = index.cast %signed : i32 to index
  %bias = index.constant 128 : index
  %ordinal = index.add %position, %bias : index
  %base = index.constant 0 : offset
  %layout = encoding.layout.strided [3] : encoding<layout>
  %view = buffer.view %table[%base] : buffer -> view<256xi32, %layout>
  %value = view.load %view[%ordinal] : view<256xi32, %layout> -> i32
  func.return %value : i32
}

