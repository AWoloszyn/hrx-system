func.def @signed_high_bit_stride(%input: vector<2xi32>, %table: buffer) -> (i8) {
  %raw = vector.extract %input[0] : vector<2xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -1, 1)] : i32
  %coordinate = index.cast %signed : i32 to index
  %bias = index.constant 1 : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %layout = encoding.layout.strided [2147483649] : encoding<layout>
  %view = buffer.view %table[%base] : buffer -> view<3xi8, %layout>
  %value = view.load %view[%position] : view<3xi8, %layout> -> i8
  func.return %value : i8
}

