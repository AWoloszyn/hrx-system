// RUN: roundtrip

func.def @turns_f32(%value: f32) -> (f32, f32) {
  %sin = scalar.sinturnsf %value : f32
  %cos = scalar.costurnsf %value : f32
  func.return %sin, %cos : f32, f32
}

// ====

func.def @radians_afn_f32(%value: f32) -> (f32, f32) {
  %sin = scalar.sinf<afn> %value : f32
  %cos = scalar.cosf<afn> %value : f32
  func.return %sin, %cos : f32, f32
}
