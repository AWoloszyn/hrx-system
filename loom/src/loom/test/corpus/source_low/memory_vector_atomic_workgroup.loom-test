kernel.def @workgroup_vector_atomic() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%flag: i32, %output: buffer) {
  %base = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<2xi32>
  %results = buffer.view %output[%base] : buffer -> view<2xi32>
  %initial = vector.constant 7 : vector<2xi32>
  vector.store %initial, %view[0] : vector<2xi32>, view<2xi32>
  %origin = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  %increment = vector.constant 1 : vector<2xi32>
  %c0 = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %c0 : i32
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  vector.atomic.reduce<addi> %increment, %view[0][%offsets] {ordering = release, scope = workgroup} : vector<2xi32>, view<2xi32>, vector<2xindex>
  vector.atomic.reduce.mask<subi> %increment, %view[0][%offsets], %mask {ordering = relaxed, scope = workgroup} : vector<2xi32>, view<2xi32>, vector<2xindex>, vector<2xi1>
  %old = vector.atomic.rmw<addi> %increment, %view[0][%offsets] {ordering = acq_rel, scope = workgroup} : vector<2xi32>, view<2xi32>, vector<2xindex>
  %masked = vector.atomic.rmw.mask<xchgi> %increment, %view[0][%offsets], %mask, %old {ordering = acquire, scope = workgroup} : vector<2xi32>, view<2xi32>, vector<2xindex>, vector<2xi1>, vector<2xi32>
  %observed = vector.atomic.cmpxchg %masked, %old, %view[0][%offsets] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : vector<2xi32>, view<2xi32>, vector<2xindex> -> vector<2xi32>
  vector.store %observed, %results[0] : vector<2xi32>, view<2xi32>
  kernel.return
}
