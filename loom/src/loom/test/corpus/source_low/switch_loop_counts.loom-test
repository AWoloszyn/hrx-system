// RUN: roundtrip

// Case selection controls whether an addition executes once or four times.
func.def @switch_loop_counts(%selector: index, %value: i32) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %result = scf.switch %selector -> (i32) {
    case 0 {
      %total = scf.for %iteration = [%begin to %end step %step](%accumulator = %value : i32) -> (i32) {
        %sum = scalar.addi %accumulator, %value : i32
        scf.yield %sum : i32
      }
      scf.yield %total : i32
    }
    default {
      %sum = scalar.addi %value, %value : i32
      scf.yield %sum : i32
    }
  }
  func.return %result : i32
}
