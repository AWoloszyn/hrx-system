  %olt = scalar.cmpf olt, %a, %b : f64
  %ole = scalar.cmpf ole, %a, %b : f64
  %one = scalar.cmpf one, %a, %b : f64
  %ord = scalar.cmpf ord, %a, %b : f64
  %ueq = scalar.cmpf ueq, %a, %b : f64
  %ugt = scalar.cmpf ugt, %a, %b : f64
  %uge = scalar.cmpf uge, %a, %b : f64
  %ult = scalar.cmpf ult, %a, %b : f64
  %ule = scalar.cmpf ule, %a, %b : f64
  %une = scalar.cmpf une, %a, %b : f64
  %uno = scalar.cmpf uno, %a, %b : f64
  func.return %oeq, %ogt, %oge, %olt, %ole, %one, %ord, %ueq, %ugt, %uge, %ult, %ule, %une, %uno : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1
}

// ====

func.def @float_selected_f64(%a: f64, %b: f64, %c: f64) -> (f64, f64, f64, f64, i1, i1, i1, f64, f64, f64, f64) {
  %minimum = scalar.minimumf %a, %b : f64
  %maximum = scalar.maximumf %a, %b : f64
  %minnum = scalar.minnumf %a, %b : f64
  %maxnum = scalar.maxnumf %a, %b : f64
  %isnan = scalar.isnanf %a : f64
  %isinf = scalar.isinff %a : f64
  %isfinite = scalar.isfinitef %a : f64
  %ordered = scalar.clampf<ordered> %a, %b, %c : f64
  %number = scalar.clampf<number> %a, %b, %c : f64
  %ieee = scalar.clampf<ieee> %a, %b, %c : f64
  %fused = scalar.fmaf %a, %b, %c : f64
  func.return %minimum, %maximum, %minnum, %maxnum, %isnan, %isinf, %isfinite, %ordered, %number, %ieee, %fused : f64, f64, f64, f64, i1, i1, i1, f64, f64, f64, f64
}

// ====

func.def @float_bitcasts_f64(%bits: i64, %number: f64) -> (f64, i64) {
  %as_number = scalar.bitcast %bits : i64 to f64
  %as_bits = scalar.bitcast %number : f64 to i64
  func.return %as_number, %as_bits : f64, i64
}

// ====

func.def @exponentials_f32(%input: f32) -> (f32, f32) {
  %base_two = scalar.exp2f<afn> %input : f32
  %natural = scalar.expf<afn> %input : f32
  func.return %base_two, %natural : f32, f32
}

// ====

func.def @float_sign_f32(%value: f32) -> (f32) {
  %result = scalar.signf %value : f32
  func.return %result : f32
}

// ====

func.def @float_sign_f64(%value: f64) -> (f64) {
  %result = scalar.signf %value : f64
  func.return %result : f64
}

// ====

func.def @roots_f32(%value: f32) -> (f32, f32) {
  %root = scalar.sqrtf %value : f32
  %inverse = scalar.rsqrtf %value : f32
  func.return %root, %inverse : f32, f32
}
