// RUN: roundtrip

func.def @byte_checksum(%byte_count: i64, %byte_start: i64, %pattern: i32) -> (i32) {
  %length = index.cast %byte_count : i64 to offset
  %start = index.cast %byte_start : i64 to offset
  %extent = index.add %length, %start : offset
  %storage = buffer.alloca<private> align(8) %extent : buffer
  %begin = index.constant 0 : offset
  %stride = index.constant 1 : offset
  scf.for %i = [%begin to %length step %stride] {
    %position = index.add %start, %i : offset
    buffer.store.i8 %pattern, %storage[%position]
  }
  %initial = scalar.constant 0 : i32
  %checksum = scf.for %i = [%begin to %length step %stride](%sum = %initial : i32) -> (i32) {
    %position = index.add %start, %i : offset
    %byte = buffer.load.i8.u %storage[%position]
    %next = scalar.addi %sum, %byte : i32
    scf.yield %next : i32
  }
  func.return %checksum : i32
}
