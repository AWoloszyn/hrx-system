func.def @bitwise_word_constants(%input: i32, %mask_input: i32) -> (i32, i32, i32) {
  %mask = scalar.assume %mask_input [range(%mask_input, 255, 255)] : i32
  %tag = scalar.constant -2147483648 : i32
  %toggle = scalar.constant 2147483647 : i32
  %masked = scalar.andi %input, %mask : i32
  %tagged = scalar.ori %tag, %input : i32
  %toggled = scalar.xori %input, %toggle : i32
  func.return %masked, %tagged, %toggled : i32, i32, i32
}

