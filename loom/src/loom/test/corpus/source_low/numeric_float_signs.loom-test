// ====

func.def @scalar_bf16_signs_fast(%magnitude: bf16, %sign: bf16) -> (bf16, bf16, bf16) {
  %absolute = scalar.absf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %magnitude : bf16
  %negated = scalar.negf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %magnitude : bf16
  %copied = scalar.copysignf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %magnitude, %sign : bf16
  func.return %absolute, %negated, %copied : bf16, bf16, bf16
}
