// RUN: roundtrip

func.def @scalar_f32_signs(%magnitude: f32, %sign: f32) -> (f32, f32, f32) {
  %absolute = scalar.absf %magnitude : f32
  %negated = scalar.negf %magnitude : f32
  %copied = scalar.copysignf %magnitude, %sign : f32
  func.return %absolute, %negated, %copied : f32, f32, f32
}

// ====

func.def @scalar_bf16_signs(%magnitude: bf16, %sign: bf16) -> (bf16, bf16, bf16) {
  %absolute = scalar.absf %magnitude : bf16
  %negated = scalar.negf %magnitude : bf16
  %copied = scalar.copysignf %magnitude, %sign : bf16
  func.return %absolute, %negated, %copied : bf16, bf16, bf16
}

