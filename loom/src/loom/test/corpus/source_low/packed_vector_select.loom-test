// ====

// All mask elements share the range [false, true], but choose independently.
func.def @select_byte_comparisons(%input: vector<4xi32>, %true_value: vector<4xi8>, %false_value: vector<4xi8>) -> (vector<4xi8>) {
  %low_bit = scalar.constant 1 : i32
  %low_bits = vector.splat %low_bit : vector<4xi32>
  %bits = vector.andi %input, %low_bits : vector<4xi32>
  %mask = vector.cmpi eq, %bits, %low_bits : vector<4xi32> -> vector<4xi1>
  %selected = vector.select %mask, %true_value, %false_value : vector<4xi8>
  func.return %selected : vector<4xi8>
}
