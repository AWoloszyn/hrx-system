// Full-width carriers retain all payload bits across native packet splitting.
kernel.def @float64_memory_copy() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<18xf64>
  %destination = buffer.view %output[%base] : buffer -> view<18xf64>
  %payload = vector.load %source[1] : view<18xf64> -> vector<16xf64>
  vector.store %payload, %destination[1] : vector<16xf64>, view<18xf64>
  kernel.return
}
