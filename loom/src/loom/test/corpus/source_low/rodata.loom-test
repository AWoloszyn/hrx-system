// RUN: roundtrip

global.rodata.def @unused = align(4096) bytes("aabbcc")

global.rodata.def @table = align(64) bytes("1122334480ff007e")

func.def @table_byte(%position: offset) -> (i32) {
  %table = global.load @table : buffer
  %result = buffer.load.i8.u %table[%position]
  func.return %result : i32
}

// ====

global.rodata.def @empty = bytes("")

global.rodata.def @odd = align(2) bytes("abcdef")

global.rodata.def @wide = align(128) bytes("01020304")

func.def @data_roots() -> (buffer, buffer, buffer) {
  %empty = global.load @empty : buffer
  %odd = global.load @odd : buffer
  %wide = global.load @wide : buffer
  func.return %empty, %odd, %wide : buffer, buffer, buffer
}

// ====

global.rodata.def @shared = align(8) bytes("0102030405060708")

func.def @data_copy(%target: buffer, %start: offset, %length: offset) {
  %source = global.load @shared : buffer
  %target_offset = index.constant 0 : offset
  buffer.copy %source[%start], %target[%target_offset], %length
  func.return
}
