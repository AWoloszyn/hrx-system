// RUN: roundtrip

func.def @integer_unary_i32(%value: i32) -> (i32, i32, i32, i32, i32) {
  %negated = scalar.negi %value : i32
  %absolute = scalar.absi %value : i32
  %leading = scalar.ctlzi %value : i32
  %trailing = scalar.cttzi %value : i32
  %population = scalar.ctpopi %value : i32
  func.return %negated, %absolute, %leading, %trailing, %population : i32, i32, i32, i32, i32
}

// ====

func.def @integer_unary_i64(%value: i64) -> (i64, i64, i64, i64, i64) {
  %negated = scalar.negi %value : i64
  %absolute = scalar.absi %value : i64
  %leading = scalar.ctlzi %value : i64
  %trailing = scalar.cttzi %value : i64
  %population = scalar.ctpopi %value : i64
  func.return %negated, %absolute, %leading, %trailing, %population : i64, i64, i64, i64, i64
}
