// RUN: roundtrip

func.def @rounding_f32(%value: f32) -> (f32, f32, f32, f32, f32) {
  %ceil = scalar.ceilf %value : f32
  %floor = scalar.floorf %value : f32
  %roundeven = scalar.roundevenf %value : f32
  %trunc = scalar.truncf %value : f32
  %round_away = scalar.roundf %value : f32
  func.return %ceil, %floor, %roundeven, %trunc, %round_away : f32, f32, f32, f32, f32
}

// ====

func.def @rounding_f64(%value: f64) -> (f64, f64, f64, f64, f64) {
  %ceil = scalar.ceilf %value : f64
  %floor = scalar.floorf %value : f64
  %roundeven = scalar.roundevenf %value : f64
  %trunc = scalar.truncf %value : f64
  %round_away = scalar.roundf %value : f64
  func.return %ceil, %floor, %roundeven, %trunc, %round_away : f64, f64, f64, f64, f64
}
