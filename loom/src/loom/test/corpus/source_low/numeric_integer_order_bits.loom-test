// RUN: roundtrip

func.def @integer_order_bits_i32(%lhs: i32, %rhs: i32, %count: i32) -> (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32) {
  %signed_min = scalar.minsi %lhs, %rhs : i32
  %unsigned_min = scalar.minui %lhs, %rhs : i32
  %signed_max = scalar.maxsi %lhs, %rhs : i32
  %unsigned_max = scalar.maxui %lhs, %rhs : i32
  %and = scalar.andi %lhs, %rhs : i32
  %or = scalar.ori %lhs, %rhs : i32
  %xor = scalar.xori %lhs, %rhs : i32
  %shift_left = scalar.shli %lhs, %count : i32
  %shift_signed = scalar.shrsi %lhs, %count : i32
  %shift_unsigned = scalar.shrui %lhs, %count : i32
  %rotate_left = scalar.rotli %lhs, %count : i32
  %rotate_right = scalar.rotri %lhs, %count : i32
  func.return %signed_min, %unsigned_min, %signed_max, %unsigned_max, %and, %or, %xor, %shift_left, %shift_signed, %shift_unsigned, %rotate_left, %rotate_right : i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32
}

// ====

func.def @integer_order_bits_i64(%lhs: i64, %rhs: i64, %count: i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
  %signed_min = scalar.minsi %lhs, %rhs : i64
  %unsigned_min = scalar.minui %lhs, %rhs : i64
  %signed_max = scalar.maxsi %lhs, %rhs : i64
  %unsigned_max = scalar.maxui %lhs, %rhs : i64
  %and = scalar.andi %lhs, %rhs : i64
  %or = scalar.ori %lhs, %rhs : i64
  %xor = scalar.xori %lhs, %rhs : i64
  %shift_left = scalar.shli %lhs, %count : i64
  %shift_signed = scalar.shrsi %lhs, %count : i64
  %shift_unsigned = scalar.shrui %lhs, %count : i64
  %rotate_left = scalar.rotli %lhs, %count : i64
  %rotate_right = scalar.rotri %lhs, %count : i64
  func.return %signed_min, %unsigned_min, %signed_max, %unsigned_max, %and, %or, %xor, %shift_left, %shift_signed, %shift_unsigned, %rotate_left, %rotate_right : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
}
