func.def @signed_byte_term(%input: i8, %table: buffer) -> (i32) {
  %coordinate = index.cast %input : i8 to index
  %bias = index.constant 128 : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<256xi32>
  %value = view.load %view[%position] : view<256xi32> -> i32
  func.return %value : i32
}

// ====

func.def @signed_halfword_term(%input: i16, %table: buffer) -> (i32) {
  %coordinate = index.cast %input : i16 to index
  %bias = index.constant 32768 : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<65536xi32>
  %value = view.load %view[%position] : view<65536xi32> -> i32
  func.return %value : i32
}

// ====

func.def @predicate_term(%input: i1, %table: buffer) -> (i32) {
  %coordinate = index.cast %input : i1 to index
  %bias = index.constant 1 : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<3xi32>
  %value = view.load %view[%position] : view<3xi32> -> i32
  func.return %value : i32
}

// ====

func.def @workgroup_signed_byte_term(%input: i8, %value: i32) -> (i32) {
  %coordinate = index.cast %input : i8 to index
  %bias = index.constant 128 : index
  %position = index.add %coordinate, %bias : index
  %length = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %scratch[%base] : buffer -> view<256xi32>
  view.store %value, %view[%position] : i32, view<256xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %view[%position] : view<256xi32> -> i32
  func.return %loaded : i32
}

// ====

func.def @workgroup_signed_halfword_term(%input: i16, %value: i32) -> (i32) {
  %bounded = scalar.assume %input [range(%input, -128, 127)] : i16
  %coordinate = index.cast %bounded : i16 to index
  %bias = index.constant 128 : index
  %position = index.add %coordinate, %bias : index
  %length = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %scratch[%base] : buffer -> view<256xi32>
  view.store %value, %view[%position] : i32, view<256xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %view[%position] : view<256xi32> -> i32
  func.return %loaded : i32
}

// ====

func.def @workgroup_predicate_term(%input: i1, %value: i32) -> (i32) {
  %coordinate = index.cast %input : i1 to index
  %bias = index.constant 1 : index
  %position = index.add %coordinate, %bias : index
  %length = index.constant 12 : offset
  %scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %scratch[%base] : buffer -> view<3xi32>
  view.store %value, %view[%position] : i32, view<3xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %view[%position] : view<3xi32> -> i32
  func.return %loaded : i32
}

// ====

func.def @negative_static_bias(%input: i32, %table: buffer) -> (i32) {
  %bounded = scalar.assume %input [range(%input, 128, 255)] : i32
  %coordinate = index.cast %bounded : i32 to index
  %bias = index.constant -128 : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<128xi32>
  %value = view.load %view[%position] : view<128xi32> -> i32
  func.return %value : i32
}

// ====

func.def @workgroup_negative_static_bias(%input: i32, %value: i32) -> (i32) {
  %bounded = scalar.assume %input [range(%input, 128, 255)] : i32
  %coordinate = index.cast %bounded : i32 to index
  %bias = index.constant -128 : index
  %position = index.add %coordinate, %bias : index
  %length = index.constant 512 : offset
  %scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %scratch[%base] : buffer -> view<128xi32>
  view.store %value, %view[%position] : i32, view<128xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %view[%position] : view<128xi32> -> i32
  func.return %loaded : i32
}

// ====

// The complete coordinate fits i32 although neither the i64 input nor its
// positive bias does. Workgroup arithmetic may project their low bits.
func.def @workgroup_wide_cancellation(%input: i64, %value: i32) -> (i32) {
  %bounded = scalar.assume %input [range(%input, -4294967296, -4294967169)] : i64
  %bias = scalar.constant 4294967296 : i64
  %ordinal = scalar.addi %bounded, %bias : i64
  %position = index.cast %ordinal : i64 to index
  %length = index.constant 512 : offset
  %scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %scratch[%base] : buffer -> view<128xi32>
  view.store %value, %view[%position] : i32, view<128xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %view[%position] : view<128xi32> -> i32
  func.return %loaded : i32
}

// ====

// Adding a static displacement to a full-width offset can lose the analyzed
// range without losing representability in the native address carrier.
func.def @offset_with_static_displacement(%base: offset, %table: buffer) -> (i32) {
  %view = buffer.view %table[%base] : buffer -> view<2xi32>
  %value = view.load %view[1] : view<2xi32> -> i32
  func.return %value : i32
}

// ====

func.def @varying_predicate_term(%input: buffer, %table: buffer) -> (i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %sign_boundary = scalar.constant 0 : i32
  %negative = scalar.cmpi slt, %raw, %sign_boundary : i32
  %coordinate = index.cast %negative : i1 to index
  %bias = index.constant 1 : index
  %position = index.add %coordinate, %bias : index
  %view = buffer.view %table[%base] : buffer -> view<3xi32>
  %value = view.load %view[%position] : view<3xi32> -> i32
  func.return %value : i32
}

// ====

func.def @uniform_comparison_term(%input: i32, %table: buffer) -> (i32) {
  %sign_boundary = scalar.constant 0 : i32
  %negative = scalar.cmpi slt, %input, %sign_boundary : i32
  %coordinate = index.cast %negative : i1 to index
  %bias = index.constant 1 : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<3xi32>
  %value = view.load %view[%position] : view<3xi32> -> i32
  func.return %value : i32
}

// ====

func.def @wide_varying_predicate_term(%input: buffer, %table: buffer) -> (i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %sign_boundary = scalar.constant 0 : i32
  %negative = scalar.cmpi slt, %raw, %sign_boundary : i32
  %coordinate = index.cast %negative : i1 to index
  %bias = index.constant 1 : index
  %position = index.add %coordinate, %bias : index
  %view = buffer.view %table[%base] : buffer -> view<3x1073741824xi32>
  %value = view.load %view[%position, 0] : view<3x1073741824xi32> -> i32
  func.return %value : i32
}
