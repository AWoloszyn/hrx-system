// RUN: roundtrip

func.def @extend_narrow(%arg0: f8E4M3, %arg1: f8E5M2, %arg2: f16, %arg3: bf16) -> (f32, f32, f32, f32) {
  %result0 = scalar.extf %arg0 : f8E4M3 to f32
  %result1 = scalar.extf %arg1 : f8E5M2 to f32
  %result2 = scalar.extf %arg2 : f16 to f32
  %result3 = scalar.extf %arg3 : bf16 to f32
  func.return %result0, %result1, %result2, %result3 : f32, f32, f32, f32
}

// ====

func.def @truncate_single(%input: f32) -> (f8E4M3, f8E5M2, f16, bf16) {
  %result0 = scalar.fptrunc %input : f32 to f8E4M3
  %result1 = scalar.fptrunc %input : f32 to f8E5M2
  %result2 = scalar.fptrunc %input : f32 to f16
  %result3 = scalar.fptrunc %input : f32 to bf16
  func.return %result0, %result1, %result2, %result3 : f8E4M3, f8E5M2, f16, bf16
}

// ====

func.def @truncate_double(%input: f64) -> (f8E4M3, f8E5M2, f16, bf16) {
  %result0 = scalar.fptrunc %input : f64 to f8E4M3
  %result1 = scalar.fptrunc %input : f64 to f8E5M2
  %result2 = scalar.fptrunc %input : f64 to f16
  %result3 = scalar.fptrunc %input : f64 to bf16
  func.return %result0, %result1, %result2, %result3 : f8E4M3, f8E5M2, f16, bf16
}

// ====

func.def @narrow_bits(%byte: i8, %word: i16, %condition: i1) -> (i8, i16) {
  %e4m3 = scalar.bitcast %byte : i8 to f8E4M3
  %e5m2 = scalar.bitcast %byte : i8 to f8E5M2
  %other_byte = scalar.bitcast %e5m2 : f8E5M2 to f8E4M3
  %selected_byte = scf.select %condition, %e4m3, %other_byte : f8E4M3
  %byte_result = scalar.bitcast %selected_byte : f8E4M3 to i8
  %half = scalar.bitcast %word : i16 to f16
  %brain = scalar.bitcast %word : i16 to bf16
  %other_word = scalar.bitcast %brain : bf16 to f16
  %selected_word = scf.select %condition, %half, %other_word : f16
  %word_result = scalar.bitcast %selected_word : f16 to i16
  func.return %byte_result, %word_result : i8, i16
}

// ====

func.def @integer_to_bf16(%word: i32, %wide: i64) -> (bf16, bf16, bf16, bf16) {
  %signed_word = scalar.sitofp %word : i32 to bf16
  %unsigned_word = scalar.uitofp %word : i32 to bf16
  %signed_wide = scalar.sitofp %wide : i64 to bf16
  %unsigned_wide = scalar.uitofp %wide : i64 to bf16
  func.return %signed_word, %unsigned_word, %signed_wide, %unsigned_wide : bf16, bf16, bf16, bf16
}

// ====

func.def @narrow_constants() -> (i8, i16, f16, bf16) {
  %byte = scalar.constant -127 : i8
  %word = scalar.constant -32767 : i16
  %half = scalar.constant -1.5 : f16
  %brain = scalar.constant 1.25 : bf16
  func.return %byte, %word, %half, %brain : i8, i16, f16, bf16
}

// ====

func.def @float8_constants() -> (f8E4M3, f8E5M2, f8E4M3, f8E5M2) {
  %finite_e4 = scalar.constant -1.5 : f8E4M3
  %finite_e5 = scalar.constant 1.25 : f8E5M2
  %zero_e4 = scalar.constant -0.0 : f8E4M3
  %zero_e5 = scalar.constant -0.0 : f8E5M2
  func.return %finite_e4, %finite_e5, %zero_e4, %zero_e5 : f8E4M3, f8E5M2, f8E4M3, f8E5M2
}

// ====

func.def @float_nan_constants() -> (f8E4M3, f8E5M2, f16, bf16, f32, f64) {
  %e4 = scalar.constant nan : f8E4M3
  %e5 = scalar.constant nan : f8E5M2
  %half = scalar.constant nan : f16
  %brain = scalar.constant nan : bf16
  %single = scalar.constant nan : f32
  %wide = scalar.constant nan : f64
  func.return %e4, %e5, %half, %brain, %single, %wide : f8E4M3, f8E5M2, f16, bf16, f32, f64
}

// ====

func.def @float_conversion_paths(%e4: f8E4M3, %e5: f8E5M2, %half: f16, %brain: bf16) -> (f16, bf16, f64, f64, f8E4M3, f8E5M2, i8, i16, i32, i64) {
  %r0 = scalar.extf %e4 : f8E4M3 to f16
  %r1 = scalar.extf %e5 : f8E5M2 to bf16
  %r2 = scalar.extf %half : f16 to f64
  %r3 = scalar.extf %brain : bf16 to f64
  %r4 = scalar.fptrunc %half : f16 to f8E4M3
  %r5 = scalar.fptrunc %brain : bf16 to f8E5M2
  %r6 = scalar.fptosi %e5 : f8E5M2 to i8
  %r7 = scalar.fptoui %half : f16 to i16
  %r8 = scalar.fptosi %brain : bf16 to i32
  %r9 = scalar.fptoui %e4 : f8E4M3 to i64
  func.return %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9 : f16, bf16, f64, f64, f8E4M3, f8E5M2, i8, i16, i32, i64
}

// ====

func.def @small_integer_float(%flag: i1, %byte: i8, %word: i16) -> (f8E4M3, f16, f32, f64, bf16, bf16, f8E5M2) {
  %r0 = scalar.sitofp %flag : i1 to f8E4M3
  %r1 = scalar.uitofp %flag : i1 to f16
  %r2 = scalar.sitofp %byte : i8 to f32
  %r3 = scalar.uitofp %byte : i8 to f64
  %r4 = scalar.sitofp %word : i16 to bf16
  %r5 = scalar.uitofp %word : i16 to bf16
  %r6 = scalar.sitofp %byte : i8 to f8E5M2
  func.return %r0, %r1, %r2, %r3, %r4, %r5, %r6 : f8E4M3, f16, f32, f64, bf16, bf16, f8E5M2
}

// ====

func.def @wide_integer_narrow_float(%wide: i64) -> (f16, f8E4M3, f8E5M2, f16, f8E4M3, f8E5M2) {
  %r0 = scalar.sitofp %wide : i64 to f16
  %r1 = scalar.sitofp %wide : i64 to f8E4M3
  %r2 = scalar.sitofp %wide : i64 to f8E5M2
  %r3 = scalar.uitofp %wide : i64 to f16
  %r4 = scalar.uitofp %wide : i64 to f8E4M3
  %r5 = scalar.uitofp %wide : i64 to f8E5M2
  func.return %r0, %r1, %r2, %r3, %r4, %r5 : f16, f8E4M3, f8E5M2, f16, f8E4M3, f8E5M2
}
