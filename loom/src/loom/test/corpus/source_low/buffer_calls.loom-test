// RUN: roundtrip

func.def @buffer_pair(%a: buffer, %tag: i64, %b: buffer) -> (buffer, i64, buffer) {
  func.return %b, %tag, %a : buffer, i64, buffer
}

// ====

func.def @buffer_cycle(%a: buffer, %tag: i32, %b: buffer, %c: buffer) -> (buffer, i32, buffer, buffer) {
  func.return %a, %tag, %c, %b : buffer, i32, buffer, buffer
}

// ====

func.def public @duplicate_buffer(%a: buffer) -> (buffer, buffer) {
  func.return %a, %a : buffer, buffer
}
