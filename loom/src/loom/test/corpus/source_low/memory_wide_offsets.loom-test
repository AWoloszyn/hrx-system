// ====

kernel.def @wide_offset_mixed_terms() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input_storage: buffer, %output_storage: buffer, %base_input: offset, %stride_input: offset) {
  %base = index.assume %base_input [mul(%base_input, 4)] : offset
  %stride = index.assume %stride_input [mul(%stride_input, 4)] : offset
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 4} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 4} : buffer
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %lane_offset = index.scale %lane, %stride : index, offset -> offset
  %byte_offset = index.add %base, %lane_offset : offset
  %input_view = buffer.view %input[%byte_offset] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}
