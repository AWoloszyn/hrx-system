// RUN: roundtrip

kernel.def @wide_offset_unsigned_index() {
  %unit = index.constant 1 : index
  %lane_count = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lane_count, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %base: i32) {
  %lane = kernel.workitem.id<x> : index
  %lane_bits = index.cast %lane : index to i32
  %wrapped = scalar.addi %base, %lane_bits : i32
  %unsigned = index.cast %wrapped : i32 to offset
  %element = index.cast %unsigned : offset to index
  %stride = index.constant 4 : offset
  %input_offset = index.scale %element, %stride : index, offset -> offset
  %input_view = buffer.view %input[%input_offset] : buffer -> view<1xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  %output_offset = index.scale %lane, %stride : index, offset -> offset
  %output_view = buffer.view %output[%output_offset] : buffer -> view<1xi32>
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  kernel.return
}

// ====

kernel.def @wide_offset_uniform() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %byte_offset: offset) {
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%byte_offset] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<1xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  kernel.return
}

// ====

kernel.def @wide_offset_loaded_lane() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %offsets: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %offset_view = buffer.view %offsets[%buffer_base] : buffer -> view<64xi64>
  %raw = view.load %offset_view[%lane] : view<64xi64> -> i64
  %byte_offset = index.cast %raw : i64 to offset
  %input_view = buffer.view %input[%byte_offset] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}
// ====

kernel.def @wide_offset_varying_record_stride() {
  %unit = index.constant 1 : index
  %lanes = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<2x1073741825xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<2xi32>
  %loaded = view.load %input_view[%lane, 0] : view<2x1073741825xi32> -> i32
  view.store %loaded, %output_view[%lane] : i32, view<2xi32>
  kernel.return
}

// ====

kernel.def @wide_offset_varying_dynamic_dimensions() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %columns_input: index) {
  %columns = index.assume %columns_input [range(%columns_input, 1, 2147483647)] : index
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x[%columns]xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = view.load %input_view[%lane, 0] : view<64x[%columns]xi32> -> i32
  view.store %loaded, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

// ====

kernel.def @wide_offset_multiple_dynamic_factors() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %rows_input: index, %columns_input: index) {
  %rows = index.assume %rows_input [range(%rows_input, 1, 1048576)] : index
  %columns = index.assume %columns_input [range(%columns_input, 1, 1048576)] : index
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x[%rows]x[%columns]xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = view.load %input_view[%lane, 0, 0] : view<64x[%rows]x[%columns]xi32> -> i32
  view.store %loaded, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

// ====

kernel.def @wide_offset_varying_stride_factor() {
  %unit = index.constant 1 : index
  %groups = index.constant 2 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %columns_input: index) {
  %columns_base = index.assume %columns_input [range(%columns_input, 1, 2147483584)] : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %columns = index.add %columns_base, %lane : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<2x[%columns]xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<2x64xi32>
  %loaded = view.load %input_view[%group, 0] : view<2x[%columns]xi32> -> i32
  view.store %loaded, %output_view[%group, %lane] : i32, view<2x64xi32>
  kernel.return
}

// ====

kernel.def @wide_offset_large_power_two_stride() {
  %unit = index.constant 1 : index
  %lanes = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %stride = index.constant 4294967296 : offset
  %byte_offset = index.scale %lane, %stride : index, offset -> offset
  %input_view = buffer.view %input[%byte_offset] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<2xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[%lane] : i32, view<2xi32>
  kernel.return
}

// ====

kernel.def @wide_offset_large_record_stride() {
  %unit = index.constant 1 : index
  %rows = index.constant 2 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %row = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<2x1073741825xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<2x64xi32>
  %loaded = view.load %input_view[%row, %lane] : view<2x1073741825xi32> -> i32
  view.store %loaded, %output_view[%row, %lane] : i32, view<2x64xi32>
  kernel.return
}

