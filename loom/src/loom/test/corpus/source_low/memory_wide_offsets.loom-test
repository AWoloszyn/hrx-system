kernel.def @wide_offset_dynamic_dimensions() {
  %unit = index.constant 1 : index
  %rows = index.constant 2 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input_storage: buffer, %output_storage: buffer, %columns_input: index) {
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 4} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 4} : buffer
  %columns = index.assume %columns_input [range(%columns_input, 64, 2147483647)] : index
  %row = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<2x[%columns]xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<2x64xi32>
  %loaded = view.load %input_view[%row, %lane] : view<2x[%columns]xi32> -> i32
  view.store %loaded, %output_view[%row, %lane] : i32, view<2x64xi32>
