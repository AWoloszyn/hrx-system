// An acquire fence completes a no-return update before consuming another root.
kernel.def @acquire_device_fence_after_reduce() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signal: buffer, %payload: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %word = buffer.view %signal[%base] : buffer -> view<1xi32>
  %data = buffer.view %payload[%base] : buffer -> view<1xi64>
  %result = buffer.view %output[%base] : buffer -> view<1xi64>
  %increment = scalar.constant 1 : i32
  view.atomic.reduce<addi> %increment, %word[0] {ordering = relaxed, scope = device} : i32, view<1xi32>
  buffer.fence scope(device) ordering(acquire)
  %value = view.load %data[0] : view<1xi64> -> i64
  view.store %value, %result[0] : i64, view<1xi64>
  kernel.return
}

