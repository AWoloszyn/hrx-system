func.def @observe_scalar(%input: buffer) -> (i32, i32) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<1xi32>
  %first = view.load<volatile> %source[0] : view<1xi32> -> i32
  %second = view.load<volatile> %source[0] : view<1xi32> -> i32
  func.return %first, %second : i32, i32
}

// ====

func.def @observe_unused(%input: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return
}

// ====

func.def @repeat_store(%output: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %destination = buffer.view %aligned[%base] : buffer -> view<1xi32>
  view.store<volatile> %value, %destination[0] : i32, view<1xi32>
  view.store<volatile> %value, %destination[0] : i32, view<1xi32>
  func.return
}

// ====

func.def @observe_vector(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %source = buffer.view %source_aligned[%base] : buffer -> view<16xi32>
  %destination = buffer.view %destination_aligned[%base] : buffer -> view<32xi32>
  %first = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  %second = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  vector.store<volatile> %first, %destination[0] : vector<16xi32>, view<32xi32>
  vector.store<volatile> %second, %destination[16] : vector<16xi32>, view<32xi32>
  func.return
}

// ====

func.def @observe_byte(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi8>
  %destination = buffer.view %output[%base] : buffer -> view<2xi8>
  %first = view.load<volatile> %source[0] : view<1xi8> -> i8
  %second = view.load<volatile> %source[0] : view<1xi8> -> i8
  view.store<volatile> %first, %destination[0] : i8, view<2xi8>
  view.store<volatile> %second, %destination[1] : i8, view<2xi8>
  func.return
}

// ====

func.def @observe_dynamic_address(%input: buffer, %byte_offset: offset) -> (i32, i32) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 4092), mul(%byte_offset, 4)] : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return %first, %second : i32, i32
}

// ====

func.def @ordinary_scalar(%input: buffer) -> (i32, i32) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<1xi32>
  %first = view.load %source[0] : view<1xi32> -> i32
  %second = view.load %source[0] : view<1xi32> -> i32
  func.return %first, %second : i32, i32
}
