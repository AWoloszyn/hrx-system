// Callee entry buffers remain independent of scratch created by that callee,
// even when the caller supplies another local allocation.
func.def noinline @read_entry_with_scratch(%input: buffer, %replacement: i32) -> (i32) {
  %base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<private> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<1xi32>
  %input_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %initial = scalar.constant 0 : i32
  %result = scf.for %iteration = [%begin to %end step %step](%previous = %initial : i32) -> (i32) {
    %value = view.load %input_view[0] : view<1xi32> -> i32
    view.store %replacement, %scratch_view[0] : i32, view<1xi32>
    scf.yield %value : i32
  }
  func.return %result : i32
}

// Derived aliases of a local allocation observe writes to that allocation.
// Two iterations distinguish the updated value from an incorrectly hoisted load.
func.def noinline @read_scratch_alias(%replacement: i32) -> (i32) {
  %base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<private> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<1xi32>
  %initial = scalar.constant 17 : i32
  view.store %initial, %scratch_view[0] : i32, view<1xi32>
  %part = view.subview %scratch_view[0] : view<1xi32> -> view<1xi32>
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %iteration = [%begin to %end step %step](%previous = %initial : i32) -> (i32) {
    %value = view.load %part[0] : view<1xi32> -> i32
    view.store %replacement, %scratch_view[0] : i32, view<1xi32>
    scf.yield %value : i32
  }
  func.return %result : i32
}

func.def public @allocation_aliases(%initial: i32, %replacement: i32) -> (i32, i32, i32) {
  %base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %input = buffer.alloca<private> align(4) %bytes : buffer
  %view = buffer.view %input[%base] : buffer -> view<1xi32>
  view.store %initial, %view[0] : i32, view<1xi32>
  %entry = func.call @read_entry_with_scratch(%input, %replacement) : (buffer, i32) -> (i32)
  %aliased = func.call @read_scratch_alias(%replacement) : (i32) -> (i32)
  %after = view.load %view[0] : view<1xi32> -> i32
  func.return %entry, %aliased, %after : i32, i32, i32
}

check.case @entry_and_derived_allocation_aliases {
  %initial = check.param.choice values([-31, 0, 2147483647]) : i32
  %replacement = check.param.choice values([-9, 99]) : i32
  %entry, %aliased, %after = func.call @allocation_aliases(%initial, %replacement) : (i32, i32) -> (i32, i32, i32)
  check.expect.equal actual(%entry) expected(%initial) : i32
  check.expect.equal actual(%aliased) expected(%replacement) : i32
  check.expect.equal actual(%after) expected(%initial) : i32
  check.return
}
