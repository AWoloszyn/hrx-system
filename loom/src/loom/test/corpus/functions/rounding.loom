func.def public @rounding_f64(%bits: i64) -> (i64, i64, i64, i64) {
  %value = scalar.bitcast %bits : i64 to f64
  %ceil = scalar.ceilf %value : f64
  %ceil_bits = scalar.bitcast %ceil : f64 to i64
  %floor = scalar.floorf %value : f64
  %floor_bits = scalar.bitcast %floor : f64 to i64
  %roundeven = scalar.roundevenf %value : f64
  %roundeven_bits = scalar.bitcast %roundeven : f64 to i64
  %trunc = scalar.truncf %value : f64
  %trunc_bits = scalar.bitcast %trunc : f64 to i64
  func.return %ceil_bits, %floor_bits, %roundeven_bits, %trunc_bits : i64, i64, i64, i64
}

