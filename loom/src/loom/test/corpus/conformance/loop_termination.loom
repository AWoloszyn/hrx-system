// The five outputs evaluate the same bounded table reduction with serial,
// recurrence, pipelined recurrence, linear, and interleaved schedules. Bounds
// near INT32_MAX exercise a narrow carrier without requiring large storage.
// Expected sums use the mathematical half-open range and preserve the seed
// when either the outer domain or nested repetition loop is empty.
template.decl @loop_boundary.recurrence_sum(%values: view<32xi32>, %begin: index, %end: index, %repeat: index, %depth: index, %factor: index) -> (i32)

template.def<@loop_boundary.recurrence_sum> @loop_boundary_recurrence_sum_impl(%values: view<32xi32>, %begin: index, %end: index, %repeat: index, %depth: index, %factor: index) -> (i32) {
  %step = index.constant 2 : index
  %initial = scalar.constant 37 : i32
  %table_size = index.constant 32 : index
  %repeat_begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %result = scf.for %counter = [%begin to %end step %step](%sum = %initial : i32) -> (i32) pipeline(%depth) unroll(%factor) schedule(recurrence) {
    %position = index.rem %counter, %table_size : index
    %value = view.load %values[%position] : view<32xi32> -> i32
    %updated = scf.for %round = [%repeat_begin to %repeat step %unit](%partial = %sum : i32) -> (i32) {
      %next = scalar.addi %partial, %value : i32
      scf.yield %next : i32
    }
    scf.yield %updated : i32
  }
  template.return %result : i32
}

template.decl @loop_boundary.linear_sum(%values: view<32xi32>, %begin: index, %end: index, %repeat: index, %depth: index, %factor: index) -> (i32)

template.def<@loop_boundary.linear_sum> @loop_boundary_linear_sum_impl(%values: view<32xi32>, %begin: index, %end: index, %repeat: index, %depth: index, %factor: index) -> (i32) {
  %step = index.constant 2 : index
  %initial = scalar.constant 37 : i32
  %table_size = index.constant 32 : index
  %repeat_begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %result = scf.for %counter = [%begin to %end step %step](%sum = %initial : i32) -> (i32) pipeline(%depth) unroll(%factor) schedule(linear) {
    %position = index.rem %counter, %table_size : index
    %value = view.load %values[%position] : view<32xi32> -> i32
    %updated = scf.for %round = [%repeat_begin to %repeat step %unit](%partial = %sum : i32) -> (i32) {
      %next = scalar.addi %partial, %value : i32
      scf.yield %next : i32
    }
    scf.yield %updated : i32
  }
  template.return %result : i32
}

template.decl @loop_boundary.interleaved_sum(%values: view<32xi32>, %begin: index, %end: index, %repeat: index, %depth: index, %factor: index) -> (i32)

template.def<@loop_boundary.interleaved_sum> @loop_boundary_interleaved_sum_impl(%values: view<32xi32>, %begin: index, %end: index, %repeat: index, %depth: index, %factor: index) -> (i32) {
  %step = index.constant 2 : index
  %initial = scalar.constant 37 : i32
  %table_size = index.constant 32 : index
  %repeat_begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %result = scf.for %counter = [%begin to %end step %step](%sum = %initial : i32) -> (i32) pipeline(%depth) unroll(%factor) schedule(interleaved) {
    %position = index.rem %counter, %table_size : index
    %value = view.load %values[%position] : view<32xi32> -> i32
    %updated = scf.for %round = [%repeat_begin to %repeat step %unit](%partial = %sum : i32) -> (i32) {
      %next = scalar.addi %partial, %value : i32
      scf.yield %next : i32
    }
    scf.yield %updated : i32
  }
  template.return %result : i32
}

kernel.def @loop_boundary_table_sum() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%begin_input: index, %end_input: index, %repeat_input: index, %input: buffer, %output: buffer) {
  %begin = index.assume %begin_input [range(%begin_input, 2147483626, 2147483647)] : index
  %end = index.assume %end_input [range(%end_input, 2147483626, 2147483647)] : index
  %repeat = index.assume %repeat_input [range(%repeat_input, 0, 3)] : index
  %base = index.constant 0 : offset
  %plain_position = index.constant 0 : index
  %unrolled_position = index.constant 1 : index
  %pipeline_position = index.constant 2 : index
  %linear_position = index.constant 3 : index
  %interleaved_position = index.constant 4 : index
  %interleaved_factor = index.constant 3 : index
  %plain_depth = index.constant 1 : index
  %plain_factor = index.constant 1 : index
  %unrolled_factor = index.constant 4 : index
  %pipeline_depth = index.constant 3 : index
  %pipeline_factor = index.constant 2 : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %source, %destination = buffer.assume.noalias %input_aligned, %output_aligned : buffer, buffer
  %values = buffer.view %source[%base] : buffer -> view<32xi32>
  %results = buffer.view %destination[%base] : buffer -> view<5xi32>
  %plain = template.apply<@loop_boundary.recurrence_sum>(%values, %begin, %end, %repeat, %plain_depth, %plain_factor) : (view<32xi32>, index, index, index, index, index) -> (i32)
  %unrolled = template.apply<@loop_boundary.recurrence_sum>(%values, %begin, %end, %repeat, %plain_depth, %unrolled_factor) : (view<32xi32>, index, index, index, index, index) -> (i32)
  %linear = template.apply<@loop_boundary.linear_sum>(%values, %begin, %end, %repeat, %plain_depth, %unrolled_factor) : (view<32xi32>, index, index, index, index, index) -> (i32)
  %interleaved = template.apply<@loop_boundary.interleaved_sum>(%values, %begin, %end, %repeat, %plain_depth, %interleaved_factor) : (view<32xi32>, index, index, index, index, index) -> (i32)
  %pipelined = template.apply<@loop_boundary.recurrence_sum>(%values, %begin, %end, %repeat, %pipeline_depth, %pipeline_factor) : (view<32xi32>, index, index, index, index, index) -> (i32)
  view.store %plain, %results[%plain_position] : i32, view<5xi32>
  view.store %unrolled, %results[%unrolled_position] : i32, view<5xi32>
  view.store %pipelined, %results[%pipeline_position] : i32, view<5xi32>
  view.store %linear, %results[%linear_position] : i32, view<5xi32>
  view.store %interleaved, %results[%interleaved_position] : i32, view<5xi32>
  kernel.return
}

check.case public @loop_boundary_partial_tile {
  %begin = check.literal value(2147483642) : index
  %end = check.literal value(2147483647) : index
  %repeat = check.literal value(1) : index
  %input = check.generate.iota offset(1) step(1) : tensor<32xi32>
  %output = check.generate.fill value(-1) : tensor<5xi32>
  %expected = check.generate.fill value(124) : tensor<5xi32>
  kernel.launch @loop_boundary_table_sum(%begin, %end, %repeat, %input, %output) : (index, index, index, tensor<32xi32>, tensor<5xi32>)
  check.expect.equal actual(%output) expected(%expected) : tensor<5xi32>
  check.return
}

check.case public @loop_boundary_single_iteration {
  %begin = check.literal value(2147483646) : index
  %end = check.literal value(2147483647) : index
  %repeat = check.literal value(3) : index
