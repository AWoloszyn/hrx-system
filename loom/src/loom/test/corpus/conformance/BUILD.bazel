load("//loom/build_tools/bazel:build_defs.bzl", "loom_generated_file_family")
load("//loom/build_tools/bazel:defs.bzl", "loom_module", "loom_test", "loom_test_module")
load("//loom/target:execution_profiles.bzl", "GPU_HARDWARE_PROFILES")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_PROFILE", "AMDGPU_HARDWARE_PROFILE")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_CASES = glob(["*.loom"])

exports_files(_CASES)

loom_test(
    name = "vector_atomic_test",
    srcs = ["vector_atomic.loom"],
    compile_targets = [
        "//loom/target/amdgpu:gfx942",
        "//loom/target/amdgpu:gfx950",
        "//loom/target/amdgpu:gfx1151",
        "//loom/target/amdgpu:gfx1170",
        "//loom/target/amdgpu:gfx1200",
        "//loom/target/amdgpu:gfx1250",
    ],
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

