// Independent address work fills VALU issue gaps before EXEC narrows.
// The store itself stays in the guarded block.
// RUN: with-checks emit low-packet-json @masked_store strategy=resource-stall
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @masked_store(%base: reg<amdgpu.sgpr x2>, %origin: reg<amdgpu.vgpr>, %pixel: reg<amdgpu.vgpr>, %color: reg<amdgpu.vgpr>, %limit: reg<amdgpu.vgpr>) asm {
  %color0 = v_mul_lo_u32 %color, %color
  %color1 = v_mul_lo_u32 %color0, %color0
  %color2 = v_mul_lo_u32 %color1, %color1
  %color3 = v_mul_lo_u32 %color2, %color2
  %within = v_cmp_lt_u32 %pixel, %limit
  %saved, %active = s_and_saveexec_b64 %within
  low.cond_br %active, ^store, ^done : reg<amdgpu.scc>
^store:
  %word = v_add_u32 %origin, %pixel
  %byte = v_lshlrev_b32_src0_inline %word, 2
  global_store_b32_saddr %byte, %color3, %base
  low.br ^done
^done:
  s_mov_b64_exec %saved
  return
}

// ----
CHECK: *"block":0,"source_ordinal":?,"scheduled_ordinal":?,"kind":"descriptor","op":"low.op","descriptor":"amdgpu.v_add_u32"*
CHECK: *"block":0,"source_ordinal":?,"scheduled_ordinal":?,"kind":"descriptor","op":"low.op","descriptor":"amdgpu.v_lshlrev_b32.src0_inline"*
CHECK: *"block":1,"source_ordinal":?,"scheduled_ordinal":?,"kind":"descriptor","op":"low.op","descriptor":"amdgpu.global_store_b32_saddr"*

// ====

