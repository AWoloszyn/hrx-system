amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @short_guard(%base: reg<amdgpu.sgpr x2>, %origin: reg<amdgpu.vgpr>, %pixel: reg<amdgpu.vgpr>, %color: reg<amdgpu.vgpr>, %limit: reg<amdgpu.vgpr>) asm {
  %within = v_cmp_lt_u32 %pixel, %limit
  %saved, %active = s_and_saveexec_b64 %within
  low.cond_br %active, ^store, ^done : reg<amdgpu.scc>
^store:
  %word = v_add_u32 %origin, %pixel
  %byte = v_lshlrev_b32_src0_inline %word, 2
  global_store_b32_saddr %byte, %color, %base
  low.br ^done
^done:
  s_mov_b64_exec %saved
  return
}

// ----
CHECK: *"block":1,"source_ordinal":?,"scheduled_ordinal":?,"kind":"descriptor","op":"low.op","descriptor":"amdgpu.v_add_u32"*
CHECK: *"block":1,"source_ordinal":?,"scheduled_ordinal":?,"kind":"descriptor","op":"low.op","descriptor":"amdgpu.v_lshlrev_b32.src0_inline"*
CHECK: *"block":1,"source_ordinal":?,"scheduled_ordinal":?,"kind":"descriptor","op":"low.op","descriptor":"amdgpu.global_store_b32_saddr"*

// ====

// An authored locked schedule keeps its original placement.
// RUN: with-checks emit low-packet-json @locked_guard strategy=resource-stall
amdgpu.target<gfx1151> @target

low.func.def schedule(locked) target<amdgpu.rdna3_5.core>(@target) @locked_guard(%base: reg<amdgpu.sgpr x2>, %origin: reg<amdgpu.vgpr>, %pixel: reg<amdgpu.vgpr>, %color: reg<amdgpu.vgpr>, %limit: reg<amdgpu.vgpr>) asm {
  %color0 = v_mul_lo_u32 %color, %color
  %color1 = v_mul_lo_u32 %color0, %color0
  %color2 = v_mul_lo_u32 %color1, %color1
  %color3 = v_mul_lo_u32 %color2, %color2
  %within = v_cmp_lt_u32 %pixel, %limit
  %saved, %active = s_and_saveexec_b64 %within
  low.cond_br %active, ^store, ^done : reg<amdgpu.scc>
^store:
  %word = v_add_u32 %origin, %pixel
  %byte = v_lshlrev_b32_src0_inline %word, 2
  global_store_b32_saddr %byte, %color3, %base
  low.br ^done
^done:
  s_mov_b64_exec %saved
  return
}

