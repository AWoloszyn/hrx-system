// RUN: emit low-schedule-json @independent_scopes strategy=resource-stall

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @independent_scopes(%pointer: reg<test.ptr>) -> (reg<test.i32 x4>, reg<test.i32 x4>) asm {
  low.schedule.begin
  %first = test.load.v4i32 %pointer
  low.schedule.step
  %first_sum = test.add.v4i32 %first, %first
  low.schedule.end
  low.schedule.begin
  %second = test.load.v4i32 %pointer
  low.schedule.step
  %second_sum = test.add.v4i32 %second, %second
  low.schedule.end
  return %first_sum, %second_sum
}

