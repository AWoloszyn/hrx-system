// RUN: emit low-schedule-json @scope_across_cfg strategy=resource-stall

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @scope_across_cfg(%condition: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  low.schedule.begin
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  low.schedule.step
  %sum = test.add.i32 %lhs, %rhs
  low.br ^join(%sum: reg<test.i32>)
^right:
  %product = test.mul.i32 %lhs, %rhs
  low.schedule.step
  low.br ^join(%product: reg<test.i32>)
^join(%result: reg<test.i32>):
  low.schedule.end
  return %result
}

