// ====
// RUN: emit low-schedule-json @nested_scopes strategy=resource-stall

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @nested_scopes(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  low.schedule.begin
  low.schedule.step
  low.schedule.begin
  %sum = test.add.i32 %lhs, %rhs
  low.schedule.step
  low.schedule.end
  low.schedule.step
  %product = test.mul.i32 %lhs, %rhs
  low.schedule.end
  return %sum, %product
}

