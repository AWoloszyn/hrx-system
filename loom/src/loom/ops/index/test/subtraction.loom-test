// RUN: pass canonicalize

func.def @preserves_positive_overflow_lhs_strict(%left: index, %right: index) -> (i64, i64) {
  %ordered = index.assume %left [gt(%left, %right)] : index
  %difference = index.sub %ordered, %right : index
  %lower = test.fact_range_lo %difference : index -> i64
  %upper = test.fact_range_hi %difference : index -> i64
  func.return %lower, %upper : i64, i64
}
// ----
func.def @preserves_positive_overflow_lhs_strict(%left: index, %right: index) -> (i64, i64) {
  %lower = scalar.constant -9223372036854775808 : i64
  %upper = scalar.constant 9223372036854775807 : i64
  func.return %lower, %upper : i64, i64
}

// ====

func.def @preserves_positive_overflow_rhs_strict(%left: index, %right: index) -> (i64, i64) {
  %ordered = index.assume %right [lt(%right, %left)] : index
  %difference = index.sub %left, %ordered : index
  %lower = test.fact_range_lo %difference : index -> i64
  %upper = test.fact_range_hi %difference : index -> i64
  func.return %lower, %upper : i64, i64
}
