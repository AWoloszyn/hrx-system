// RUN: format bytecode

test.target<low_core> @test_target

// A module namespace and an aliased symbol survive serialization independently.
low.func.decl import(native, "observe", module = "check") target<test.low.core>(@test_target) @observe_value(%value: reg<test.i32>)

// Flat object symbol imports do not require a runtime module namespace.
low.func.decl import(object, "object_function") target<test.low.core>(@test_target) @object_function(%value: reg<test.i32>)

// ----
test.target<low_core> @test_target

low.func.decl import(native, "observe", module = "check") target<test.low.core>(@test_target) @observe_value(%value: reg<test.i32>)

low.func.decl import(object, "object_function") target<test.low.core>(@test_target) @object_function(%value: reg<test.i32>)

// ====
// RUN: verify

test.target<low_core> @test_target

// ERROR@+1: STRUCTURE/027 {attr_name="import_module", actual_value="", expected_constraint="non-empty imported module name"}
low.func.decl import(native, "observe", module = "") target<test.low.core>(@test_target) @empty_namespace(%value: reg<test.i32>)
