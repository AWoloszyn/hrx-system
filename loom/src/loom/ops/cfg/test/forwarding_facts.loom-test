// RUN: pass canonicalize

// Layout is opposite execution order; an acyclic chain never needs widening.
func.def @reverse_acyclic_layout() {
  %seed = index.constant 8 : offset
  cfg.br ^stage0(%seed: offset)
^stage23(%value23: offset):
  %result_range_lo = test.fact_range_lo %value23 : offset -> i64
  test.use %result_range_lo : i64
  %result_range_hi = test.fact_range_hi %value23 : offset -> i64
  test.use %result_range_hi : i64
