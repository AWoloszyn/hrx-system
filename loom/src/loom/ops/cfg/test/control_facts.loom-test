^header(%counter: index):
  %more = index.cmp ult, %counter, %lane : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = index.add %counter, %c1 : index
  cfg.br ^header(%next: index)
^exit:
  %uniform = scalar.constant false : i1
  %varying = scalar.constant true : i1
  test.use %uniform, %varying : i1, i1
  kernel.return
}

// ====

// RUN: pass canonicalize

// Divergent loop exits select different rotation positions while preserving
// the finite range and alignment of the complete forwarding component.
target.generic<reference> @device {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@device) @temporal_rotation() {
  %unit = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%variant: index) {
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %step = index.constant 1 : index
  %low = index.constant 0 : offset
  %high = index.constant 128 : offset
  cfg.br ^header(%c0: index, %low: offset, %high: offset)
^header(%counter: index, %first: offset, %second: offset):
  %more = index.cmp ult, %counter, %lane : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = index.add %counter, %step : index
  cfg.br ^latch(%second: offset, %first: offset)
^latch(%carry_first: offset, %carry_second: offset):
  cfg.br ^header(%next: index, %carry_first: offset, %carry_second: offset)
^exit:
  %lower = test.fact_range_lo %first : offset -> i64
  %upper = test.fact_range_hi %first : offset -> i64
  %alignment = test.fact_divisor %first : offset -> i64
  %uniform = test.fact_subgroup_uniform %first : offset -> i1
  %varying = test.fact_lane_varying %first : offset -> i1
  test.use %lower, %upper, %alignment, %uniform, %varying : i64, i64, i64, i1, i1
  kernel.return
}

