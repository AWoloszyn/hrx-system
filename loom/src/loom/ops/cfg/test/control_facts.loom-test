// ====

// RUN: pass canonicalize

// On exit, the induction value equals the lane ID. Uniform per-iteration
// induction does not establish uniformity for this observation.
kernel.def @cfg_temporal_counter() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  cfg.br ^header(%c0: index)
^header(%counter: index):
  %more = index.cmp ult, %counter, %lane : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = index.add %counter, %c1 : index
  cfg.br ^header(%next: index)
^exit:
  %uniform = test.fact_subgroup_uniform %counter : index -> i1
  %varying = test.fact_lane_varying %counter : index -> i1
  test.use %uniform, %varying : i1, i1
  kernel.return
}

