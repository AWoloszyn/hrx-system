  %c0 = index.constant 0 : index
  %step = index.constant 1 : index
  %low = index.constant 0 : offset
  %high = index.constant 128 : offset
  cfg.br ^header(%c0: index, %low: offset, %high: offset)
^header(%counter: index, %first: offset, %second: offset):
  %more = index.cmp ult, %counter, %lane : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = index.add %counter, %step : index
  cfg.br ^latch(%second: offset, %first: offset)
^latch(%carry_first: offset, %carry_second: offset):
  cfg.br ^header(%next: index, %carry_first: offset, %carry_second: offset)
^exit:
  %lower = scalar.constant 0 : i64
  %upper = scalar.constant 128 : i64
  %alignment = scalar.constant 128 : i64
  %uniform = scalar.constant false : i1
  %varying = scalar.constant true : i1
  test.use %lower, %upper, %alignment, %uniform, %varying : i64, i64, i64, i1, i1
