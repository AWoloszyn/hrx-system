  %rhs = scalar.constant 20 : i32
  %equal = scalar.constant 10 : i32
  cfg.cond_br %condition, ^left, ^right
^left:
  test.use %lhs : i32
  cfg.br ^left_more
^left_more:
  cfg.br ^join(%lhs: i32, %lhs: i32, %lhs: i32)
^right:
  cfg.br ^join(%rhs: i32, %lhs: i32, %equal: i32)
