  %exact_subgroup_uniform = test.fact_subgroup_uniform %exact : i32 -> i1
  %exact_workgroup_uniform = test.fact_workgroup_uniform %exact : i32 -> i1
  %exact_cluster_uniform = test.fact_cluster_uniform %exact : i32 -> i1
  %exact_lane_varying = test.fact_lane_varying %exact : i32 -> i1
  test.use %selected_subgroup_uniform, %selected_workgroup_uniform, %selected_cluster_uniform, %selected_lane_varying, %unchanged_subgroup_uniform, %unchanged_workgroup_uniform, %unchanged_cluster_uniform, %unchanged_lane_varying, %exact_subgroup_uniform, %exact_workgroup_uniform, %exact_cluster_uniform, %exact_lane_varying : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1
