  %c0 = index.constant 0 : index
  %low = index.constant 0 : offset
  %high = index.constant 128 : offset
  %choose_first = index.cmp eq, %lane, %c0 : index
  %keep_going = index.cmp ne, %variant, %c0 : index
  cfg.cond_br %choose_first, ^seed_first, ^seed_second
^seed_first:
  cfg.br ^first(%low: offset)
^seed_second:
  cfg.br ^second(%high: offset)
^first(%first_value: offset):
  cfg.cond_br %keep_going, ^first_latch, ^first_exit
^first_latch:
  cfg.br ^second(%first_value: offset)
^first_exit:
  cfg.br ^joined(%first_value: offset)
^second(%second_value: offset):
  cfg.cond_br %keep_going, ^second_latch, ^second_exit
^second_latch:
  cfg.br ^first(%second_value: offset)
^second_exit:
  cfg.br ^joined(%second_value: offset)
^joined(%observed: offset):
  %lower = test.fact_range_lo %observed : offset -> i64
  %upper = test.fact_range_hi %observed : offset -> i64
  %alignment = test.fact_divisor %observed : offset -> i64
  %uniform = test.fact_subgroup_uniform %observed : offset -> i1
  %varying = test.fact_lane_varying %observed : offset -> i1
  test.use %lower, %upper, %alignment, %uniform, %varying : i64, i64, i64, i1, i1
  kernel.return
}

