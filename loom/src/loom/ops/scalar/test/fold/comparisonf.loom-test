// RUN: pass canonicalize

func.def @same_value_0(%lhs: f32) -> (i1, i1, i1, i1, i1, i1, i1) {
  %oeq = scalar.cmpf oeq, %lhs, %lhs : f32
  %ogt = scalar.cmpf ogt, %lhs, %lhs : f32
  %oge = scalar.cmpf oge, %lhs, %lhs : f32
  %olt = scalar.cmpf olt, %lhs, %lhs : f32
  %ole = scalar.cmpf ole, %lhs, %lhs : f32
  %one = scalar.cmpf one, %lhs, %lhs : f32
  %ord = scalar.cmpf ord, %lhs, %lhs : f32
  func.return %oeq, %ogt, %oge, %olt, %ole, %one, %ord : i1, i1, i1, i1, i1, i1, i1
}

// ----
func.def @same_value_0(%lhs: f32) -> (i1, i1, i1, i1, i1, i1, i1) {
  %oeq = scalar.cmpf oeq, %lhs, %lhs : f32
  %ogt = scalar.constant false : i1
  %oge = scalar.cmpf oge, %lhs, %lhs : f32
  %olt = scalar.constant false : i1
  %ole = scalar.cmpf ole, %lhs, %lhs : f32
  %one = scalar.constant false : i1
  %ord = scalar.cmpf ord, %lhs, %lhs : f32
  func.return %oeq, %ogt, %oge, %olt, %ole, %one, %ord : i1, i1, i1, i1, i1, i1, i1
}

