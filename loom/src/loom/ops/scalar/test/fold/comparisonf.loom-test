// ====

// Other flags do not exclude NaNs or strengthen a neighboring comparison.
func.def @independent_permissions(%lhs: f32, %rhs: f32) -> (i1, i1, i1, i1) {
  %plain = scalar.cmpf ord, %lhs, %rhs : f32
  %nnan = scalar.cmpf<nnan> ord, %lhs, %rhs : f32
  %other = scalar.cmpf<reassoc|ninf|nsz|arcp|contract|afn> ord, %lhs, %rhs : f32
  %same_other = scalar.cmpf<reassoc|ninf|nsz|arcp|contract|afn> oeq, %lhs, %lhs : f32
  func.return %plain, %nnan, %other, %same_other : i1, i1, i1, i1
}

// ----
func.def @independent_permissions(%lhs: f32, %rhs: f32) -> (i1, i1, i1, i1) {
  %plain = scalar.cmpf ord, %lhs, %rhs : f32
  %nnan = scalar.constant true : i1
  %other = scalar.cmpf<reassoc|ninf|nsz|arcp|contract|afn> ord, %lhs, %rhs : f32
  %same_other = scalar.cmpf<reassoc|ninf|nsz|arcp|contract|afn> oeq, %lhs, %lhs : f32
  func.return %plain, %nnan, %other, %same_other : i1, i1, i1, i1
}

// ====

// Exact boolean facts reach widening before target selection.
func.def @classification_consumers(%lhs: bf16, %rhs: bf16) -> (i32, i64, i64) {
  %ordered = scalar.cmpf<nnan> ord, %lhs, %rhs : bf16
  %unordered = scalar.cmpf<nnan> uno, %lhs, %rhs : bf16
  %wide = scalar.extui %ordered : i1 to i32
  %lo = test.fact_range_lo %unordered : i1 -> i64
  %hi = test.fact_range_hi %unordered : i1 -> i64
  func.return %wide, %lo, %hi : i32, i64, i64
}

// ----
func.def @classification_consumers(%lhs: bf16, %rhs: bf16) -> (i32, i64, i64) {
  %wide = scalar.constant 1 : i32
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 0 : i64
  func.return %wide, %lo, %hi : i32, i64, i64
}

// ====

// The identity proof keeps strict NaN, signed-zero and infinity answers.
func.def @exceptional_values() -> (i1, i1, i1, i1) {
  %nan = scalar.constant nan : f64
  %c0 = scalar.constant 0.0 : f64
  %cn0 = scalar.constant -0.0 : f64
  %infinity = scalar.constant inf : f64
  %nan_ordered = scalar.cmpf ord, %nan, %nan : f64
  %nan_unordered_equal = scalar.cmpf ueq, %nan, %nan : f64
  %zero_equal = scalar.cmpf<nnan> oeq, %c0, %cn0 : f64
  %infinity_equal = scalar.cmpf<nnan> oeq, %infinity, %infinity : f64
  func.return %nan_ordered, %nan_unordered_equal, %zero_equal, %infinity_equal : i1, i1, i1, i1
}

// ----
func.def @exceptional_values() -> (i1, i1, i1, i1) {
  %nan_ordered = scalar.constant false : i1
  %nan_unordered_equal = scalar.constant true : i1
  %zero_equal = scalar.constant true : i1
  %infinity_equal = scalar.constant true : i1
  func.return %nan_ordered, %nan_unordered_equal, %zero_equal, %infinity_equal : i1, i1, i1, i1
}
