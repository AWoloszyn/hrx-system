kernel.def @widen_packed_integer_lanes() {
  %c1 = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%input: buffer, %u16: buffer, %s16: buffer, %u32: buffer, %s32: buffer, %half_u32: buffer, %half_s32: buffer) {
  %c0 = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %c4 = index.constant 4 : index
  %index = index.mul %lane, %c4 : index
  %bytes = buffer.view %input[%c0] : buffer -> view<256xi8>
  %halves = buffer.view %input[%c0] : buffer -> view<128xi16>
  %u16_view = buffer.view %u16[%c0] : buffer -> view<128xi16>
  %s16_view = buffer.view %s16[%c0] : buffer -> view<128xi16>
  %u32_view = buffer.view %u32[%c0] : buffer -> view<128xi32>
  %s32_view = buffer.view %s32[%c0] : buffer -> view<128xi32>
  %half_u32_view = buffer.view %half_u32[%c0] : buffer -> view<128xi32>
  %half_s32_view = buffer.view %half_s32[%c0] : buffer -> view<128xi32>
  %byte_values = vector.load %bytes[%index] : view<256xi8> -> vector<4xi8>
  %half_values = vector.load %halves[%index] : view<128xi16> -> vector<4xi16>
  %u16_values = vector.extui %byte_values : vector<4xi8> to vector<4xi16>
  %s16_values = vector.extsi %byte_values : vector<4xi8> to vector<4xi16>
  %u32_values = vector.extui %byte_values : vector<4xi8> to vector<4xi32>
  %s32_values = vector.extsi %byte_values : vector<4xi8> to vector<4xi32>
  %half_u32_values = vector.extui %half_values : vector<4xi16> to vector<4xi32>
  %half_s32_values = vector.extsi %half_values : vector<4xi16> to vector<4xi32>
  vector.store %u16_values, %u16_view[%index] : vector<4xi16>, view<128xi16>
  vector.store %s16_values, %s16_view[%index] : vector<4xi16>, view<128xi16>
  vector.store %u32_values, %u32_view[%index] : vector<4xi32>, view<128xi32>
  vector.store %s32_values, %s32_view[%index] : vector<4xi32>, view<128xi32>
  vector.store %half_u32_values, %half_u32_view[%index] : vector<4xi32>, view<128xi32>
  vector.store %half_s32_values, %half_s32_view[%index] : vector<4xi32>, view<128xi32>
  kernel.return
}

// Adjacent source bytes have high bits set, so unmasked extraction cannot
// accidentally satisfy zero extension when the destination stays packed.
check.case public @packed_integer_widening {
  %input = check.generate.fill value(-32640) : tensor<128xi16>
  %u16 = check.generate.fill value(0) : tensor<128xi16>
  %s16 = check.generate.fill value(0) : tensor<128xi16>
  %u32 = check.generate.fill value(0) : tensor<128xi32>
  %s32 = check.generate.fill value(0) : tensor<128xi32>
  %half_u32 = check.generate.fill value(0) : tensor<128xi32>
  %half_s32 = check.generate.fill value(0) : tensor<128xi32>
  kernel.launch @widen_packed_integer_lanes(%input, %u16, %s16, %u32, %s32, %half_u32, %half_s32) : (tensor<128xi16>, tensor<128xi16>, tensor<128xi16>, tensor<128xi32>, tensor<128xi32>, tensor<128xi32>, tensor<128xi32>)
  %expected_u16 = check.generate.fill value(128) : tensor<128xi16>
  %expected_s16 = check.generate.fill value(-128) : tensor<128xi16>
  %expected_u32 = check.generate.fill value(128) : tensor<128xi32>
  %expected_s32 = check.generate.fill value(-128) : tensor<128xi32>
  %expected_half_u32 = check.generate.fill value(32896) : tensor<128xi32>
  %expected_half_s32 = check.generate.fill value(-32640) : tensor<128xi32>
  check.expect.equal actual(%u16) expected(%expected_u16) : tensor<128xi16>
  check.expect.equal actual(%s16) expected(%expected_s16) : tensor<128xi16>
  check.expect.equal actual(%u32) expected(%expected_u32) : tensor<128xi32>
  check.expect.equal actual(%s32) expected(%expected_s32) : tensor<128xi32>
  check.expect.equal actual(%half_u32) expected(%expected_half_u32) : tensor<128xi32>
  check.expect.equal actual(%half_s32) expected(%expected_half_s32) : tensor<128xi32>
  check.return
}
