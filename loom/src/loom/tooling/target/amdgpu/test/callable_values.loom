kernel.def export("callable_i64") @callable_i64() {
  %unit = index.constant 1 : index
  %group_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%group_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %delta: i64, %count: index) {
  %lane = kernel.workitem.id<x> : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %uniform_lane = index.add %lane, %c64 : index
  %loop_lane = index.add %lane, %c128 : index
  %start = index.constant 8 : offset
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<64xi64>
  %output_view = buffer.view %output[%start] : buffer -> view<192xi64>
  %value = view.load %input_view[%lane] : view<64xi64> -> i64
  %mixed = func.call @add_i64(%value, %delta) : (i64, i64) -> (i64)
  %uniform = func.call @add_i64(%delta, %delta) : (i64, i64) -> (i64)
  %repeated = func.call @repeat_i64(%value, %delta, %count) : (i64, i64, index) -> (i64)
  view.store %mixed, %output_view[%lane] : i64, view<192xi64>
  view.store %uniform, %output_view[%uniform_lane] : i64, view<192xi64>
  view.store %repeated, %output_view[%loop_lane] : i64, view<192xi64>
  kernel.return
}

func.def @add_i64(%value: i64, %delta: i64) -> (i64) {
  %result = scalar.addi %value, %delta : i64
  func.return %result : i64
}

func.def @repeat_i64(%value: i64, %delta: i64, %count: index) -> (i64) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %result = scf.for %i = [%c0 to %count step %c1](%current = %value : i64) -> (i64) {
    %next = func.call @add_i64(%current, %delta) : (i64, i64) -> (i64)
    scf.yield %next : i64
  }
  func.return %result : i64
}

