// Helper calls preserve lane-dependent values, uniform arithmetic, loop-carried
// results, and vector extraction results across physical register selection.

kernel.def export("callable_i32") @callable_i32() {
  %unit = index.constant 1 : index
  %group_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%group_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %delta: i32, %count: index) {
  %lane = kernel.workitem.id<x> : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %uniform_lane = index.add %lane, %c64 : index
  %loop_lane = index.add %lane, %c128 : index
  %start = index.constant 4 : offset
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%start] : buffer -> view<192xi32>
  %value = view.load %input_view[%lane] : view<64xi32> -> i32
  %mixed = func.call @add_i32(%value, %delta) : (i32, i32) -> (i32)
  %uniform = func.call @add_i32(%delta, %delta) : (i32, i32) -> (i32)
  %repeated = func.call @repeat_i32(%value, %delta, %count) : (i32, i32, index) -> (i32)
  view.store %mixed, %output_view[%lane] : i32, view<192xi32>
  view.store %uniform, %output_view[%uniform_lane] : i32, view<192xi32>
  view.store %repeated, %output_view[%loop_lane] : i32, view<192xi32>
  kernel.return
}

func.def @add_i32(%value: i32, %delta: i32) -> (i32) {
  %wide_value = scalar.extui %value : i32 to i64
  %wide_delta = scalar.extui %delta : i32 to i64
  %sum = scalar.addi %wide_value, %wide_delta : i64
  %result = scalar.trunci %sum : i64 to i32
  func.return %result : i32
}

func.def @repeat_i32(%value: i32, %delta: i32, %count: index) -> (i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %result = scf.for %i = [%c0 to %count step %c1](%current = %value : i32) -> (i32) {
    %next = func.call @add_i32(%current, %delta) : (i32, i32) -> (i32)
    scf.yield %next : i32
  }
  func.return %result : i32
}

check.case @callable_i32_zero_trips {
  %input = check.generate.iota offset(-8) step(1) : tensor<64xi32>
  %output = check.generate.fill value(37) : tensor<194xi32>
  %delta = check.literal value(17) : i32
  %count = check.literal value(0) : index
  kernel.launch @callable_i32(%input, %output, %delta, %count) : (tensor<64xi32>, tensor<194xi32>, i32, index)
  %mixed = check.tensor.view %output offset(4) : tensor<194xi32> -> tensor<64xi32>
  %uniform = check.tensor.view %output offset(260) : tensor<194xi32> -> tensor<64xi32>
  %repeated = check.tensor.view %output offset(516) : tensor<194xi32> -> tensor<64xi32>
  %expected_mixed = check.generate.iota offset(9) step(1) : tensor<64xi32>
  %expected_uniform = check.generate.fill value(34) : tensor<64xi32>
  %expected_repeated = check.generate.iota offset(-8) step(1) : tensor<64xi32>
  check.expect.equal actual(%mixed) expected(%expected_mixed) : tensor<64xi32>
  check.expect.equal actual(%uniform) expected(%expected_uniform) : tensor<64xi32>
  check.expect.equal actual(%repeated) expected(%expected_repeated) : tensor<64xi32>
  %expected_input = check.generate.iota offset(-8) step(1) : tensor<64xi32>
  check.expect.equal actual(%input) expected(%expected_input) : tensor<64xi32>
  %prefix = check.tensor.view %output offset(0) : tensor<194xi32> -> tensor<1xi32>
  %suffix = check.tensor.view %output offset(772) : tensor<194xi32> -> tensor<1xi32>
  %guard = check.generate.fill value(37) : tensor<1xi32>
  check.expect.equal actual(%prefix) expected(%guard) : tensor<1xi32>
  check.expect.equal actual(%suffix) expected(%guard) : tensor<1xi32>
  check.return
}

