kernel.def export("callable_vector_result") @callable_vector_result() {
  %unit = index.constant 1 : index
  %group_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%group_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %selector: index) {
  %lane = kernel.workitem.id<x> : index
  %selected = index.assume %selector [range(%selector, 0, 3)] : index
  %start = index.constant 4 : offset
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%start] : buffer -> view<64xi32>
  %value = view.load %input_view[%lane] : view<64xi32> -> i32
  %result = func.call @select_value(%value, %selected) : (i32, index) -> (i32)
  view.store %result, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

func.def @select_value(%input: i32, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %values = vector.from_elements %input, %c1, %c2, %c3 : vector<4xi32>
  %result = vector.extract %values[%lane] : vector<4xi32> -> i32
  func.return %result : i32
}

