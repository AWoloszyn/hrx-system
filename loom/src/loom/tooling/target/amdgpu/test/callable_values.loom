  %guard = check.generate.fill value(37) : tensor<1xi32>
  check.expect.equal actual(%prefix) expected(%guard) : tensor<1xi32>
  check.expect.equal actual(%suffix) expected(%guard) : tensor<1xi32>
  check.return
}

kernel.def export("callable_varying_loop") @callable_varying_loop() {
  %unit = index.constant 1 : index
  %group_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%group_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %delta: i32) {
  %lane = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %start = index.constant 4 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%start] : buffer -> view<64xi32>
  %value = view.load %input_view[%lane] : view<64xi32> -> i32
  %result = func.call @repeat_i32(%value, %delta, %lane) : (i32, i32, index) -> (i32)
  view.store %result, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

check.case @callable_varying_loop_lanes {
  %input = check.generate.iota offset(-8) step(1) : tensor<64xi32>
  %output = check.generate.fill value(37) : tensor<66xi32>
  %delta = check.literal value(17) : i32
  kernel.launch @callable_varying_loop(%input, %output, %delta) : (tensor<64xi32>, tensor<66xi32>, i32)
  %actual = check.tensor.view %output offset(4) : tensor<66xi32> -> tensor<64xi32>
  %expected = check.generate.iota offset(-8) step(18) : tensor<64xi32>
  check.expect.equal actual(%actual) expected(%expected) : tensor<64xi32>
  %expected_input = check.generate.iota offset(-8) step(1) : tensor<64xi32>
  check.expect.equal actual(%input) expected(%expected_input) : tensor<64xi32>
  %prefix = check.tensor.view %output offset(0) : tensor<66xi32> -> tensor<1xi32>
  %suffix = check.tensor.view %output offset(260) : tensor<66xi32> -> tensor<1xi32>
  %guard = check.generate.fill value(37) : tensor<1xi32>
  check.expect.equal actual(%prefix) expected(%guard) : tensor<1xi32>
  check.expect.equal actual(%suffix) expected(%guard) : tensor<1xi32>
  check.return
}
