          "--format=amdgpu-hsaco",
          "--output={tmp}/memory.hsaco",
          "--compile-report=summary",
          "--compile-report-output={tmp}/memory.json"
        ]
      },
      "files": [
        {
          "path": "{tmp}/memory.hsaco",
          "non_empty": true
        },
