kernel.def target(@spill_target) @spill_snapshot_kernel() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %index = index.constant 0 : index
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<1xi32>
  %input = vector.load %input_view[%index] : view<1xi32> -> vector<1xi32>
  %output = low.invoke @spill_snapshot(%input) : (vector<1xi32>) -> (vector<1xi32>)
  vector.store %output, %output_view[%index] : vector<1xi32>, view<1xi32>
  kernel.return
}

check.case public @spill_snapshot_0 {
  %input = check.generate.fill value(0) : tensor<1xi32>
  %output = check.generate.fill value(123) : tensor<1xi32>
  %expected = check.generate.fill value(0) : tensor<1xi32>
  kernel.launch @spill_snapshot_kernel(%input, %output) : (tensor<1xi32>, tensor<1xi32>)
  check.expect.equal actual(%output) expected(%expected) : tensor<1xi32>
  check.return
}

