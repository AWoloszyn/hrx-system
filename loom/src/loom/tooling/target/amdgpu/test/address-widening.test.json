    {
      "name": "compiles address widening for gfx942",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/../../../../test/corpus/conformance/address_widening.loom",
          "--target=amdgpu:gfx942",
          "--format=amdgpu-hsaco",
          "--output={tmp}/address_widening.hsaco"
        ]
      },
      "files": [
