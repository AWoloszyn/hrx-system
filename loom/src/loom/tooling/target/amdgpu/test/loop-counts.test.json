{
  "version": 1,
  "cases": [
    {
      "name": "counts native loop effects for unsigned_empty_loop",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/corpus/gfx11/loop_count.loom",
          "--root=@unsigned_empty_loop",
          "--target=amdgpu:gfx1151",
          "--format=amdgpu-hsaco",
          "--output={tmp}/unsigned_empty_loop.hsaco",
          "--compile-report=details",
          "--compile-report-output={tmp}/unsigned_empty_loop.json"
        ]
      },
      "files": [
        {
          "path": "{tmp}/unsigned_empty_loop.hsaco",
          "non_empty": true
        },
        {
          "path": "{tmp}/unsigned_empty_loop.json",
          "contains": [
            {
              "regex": "\"dynamic_instruction_mix\":\\{[^}]*\"global_store_count\":1,"
            }
          ]
        }
      ]
    },
