{
  "version": 1,
  "cases": [
    {
      "name": "reports source loop count for unsigned_empty on gfx942",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/../../../../test/corpus/source_low/loop_count.loom-test",
          "--root=@unsigned_empty",
          "--target=amdgpu:gfx942",
          "--format=amdgpu-hsaco",
          "--pipeline=source-to-low,amdgpu-materialize-hal-buffer-descriptors,amdgpu-materialize-hal-kernel-abi,low-dce",
          "--output={tmp}/loop.hsaco",
          "--compile-report=details",
          "--compile-report-output={tmp}/loop.json"
        ]
      },
      "files": [
        {
          "path": "{tmp}/loop.hsaco",
          "non_empty": true
        },
        {
          "path": "{tmp}/loop.json",
          "contains": {
            "unordered": [
              {
                "regex": "\"source_op\":\"view.store\"[^{}]*\"execution_count\":0[,}]"
              },
              "\"unknown_dynamic_packet_count\":0,",
              "\"dynamic_write_byte_count\":0,"
            ]
          }
        }
      ]
    },
