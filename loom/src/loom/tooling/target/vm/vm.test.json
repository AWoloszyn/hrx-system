{
  "version": 1,
  "cases": [
    {
      "name": "rejects a target opcode with incompatible source registers",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/invalid_operand.loom", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["input module failed Low verification"]},
      "files": [{"path": "{tmp}/invalid.vm", "exists": false}]
    },
    {
      "name": "compiles an authored module into standalone VM bytecode",
      "steps": [
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": ["{srcdir}/module.loom", "--format=vm", "--output={tmp}/module.vm"]
          }
        },
        {
          "name": "disassemble",
          "run": {
            "tool": "vm-dis",
            "args": ["{tmp}/module.vm"]
          },
          "stdout": {
            "contains": [
              "vm.module core(0.0)",
              "\"arithmetic\"",
              "\"swap\"",
              "integer.mul.i32",
              "value.copy",
              "control.return"
            ]
          }
        }
      ]
    },
    {
      "name": "rejects colliding host export names",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/duplicate_exports.loom", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["duplicate VM export 'collision'"]}
    },
    {
      "name": "rejects an explicitly empty export name",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/empty_export.loom", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["VM export names must not be empty"]}
    },
    {
      "name": "rejects storage exceeding the Core frame extent",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/invalid_storage.loom", "--root=oversized", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["VM local storage exceeds 65535 bytes"]}
    },
    {
      "name": "rejects a narrow scalar spill that does not hold a complete value cell",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/invalid_storage.loom", "--root=short", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["VM register transfer exceeds its storage span"]}
    },
    {
      "name": "rejects workgroup storage in a Core host function",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/invalid_storage.loom", "--root=wrong_space", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["VM local storage requires the stack space"]}
    }
  ]
}
