  func.return %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9, %r10, %r11, %r12, %r13, %r14, %r15, %r16 : hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view, hal.buffer_view
