load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "testbench",
    srcs = ["testbench.c"],
    hdrs = ["testbench.h"],
    deps = [
        "//loom/src/loom/link:linker",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/func",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/vm:module",
        "//loom/src/loom/target/arch/vm:provider",
        "//loom/src/loom/tooling/compile:pipeline",
        "//loom/src/loom/tooling/testbench:invocation",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/vm",
        "//runtime/src/iree/vm/bytecode:module",
    ],
)

iree_execution_test_suite(
    name = "tools_test",
    data = [
        "boolean_comparison.loom",
        "duplicate_exports.loom",
        "empty_export.loom",
        "invalid_operand.loom",
        "invalid_storage.loom",
        "module.loom",
        "//loom/src/loom/test/corpus/source_low:numeric_boolean_comparison.loom-test",
        "source_cases.loom",
        "source_library_cases.loom",
        "source_unavailable.loom",
    ],
    manifests = ["vm.test.json"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/target/arch:vm"]),
    tools = {
        "iree-benchmark-loom": "//loom/src/loom/tools/iree-benchmark-loom",
        "iree-test-loom": "//loom/src/loom/tools/iree-test-loom",
        "loom-compile": "//loom/src/loom/tools/loom-compile",
        "vm-dis": "//tools:vm-dis",
    },
)
