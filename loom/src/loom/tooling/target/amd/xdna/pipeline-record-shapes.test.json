{
  "version": 1,
  "cases": [
    {
      "name": "unit lane extent",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/test/unit_lane_extent.loom",
          "--root=@copy_records",
          "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
          "--output={tmp}/invalid.xdna"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "pipeline output leading dimension must equal source-group cardinality"
        ]
      },
      "files": [
        {
          "path": "{tmp}/invalid.xdna",
          "exists": false
        }
      ]
    },
    {
