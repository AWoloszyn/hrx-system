// RUN: pass aie2p-lower-pipeline

// A single-lane group still requires its explicit lane axis to have extent one.

aie2p.target<array> @array_target

aie2p.target<core> @core_target

func.decl target(@core_target) @copy(%input: buffer, %output: buffer)

pipeline.def<kernel> public retain target(@array_target) @copy_records() launch(%input: buffer, %output: buffer) {
  %lanes = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %lanes : index -> group
  %input_view = buffer.view %input[%base] : buffer -> view<1x1x4xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<2x1x4xi32>
  %input_flow = pipeline.scatter %input_view across %workers : view<1x1x4xi32>, group -> pipeline.flow<tile<4xi32>>
  %output_flow = pipeline.stage @copy on %workers(%input_flow) : (group, pipeline.flow<tile<4xi32>>) -> (pipeline.flow<tile<4xi32>>)
  // ERROR@+1: LOWERING/061 {extent="2", lane_count="1"}
  pipeline.write %output_flow to %output_view : pipeline.flow<tile<4xi32>>, view<2x1x4xi32>
  pipeline.return
}
