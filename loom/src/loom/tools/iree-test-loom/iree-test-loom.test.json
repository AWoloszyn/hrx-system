{
  "version": 1,
  "cases": [
    {
      "name": "rejects duplicate primary definitions before source library linking",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/../../tooling/input/testdata/duplicate_symbols.loom-test",
          "--library={srcdir}/testdata/library_cases.loom"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "empty": true
      },
      "stderr": {
        "contains": {
          "unordered": [
            "duplicate_symbols.loom-test:5:19: error [SYMBOL/005]",
            "symbol '@collision' is already defined",
            "first definition here",
            "duplicate_symbols.loom-test:3:13",
            "kernel.decl @collision() launch()",
            "check.case public @collision {"
          ]
        }
      }
    },
    {
      "name": "rejects duplicate primary definitions before bytecode library linking",
      "steps": [
        {
          "name": "encode-library",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/library_cases.loom",
              "--mode=merge",
              "--to=bc",
              "--output={tmp}/library.loombc"
            ]
          }
        },
        {
          "name": "reject-input",
          "run": {
            "tool": "iree-test-loom",
            "args": [
              "{srcdir}/../../tooling/input/testdata/duplicate_symbols.loom-test",
              "--library={tmp}/library.loombc"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stdout": {
            "empty": true
          },
          "stderr": {
            "contains": {
              "unordered": [
                "duplicate_symbols.loom-test:5:19: error [SYMBOL/005]",
                "symbol '@collision' is already defined",
                "first definition here",
                "duplicate_symbols.loom-test:3:13",
                "kernel.decl @collision() launch()",
                "check.case public @collision {"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "rejects duplicate library definitions before discovering bytecode input cases",
      "steps": [
        {
          "name": "encode-input",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/linked_input_cases.loom",
              "--mode=merge",
              "--to=bc",
              "--output={tmp}/input.loombc"
            ]
          }
        },
        {
          "name": "reject-library",
          "run": {
            "tool": "iree-test-loom",
            "args": [
              "{tmp}/input.loombc",
              "--library={srcdir}/../../tooling/input/testdata/duplicate_symbols.loom-test"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stdout": {
            "empty": true
          },
          "stderr": {
            "contains": {
              "unordered": [
                "duplicate_symbols.loom-test:5:19: error [SYMBOL/005]",
                "symbol '@collision' is already defined",
                "first definition here",
                "duplicate_symbols.loom-test:3:13",
                "kernel.decl @collision() launch()",
                "check.case public @collision {"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "iree-test-loom",
        "args": ["--agents_md"]
      },
      "stdout": {
        "non_empty": true
      }
    },
    {
      "name": "runs selected sampled case",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/testdata/scalar_cases.loom",
          "--case=@sampled_choice",
          "--sanitizer=tsan",
          "--sanitizer-reporting=report-only",
          "--sample=1"
        ]
      },
      "stdout": {
        "contains": [
          "\"format\":\"loom.test.v0\"",
          "\"case_count\":1",
          "\"sample_count\":1",
          "\"failed_sample_count\":0",
          "\"skipped_case_count\":0",
          "\"case\":\"sampled_choice\",\"sample_ordinal\":1,\"passed\":true"
        ]
      }
    },
    {
      "name": "links explicit bytecode library into authored input",
      "steps": [
        {
          "name": "merge-library",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/library_cases.loom",
              "--mode=merge",
              "--to=bc",
              "--output={tmp}/library_cases.loombc"
            ]
          }
        },
        {
          "name": "run-linked-input",
          "run": {
            "tool": "iree-test-loom",
            "args": [
              "{srcdir}/testdata/linked_input_cases.loom",
              "--library={tmp}/library_cases.loombc"
            ]
          },
          "stdout": {
            "contains": [
              "\"case_count\":2",
              "\"sample_count\":2",
              "\"failed_sample_count\":0",
              "\"case\":\"input_case\",\"sample_ordinal\":0,\"passed\":true",
              "\"case\":\"library_case\",\"sample_ordinal\":0,\"passed\":true"
            ]
          }
        }
      ]
    },
    {
      "name": "reports skipped requirements with stable codes",
      "run": {
        "tool": "iree-test-loom",
        "args": ["{srcdir}/testdata/requirement_cases.loom"]
      },
      "stdout": {
        "contains": [
          "\"format\":\"loom.test.v0\"",
          "\"case_count\":2",
          "\"sample_count\":0",
          "\"failed_sample_count\":0",
          "\"skipped_case_count\":2",
          "\"case\":\"missing_provider_requirement\",\"provider\":\"missing.provider\",\"op\":\"requires\",\"code\":\"provider_not_registered\"",
          "\"case\":\"missing_provider_skip_if\",\"provider\":\"missing.provider\",\"op\":\"skip_if\",\"code\":\"provider_not_registered\",\"display_message\":\"human skip display text\""
        ],
        "not_contains": ["\"reason\""]
      }
    },
    {
      "name": "rejects an unavailable explicit device",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/testdata/scalar_cases.loom",
          "--device=loom-unavailable"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "--device=loom-unavailable",
          "not available in this Loom installation",
          "no linked device provider"
        ]
      }
    }
  ]
}
