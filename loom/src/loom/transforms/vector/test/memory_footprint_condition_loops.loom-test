func.def @condition_declared_aliases(%output: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<4xi32>
  %terminal = scf.while(%before = %begin : index) -> (index) {
    %more = index.cmp slt, %before, %end : index
    %forwarded = index.assume %before [] : index
    scf.condition %more, %forwarded : i1, index
  } do(%position: index) {
    %value = index.cast %position : index to i32
    view.store %value, %view[%position] : i32, view<4xi32>
    %body_counter = index.assume %position [] : index
    %next = index.add %step, %body_counter : index
    %backedge = index.assume %next [] : index
    scf.yield %backedge : index
  }
  func.return
}

