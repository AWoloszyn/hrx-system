// RUN: pass cfg-simplify

func.def @and_with_unproven_disjunction(%left: i1, %right: i1, %gate: i1, %yes: i32, %no: i32) -> (i32) {
  %inner = scalar.ori %left, %right : i1
  %selected = scalar.andi %inner, %gate : i1
  cfg.cond_br %gate, ^check, ^no
^check:
  cfg.cond_br %selected, ^yes, ^no
^yes:
  func.return %yes : i32
^no:
  func.return %no : i32
}

// ====

