func.def @keeps_repeated_scratch_assumptions(%replacement: i32, %initial: i32) -> (i32) {
  %base = index.constant 0 : offset
  %bytes = index.constant 32 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<8xi32>
  view.store %initial, %scratch_view[0] : i32, view<8xi32>
  %aligned = buffer.assume.alignment %scratch {minimum_alignment = 16} : buffer
  %unique = buffer.assume.noalias %aligned : buffer
  %again = buffer.assume.noalias %unique : buffer
  %input_view = buffer.view %again[%base] : buffer -> view<8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %iteration = [%begin to %end step %step](%carry = %initial : i32) -> (i32) {
    %loaded = view.load %input_view[0] : view<8xi32> -> i32
    view.store %replacement, %scratch_view[0] : i32, view<8xi32>
    scf.yield %loaded : i32
  }
  func.return %result : i32
}

