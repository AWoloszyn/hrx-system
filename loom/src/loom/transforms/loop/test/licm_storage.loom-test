  %aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %again = buffer.assume.alignment %aligned {minimum_alignment = 32} : buffer
  %large = buffer.view %again[%base] : buffer -> view<16xi32>
  %input_view = view.subview %large[4] : view<16xi32> -> view<8xi32>
