// RUN: pass unroll-scf-for

func.def @dependent_unroll_guarded_tail(%input: buffer, %base: offset, %count: index, %initial_rows: index, %layout: encoding<layout>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %factor = index.constant 2 : index
  %initial = buffer.view %input[%base] : buffer -> view<[%initial_rows]x4xi32, %layout>
  %rows, %view = scf.for %i = [%begin to %count step %step](%body_rows = %initial_rows : index, %body_view = %initial : view<[%initial_rows]x4xi32, %layout>) -> (index, view<[%rows]x4xi32, %layout>) unroll(%factor) {
    test.use %body_view : view<[%body_rows]x4xi32, %layout>
    %next_rows = index.sub %body_rows, %step : index
    %next = view.subview %body_view[1, 0] : view<[%body_rows]x4xi32, %layout> -> view<[%next_rows]x4xi32, %layout>
    scf.yield %next_rows, %next : index, view<[%next_rows]x4xi32, %layout>
  }
  test.use %view : view<[%rows]x4xi32, %layout>
  func.return
}

// ----
func.def @dependent_unroll_guarded_tail(%input: buffer, %base: offset, %count: index, %initial_rows: index, %layout: encoding<layout>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %factor = index.constant 2 : index
  %initial = buffer.view %input[%base] : buffer -> view<[%initial_rows]x4xi32, %layout>
  %16 = index.constant 2 : index
  %rows, %view = scf.for %i = [%begin to %count step %16](%body_rows = %initial_rows : index, %body_view = %initial : view<[%initial_rows]x4xi32, %layout>) -> (index, view<[%rows]x4xi32, %layout>) {
    test.use %body_view : view<[%body_rows]x4xi32, %layout>
    %next_rows = index.sub %body_rows, %step : index
    %next = view.subview %body_view[1, 0] : view<[%body_rows]x4xi32, %layout> -> view<[%next_rows]x4xi32, %layout>
    %24 = index.constant 1 : index
    %i_1 = index.add %i, %24 : index
    %26 = index.cmp slt, %i_1, %count : index
    %27, %28 = scf.if %26 -> (index, view<[%27]x4xi32, %layout>) {
      test.use %next : view<[%next_rows]x4xi32, %layout>
      %next_rows_1 = index.sub %next_rows, %step : index
      %next_1 = view.subview %next[1, 0] : view<[%next_rows]x4xi32, %layout> -> view<[%next_rows_1]x4xi32, %layout>
      scf.yield %next_rows_1, %next_1 : index, view<[%next_rows_1]x4xi32, %layout>
    } else {
      scf.yield %next_rows, %next : index, view<[%next_rows]x4xi32, %layout>
    }
    scf.yield %27, %28 : index, view<[%27]x4xi32, %layout>
  }
  test.use %view : view<[%rows]x4xi32, %layout>
  func.return
}

