// ====

// A pure conditional used by a load joins the producer's prerequisite closure.
func.def @conditional_address_prerequisite(%input: view<8xf32>, %end: index, %initial: f32, %condition: i1) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %position = scf.if %condition -> (index) {
      %next_position = index.add %i, %step : index
      scf.yield %next_position : index
    } else {
      scf.yield %i : index
    }
    %value = view.load %input[%position] : view<8xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

