// RUN: pass-report pipeline-scf-for

func.def @inspect_read_ahead_schedule(%input: view<64xf32>, %end: index, %initial: f32, %weight: f32) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %stride = index.constant 2 : index
  %depth = index.constant 3 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %position = index.mul %i, %stride : index
    %value = view.load %input[%position] : view<64xf32> -> f32
    %weighted = scalar.mulf %value, %weight : f32
    %next = scalar.addf %sum, %weighted : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

