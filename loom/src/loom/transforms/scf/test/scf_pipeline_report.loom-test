func.def @no_implicit_pipeline(%input: view<64xf32>, %end: index, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) {
    %value = view.load %input[%i] : view<64xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

