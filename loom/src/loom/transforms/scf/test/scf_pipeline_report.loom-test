// ====

// Static read_count includes both branches of the atomic producer loop.
func.def @inspect_structured_producer(%input: view<8xf32>, %end: index, %inner_end: index, %initial: f32, %condition: i1) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 3 : index
  %identity = scalar.constant 0.0 : f32
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %partial = scf.for %j = [%begin to %inner_end step %step](%inner_sum = %identity : f32) -> (f32) {
      %selected = scf.if %condition -> (f32) {
        %left = view.load %input[%i] : view<8xf32> -> f32
        scf.yield %left : f32
      } else {
        %right = view.load %input[%j] : view<8xf32> -> f32
        scf.yield %right : f32
      }
      %added = scalar.addf %inner_sum, %selected : f32
      scf.yield %added : f32
    }
    %next = scalar.addf %sum, %partial : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

