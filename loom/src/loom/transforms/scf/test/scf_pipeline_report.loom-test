// ====

// Inner and outer policies are independently consumed, including the inner
// pipeline's short-loop fallback and carried queue in the outer producer unit.
func.def @nested_pipeline_policies(%input: view<8xf32>, %end: index, %inner_end: index, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %identity = scalar.constant 0.0 : f32
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %partial = scf.for %j = [%begin to %inner_end step %step](%inner_sum = %identity : f32) -> (f32) pipeline(%depth) {
      %value = view.load %input[%j] : view<8xf32> -> f32
      %added = scalar.addf %inner_sum, %value : f32
      scf.yield %added : f32
    }
    %next = scalar.addf %sum, %partial : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

