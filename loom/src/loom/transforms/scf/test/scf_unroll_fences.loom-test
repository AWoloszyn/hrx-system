// ====

// RUN: pass unroll-scf-for

// A carried consumer precedes the table read and its dependent payload under recurrence unrolling.
func.def @consume_then_lookup(%ids: view<8xi32>, %payloads: view<8xf32>, %initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %initial : f32) -> (f32) unroll schedule(recurrence) {
    %consumed = scalar.addf %sum, %bias : f32
    scf.schedule.fence
    %id = view.load %ids[%row] : view<8xi32> -> i32
    %index = index.cast %id : i32 to index
    %payload = view.load %payloads[%index] : view<8xf32> -> f32
    %next = scalar.addf %consumed, %payload : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @consume_then_lookup(%ids: view<8xi32>, %payloads: view<8xf32>, %initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %row_0 = index.constant 0 : index
  %row_1 = index.constant 1 : index
  scf.schedule.fence
  %consumed = scalar.addf %initial, %bias : f32
  scf.schedule.fence
  %id = view.load %ids[%row_0] : view<8xi32> -> i32
  %index = index.cast %id : i32 to index
  %payload = view.load %payloads[%index] : view<8xf32> -> f32
  %next = scalar.addf %consumed, %payload : f32
  scf.schedule.fence
  %consumed_1 = scalar.addf %next, %bias : f32
  scf.schedule.fence
  %id_1 = view.load %ids[%row_1] : view<8xi32> -> i32
  %index_1 = index.cast %id_1 : i32 to index
  %payload_1 = view.load %payloads[%index_1] : view<8xf32> -> f32
  %next_1 = scalar.addf %consumed_1, %payload_1 : f32
  func.return %next_1 : f32
}

// ====

// RUN: pass inline-callables,unroll-scf-for

// Inlining exposes the helper boundary to the same body analysis used for directly authored fences.
func.def inline @fenced_producer(%bias: f32) -> (f32) {
  scf.schedule.fence
  %value = scalar.mulf %bias, %bias : f32
  func.return %value : f32
}

func.def @inline_composition(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %initial : f32) -> (f32) unroll schedule(recurrence) {
    %consumed = scalar.addf %sum, %bias : f32
    %produced = func.call @fenced_producer(%bias) : (f32) -> (f32)
    %next = scalar.addf %consumed, %produced : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @inline_composition(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  scf.schedule.fence
  %consumed = scalar.addf %initial, %bias : f32
  scf.schedule.fence
  %value = scalar.mulf %bias, %bias : f32
  %next = scalar.addf %consumed, %value : f32
  scf.schedule.fence
  %consumed_1 = scalar.addf %next, %bias : f32
  scf.schedule.fence
  %value_1 = scalar.mulf %bias, %bias : f32
  %next_1 = scalar.addf %consumed_1, %value_1 : f32
  func.return %next_1 : f32
}
