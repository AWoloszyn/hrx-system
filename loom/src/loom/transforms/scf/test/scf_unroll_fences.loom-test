// RUN: pass unroll-scf-for

// A fence constrains pure operations even when the body has no memory effects.
func.def @pure_interleaved(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %initial : f32) -> (f32) unroll schedule(interleaved) {
    %consumed = scalar.addf %sum, %bias : f32
    scf.schedule.fence
    %produced = scalar.mulf %bias, %bias : f32
    %next = scalar.addf %consumed, %produced : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @pure_interleaved(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %consumed = scalar.addf %initial, %bias : f32
  scf.schedule.fence
  %produced = scalar.mulf %bias, %bias : f32
  %next = scalar.addf %consumed, %produced : f32
  %consumed_1 = scalar.addf %next, %bias : f32
  scf.schedule.fence
  %produced_1 = scalar.mulf %bias, %bias : f32
  %next_1 = scalar.addf %consumed_1, %produced_1 : f32
  func.return %next_1 : f32
}

// ====

// RUN: pass unroll-scf-for

// Recurrence lookahead cannot issue the independent producer across an authored fence.
func.def @pure_recurrence(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %initial : f32) -> (f32) unroll schedule(recurrence) {
    %consumed = scalar.addf %sum, %bias : f32
    scf.schedule.fence
    %produced = scalar.mulf %bias, %bias : f32
    %next = scalar.addf %consumed, %produced : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @pure_recurrence(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  scf.schedule.fence
  %consumed = scalar.addf %initial, %bias : f32
  scf.schedule.fence
  %produced = scalar.mulf %bias, %bias : f32
  %next = scalar.addf %consumed, %produced : f32
  scf.schedule.fence
  %consumed_1 = scalar.addf %next, %bias : f32
  scf.schedule.fence
  %produced_1 = scalar.mulf %bias, %bias : f32
  %next_1 = scalar.addf %consumed_1, %produced_1 : f32
  func.return %next_1 : f32
}

// ====

// RUN: pass unroll-scf-for

// Without a fence, the independent producer can still run ahead of the carried consumer.
func.def @free_interleaved(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %initial : f32) -> (f32) unroll schedule(interleaved) {
    %consumed = scalar.addf %sum, %bias : f32
    %produced = scalar.mulf %bias, %bias : f32
    %next = scalar.addf %consumed, %produced : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @free_interleaved(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %consumed = scalar.addf %initial, %bias : f32
  %produced = scalar.mulf %bias, %bias : f32
  %produced_1 = scalar.mulf %bias, %bias : f32
  %next = scalar.addf %consumed, %produced : f32
  %consumed_1 = scalar.addf %next, %bias : f32
  %next_1 = scalar.addf %consumed_1, %produced_1 : f32
  func.return %next_1 : f32
}

// ====

// RUN: pass unroll-scf-for

// Leading, adjacent, and trailing boundaries preserve empty ranges across iterations.
func.def @multiple_boundaries(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %initial : f32) -> (f32) unroll schedule(interleaved) {
    scf.schedule.fence
    %consumed = scalar.addf %sum, %bias : f32
    scf.schedule.fence
    scf.schedule.fence
    %produced = scalar.mulf %bias, %bias : f32
    %next = scalar.addf %consumed, %produced : f32
    scf.schedule.fence
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @multiple_boundaries(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  scf.schedule.fence
  %consumed = scalar.addf %initial, %bias : f32
  scf.schedule.fence
  scf.schedule.fence
  %produced = scalar.mulf %bias, %bias : f32
  %next = scalar.addf %consumed, %produced : f32
  scf.schedule.fence
  scf.schedule.fence
  %consumed_1 = scalar.addf %next, %bias : f32
  scf.schedule.fence
  scf.schedule.fence
  %produced_1 = scalar.mulf %bias, %bias : f32
  %next_1 = scalar.addf %consumed_1, %produced_1 : f32
  scf.schedule.fence
  func.return %next_1 : f32
}

// ====

// RUN: pass unroll-scf-for

// A partial recurrence tile and its scalar remainder both preserve the authored boundary.
func.def @partial_recurrence(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 5 : index
  %step = index.constant 1 : index
  %factor = index.constant 2 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %initial : f32) -> (f32) unroll(%factor) schedule(recurrence) {
    %consumed = scalar.addf %sum, %bias : f32
    scf.schedule.fence
    %produced = scalar.mulf %bias, %bias : f32
    %next = scalar.addf %consumed, %produced : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @partial_recurrence(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 5 : index
  %step = index.constant 1 : index
  %factor = index.constant 2 : index
  %13 = index.constant 2 : index
  %14 = index.constant 4 : index
  %17 = scf.for %row = [%begin to %14 step %13](%sum = %initial : f32) -> (f32) {
    scf.schedule.fence
    %consumed = scalar.addf %sum, %bias : f32
    scf.schedule.fence
    %produced = scalar.mulf %bias, %bias : f32
    %next = scalar.addf %consumed, %produced : f32
    scf.schedule.fence
    %consumed_1 = scalar.addf %next, %bias : f32
    scf.schedule.fence
    %produced_1 = scalar.mulf %bias, %bias : f32
    %next_1 = scalar.addf %consumed_1, %produced_1 : f32
    scf.yield %next_1 : f32
  }
  %result = scf.for %row = [%14 to %end step %step](%sum = %17 : f32) -> (f32) {
    %consumed = scalar.addf %sum, %bias : f32
    scf.schedule.fence
    %produced = scalar.mulf %bias, %bias : f32
    %next = scalar.addf %consumed, %produced : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

