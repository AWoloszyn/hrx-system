// RUN: pass unroll-scf-for

// Single and empty loops retain the fence only for iterations that execute.
func.def @single_iteration(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 1 : index
  %step = index.constant 1 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %initial : f32) -> (f32) unroll schedule(recurrence) {
    %consumed = scalar.addf %sum, %bias : f32
    scf.schedule.fence
    %produced = scalar.mulf %bias, %bias : f32
    %next = scalar.addf %consumed, %produced : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

func.def @empty_loop(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %initial : f32) -> (f32) unroll schedule(interleaved) {
    %consumed = scalar.addf %sum, %bias : f32
    scf.schedule.fence
    %produced = scalar.mulf %bias, %bias : f32
    %next = scalar.addf %consumed, %produced : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @single_iteration(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 1 : index
  %step = index.constant 1 : index
  %consumed = scalar.addf %initial, %bias : f32
  scf.schedule.fence
  %produced = scalar.mulf %bias, %bias : f32
  %next = scalar.addf %consumed, %produced : f32
  func.return %next : f32
}

func.def @empty_loop(%initial: f32, %bias: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 0 : index
  %step = index.constant 1 : index
  func.return %initial : f32
}

// ====

// RUN: pass unroll-scf-for

// A next-iteration producer can overlap the preceding iteration's consumer
// within the same unfenced range. Only the authored boundaries constrain it.
func.def @shared_iteration_range(%input: i32) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %input : i32) -> (i32) unroll schedule(recurrence) {
    %head = scalar.muli %input, %input : i32
    scf.schedule.fence
    %tail = scalar.addi %sum, %head : i32
    scf.yield %tail : i32
  }
  func.return %result : i32
}

// ----
func.def @shared_iteration_range(%input: i32) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %head = scalar.muli %input, %input : i32
  scf.schedule.fence
  %head_1 = scalar.muli %input, %input : i32
  scf.schedule.fence
  %tail = scalar.addi %input, %head : i32
  scf.schedule.fence
  scf.schedule.fence
  %tail_1 = scalar.addi %tail, %head_1 : i32
  func.return %tail_1 : i32
}

// ====

// RUN: pass unroll-scf-for

// An outer boundary orders a whole structured unit, including its captured carried value.
func.def @outer_fence(%input: i32, %bias: i32, %enabled: i1, %limit: index) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %input : i32) -> (i32) unroll schedule(recurrence) {
    %consumed = scalar.addi %sum, %bias : i32
    scf.schedule.fence
    %produced = scf.if %enabled -> (i32) {
      %nested = scf.for %column = [%begin to %limit step %step](%value = %bias : i32) -> (i32) {
        %next = scalar.addi %value, %bias : i32
        scf.schedule.fence
        scf.yield %next : i32
      }
      scf.yield %nested : i32
    } else {
      scf.yield %bias : i32
    }
    %next = scalar.addi %consumed, %produced : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
func.def @outer_fence(%input: i32, %bias: i32, %enabled: i1, %limit: index) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  scf.schedule.fence
  %consumed = scalar.addi %input, %bias : i32
  scf.schedule.fence
  %produced = scf.if %enabled -> (i32) {
    %nested = scf.for %column = [%begin to %limit step %step](%value = %bias : i32) -> (i32) {
      %next = scalar.addi %value, %bias : i32
      scf.schedule.fence
      scf.yield %next : i32
    }
    scf.yield %nested : i32
  } else {
    scf.yield %bias : i32
  }
  %next = scalar.addi %consumed, %produced : i32
  scf.schedule.fence
  %consumed_1 = scalar.addi %next, %bias : i32
  scf.schedule.fence
  %produced_1 = scf.if %enabled -> (i32) {
    %nested = scf.for %column = [%begin to %limit step %step](%value = %bias : i32) -> (i32) {
      %next = scalar.addi %value, %bias : i32
      scf.schedule.fence
      scf.yield %next : i32
    }
    scf.yield %nested : i32
  } else {
    scf.yield %bias : i32
  }
  %next_1 = scalar.addi %consumed_1, %produced_1 : i32
  func.return %next_1 : i32
}

// ====

// RUN: pass unroll-scf-for

// A fence inside a nested region stays within that region when the unit is cloned.
// It does not become an outer boundary that serializes independent structured producers.
func.def @nested_scope(%input: i32, %enabled: i1) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %result = scf.for %row = [%begin to %end step %step](%sum = %input : i32) -> (i32) unroll schedule(recurrence) {
    %consumed = scalar.addi %sum, %input : i32
    %produced = scf.if %enabled -> (i32) {
      %value = scalar.muli %input, %input : i32
      scf.schedule.fence
      scf.yield %value : i32
    } else {
      scf.yield %input : i32
    }
    %next = scalar.addi %consumed, %produced : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
func.def @nested_scope(%input: i32, %enabled: i1) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %produced = scf.if %enabled -> (i32) {
    %value = scalar.muli %input, %input : i32
    scf.schedule.fence
    scf.yield %value : i32
  } else {
    scf.yield %input : i32
  }
  %produced_1 = scf.if %enabled -> (i32) {
    %value = scalar.muli %input, %input : i32
    scf.schedule.fence
    scf.yield %value : i32
  } else {
    scf.yield %input : i32
  }
  scf.schedule.fence
  %consumed = scalar.addi %input, %input : i32
  %next = scalar.addi %consumed, %produced : i32
  scf.schedule.fence
  %consumed_1 = scalar.addi %next, %input : i32
  %next_1 = scalar.addi %consumed_1, %produced_1 : i32
  func.return %next_1 : i32
}

