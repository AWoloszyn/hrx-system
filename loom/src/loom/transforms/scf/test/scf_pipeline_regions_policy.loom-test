// RUN: pass pipeline-scf-for

func.def @nested_writes_are_not_moved(%input: view<8xf32>, %initial: f32, %condition: i1) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="ordinary loads and pure operations without writes, ordered effects or async groups"}
    %value = scf.if %condition -> (f32) {
      %loaded = view.load %input[%i] : view<8xf32> -> f32
      scf.yield %loaded : f32
    } else {
      scf.for %j = [%begin to %end step %step] {
        view.store %initial, %input[%j] : f32, view<8xf32>
      }
      scf.yield %initial : f32
    }
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ====

func.def @nested_ordered_effect(%input: view<8xf32>, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %value = view.load %input[%i] : view<8xf32> -> f32
    // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="ordinary loads and pure operations without writes, ordered effects or async groups"}
    scf.for %j = [%begin to %end step %step] {
      scf.schedule.fence
    }
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ====

func.def @nested_non_load_read(%input: view<8xi32>, %pool: pool<16>, %initial: i32, %condition: i1) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : i32) -> (i32) pipeline(%depth) {
    // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="ordinary loads and pure operations without writes, ordered effects or async groups"}
    %value = scf.if %condition -> (i32) {
      %loaded = view.load %input[%i] : view<8xi32> -> i32
      scf.yield %loaded : i32
    } else {
      %loaded = test.read_resource %pool : pool<16> -> i32
      scf.yield %loaded : i32
    }
    %next = scalar.addi %sum, %value : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ====

func.def @carried_guard(%input: view<8xf32>, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %identity = scalar.constant 0.0 : f32
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="read-ahead prerequisites independent of loop-carried state"}
    %positive = scalar.cmpf ogt, %sum, %identity : f32
    %value = scf.if %positive -> (f32) {
      %loaded = view.load %input[%i] : view<8xf32> -> f32
      scf.yield %loaded : f32
    } else {
      scf.yield %identity : f32
    }
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ====

func.def @nested_carried_capture(%input: view<8xf32>, %initial: f32, %condition: i1) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="read-ahead prerequisites independent of loop-carried state"}
    %value = scf.if %condition -> (f32) {
      %loaded = view.load %input[%i] : view<8xf32> -> f32
      %added = scalar.addf %sum, %loaded : f32
      scf.yield %added : f32
    } else {
      scf.yield %initial : f32
    }
    scf.yield %value : f32
  }
  func.return %result : f32
}

// ====

func.def @carried_inner_bound(%input: view<8xi32>, %initial: index) -> (index) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %identity = scalar.constant 0 : i32
  %result = scf.for %i = [%begin to %end step %step](%limit = %initial : index) -> (index) pipeline(%depth) {
    // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="read-ahead prerequisites independent of loop-carried state"}
    %partial = scf.for %j = [%begin to %limit step %step](%inner_sum = %identity : i32) -> (i32) {
      %loaded = view.load %input[%j] : view<8xi32> -> i32
      %added = scalar.addi %inner_sum, %loaded : i32
      scf.yield %added : i32
    }
    %next = index.cast %partial : i32 to index
    scf.yield %next : index
  }
  func.return %result : index
}

// ====

func.def @carried_inner_initial_state(%input: view<8xf32>, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="read-ahead prerequisites independent of loop-carried state"}
    %next = scf.for %j = [%begin to %end step %step](%inner_sum = %sum : f32) -> (f32) {
      %loaded = view.load %input[%j] : view<8xf32> -> f32
      %added = scalar.addf %inner_sum, %loaded : f32
      scf.yield %added : f32
    }
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ====

// A carried value used only by a predicate payload still blocks read-ahead.
func.def @carried_nested_predicate(%input: view<8xf32>, %initial: index, %condition: i1) -> (index) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %result = scf.for %i = [%begin to %end step %step](%position = %initial : index) -> (index) pipeline(%depth) {
    // ERROR@+1: STRUCTURE/014 {attr_name="pipeline", expected_constraint="read-ahead prerequisites independent of loop-carried state"}
    %next = scf.if %condition -> (index) {
      %bounded = test.assume %i [lt(%position, %end)] : index
      %loaded = view.load %input[%bounded] : view<8xf32> -> f32
      scf.yield %bounded : index
    } else {
      scf.yield %i : index
    }
    scf.yield %next : index
  }
  func.return %result : index
}
