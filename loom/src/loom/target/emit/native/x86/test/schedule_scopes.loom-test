// RUN: emit x86-asm @paired strategy=resource-stall fixed=%a:physical_register:7:1 fixed=%b:physical_register:6:1 fixed=%output:physical_register:2:1
x86.target<avx512> @target

low.func.def target<x86.avx512.core>(@target) @paired(%a: reg<x86.gpr64>, %b: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  low.schedule.begin
  %a_first = vmovdqu32.load %a {disp32 = 0}
  low.schedule.phase
  %a_consumed = vpaddd %a_first, %a_first
  low.schedule.phase
  %a_second = vmovdqu32.load %a {disp32 = 64}
  %a_result = vpaddd %a_consumed, %a_second
  low.schedule.end
  low.schedule.fence
  low.schedule.begin
  %b_first = vmovdqu32.load %b {disp32 = 0}
  low.schedule.phase
  %b_consumed = vpaddd %b_first, %b_first
  low.schedule.phase
  %b_second = vmovdqu32.load %b {disp32 = 64}
  %b_result = vpaddd %b_consumed, %b_second
  low.schedule.end
  vmovdqu32.store %a_result, %output {disp32 = 0}
  vmovdqu32.store %b_result, %output {disp32 = 64}
  return
}

// ----
  vmovdqu32 zmm0, [rdi]
  vpaddd zmm0, zmm0, zmm0
  vmovdqu32 zmm1, [rdi + 64]
  vpaddd zmm0, zmm0, zmm1
  vmovdqu32 zmm1, [rsi]
  vpaddd zmm1, zmm1, zmm1
  vmovdqu32 zmm2, [rsi + 64]
  vpaddd zmm1, zmm1, zmm2
  vmovdqu32 [rdx], zmm0
  vmovdqu32 [rdx + 64], zmm1
  ret

// ====
// RUN: emit x86-asm @function_phases strategy=resource-stall fixed=%input:physical_register:7:1 fixed=%output:physical_register:6:1
x86.target<avx512> @target

low.func.def schedule(phased) target<x86.avx512.core>(@target) @function_phases(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %first = vmovdqu32.load %input {disp32 = 0}
  %consumed = vpaddd %first, %first
  low.schedule.phase
  %second = vmovdqu32.load %input {disp32 = 64}
  %result = vpaddd %consumed, %second
  vmovdqu32.store %result, %output {disp32 = 0}
  return
}

// ----
  vmovdqu32 zmm0, [rdi]
  vpaddd zmm0, zmm0, zmm0
  vmovdqu32 zmm1, [rdi + 64]
  vpaddd zmm0, zmm0, zmm1
  vmovdqu32 [rsi], zmm0
  ret
