// The numerator remains live across MUL's implicit RAX/RDX writes. A 32-bit
// move still clears the upper half when source and destination alias.
// RUN: emit x86-asm @high_product_with_live_input fixed=%input:physical_register:0:1 fixed=%multiplier:physical_register:8:1 fixed=%result:physical_register:0:1

low.func.def target<x86.scalar.core> @high_product_with_live_input(%input: reg<x86.gpr32>, %multiplier: reg<x86.gpr64>) -> (reg<x86.gpr32>) asm {
  %preserved = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %numerator = movzx.gpr64.gpr32 %preserved
  %accumulator = copy %numerator : reg<x86.gpr64> -> reg<x86.rax>
  %high = mul.high.gpr64 %accumulator, %multiplier
  %wide = copy %high : reg<x86.rdx> -> reg<x86.gpr64>
  %narrow = mov.trunc.gpr32.gpr64 %wide
  %result = add.gpr32 %narrow, %preserved
  return %result
}

// ----
  mov ecx, eax
  mov eax, ecx
  mul r8
  mov eax, edx
  add eax, ecx
  ret

// ====

// A numerator arriving in RDX must be preserved outside the high-result domain.
// RUN: emit x86-asm @high_product_with_live_input fixed=%input:physical_register:2:1 fixed=%multiplier:physical_register:8:1 fixed=%result:physical_register:0:1

low.func.def target<x86.scalar.core> @high_product_with_live_input(%input: reg<x86.gpr32>, %multiplier: reg<x86.gpr64>) -> (reg<x86.gpr32>) asm {
  %preserved = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %numerator = movzx.gpr64.gpr32 %preserved
  %accumulator = copy %numerator : reg<x86.gpr64> -> reg<x86.rax>
  %high = mul.high.gpr64 %accumulator, %multiplier
  %wide = copy %high : reg<x86.rdx> -> reg<x86.gpr64>
  %narrow = mov.trunc.gpr32.gpr64 %wide
  %result = add.gpr32 %narrow, %preserved
  return %result
}

// ----
  mov ecx, edx
  mov eax, ecx
  mul r8
  mov eax, edx
  add eax, ecx
  ret

// ====

// RUN: emit x86-asm @two_products strategy=source fixed=%lhs:physical_register:7:1 fixed=%rhs:physical_register:6:1 fixed=%multiplier:physical_register:8:1 fixed=%result:physical_register:0:1

low.func.def target<x86.scalar.core> @two_products(%lhs: reg<x86.gpr64>, %rhs: reg<x86.gpr64>, %multiplier: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %lhs_accumulator = copy %lhs : reg<x86.gpr64> -> reg<x86.rax>
  %lhs_high = mul.high.gpr64 %lhs_accumulator, %multiplier
  %lhs_result = copy %lhs_high : reg<x86.rdx> -> reg<x86.gpr64>
  %rhs_accumulator = copy %rhs : reg<x86.gpr64> -> reg<x86.rax>
  %rhs_high = mul.high.gpr64 %rhs_accumulator, %multiplier
  %rhs_result = copy %rhs_high : reg<x86.rdx> -> reg<x86.gpr64>
  %sum_input = copy %lhs_result : reg<x86.gpr64> -> reg<x86.gpr64>
  %result = add.gpr64 %sum_input, %rhs_result
  return %result
}

// ----
  mov rax, rdi
  mul r8
  mov rcx, rdx
  mov rax, rsi
  mul r8
  mov rax, rcx
  add rax, rdx
  ret

// ====

