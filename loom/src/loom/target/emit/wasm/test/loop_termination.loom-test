// RUN: with-checks emit wasm-dis
// REQUIRES: wasm-objdump

wasm.target<simd128> @target

// Ordered hashes expose a wrong IV, an extra iteration, and lost final state.
low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @signed_hash(%lower: reg<wasm.i32>, %upper: reg<wasm.i32>, %step: reg<wasm.i32>, %seed: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %multiplier = i32.const 33
  %result = low.scf.for signed [%lower to %upper step %step] iter_args(%seed: reg<wasm.i32>) -> (reg<wasm.i32>) do(%iv: reg<wasm.i32>, %hash: reg<wasm.i32>) {
    %scaled = i32.mul %hash, %multiplier
    %next = i32.add %scaled, %iv
    low.scf.yield %next : reg<wasm.i32>
  }
  return %result
}

// ----
CHECK: <signed_hash>:
CHECK: i32.lt_s
CHECK: i32.lt_u
CHECK: i32.sub
CHECK: f32.select
CHECK: br_if     0
CHECK: br_if     1
CHECK: i32.mul

// ====

wasm.target<simd128> @target

// The same opaque register class covers the entire unsigned 32-bit domain.
low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @unsigned_hash(%lower: reg<wasm.i32>, %upper: reg<wasm.i32>, %step: reg<wasm.i32>, %seed: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %multiplier = i32.const 33
  %result = low.scf.for unsigned [%lower to %upper step %step] iter_args(%seed: reg<wasm.i32>) -> (reg<wasm.i32>) do(%iv: reg<wasm.i32>, %hash: reg<wasm.i32>) {
    %scaled = i32.mul %hash, %multiplier
    %next = i32.add %scaled, %iv
    low.scf.yield %next : reg<wasm.i32>
  }
  return %result
}

// ----
CHECK: <unsigned_hash>:
CHECK: i32.lt_u
CHECK: i32.sub
CHECK: f32.select
CHECK: br_if     0
CHECK: br_if     1
CHECK-NOT: i32.lt_s

// ====

wasm.target<simd128> @target

// Directly yielding the counter must return the last body IV, including when
// the mathematical terminal increment cannot be represented.
low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @last_iv(%lower: reg<wasm.i32>, %upper: reg<wasm.i32>, %step: reg<wasm.i32>, %seed: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %result = low.scf.for signed [%lower to %upper step %step] iter_args(%seed: reg<wasm.i32>) -> (reg<wasm.i32>) do(%iv: reg<wasm.i32>, %previous: reg<wasm.i32>) {
    low.scf.yield %iv : reg<wasm.i32>
  }
  return %result
}

// Parallel state moves must preserve a swap at the final iteration as well as
// on ordinary backedges. A zero-trip loop preserves the initial pair.
low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @swap(%lower: reg<wasm.i32>, %upper: reg<wasm.i32>, %step: reg<wasm.i32>, %left: reg<wasm.i32>, %right: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %result_left, %result_right = low.scf.for signed [%lower to %upper step %step] iter_args(%left: reg<wasm.i32>, %right: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) do(%iv: reg<wasm.i32>, %a: reg<wasm.i32>, %b: reg<wasm.i32>) {
    low.scf.yield %b, %a : reg<wasm.i32>, reg<wasm.i32>
  }
  return %result_left, %result_right
}

// Each nested loop needs its own stopping threshold. The branch result is the
// inner loop's carried value and the outer loop's final yielded value.
low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @nested(%lower: reg<wasm.i32>, %upper: reg<wasm.i32>, %step: reg<wasm.i32>, %seed: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %inner_lower = i32.const 2147483642
  %inner_upper = i32.const 2147483647
  %inner_step = i32.const 2
  %multiplier = i32.const 33
  %result = low.scf.for signed [%lower to %upper step %step] iter_args(%seed: reg<wasm.i32>) -> (reg<wasm.i32>) do(%outer_iv: reg<wasm.i32>, %outer_hash: reg<wasm.i32>) {
    %inner_result = low.scf.for signed [%inner_lower to %inner_upper step %inner_step] iter_args(%outer_hash: reg<wasm.i32>) -> (reg<wasm.i32>) do(%inner_iv: reg<wasm.i32>, %inner_hash: reg<wasm.i32>) {
      %less = i32.lt_u %outer_iv, %inner_iv
      %chosen = low.scf.if %less -> (reg<wasm.i32>) {
        low.scf.yield %outer_iv : reg<wasm.i32>
      } else {
        low.scf.yield %inner_iv : reg<wasm.i32>
      }
      %scaled = i32.mul %inner_hash, %multiplier
      %next = i32.add %scaled, %chosen
      low.scf.yield %next : reg<wasm.i32>
    }
    low.scf.yield %inner_result : reg<wasm.i32>
  }
  return %result
}

// ----
CHECK: <last_iv>:
CHECK: <swap>:
CHECK: <nested>:
CHECK: i32.lt_s
CHECK: i32.lt_u
CHECK: br_if     0
CHECK: br_if     1
CHECK: if
CHECK: else
