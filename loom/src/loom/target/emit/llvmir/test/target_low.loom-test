  %v17 = call i32 @llvm.amdgcn.workgroup.id.z()
  %v18.workgroup_z = zext i32 %v17 to i64
  %v22.size_xy = add i64 64, 1
  %v23.size_xyz = add i64 %v22.size_xy, 1
  %v25 = getelementptr i8, ptr addrspace(1) %v0.input, i64 8
  store i64 %v23.size_xyz, ptr addrspace(1) %v25
  %v26 = call i32 @llvm.amdgcn.workgroup.id.x()
  %v27 = zext i32 %v26 to i64
  %v28 = call i32 @llvm.amdgcn.workitem.id.x()
