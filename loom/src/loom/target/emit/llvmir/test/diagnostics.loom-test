// RUN: emit llvmir-body

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @unsupported_vector_shape(%lhs: vector<32xi32>, %rhs: vector<32xi32>) -> (vector<32xi32>) {
  // ERROR@+1: TARGET/002 {field_name="lhs", actual_type="vector<32xi32>", expected_type="vector<2xi32>"}
  %sum = vector.addi %lhs, %rhs : vector<32xi32>
  func.return %sum : vector<32xi32>
}

// ====

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

// ERROR@+1: TARGET/054 {function_name="multi_result", emitter_key="llvmir.low", subject_kind="function_result", actual_count="2", expected_count="1"}
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @multi_result(%lhs: reg<llvmir.i32>, %rhs: reg<llvmir.i32>) -> (reg<llvmir.i32>, reg<llvmir.i32>) asm {
  %sum = add.i32 %lhs, %rhs
  return %sum, %lhs
}

// ====

llvmir.target<object> @target {triple = "x86_64-unknown-linux-gnu"}

// Pointer registers do not retain an address space across a CFG edge. Source
// view transport carries byte offsets over a dominating buffer instead.
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @pointer_phi(%input: reg<llvmir.ptr>) -> (reg<llvmir.i32>) asm {
  low.br ^body(%input: reg<llvmir.ptr>)
^body(%carried: reg<llvmir.ptr>):
  // ERROR@+1: TARGET/056 {function_name="pointer_phi", value_kind="block_argument", expected_constraint="non-pointer block argument"}
  %value = load.i32 %carried, 0
  return %value
}

// ====

llvmir.target<object> @target {triple = "x86_64-unknown-linux-gnu"}

low.func.def target<llvmir.generic.core>(@target) abi(object_function) @entry_pointer_phi(%input: reg<llvmir.ptr>) asm {
^entry:
  // ERROR@+1: TARGET/056 {function_name="entry_pointer_phi", value_kind="block_argument", expected_constraint="non-pointer block argument"}
  low.br ^entry(%input: reg<llvmir.ptr>)
}
