// RUN: emit llvmir-object @target
// REQUIRES: llc

llvmir.target<object> @target {data_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128", triple = "x86_64-unknown-linux-gnu"}

func.def target(@target) @object_add(%lhs: i32, %rhs: i32) -> (i32) {
  %sum = scalar.addi<nsw> %lhs, %rhs : i32
  func.return %sum : i32
}

