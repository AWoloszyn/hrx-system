// ====

// RUN: emit llvmir-bitcode
// REQUIRES: llvm-dis

llvmir.target<object> @target {triple = "x86_64-unknown-linux-gnu"}

low.func.def target<llvmir.generic.core>(@target) abi(object_function) @entry_cycle(%remaining: reg<llvmir.i32>, %sum: reg<llvmir.i32>) -> (reg<llvmir.i32>) asm {
^entry:
  %zero = const.i32 0
  %one = const.i32 1
  %continue = cmp.sgt.i32 %remaining, %zero
  low.cond_br %continue, ^body, ^exit : reg<llvmir.i1>
^body:
  %next_remaining = sub.i32 %remaining, %one
  %next_sum = add.i32 %sum, %remaining
  low.br ^entry(%next_remaining: reg<llvmir.i32>, %next_sum: reg<llvmir.i32>)
^exit:
  return %sum
}

// ----
target triple = "x86_64-unknown-linux-gnu"

define dso_local i32 @entry_cycle(i32 %remaining, i32 %sum) {
abi:
  br label %entry

entry:                                            ; preds = %body, %abi
  %remaining1 = phi i32 [ %remaining, %abi ], [ %next_remaining, %body ]
  %sum2 = phi i32 [ %sum, %abi ], [ %next_sum, %body ]
  %continue = icmp sgt i32 %remaining1, 0
  br i1 %continue, label %body, label %exit

exit:                                             ; preds = %entry
  ret i32 %sum2

body:                                             ; preds = %entry
  %next_remaining = sub i32 %remaining1, 1
  %next_sum = add i32 %sum2, %remaining1
  br label %entry
}

