// REQUIRES: spirv-dis, spirv-val

// Entries share physical root storage while retaining distinct logical ABIs.
spirv.target<vulkan1_3> @hal_target {abi = hal_kernel}

low.kernel.def target<spirv.logical.core>(@hal_target) workgroup_size(1, 1, 1) @copy(%byte_offset: reg<spirv.offset64>) asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %input_view = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %byte_offset
  %loaded = OpLoad.storage_buffer.i32 %input_view
  %output_view = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %byte_offset
  OpStore.storage_buffer.i32 %output_view, %loaded
  return
}

low.kernel.def target<spirv.logical.core>(@hal_target) workgroup_size(1, 1, 1) @copy_and_add(%byte_offset: reg<spirv.offset64>, %bias: reg<spirv.id : i32>) asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %copy_output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %add_output = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %input_view = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %byte_offset
  %loaded = OpLoad.storage_buffer.i32 %input_view
  %copy_view = OpPtrAccessChain.storage_buffer.i32.byte_offset %copy_output, %byte_offset
  OpStore.storage_buffer.i32 %copy_view, %loaded
  %sum = OpIAdd %loaded, %bias
  %add_view = OpPtrAccessChain.storage_buffer.i32.byte_offset %add_output, %byte_offset
  OpStore.storage_buffer.i32 %add_view, %sum
  return
}

