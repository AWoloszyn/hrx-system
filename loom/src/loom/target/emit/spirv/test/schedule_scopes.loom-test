// RUN: emit spirv-dis
// REQUIRES: spirv-dis

spirv.target<vulkan1_3> @target

low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @required_order() asm {
  // ERROR@+1: BACKEND/047 {op_name="low.schedule.begin", representation="spirv.logical.core"}
  low.schedule.begin
  // ERROR@+1: BACKEND/047 {op_name="low.schedule.step", representation="spirv.logical.core"}
  low.schedule.step
  // ERROR@+1: BACKEND/047 {op_name="low.schedule.end", representation="spirv.logical.core"}
  low.schedule.end
  return
}
