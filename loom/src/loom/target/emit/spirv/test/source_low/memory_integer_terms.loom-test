// The complete coordinate fits i32 although neither the i64 input nor its
// positive bias does. Workgroup arithmetic may project their low bits.
func.def @workgroup_wide_cancellation(%input: i64, %value: i32) -> (i32) {
  %bounded = scalar.assume %input [range(%input, -4294967296, -4294967169)] : i64
  %bias = scalar.constant 4294967296 : i64
  %ordinal = scalar.addi %bounded, %bias : i64
  %position = index.cast %ordinal : i64 to index
  %length = index.constant 512 : offset
  %scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %scratch[%base] : buffer -> view<128xi32>
  view.store %value, %view[%position] : i32, view<128xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %view[%position] : view<128xi32> -> i32
  func.return %loaded : i32
}

