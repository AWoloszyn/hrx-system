func.def @signed_byte_term(%input: i8, %table: buffer) -> (i32) {
  %coordinate = index.cast %input : i8 to index
  %bias = index.constant 128 : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<256xi32>
  %value = view.load %view[%position] : view<256xi32> -> i32
  func.return %value : i32
}

