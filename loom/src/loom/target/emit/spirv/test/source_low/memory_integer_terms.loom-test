// Adding a static displacement to a full-width offset can lose the analyzed
// range without losing representability in the native address carrier.
func.def @offset_with_static_displacement(%base: offset, %table: buffer) -> (i32) {
  %view = buffer.view %table[%base] : buffer -> view<2xi32>
  %value = view.load %view[1] : view<2xi32> -> i32
  func.return %value : i32
}

