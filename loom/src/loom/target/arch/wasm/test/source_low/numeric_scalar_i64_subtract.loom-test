wasm.target<simd128> @target

func.def target(@target) @uniform_subtract(%lhs: i64, %rhs: i64) -> (i64) {
  // ERROR@+1: WASM/001 {op_name="scalar.subi", field_name="lhs", actual_type="i64", required_type="i32 scalar"}
  %difference = scalar.subi %lhs, %rhs : i64
  func.return %difference : i64
}

// ====

wasm.target<simd128> @target

func.def target(@target) @constant_subtract(%value: i64) -> (i64, i64, i64) {
  %c0 = scalar.constant 0 : i64
  %wide = scalar.constant 4294967297 : i64
  // ERROR@+1: WASM/001 {op_name="scalar.subi", field_name="lhs", actual_type="i64", required_type="i32 scalar"}
  %negated = scalar.subi %c0, %value : i64
  // ERROR@+1: WASM/001 {op_name="scalar.subi", field_name="lhs", actual_type="i64", required_type="i32 scalar"}
  %constant_left = scalar.subi %wide, %value : i64
  // ERROR@+1: WASM/001 {op_name="scalar.addi", field_name="lhs", actual_type="i64", required_type="i32 scalar"}
  %constant_right = scalar.subi %value, %wide : i64
  func.return %negated, %constant_left, %constant_right : i64, i64, i64
}

// ====

wasm.target<simd128> @target

func.def target(@target) @mixed_subtract(%uniform: i64, %values: vector<2xi64>) -> (i64, i64) {
  // ERROR@+1: WASM/001 {op_name="vector.extract", field_name="source", actual_type="vector<2xi64>", required_type="vector<4xi32>"}
  %varying = vector.extract %values[0] : vector<2xi64> -> i64
  // ERROR@+1: WASM/001 {op_name="scalar.subi", field_name="lhs", actual_type="i64", required_type="i32 scalar"}
  %uniform_left = scalar.subi %uniform, %varying : i64
  // ERROR@+1: WASM/001 {op_name="scalar.subi", field_name="lhs", actual_type="i64", required_type="i32 scalar"}
  %uniform_right = scalar.subi %varying, %uniform : i64
  func.return %uniform_left, %uniform_right : i64, i64
}
