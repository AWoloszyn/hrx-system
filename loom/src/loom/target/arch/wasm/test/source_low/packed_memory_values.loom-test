  %71 = i32.load8_u %source_view {offset = 12}
  %72 = i32.load8_u %source_view {offset = 13}
  %73 = i32.load8_u %source_view {offset = 14}
  %74 = i32.load8_u %source_view {offset = 15}
  i32.store8 %output_view, %59
  i32.store8 %output_view, %60 {offset = 1}
  i32.store8 %output_view, %61 {offset = 2}
  i32.store8 %output_view, %62 {offset = 3}
  i32.store8 %output_view, %63 {offset = 4}
  i32.store8 %output_view, %64 {offset = 5}
  i32.store8 %output_view, %65 {offset = 6}
  i32.store8 %output_view, %66 {offset = 7}
