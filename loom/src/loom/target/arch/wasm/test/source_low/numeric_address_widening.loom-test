// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_address_widening.loom-test
// RUN: emit source-low output=low

wasm.target<simd128> @target

func.def target(@target) @widen_address_domains(%coordinate: index, %byte_offset: offset) -> (i64, i64) {
  %signed = index.cast %coordinate : index to i64
  %unsigned = index.cast %byte_offset : offset to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @widen_address_domains(%coordinate: reg<wasm.i32>, %byte_offset: reg<wasm.i32>) -> (reg<wasm.i64>, reg<wasm.i64>) asm {
  %signed = i64.extend_i32_s %coordinate
  %unsigned = i64.extend_i32_u %byte_offset
  return %signed, %unsigned
}

// ====

wasm.target<simd128> @target

func.def target(@target) @widen_address_payload(%input: i32) -> (i64, i64) {
  %coordinate = index.cast %input : i32 to index
  %byte_offset = index.cast %input : i32 to offset
  %signed = index.cast %coordinate : index to i64
  %unsigned = index.cast %byte_offset : offset to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @widen_address_payload(%byte_offset: reg<wasm.i32>) -> (reg<wasm.i64>, reg<wasm.i64>) asm {
  %signed = i64.extend_i32_s %byte_offset
  %unsigned = i64.extend_i32_u %byte_offset
  return %signed, %unsigned
}

// ====

wasm.target<simd128> @target

func.def target(@target) @widen_constant_addresses() -> (i64, i64, i64, i64) {
  %high_bit = scalar.constant -2147483648 : i32
  %all_bits = scalar.constant -1 : i32
  %minimum_index = index.cast %high_bit : i32 to index
  %negative_index = index.cast %all_bits : i32 to index
  %high_bit_offset = index.cast %high_bit : i32 to offset
  %maximum_offset = index.cast %all_bits : i32 to offset
  %minimum = index.cast %minimum_index : index to i64
  %negative = index.cast %negative_index : index to i64
  %high = index.cast %high_bit_offset : offset to i64
  %maximum = index.cast %maximum_offset : offset to i64
  func.return %minimum, %negative, %high, %maximum : i64, i64, i64, i64
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @widen_constant_addresses() -> (reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>) asm {
  %minimum = i64.const -2147483648
  %negative = i64.const -1
  %high = i64.const 2147483648
  %maximum = i64.const 4294967295
  return %minimum, %negative, %high, %maximum
}
