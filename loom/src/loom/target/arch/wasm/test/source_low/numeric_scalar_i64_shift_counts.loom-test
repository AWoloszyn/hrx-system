// ====

wasm.target<simd128> @target

func.def target(@target) @wide_right_shift_uniform(%value: i64, %count: i64) -> (i64, i64) {
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  func.return %logical, %signed : i64, i64
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @wide_right_shift_uniform(%value: reg<wasm.i64>, %count: reg<wasm.i64>) -> (reg<wasm.i64>, reg<wasm.i64>) asm {
  %logical = i64.shr_u %value, %count
  %signed = i64.shr_s %value, %count
  return %logical, %signed
}

