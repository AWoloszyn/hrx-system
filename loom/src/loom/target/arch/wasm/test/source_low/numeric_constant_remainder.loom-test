// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_constant_remainder.loom-test
// RUN: emit source-low output=low

wasm.target<simd128> @target

func.def target(@target) @constant_remainder_uniform(%value: i32) -> (i32) {
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  func.return %remainder : i32
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @constant_remainder_uniform(%value: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %divisor = i32.const 3
  %remainder = i32.rem_u %value, %divisor
  return %remainder
}

// ====

wasm.target<simd128> @target

func.def target(@target) @constant_remainder_loaded(%input: buffer) -> (i32, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  // ERROR@+1: TARGET/001 {op_name="view.load"}
  %value = view.load %input_view[0] : view<1xi32> -> i32
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  %mask = scalar.constant 2147483647 : i32
  %nonnegative = scalar.andi %value, %mask : i32
  // ERROR@+1: TARGET/001 {op_name="index.cast"}
  %position = index.cast %nonnegative : i32 to index
  %index_divisor = index.constant 3 : index
  %index_remainder = index.rem %position, %index_divisor : index
  func.return %remainder, %index_remainder : i32, index
}
