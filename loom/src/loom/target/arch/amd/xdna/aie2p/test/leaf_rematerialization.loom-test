// Thirteen 512-bit broadcasts exceed the 24 vector-register units at the
// block boundary. The repaired native program streams each broadcast into
// the running sum instead of retaining the entire invariant set.
// RUN: emit aie2p-leaf @broadcast_pressure report=emission

low.func.def target<amd.xdna.aie2p.core> @broadcast_pressure(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>) asm {
  %scalar0 = mov.i32 1
  %vector0 = vbcst.32 %scalar0
  %scalar1 = mov.i32 2
  %vector1 = vbcst.32 %scalar1
  %scalar2 = mov.i32 3
  %vector2 = vbcst.32 %scalar2
  %scalar3 = mov.i32 4
  %vector3 = vbcst.32 %scalar3
  %scalar4 = mov.i32 5
  %vector4 = vbcst.32 %scalar4
  %scalar5 = mov.i32 6
  %vector5 = vbcst.32 %scalar5
  %scalar6 = mov.i32 7
  %vector6 = vbcst.32 %scalar6
  %scalar7 = mov.i32 8
  %vector7 = vbcst.32 %scalar7
  %scalar8 = mov.i32 9
  %vector8 = vbcst.32 %scalar8
  %scalar9 = mov.i32 10
  %vector9 = vbcst.32 %scalar9
  %scalar10 = mov.i32 11
  %vector10 = vbcst.32 %scalar10
  %scalar11 = mov.i32 12
  %vector11 = vbcst.32 %scalar11
  %scalar12 = mov.i32 13
  %vector12 = vbcst.32 %scalar12
  low.br ^consume
^consume:
  %input_value = vlda.512.i32x16 %input, 0
  %sum0 = vadd.32 %input_value, %vector0
  %sum1 = vadd.32 %sum0, %vector1
  %sum2 = vadd.32 %sum1, %vector2
  %sum3 = vadd.32 %sum2, %vector3
  %sum4 = vadd.32 %sum3, %vector4
  %sum5 = vadd.32 %sum4, %vector5
  %sum6 = vadd.32 %sum5, %vector6
  %sum7 = vadd.32 %sum6, %vector7
  %sum8 = vadd.32 %sum7, %vector8
  %sum9 = vadd.32 %sum8, %vector9
  %sum10 = vadd.32 %sum9, %vector10
  %sum11 = vadd.32 %sum10, %vector11
  %sum12 = vadd.32 %sum11, %vector12
  vst.512.i32x16 %sum12, %output, 0
  return
}

