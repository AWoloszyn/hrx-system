// RUN: emit aie2p-array-plan @external_group

aie2p.target<array> @array_target

aie2p.target<core> @core_target

// ERROR@+1: TARGET/054 {function_name="external_group", emitter_key="aie2p-array-plan", subject_kind="register argument", actual_count="1", expected_count="0"}
low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @external_group(%external: reg<aie2p.array.group>) asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker = worker %external, %zero, @worker
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @worker() asm {
  return
}

