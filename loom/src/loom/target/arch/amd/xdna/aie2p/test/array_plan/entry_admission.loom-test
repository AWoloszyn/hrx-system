// ====
// RUN: verify

aie2p.target<array> @array_target

low.func.def target<amd.xdna.aie2p.array>(@array_target) @untyped_channel() asm {
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %input = binding 0, "read"
  %output = binding 1, "write"
  %sender = sender %input, 0 : reg<aie2p.array.sender : tile<1xf32>>
  %receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<1xf32>>
  // ERROR@+1: TARGET/124 {descriptor="amd.xdna.aie2p.array.channel", result_type="reg<aie2p.array.channel>"}
  %channel = channel %sender, %receiver, %one, %one
  return
}

