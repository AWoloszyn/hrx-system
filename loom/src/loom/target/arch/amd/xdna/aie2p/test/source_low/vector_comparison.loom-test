  %49 = predicate.or.high32 %45, %47, %48
  %50 = mov.short 0
  %51 = vbcst.32 %50
  %52 = mov.i32 -2147483648
  %53 = vbcst.32 %52
  %54 = mov.short -1
  %55 = vbcst.32 %54
  %56 = vsub.32 %40, %51
  %57 = veqz.32.el.low32 %56
  %58 = predicate.complete.zero.high32 %57, 0
  %59 = vsel.32.mask64 %lhs, %51, %58
  %60 = vlt.s32x16.el.low32 %59, %51
  %61 = predicate.complete.zero.high32 %60, 0
  %62 = vadd.32 %59, %53
  %63 = vsub.32 %55, %59
  %64 = vsel.32.mask64 %62, %63, %61
  %65 = vsub.32 %41, %51
  %66 = veqz.32.el.low32 %65
  %67 = predicate.complete.zero.high32 %66, 0
  %68 = vsel.32.mask64 %rhs, %51, %67
  %69 = vlt.s32x16.el.low32 %68, %51
  %70 = predicate.complete.zero.high32 %69, 0
  %71 = vadd.32 %68, %53
  %72 = vsub.32 %55, %68
  %73 = vsel.32.mask64 %71, %72, %70
  %74 = vlt.u32x16.el.low32 %64, %73
  %75 = predicate.complete.zero.high32 %74, 0
  %76 = predicate.and.low32 %75, %49
  %77 = predicate.and.high32 %75, %49, %76
  %78 = predicate.xor.low32 %75, %77
  %mask = predicate.xor.high32 %75, %77, %78
  %80 = mov.short 1
  %81 = vbcst.32 %80
  %result = vsel.32.mask64 %51, %81, %mask
  return %result
}
