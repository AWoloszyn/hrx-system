// TEMPLATE: loom/src/loom/test/corpus/source_low/vector_comparison.loom-test
// TEMPLATE-EXCLUDE: @wide_integer_comparison AIE2P supports vector comparison elements up to 32 bits.
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @signed_byte_comparison(%lhs: vector<4xi8>, %rhs: vector<4xi8>) -> (vector<4xi32>) {
  %mask = vector.cmpi slt, %lhs, %rhs : vector<4xi8> -> vector<4xi1>
  %result = vector.extui %mask : vector<4xi1> to vector<4xi32>
  func.return %result : vector<4xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @signed_byte_comparison(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %mask = vlt.s8x64 %lhs, %rhs
  %12 = mov.short 1
  %13 = vbcst.32 %12
  %14 = mov.short 0
  %15 = vbcst.32 %14
  %result = vsel.32.mask64 %15, %13, %mask
  return %result
}

// ====

func.def @unsigned_byte_comparison(%lhs: vector<4xi8>, %rhs: vector<4xi8>) -> (vector<4xi32>) {
  %mask = vector.cmpi ule, %lhs, %rhs : vector<4xi8> -> vector<4xi1>
  %result = vector.extui %mask : vector<4xi1> to vector<4xi32>
  func.return %result : vector<4xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @unsigned_byte_comparison(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %mask = vge.u8x64 %rhs, %lhs
  %12 = mov.short 1
  %13 = vbcst.32 %12
  %14 = mov.short 0
  %15 = vbcst.32 %14
  %result = vsel.32.mask64 %15, %13, %mask
  return %result
}

// ====

func.def @signed_halfword_comparison(%lhs: vector<2xi16>, %rhs: vector<2xi16>) -> (vector<2xi32>) {
  %mask = vector.cmpi sge, %lhs, %rhs : vector<2xi16> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @signed_halfword_comparison(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %11 = vge.s16x32.el.low32 %lhs, %rhs
  %mask = predicate.complete.zero.high32 %11, 0
  %13 = mov.short 1
  %14 = vbcst.32 %13
  %15 = mov.short 0
  %16 = vbcst.32 %15
  %result = vsel.32.mask64 %16, %14, %mask
  return %result
}

// ====

func.def @halfword_equality(%lhs: vector<2xi16>, %rhs: vector<2xi16>) -> (vector<2xi32>) {
  %mask = vector.cmpi eq, %lhs, %rhs : vector<2xi16> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @halfword_equality(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %11 = vsub.16 %lhs, %rhs
  %12 = veqz.16.el.low32 %11
  %mask = predicate.complete.zero.high32 %12, 0
  %14 = mov.short 1
  %15 = vbcst.32 %14
  %16 = mov.short 0
  %17 = vbcst.32 %16
  %result = vsel.32.mask64 %17, %15, %mask
  return %result
}

// ====

func.def @floating_comparison_flags(%lhs: vector<2xf32>, %rhs: vector<2xf32>) -> (vector<2xi32>) {
  %mask = vector.cmpf<nnan|ninf> olt, %lhs, %rhs : vector<2xf32> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @floating_comparison_flags(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %38 = mov.i32 2147483647
  %39 = vbcst.32 %38
  %40 = vband %lhs, %39
  %41 = vband %rhs, %39
  %42 = mov.i32 2139095040
  %43 = vbcst.32 %42
  %44 = vlt.u32x16.el.low32 %43, %40
