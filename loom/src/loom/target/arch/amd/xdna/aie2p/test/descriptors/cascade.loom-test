// Every cascade read consumes a stream value, including unused results.
// Repeated writes transmit repeated payloads and retain their protocol order.
// RUN: with-low-asm pass low-cse,low-dce

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @forward_vectors() asm {
  set.scd-enable 1
  set.mcd-enable 1
  %discarded = vmov.scd
  %first = vmov.scd
  %second = vmov.scd
  vmov.mcd %first
  vmov.mcd %first
  vmov.mcd %second
  return
}

// ====

// Accumulator payloads use the same native 512-bit link without conversion.
// Memory publication and cascade effects remain individually observable.
// RUN: with-low-asm pass low-cse,low-dce

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @forward_accumulators(%output: reg<aie2p.ep>) asm {
  set.scd-enable 1
  set.mcd-enable 1
  %discarded = vmov.scd.acc
  %value = vmov.scd.acc
  vst.acc %value, %output, 0
  vmov.mcd.acc %value
  vmov.mcd.acc %value
  return
}

// ====

// Expansion remains a protocol effect even when every accumulator is unused.
// Constant selectors produce complete aggregates without a previous value.
// RUN: with-low-asm pass low-cse,low-dce

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @discard_expansions() asm {
  set.scd-enable 1
  %low = vmov.scd.expand.1024.0
  %high = vmov.scd.expand.1024.1
  %first = vmov.scd.expand.2048.0
  %second = vmov.scd.expand.2048.1
  %third = vmov.scd.expand.2048.2
  %fourth = vmov.scd.expand.2048.3
  return
}

// ====

// The selected quarter and increment are ordinary fixed-register SSA values.
// A following read observes both the updated selector and stream position.
// RUN: with-low-asm pass low-cse,low-dce

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @advance_selector(%position: reg<aie2p.mr31_scd>, %output: reg<aie2p.ep>) -> (reg<aie2p.mr31_scd>) asm {
  set.scd-enable 1
  set.mcd-enable 1
  %discarded, %next_position = vmov.scd.expand.2048.increment %position
  %value = vmov.scd.expand.2048 %next_position
  %low = slice %value[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %high = slice %value[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %low, %output, 0
  vmov.mcd.acc %high
  return %next_position
}

// ====

// Fused arithmetic consumes the selected stream item even when its result is
// unused. Accumulator inputs remain live independently of the new result.
// RUN: with-low-asm pass low-cse,low-dce

low.func.def target<amd.xdna.aie2p.core> @integer_partial_sums(%resident: reg<aie2p.mbms x4>, %position: reg<aie2p.mr31_scd>, %configuration: reg<aie2p.er>, %output: reg<aie2p.ep>) -> (reg<aie2p.mbms x4>, reg<aie2p.mr31_scd>) asm {
  set.scd-enable 1
  %discarded = vadd.acc.integer.scd %resident, %position, %configuration
  %first = vadd.acc.integer.scd %resident, %position, %configuration
  %second = vsub.acc.integer.scd %first, %position, %configuration
  %third, %next_position = vadd.acc.integer.scd.increment %second, %position, %configuration
  %fourth, %final_position = vsub.acc.integer.scd.increment %third, %next_position, %configuration
  %old_quarter = slice %resident[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %old_quarter, %output, 0
  return %fourth, %final_position
}

// ====

// Floating forms preserve the same protocol and explicit selector recurrence.
// A following ordinary read observes the position left by both fused updates.
// RUN: with-low-asm pass low-cse,low-dce

low.func.def target<amd.xdna.aie2p.core> @floating_partial_sums(%resident: reg<aie2p.mbms x4>, %position: reg<aie2p.mr31_scd>, %configuration: reg<aie2p.er>) -> (reg<aie2p.mbms x4>, reg<aie2p.mr31_scd>, reg<aie2p.vec256 x2>) asm {
  set.scd-enable 1
  %discarded = vadd.acc.floating.scd %resident, %position, %configuration
  %first = vadd.acc.floating.scd %resident, %position, %configuration
  %second = vsub.acc.floating.scd %first, %position, %configuration
  %third, %next_position = vadd.acc.floating.scd.increment %second, %position, %configuration
  %fourth, %final_position = vsub.acc.floating.scd.increment %third, %next_position, %configuration
  %following = vmov.scd
  return %fourth, %final_position, %following
}

// ====

// A matrix consumes its working accumulator; an explicit copy keeps the source
// live. The unused final result retains its stream effect and r31 update.
// RUN: with-low-asm pass low-cse,low-dce

low.func.def target<amd.xdna.aie2p.core> @integer_x_x_cascade(%left: reg<aie2p.vec256 x2>, %right: reg<aie2p.vec256 x2>, %resident: reg<aie2p.mbms x4>, %position: reg<aie2p.mr31_scd>, %configuration: reg<aie2p.er>) -> (reg<aie2p.mbms x4>, reg<aie2p.mr31_scd>) asm {
  set.scd-enable 1
  %working = copy %resident : reg<aie2p.mbms x4> -> reg<aie2p.mbms x4>
  %first = maddmac.integer.x-x.scd %working, %position, %left, %right, %configuration
  %second = maddmsc.integer.x-x.scd %first, %position, %left, %right, %configuration
  %third, %next_position = maddmac.integer.x-x.scd.increment %second, %position, %left, %right, %configuration
  %discarded, %final_position = maddmsc.integer.x-x.scd.increment %third, %next_position, %left, %right, %configuration
  return %resident, %final_position
}

