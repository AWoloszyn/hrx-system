aie2p.target<core> @target

func.def target(@target) @wide_shift_word_boundaries(%value: i64) -> (i64, i64, i64, i64) {
  %identity_count = scalar.constant 0 : i64
  %last_low = scalar.constant 31 : i64
  %first_high = scalar.constant 32 : i64
  %last_high = scalar.constant 63 : i64
  %unchanged = scalar.shli %value, %identity_count : i64
  %low_edge = scalar.shli %value, %last_low : i64
  %high_edge = scalar.shli %value, %first_high : i64
  %top_bit = scalar.shli %value, %last_high : i64
  func.return %unchanged, %low_edge, %high_edge, %top_bit : i64, i64, i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @wide_shift_word_boundaries(%value: reg<aie2p.er x2>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %18 = mov.i32 31
  %21 = mov.i32 32
  %24 = mov.i32 63
  %27 = slice %value[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %28 = slice %value[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %30 = add %18, -32
  %31 = lshl %27, %18
  %32 = lshl %28, %18
  %33 = lshl %27, %30
  %34 = or %32, %33
  %low_edge = concat(%31, %34) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %39 = add %21, -32
  %40 = mov.short 0
  %41 = lshl %27, %39
  %high_edge = concat(%40, %41) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %46 = add %24, -32
  %48 = lshl %27, %46
  %top_bit = concat(%40, %48) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %value, %low_edge, %high_edge, %top_bit
}

