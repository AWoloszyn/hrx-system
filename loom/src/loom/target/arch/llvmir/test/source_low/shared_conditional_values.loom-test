// TEMPLATE: loom/src/loom/test/corpus/source_low/shared_conditional_values.loom-test
// RUN: emit source-low output=low

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @shared_conditional_values(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = scalar.constant 0 : i32
  %completed = scalar.constant 1 : i32
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %in = buffer.view %aligned_input[%base] : buffer -> view<3xi32>
  %out = buffer.view %aligned_output[%base] : buffer -> view<3xi32>
  %outer_value = view.load %in[0] : view<3xi32> -> i32
  %outer = scalar.cmpi ne, %outer_value, %c0 : i32
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %loaded = view.load %in[1] : view<3xi32> -> i32
  view.store %loaded, %out[0] : i32, view<3xi32>
  %inner = scalar.cmpi ne, %loaded, %c0 : i32
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %result = scalar.addi %loaded, %loaded : i32
  view.store %result, %out[1] : i32, view<3xi32>
  cfg.br ^exit
^fallback:
  %fallback = view.load %in[2] : view<3xi32> -> i32
  view.store %fallback, %out[1] : i32, view<3xi32>
  cfg.br ^exit
^exit:
  view.store %completed, %out[2] : i32, view<3xi32>
  func.return
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @shared_conditional_values(%in: reg<llvmir.ptr>, %out: reg<llvmir.ptr>) asm {
  %c0 = const.i32 0
  %completed = const.i32 1
  %outer_value = load.i32 %in, 0
  %outer = cmp.ne.i32 %outer_value, %c0
  low.cond_br %outer, ^evaluate, ^fallback : reg<llvmir.i1>
^evaluate:
  %loaded = load.i32 %in, 4
  store.i32 %loaded, %out, 0
  %inner = cmp.ne.i32 %loaded, %c0
  low.cond_br %inner, ^selected, ^fallback : reg<llvmir.i1>
^selected:
  %result = add.i32 %loaded, %loaded
  store.i32 %result, %out, 4
  low.br ^exit
^fallback:
  %fallback = load.i32 %in, 8
  store.i32 %fallback, %out, 4
  low.br ^exit
^exit:
  store.i32 %completed, %out, 8
  return
}
