// RUN: emit source-low output=low

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @unsupported_vector_shape(%lhs: vector<32xi32>, %rhs: vector<32xi32>) -> (vector<32xi32>) {
  // ERROR@+1: TARGET/002 {field_name="lhs", actual_type="vector<32xi32>", expected_type="vector<2xi32>"}
  %sum = vector.addi %lhs, %rhs : vector<32xi32>
  func.return %sum : vector<32xi32>
}

// ====

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @unsupported_source_op(%lhs: i32, %rhs: i32) -> (i32) {
  // ERROR@+1: TARGET/001 {op_name="scalar.ceildivsi"}
  %quotient = scalar.ceildivsi %lhs, %rhs : i32
  func.return %quotient : i32
}

// ====

llvmir.target<object> @target {triple = "x86_64-unknown-linux-gnu"}

func.def target(@target) @negative_i64_offset() -> (offset) {
  %source = scalar.constant -6 : i64
  // ERROR@+1: TARGET/005 {op_name="index.cast", subject_role="operand", subject_name="input", constraint_key="index_cast.offset_non_negative", minimum="0", maximum="9223372036854775807"}
  %result = index.cast %source : i64 to offset
  func.return %result : offset
}

// ====

llvmir.target<object> @target {triple = "x86_64-unknown-linux-gnu"}

func.def target(@target) @offset_requires_source_proof(%input: i64) -> (offset) {
  // ERROR@+1: TARGET/005 {op_name="index.cast", subject_role="operand", subject_name="input", constraint_key="index_cast.offset_non_negative", minimum="0", maximum="9223372036854775807"}
  %result = index.cast %input : i64 to offset
  func.return %result : offset
}

// ====

llvmir.target<object> @target {triple = "x86_64-unknown-linux-gnu"}

func.def target(@target) @result_assumption_does_not_prove_source(%input: i64) -> (offset) {
  // ERROR@+1: TARGET/005 {op_name="index.cast", subject_role="operand", subject_name="input", constraint_key="index_cast.offset_non_negative", minimum="0", maximum="9223372036854775807"}
  %converted = index.cast %input : i64 to offset
  %result = index.assume %converted [range(%converted, 0, 1023)] : offset
  func.return %result : offset
}

// ====

llvmir.target<object> @target {triple = "x86_64-unknown-linux-gnu"}

func.def target(@target) @negative_index_offset(%input: index) -> (offset) {
  %negative = index.assume %input [range(%input, -7, -1)] : index
  // ERROR@+1: TARGET/005 {op_name="index.cast", subject_role="operand", subject_name="input", constraint_key="index_cast.offset_non_negative", minimum="0", maximum="9223372036854775807"}
  %result = index.cast %negative : index to offset
  func.return %result : offset
}
