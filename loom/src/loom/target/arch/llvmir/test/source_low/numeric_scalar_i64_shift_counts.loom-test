low.func.def target<llvmir.generic.core>(@target) abi(object_function) @wide_shift_uniform(%values: reg<llvmir.i64 x2>, %count: reg<llvmir.i64>) -> (reg<llvmir.i64>) asm {
  %value = extract.v2i64 %values, 0
