llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @wide_shift_varying(%values: vector<2xi64>, %counts: vector<2xi64>) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %count = vector.extract %counts[0] : vector<2xi64> -> i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @wide_shift_varying(%values: reg<llvmir.i64 x2>, %counts: reg<llvmir.i64 x2>) -> (reg<llvmir.i64>) asm {
  %value = extract.v2i64 %values, 0
  %count = extract.v2i64 %counts, 0
  %shifted = shl.i64 %value, %count
  return %shifted
}
