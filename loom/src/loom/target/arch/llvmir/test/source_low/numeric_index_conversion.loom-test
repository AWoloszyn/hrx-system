// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_index_conversion.loom-test
// RUN: emit source-low output=low

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @index_constants() -> (index, index, offset) {
  %minimum = index.constant -2147483648 : index
  %maximum = index.constant 2147483647 : index
  %byte_limit = index.constant 9223372036854775807 : offset
  func.return %minimum, %maximum, %byte_limit : index, index, offset
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @index_constants() -> (reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i64>) asm {
  %minimum = const.i64 -2147483648
  %maximum = const.i64 2147483647
  %byte_limit = const.i64 9223372036854775807
  return %minimum, %maximum, %byte_limit
}

// ====

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @index_assume_ordinals(%coordinate0: index, %byte_offset0: offset) -> (index, offset) {
  %coordinate, %byte_offset = index.assume %coordinate0, %byte_offset0 [range(%coordinate0, 0, 1024), range(%byte_offset0, 0, 4096)] : index, offset
  func.return %coordinate, %byte_offset : index, offset
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @index_assume_ordinals(%coordinate: reg<llvmir.i64>, %byte_offset: reg<llvmir.i64>) -> (reg<llvmir.i64>, reg<llvmir.i64>) asm {
  return %coordinate, %byte_offset
}

// ====

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @boolean_address_cast_family(%flag: i1, %coordinate: index, %byte_offset: offset) -> (index, offset, i1, i1) {
  %flag_index = index.cast %flag : i1 to index
  %flag_offset = index.cast %flag : i1 to offset
  %index_low_bit = index.cast %coordinate : index to i1
  %offset_low_bit = index.cast %byte_offset : offset to i1
  func.return %flag_index, %flag_offset, %index_low_bit, %offset_low_bit : index, offset, i1, i1
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @boolean_address_cast_family(%flag: reg<llvmir.i1>, %coordinate: reg<llvmir.i64>, %byte_offset: reg<llvmir.i64>) -> (reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i1>, reg<llvmir.i1>) asm {
  %flag_index = zext.i1.i64 %flag
  %index_low_bit = trunc.i64.i1 %coordinate
  %offset_low_bit = trunc.i64.i1 %byte_offset
  return %flag_index, %flag_index, %index_low_bit, %offset_low_bit
}

// ====

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @index_payload_cast_family(%i8: i8, %i16: i16, %i32: i32, %i64_raw: i64, %coordinate: index) -> (index, index, index, index, i8, i16, i32, i64) {
  %i64 = scalar.assume %i64_raw [range(%i64_raw, -2147483648, 2147483647)] : i64
  %from_i8 = index.cast %i8 : i8 to index
  %from_i16 = index.cast %i16 : i16 to index
  %from_i32 = index.cast %i32 : i32 to index
  %from_i64 = index.cast %i64 : i64 to index
  %to_i8 = index.cast %coordinate : index to i8
  %to_i16 = index.cast %coordinate : index to i16
  %to_i32 = index.cast %coordinate : index to i32
  %to_i64 = index.cast %coordinate : index to i64
  func.return %from_i8, %from_i16, %from_i32, %from_i64, %to_i8, %to_i16, %to_i32, %to_i64 : index, index, index, index, i8, i16, i32, i64
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @index_payload_cast_family(%i8: reg<llvmir.i8>, %i16: reg<llvmir.i16>, %i32: reg<llvmir.i32>, %from_i64: reg<llvmir.i64>, %to_i64: reg<llvmir.i64>) -> (reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i8>, reg<llvmir.i16>, reg<llvmir.i32>, reg<llvmir.i64>) asm {
  %from_i8 = sext.i8.i64 %i8
  %from_i16 = sext.i16.i64 %i16
  %from_i32 = sext.i32.i64 %i32
  %to_i8 = trunc.i64.i8 %to_i64
  %to_i16 = trunc.i64.i16 %to_i64
  %to_i32 = trunc.i64.i32 %to_i64
  return %from_i8, %from_i16, %from_i32, %from_i64, %to_i8, %to_i16, %to_i32, %to_i64
}

// ====

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @offset_payload_cast_family(%i8: i8, %i16: i16, %i32: i32, %i64_raw: i64, %byte_offset: offset) -> (offset, offset, offset, offset, i8, i16, i32, i64) {
  %i64 = scalar.assume %i64_raw [range(%i64_raw, 0, 9223372036854775807)] : i64
  %from_i8 = index.cast %i8 : i8 to offset
  %from_i16 = index.cast %i16 : i16 to offset
  %from_i32 = index.cast %i32 : i32 to offset
  %from_i64 = index.cast %i64 : i64 to offset
  %to_i8 = index.cast %byte_offset : offset to i8
  %to_i16 = index.cast %byte_offset : offset to i16
  %to_i32 = index.cast %byte_offset : offset to i32
  %to_i64 = index.cast %byte_offset : offset to i64
  func.return %from_i8, %from_i16, %from_i32, %from_i64, %to_i8, %to_i16, %to_i32, %to_i64 : offset, offset, offset, offset, i8, i16, i32, i64
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @offset_payload_cast_family(%i8: reg<llvmir.i8>, %i16: reg<llvmir.i16>, %i32: reg<llvmir.i32>, %from_i64: reg<llvmir.i64>, %to_i64: reg<llvmir.i64>) -> (reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i8>, reg<llvmir.i16>, reg<llvmir.i32>, reg<llvmir.i64>) asm {
  %from_i8 = zext.i8.i64 %i8
  %from_i16 = zext.i16.i64 %i16
  %from_i32 = zext.i32.i64 %i32
  %to_i8 = trunc.i64.i8 %to_i64
  %to_i16 = trunc.i64.i16 %to_i64
  %to_i32 = trunc.i64.i32 %to_i64
  return %from_i8, %from_i16, %from_i32, %from_i64, %to_i8, %to_i16, %to_i32, %to_i64
}

// ====

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @address_domain_cast_family(%coordinate0: index, %byte_offset0: offset) -> (offset, index) {
  %coordinate, %byte_offset = index.assume %coordinate0, %byte_offset0 [range(%coordinate0, 0, 2147483647), range(%byte_offset0, 0, 2147483647)] : index, offset
  %as_offset = index.cast %coordinate : index to offset
  %as_index = index.cast %byte_offset : offset to index
  func.return %as_offset, %as_index : offset, index
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @address_domain_cast_family(%as_offset: reg<llvmir.i64>, %as_index: reg<llvmir.i64>) -> (reg<llvmir.i64>, reg<llvmir.i64>) asm {
  return %as_offset, %as_index
}
