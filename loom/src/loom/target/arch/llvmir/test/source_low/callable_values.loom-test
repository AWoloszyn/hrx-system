llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def public target(@target) @call_scalar(%value: i32, %delta: i32) -> (i32) {
  %result = func.call @scalar_add(%value, %delta) : (i32, i32) -> (i32)
  func.return %result : i32
}

func.def @scalar_add(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<llvmir.generic.core>(@target) abi(object_function) @call_scalar(%value: reg<llvmir.i32>, %delta: reg<llvmir.i32>) -> (reg<llvmir.i32>) asm {
  %result = add.i32 %value, %delta
  return %result
}
