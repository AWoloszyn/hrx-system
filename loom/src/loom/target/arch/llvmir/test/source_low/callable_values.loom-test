llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def public target(@target) @call_vector_result(%input: i32, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %values = vector.from_elements %input, %c1, %c2, %c3 : vector<4xi32>
  %result = func.call @select_lane(%values, %lane) : (vector<4xi32>, index) -> (i32)
  func.return %result : i32
}

func.def @select_lane(%values: vector<4xi32>, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %result = vector.extract %values[%lane] : vector<4xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def public target<llvmir.generic.core>(@target) abi(object_function) @call_vector_result(%input: reg<llvmir.i32>, %lane: reg<llvmir.i64>) -> (reg<llvmir.i32>) where [range(%lane, 0, 3)] asm {
  %c1 = const.i32 1
  %c2 = const.i32 2
  %c3 = const.i32 3
  %values = from_elements.v4i32 %input, %c1, %c2, %c3
  %result = extract.dynamic.v4i32 %values, %lane
  return %result
}

