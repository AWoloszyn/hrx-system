llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def public target(@target) @call_mixed_i32(%input: vector<1xi32>, %delta: i32) -> (i32, i32) {
  %value = vector.extract %input[0] : vector<1xi32> -> i32
  %mixed = func.call @add_i32(%value, %delta) : (i32, i32) -> (i32)
  %uniform = func.call @add_i32(%delta, %delta) : (i32, i32) -> (i32)
  func.return %mixed, %uniform : i32, i32
}

func.def @add_i32(%value: i32, %delta: i32) -> (i32) {
  %wide_value = scalar.extui %value : i32 to i64
  %wide_delta = scalar.extui %delta : i32 to i64
  %sum = scalar.addi %wide_value, %wide_delta : i64
  %result = scalar.trunci %sum : i64 to i32
  func.return %result : i32
}

// ----
low.func.def public target<llvmir.generic.core>(@target) abi(object_function) @call_mixed_i32(%value: reg<llvmir.i32>, %delta: reg<llvmir.i32>) -> (reg<llvmir.i32>, reg<llvmir.i32>) asm {
  %wide_value = zext.i32.i64 %value
  %wide_delta = zext.i32.i64 %delta
  %sum$24 = add.i64 %wide_value, %wide_delta
  %result$25 = trunc.i64.i32 %sum$24
  %sum$26 = add.i64 %wide_delta, %wide_delta
  %result$27 = trunc.i64.i32 %sum$26
  return %result$25, %result$27
}

