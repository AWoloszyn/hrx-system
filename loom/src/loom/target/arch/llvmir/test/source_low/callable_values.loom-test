llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def public target(@target) @call_loop(%input: vector<1xi32>, %delta: i32, %count: index) -> (i32) {
  %value = vector.extract %input[0] : vector<1xi32> -> i32
  %result = func.call @repeat_add(%value, %delta, %count) : (i32, i32, index) -> (i32)
  func.return %result : i32
}

func.def @repeat_add(%value: i32, %delta: i32, %count: index) -> (i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %result = scf.for %i = [%c0 to %count step %c1](%current = %value : i32) -> (i32) {
    %next = func.call @advance_i32(%current, %delta) : (i32, i32) -> (i32)
    scf.yield %next : i32
  }
  func.return %result : i32
}

func.def @advance_i32(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<llvmir.generic.core>(@target) abi(object_function) @call_loop(%value: reg<llvmir.i32>, %delta: reg<llvmir.i32>, %count: reg<llvmir.i64>) -> (reg<llvmir.i32>) asm {
  %c0 = const.i64 0
  %c1 = const.i64 1
  low.br ^_bb1(%c0: reg<llvmir.i64>, %value: reg<llvmir.i32>)
^_bb1(%i: reg<llvmir.i64>, %current: reg<llvmir.i32>):
  %35 = cmp.slt.i64 %i, %count
  low.cond_br %35, ^_bb2, ^_bb3 : reg<llvmir.i1>
^_bb2:
  %result = add.i32 %current, %delta
  %37 = add.i64 %i, %c1
  low.br ^_bb1(%37: reg<llvmir.i64>, %result: reg<llvmir.i32>)
^_bb3:
  return %current
}

