// TEMPLATE: loom/src/loom/test/corpus/source_low/selected_payload_transport.loom-test
// RUN: pass source-to-low

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def public target(@target) @selected_truncated(%input: vector<4xi32>, %left: i64, %right: i64) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i64
  %payload = scalar.trunci %selected : i64 to i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ----
llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

low.func.def public target<llvmir.generic.core>(@target) abi(object_function) @selected_truncated(%input: reg<llvmir.i32 x4>, %left: reg<llvmir.i64>, %right: reg<llvmir.i64>) -> (reg<llvmir.i32>) asm {
  %value = extract.v4i32 %input, 0
  %threshold = const.i32 0
  %condition = cmp.sgt.i32 %value, %threshold
  %selected = select.i64 %condition, %left, %right
  %payload = trunc.i64.i32 %selected
  low.br ^forward(%payload: reg<llvmir.i32>)
^forward(%carried: reg<llvmir.i32>):
  return %carried
}

