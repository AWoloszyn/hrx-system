// XFAIL: LLVMIR full-width vector bitfield insert legalization is unsupported
llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @i32_bitfield_insert_full_width_alias(%field_buffer: buffer, %base_buffer: buffer, %output: buffer) {
  %buffer_base = index.constant 0 : offset
  %field_view = buffer.view %field_buffer[%buffer_base] : buffer -> view<1xi32>
  %base_view = buffer.view %base_buffer[%buffer_base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<1xi32>
  %field = vector.load %field_view[0] : view<1xi32> -> vector<1xi32>
  %base = vector.load %base_view[0] : view<1xi32> -> vector<1xi32>
  %inserted = vector.bitfield.insert %field into %base {offset = 0, width = 32} : vector<1xi32>, vector<1xi32>
  vector.store %inserted, %output_view[0] : vector<1xi32>, view<1xi32>
  func.return
}

// ====

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @i32_bitfield_b128_shape(%input: buffer, %output: buffer) {
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<4xi32>
  %loaded = vector.load %input_view[0] : view<4xi32> -> vector<4xi32>
  %low = vector.bitfield.extractu %loaded {offset = 0, width = 4} : vector<4xi32> -> vector<4xi32>
  %high = vector.bitfield.extractu %loaded {offset = 4, width = 2} : vector<4xi32> -> vector<4xi32>
  %merged = vector.bitfield.insert %high into %low {offset = 4, width = 2} : vector<4xi32>, vector<4xi32>
  %bias = vector.constant 32 : vector<4xi32>
  %result = vector.subi %merged, %bias : vector<4xi32>
  vector.store %result, %output_view[0] : vector<4xi32>, view<4xi32>
  func.return
}

