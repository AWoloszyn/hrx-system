llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @i32_bitfield_extractu(%input: buffer, %output: buffer) {
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<1xi32>
  %loaded = vector.load %input_view[0] : view<1xi32> -> vector<1xi32>
  %nibble = vector.bitfield.extractu %loaded {offset = 4, width = 4} : vector<1xi32> -> vector<1xi32>
  vector.store %nibble, %output_view[0] : vector<1xi32>, view<1xi32>
  func.return
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @i32_bitfield_extractu(%input_view: reg<llvmir.ptr>, %output_view: reg<llvmir.ptr>) asm {
  %17 = load.i32 %input_view, 0
  %18 = const.i32 4
  %19 = lshr.i32 %17, %18
  %20 = const.i32 15
  %nibble = and.i32 %19, %20
  store.i32 %nibble, %output_view, 0
  return
}

