low.func.def target<llvmir.generic.core>(@target) abi(object_function) @i32_bitfield_b128_shape(%input_view: reg<llvmir.ptr>, %output_view: reg<llvmir.ptr>) asm {
  %94 = load.i32 %input_view, 0
  %95 = const.i32 4
  %96 = lshr.i32 %94, %95
  %97 = const.i32 3
  %98 = and.i32 %96, %97
  %99 = const.i32 15
  %100 = and.i32 %94, %99
  %101 = shl.i32 %98, %95
  %102 = const.i32 -49
  %103 = and.i32 %100, %102
  %104 = or.i32 %103, %101
  %105 = load.i32 %input_view, 4
  %106 = lshr.i32 %105, %95
  %107 = and.i32 %106, %97
  %108 = and.i32 %105, %99
  %109 = shl.i32 %107, %95
  %110 = and.i32 %108, %102
  %111 = or.i32 %110, %109
  %112 = load.i32 %input_view, 8
  %113 = lshr.i32 %112, %95
  %114 = and.i32 %113, %97
  %115 = and.i32 %112, %99
  %116 = shl.i32 %114, %95
  %117 = and.i32 %115, %102
  %118 = or.i32 %117, %116
  %119 = load.i32 %input_view, 12
  %120 = lshr.i32 %119, %95
  %121 = and.i32 %120, %97
  %122 = and.i32 %119, %99
  %123 = shl.i32 %121, %95
  %124 = and.i32 %122, %102
  %125 = or.i32 %124, %123
  %merged = from_elements.v4i32 %104, %111, %118, %125
  %bias = const.v4i32 32
  %result = sub.v4i32 %merged, %bias
  store.v4i32 %result, %output_view, 0
  return
}
