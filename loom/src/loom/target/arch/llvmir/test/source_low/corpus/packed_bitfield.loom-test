low.func.def target<llvmir.generic.core>(@target) abi(object_function) @i32_bitfield_insert(%field_view: reg<llvmir.ptr>, %base_view: reg<llvmir.ptr>, %output_view: reg<llvmir.ptr>) asm {
  %27 = load.i32 %field_view, 0
  %28 = load.i32 %base_view, 0
  %29 = const.i32 15
  %30 = and.i32 %27, %29
  %31 = const.i32 8
  %32 = shl.i32 %30, %31
  %33 = const.i32 -3841
  %34 = and.i32 %28, %33
  %inserted = or.i32 %34, %32
  store.i32 %inserted, %output_view, 0
  return
}

