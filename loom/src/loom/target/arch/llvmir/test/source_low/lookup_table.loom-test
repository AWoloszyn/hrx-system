low.func.def target<llvmir.generic.core>(@target) abi(object_function) @i8_table_lookup_u4_dynamic_table(%grid: reg<llvmir.i8 x16>, %packed: reg<llvmir.i8 x2>) -> (reg<llvmir.i8 x4>) asm {
  %49 = extract.v2i8 %packed, 0
  %50 = zext.i8.i32 %49
  %51 = const.i32 15
  %52 = and.i32 %50, %51
  %53 = trunc.i32.i8 %52
  %54 = sext.i8.i64 %53
  %55 = extract.dynamic.v16i8 %grid, %54
  %56 = const.i32 4
  %57 = lshr.i32 %50, %56
  %58 = trunc.i32.i8 %57
  %59 = sext.i8.i64 %58
  %60 = extract.dynamic.v16i8 %grid, %59
  %61 = extract.v2i8 %packed, 1
  %62 = zext.i8.i32 %61
  %63 = and.i32 %62, %51
  %64 = trunc.i32.i8 %63
  %65 = sext.i8.i64 %64
  %66 = extract.dynamic.v16i8 %grid, %65
  %67 = lshr.i32 %62, %56
  %68 = trunc.i32.i8 %67
  %69 = sext.i8.i64 %68
  %70 = extract.dynamic.v16i8 %grid, %69
  %decoded = from_elements.v4i8 %55, %60, %66, %70
  return %decoded
}

