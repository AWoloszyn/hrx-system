  %g0 = const.f32 1073741824
  %g1 = const.f32 3225419776
  %g2 = const.f32 1084227584
  %grid = from_elements.v3f32 %g0, %g1, %g2
  %20 = extract.v2i32 %codes, 0
  %21 = sext.i32.i64 %20
  %22 = extract.dynamic.v3f32 %grid, %21
  %23 = extract.v2i32 %codes, 1
  %24 = sext.i32.i64 %23
  %25 = extract.dynamic.v3f32 %grid, %24
  %decoded = from_elements.v2f32 %22, %25
  return %decoded
}

