// TEMPLATE: loom/src/loom/test/corpus/source_low/lookup_table.loom-test
// RUN: emit source-low output=low

llvmir.target<object> @target {triple = "amdgcn-amd-amdhsa"}

kernel.def target(@target) @f32_table_lookup_i8_codes() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%codes_buffer: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base_offset = index.constant 0 : offset
  %code_stride = index.constant 4 : index
  %base = index.mul %lane, %code_stride : index
  %codes_view = buffer.view %codes_buffer[%base_offset] : buffer -> view<8xi8>
  %output_view = buffer.view %output[%base_offset] : buffer -> view<8xf32>
  %codes = vector.load %codes_view[%base] : view<8xi8> -> vector<4xi8>
  %g0 = scalar.constant -1.0 : f32
  %g1 = scalar.constant -0.5 : f32
  %g2 = scalar.constant 0.5 : f32
  %g3 = scalar.constant 1.5 : f32
  %grid = vector.from_elements %g0, %g1, %g2, %g3 : vector<4xf32>
  %decoded = vector.table.lookup %grid[%codes] : vector<4xf32>, vector<4xi8> -> vector<4xf32>
  vector.store %decoded, %output_view[%base] : vector<4xf32>, view<8xf32>
  kernel.return
}

// ----
low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(2, 1, 1) workgroup_count(1, 1, 1) @f32_table_lookup_i8_codes() asm {
  %codes_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<llvmir.ptr>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<llvmir.ptr>
  %lane = kernel.workitem_id.x
  %g0 = const.f32 3212836864
  %g1 = const.f32 3204448256
  %g2 = const.f32 1056964608
  %g3 = const.f32 1069547520
  %grid = from_elements.v4f32 %g0, %g1, %g2, %g3
  %52 = load.indexed.i8 %codes_view, %lane, 0, 4
  %53 = sext.i8.i64 %52
  %54 = extract.dynamic.v4f32 %grid, %53
  %55 = load.indexed.i8 %codes_view, %lane, 1, 4
  %56 = sext.i8.i64 %55
  %57 = extract.dynamic.v4f32 %grid, %56
  %58 = load.indexed.i8 %codes_view, %lane, 2, 4
  %59 = sext.i8.i64 %58
  %60 = extract.dynamic.v4f32 %grid, %59
  %61 = load.indexed.i8 %codes_view, %lane, 3, 4
  %62 = sext.i8.i64 %61
  %63 = extract.dynamic.v4f32 %grid, %62
  %decoded = from_elements.v4f32 %54, %57, %60, %63
  store.indexed.v4f32 %decoded, %output_view, %lane, 0, 16
  return
}

