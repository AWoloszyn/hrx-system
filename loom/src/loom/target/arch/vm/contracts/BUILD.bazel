load("//loom/build_tools/bazel:build_defs.bzl", "loom_target_contract_table_cc_libraries")

package(
    default_visibility = ["//loom/src/loom/target/arch/vm:__subpackages__"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_target_contract_table_cc_libraries(
    name = "core",
    args = ["--contract-fragment=vm.core"],
    contract_deps = ["//loom/src/loom/target:contract"],
    generator = "//loom/py/loom/gen/target/contracts:vm_contract_table_family",
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/target/arch/vm/descriptors:descriptors_ids",
    ],
)
