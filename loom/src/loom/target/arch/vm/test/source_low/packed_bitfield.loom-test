low.func.def target<vm.core> abi(vm_function) @i32_bitfield_insert(%field_view: reg<vm.ref : buffer>, %base_view: reg<vm.ref : buffer>, %output_view: reg<vm.ref : buffer>) asm {
  %29 = constant.i64 0
  %30 = buffer.load %field_view, %29, %29, 0, "i32.x1" : reg<vm.value : i32>
  %32 = buffer.load %base_view, %29, %29, 0, "i32.x1" : reg<vm.value : i32>
  %33 = constant.i32 15
  %34 = integer.and.i32 %30, %33
  %35 = constant.i32 8
  %36 = integer.shift.left.i32 %34, %35
  %37 = constant.i32 4294963455
  %38 = integer.and.i32 %32, %37
  %39 = integer.or.i32 %38, %36
  buffer.store %output_view, %29, %29, %39, 0, "i32.x1"
  return
}

