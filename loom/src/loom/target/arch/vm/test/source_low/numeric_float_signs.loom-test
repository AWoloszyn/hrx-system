// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_float_signs.loom-test
// TEMPLATE-EXCLUDE: @scalar_bf16_signs The VM floating-point sign instructions consume F32 or F64 values.
// TEMPLATE-EXCLUDE: @vector_bf16_4_signs The VM floating-point sign instructions consume F32 or F64 values.
// TEMPLATE-EXCLUDE: @vector_bf16_8_signs The VM floating-point sign instructions consume F32 or F64 values.
// TEMPLATE-EXCLUDE: @vector_bf16_16_signs The VM floating-point sign instructions consume F32 or F64 values.
// TEMPLATE-EXCLUDE: @vector_bf16_32_signs The VM floating-point sign instructions consume F32 or F64 values.
// TEMPLATE-EXCLUDE: @scalar_bf16_signs_fast The VM floating-point sign instructions consume F32 or F64 values.
// TEMPLATE-EXCLUDE: @vector_f32_4_signs Vector sign-operation lowering is not implemented for this profile.
// TEMPLATE-EXCLUDE: @vector_f32_16_signs Vector sign-operation lowering is not implemented for this profile.
// RUN: emit source-low target=vm:core output=low

func.def @scalar_f32_signs(%magnitude: f32, %sign: f32) -> (f32, f32, f32) {
  %absolute = scalar.absf %magnitude : f32
  %negated = scalar.negf %magnitude : f32
  %copied = scalar.copysignf %magnitude, %sign : f32
  func.return %absolute, %negated, %copied : f32, f32, f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @scalar_f32_signs(%magnitude: reg<vm.value : f32>, %sign: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %absolute = float.abs.f32 %magnitude
  %negated = float.neg.f32 %magnitude
  %copied = float.copysign.f32 %magnitude, %sign
  return %absolute, %negated, %copied
}
