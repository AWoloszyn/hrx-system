// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_float_rounding.loom-test
// RUN: emit source-low output=low

vm.target<core> @vm

func.def target(@vm) @rounding_f32(%value: f32) -> (f32, f32, f32, f32) {
  %ceil = scalar.ceilf %value : f32
  %floor = scalar.floorf %value : f32
  %roundeven = scalar.roundevenf %value : f32
  %trunc = scalar.truncf %value : f32
  func.return %ceil, %floor, %roundeven, %trunc : f32, f32, f32, f32
}

// ----
low.func.def target<vm.core>(@vm) abi(vm_function) @rounding_f32(%value: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %ceil = float.math.unary.f32 %value, 0
  %floor = float.math.unary.f32 %value, 1
  %roundeven = float.math.unary.f32 %value, 2
  %trunc = float.math.unary.f32 %value, 3
  return %ceil, %floor, %roundeven, %trunc
}

// ====

vm.target<core> @vm

func.def target(@vm) @rounding_f64(%value: f64) -> (f64, f64, f64, f64) {
  %ceil = scalar.ceilf %value : f64
  %floor = scalar.floorf %value : f64
  %roundeven = scalar.roundevenf %value : f64
  %trunc = scalar.truncf %value : f64
  func.return %ceil, %floor, %roundeven, %trunc : f64, f64, f64, f64
}

// ----
low.func.def target<vm.core>(@vm) abi(vm_function) @rounding_f64(%value: reg<vm.value : f64>) -> (reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>) asm {
  %ceil = float.math.unary.f64 %value, 0
  %floor = float.math.unary.f64 %value, 1
  %roundeven = float.math.unary.f64 %value, 2
  %trunc = float.math.unary.f64 %value, 3
  return %ceil, %floor, %roundeven, %trunc
}
