// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_float8_constants.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @float8_finite_constants() -> (f8E4M3, f8E5M2, f8E4M3, f8E5M2, f8E4M3, f8E5M2) {
  %e4_negative = scalar.constant -1.5 : f8E4M3
  %e5_fraction = scalar.constant 1.25 : f8E5M2
  %e4_smallest = scalar.constant 0.001953125 : f8E4M3
  %e5_smallest = scalar.constant 1.52587890625e-05 : f8E5M2
  %e4_largest = scalar.constant 448.0 : f8E4M3
  %e5_largest = scalar.constant 57344.0 : f8E5M2
  func.return %e4_negative, %e5_fraction, %e4_smallest, %e5_smallest, %e4_largest, %e5_largest : f8E4M3, f8E5M2, f8E4M3, f8E5M2, f8E4M3, f8E5M2
}

// ----
low.func.def target<vm.core> abi(vm_function) @float8_finite_constants() -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>) asm {
  %e4_negative = constant.i32 188 : reg<vm.value : f8E4M3>
  %e5_fraction = constant.i32 61 : reg<vm.value : f8E5M2>
  %e4_smallest = constant.i32 1 : reg<vm.value : f8E4M3>
  %e5_smallest = constant.i32 1 : reg<vm.value : f8E5M2>
  %e4_largest = constant.i32 126 : reg<vm.value : f8E4M3>
  %e5_largest = constant.i32 123 : reg<vm.value : f8E5M2>
  return %e4_negative, %e5_fraction, %e4_smallest, %e5_smallest, %e4_largest, %e5_largest
}

// ====

func.def @float8_rounding_constants() -> (f8E4M3, f8E4M3, f8E5M2, f8E5M2, f8E4M3, f8E5M2) {
  %e4_even_lower = scalar.constant 1.0625 : f8E4M3
  %e4_even_upper = scalar.constant 1.1875 : f8E4M3
  %e5_even_lower = scalar.constant 1.125 : f8E5M2
  %e5_even_upper = scalar.constant 1.375 : f8E5M2
  %e4_saturated = scalar.constant 61440.0 : f8E4M3
  %e5_overflow = scalar.constant 61440.0 : f8E5M2
  func.return %e4_even_lower, %e4_even_upper, %e5_even_lower, %e5_even_upper, %e4_saturated, %e5_overflow : f8E4M3, f8E4M3, f8E5M2, f8E5M2, f8E4M3, f8E5M2
}

// ----
low.func.def target<vm.core> abi(vm_function) @float8_rounding_constants() -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f8E5M2>, reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>) asm {
  %e4_even_lower = constant.i32 56 : reg<vm.value : f8E4M3>
  %e4_even_upper = constant.i32 58 : reg<vm.value : f8E4M3>
  %e5_even_lower = constant.i32 60 : reg<vm.value : f8E5M2>
  %e5_even_upper = constant.i32 62 : reg<vm.value : f8E5M2>
  %e4_saturated = constant.i32 126 : reg<vm.value : f8E4M3>
  %e5_overflow = constant.i32 124 : reg<vm.value : f8E5M2>
  return %e4_even_lower, %e4_even_upper, %e5_even_lower, %e5_even_upper, %e4_saturated, %e5_overflow
}

// ====

func.def @float8_signed_zeros() -> (f8E4M3, f8E5M2, f8E4M3, f8E5M2) {
  %e4_positive = scalar.constant 0.0 : f8E4M3
  %e5_positive = scalar.constant 0.0 : f8E5M2
  %e4_negative = scalar.constant -0.0 : f8E4M3
  %e5_negative = scalar.constant -0.0 : f8E5M2
  func.return %e4_positive, %e5_positive, %e4_negative, %e5_negative : f8E4M3, f8E5M2, f8E4M3, f8E5M2
}

// ----
low.func.def target<vm.core> abi(vm_function) @float8_signed_zeros() -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>) asm {
  %e4_positive = constant.i32 0 : reg<vm.value : f8E4M3>
  %e5_positive = constant.i32 0 : reg<vm.value : f8E5M2>
  %e4_negative = constant.i32 128 : reg<vm.value : f8E4M3>
  %e5_negative = constant.i32 128 : reg<vm.value : f8E5M2>
  return %e4_positive, %e5_positive, %e4_negative, %e5_negative
}

// ====

func.def @float8_special_constants() -> (f8E4M3, f8E4M3, f8E5M2, f8E5M2, f8E4M3, f8E5M2) {
  %e4_positive = scalar.constant inf : f8E4M3
  %e4_negative = scalar.constant -inf : f8E4M3
  %e5_positive = scalar.constant inf : f8E5M2
  %e5_negative = scalar.constant -inf : f8E5M2
  %e4_nan = scalar.constant nan : f8E4M3
  %e5_nan = scalar.constant nan : f8E5M2
  func.return %e4_positive, %e4_negative, %e5_positive, %e5_negative, %e4_nan, %e5_nan : f8E4M3, f8E4M3, f8E5M2, f8E5M2, f8E4M3, f8E5M2
}

// ----
low.func.def target<vm.core> abi(vm_function) @float8_special_constants() -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f8E5M2>, reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>) asm {
  %e4_positive = constant.i32 126 : reg<vm.value : f8E4M3>
  %e4_negative = constant.i32 254 : reg<vm.value : f8E4M3>
  %e5_positive = constant.i32 124 : reg<vm.value : f8E5M2>
  %e5_negative = constant.i32 252 : reg<vm.value : f8E5M2>
  %e4_nan = constant.i32 127 : reg<vm.value : f8E4M3>
  %e5_nan = constant.i32 127 : reg<vm.value : f8E5M2>
  return %e4_positive, %e4_negative, %e5_positive, %e5_negative, %e4_nan, %e5_nan
}
