low.func.def target<vm.core>(@target) abi(vm_function) @wide_right_shift_uniform(%value: reg<vm.value : i64>, %count: reg<vm.value : i64>) -> (reg<vm.value : i64>, reg<vm.value : i64>) asm {
  %logical = integer.shift.right.u64 %value, %count
  %signed = integer.shift.right.s64 %value, %count
  return %logical, %signed
}

