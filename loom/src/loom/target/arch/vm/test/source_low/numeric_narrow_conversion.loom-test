// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_narrow_conversion.loom-test
// RUN: emit source-low output=low

vm.target<core> @vm

func.def target(@vm) @extend_narrow(%arg0: f8E4M3, %arg1: f8E5M2, %arg2: f16, %arg3: bf16) -> (f32, f32, f32, f32) {
  %result0 = scalar.extf %arg0 : f8E4M3 to f32
  %result1 = scalar.extf %arg1 : f8E5M2 to f32
  %result2 = scalar.extf %arg2 : f16 to f32
  %result3 = scalar.extf %arg3 : bf16 to f32
  func.return %result0, %result1, %result2, %result3 : f32, f32, f32, f32
}

// ----
low.func.def target<vm.core>(@vm) abi(vm_function) @extend_narrow(%arg0: reg<vm.value : f8E4M3>, %arg1: reg<vm.value : f8E5M2>, %arg2: reg<vm.value : f16>, %arg3: reg<vm.value : bf16>) -> (reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %result0 = conversion.float.extend %arg0, 0 : reg<vm.value : f32>
  %result1 = conversion.float.extend %arg1, 1 : reg<vm.value : f32>
  %result2 = conversion.float.extend %arg2, 2 : reg<vm.value : f32>
  %result3 = conversion.float.extend %arg3, 3 : reg<vm.value : f32>
  return %result0, %result1, %result2, %result3
}

// ====

vm.target<core> @vm

func.def target(@vm) @truncate_single(%input: f32) -> (f8E4M3, f8E5M2, f16, bf16) {
  %result0 = scalar.fptrunc %input : f32 to f8E4M3
  %result1 = scalar.fptrunc %input : f32 to f8E5M2
  %result2 = scalar.fptrunc %input : f32 to f16
  %result3 = scalar.fptrunc %input : f32 to bf16
  func.return %result0, %result1, %result2, %result3 : f8E4M3, f8E5M2, f16, bf16
}

// ----
low.func.def target<vm.core>(@vm) abi(vm_function) @truncate_single(%input: reg<vm.value : f32>) -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f16>, reg<vm.value : bf16>) asm {
  %result0 = conversion.float.truncate %input, 0 : reg<vm.value : f8E4M3>
  %result1 = conversion.float.truncate %input, 1 : reg<vm.value : f8E5M2>
  %result2 = conversion.float.truncate %input, 2 : reg<vm.value : f16>
  %result3 = conversion.float.truncate %input, 3 : reg<vm.value : bf16>
  return %result0, %result1, %result2, %result3
}

