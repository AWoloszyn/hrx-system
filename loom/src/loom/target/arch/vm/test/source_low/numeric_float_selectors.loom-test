// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_float_selectors.loom-test
// RUN: emit source-low output=low

vm.target<core> @vm

func.def target(@vm) @float_predicates_f32(%a: f32, %b: f32) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1) {
  %oeq = scalar.cmpf oeq, %a, %b : f32
  %ogt = scalar.cmpf ogt, %a, %b : f32
  %oge = scalar.cmpf oge, %a, %b : f32
  %olt = scalar.cmpf olt, %a, %b : f32
  %ole = scalar.cmpf ole, %a, %b : f32
  %one = scalar.cmpf one, %a, %b : f32
  %ord = scalar.cmpf ord, %a, %b : f32
  %ueq = scalar.cmpf ueq, %a, %b : f32
  %ugt = scalar.cmpf ugt, %a, %b : f32
  %uge = scalar.cmpf uge, %a, %b : f32
  %ult = scalar.cmpf ult, %a, %b : f32
  %ule = scalar.cmpf ule, %a, %b : f32
  %une = scalar.cmpf une, %a, %b : f32
  %uno = scalar.cmpf uno, %a, %b : f32
  func.return %oeq, %ogt, %oge, %olt, %ole, %one, %ord, %ueq, %ugt, %uge, %ult, %ule, %une, %uno : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1
}

// ----
low.func.def target<vm.core>(@vm) abi(vm_function) @float_predicates_f32(%a: reg<vm.value : f32>, %b: reg<vm.value : f32>) -> (reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %oeq = float.compare.f32 %a, %b, 0
  %ogt = float.compare.f32 %a, %b, 1
  %oge = float.compare.f32 %a, %b, 2
  %olt = float.compare.f32 %a, %b, 3
  %ole = float.compare.f32 %a, %b, 4
  %one = float.compare.f32 %a, %b, 5
  %ord = float.compare.f32 %a, %b, 6
  %ueq = float.compare.f32 %a, %b, 7
  %ugt = float.compare.f32 %a, %b, 8
  %uge = float.compare.f32 %a, %b, 9
  %ult = float.compare.f32 %a, %b, 10
  %ule = float.compare.f32 %a, %b, 11
  %une = float.compare.f32 %a, %b, 12
  %uno = float.compare.f32 %a, %b, 13
  return %oeq, %ogt, %oge, %olt, %ole, %one, %ord, %ueq, %ugt, %uge, %ult, %ule, %une, %uno
}

// ====

vm.target<core> @vm

func.def target(@vm) @float_selected_f32(%a: f32, %b: f32, %c: f32) -> (f32, f32, f32, f32, i1, i1, i1, f32, f32, f32, f32) {
  %minimum = scalar.minimumf %a, %b : f32
  %maximum = scalar.maximumf %a, %b : f32
  %minnum = scalar.minnumf %a, %b : f32
  %maxnum = scalar.maxnumf %a, %b : f32
  %isnan = scalar.isnanf %a : f32
  %isinf = scalar.isinff %a : f32
  %isfinite = scalar.isfinitef %a : f32
  %ordered = scalar.clampf<ordered> %a, %b, %c : f32
  %number = scalar.clampf<number> %a, %b, %c : f32
  %ieee = scalar.clampf<ieee> %a, %b, %c : f32
  %fused = scalar.fmaf %a, %b, %c : f32
  func.return %minimum, %maximum, %minnum, %maxnum, %isnan, %isinf, %isfinite, %ordered, %number, %ieee, %fused : f32, f32, f32, f32, i1, i1, i1, f32, f32, f32, f32
}

// ----
low.func.def target<vm.core>(@vm) abi(vm_function) @float_selected_f32(%a: reg<vm.value : f32>, %b: reg<vm.value : f32>, %c: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %minimum = float.minmax.f32 %a, %b, 0
  %maximum = float.minmax.f32 %a, %b, 1
  %minnum = float.minmax.f32 %a, %b, 2
  %maxnum = float.minmax.f32 %a, %b, 3
  %isnan = float.classify.f32 %a, 0
  %isinf = float.classify.f32 %a, 1
  %isfinite = float.classify.f32 %a, 2
  %ordered = float.clamp.f32 %a, %b, %c, 0
  %number = float.clamp.f32 %a, %b, %c, 1
  %ieee = float.clamp.f32 %a, %b, %c, 2
  %fused = float.fma.f32 %a, %b, %c
  return %minimum, %maximum, %minnum, %maxnum, %isnan, %isinf, %isfinite, %ordered, %number, %ieee, %fused
}

// ====

vm.target<core> @vm

func.def target(@vm) @float_bitcasts_f32(%bits: i32, %number: f32) -> (f32, i32) {
  %as_number = scalar.bitcast %bits : i32 to f32
  %as_bits = scalar.bitcast %number : f32 to i32
  func.return %as_number, %as_bits : f32, i32
}

// ----
low.func.def target<vm.core>(@vm) abi(vm_function) @float_bitcasts_f32(%bits: reg<vm.value : i32>, %number: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : i32>) asm {
  %as_number = value.copy %bits : reg<vm.value : f32>
  %as_bits = value.copy %number : reg<vm.value : i32>
  return %as_number, %as_bits
}

