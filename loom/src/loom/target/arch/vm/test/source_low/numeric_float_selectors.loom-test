vm.target<core> @vm

func.def target(@vm) @float_sign_f32(%value: f32) -> (f32) {
  %result = scalar.signf %value : f32
  func.return %result : f32
}

// ----
low.func.def target<vm.core>(@vm) abi(vm_function) @float_sign_f32(%value: reg<vm.value : f32>) -> (reg<vm.value : f32>) asm {
  %result = float.math.unary.f32 %value, 4
  return %result
}

