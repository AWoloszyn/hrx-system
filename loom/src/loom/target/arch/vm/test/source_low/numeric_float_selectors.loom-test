// ====

vm.target<core> @vm

func.def target(@vm) @exponentials_f32(%input: f32) -> (f32, f32) {
  %base_two = scalar.exp2f<afn> %input : f32
  %natural = scalar.expf<afn> %input : f32
  func.return %base_two, %natural : f32, f32
}

// ----
low.func.def target<vm.core>(@vm) abi(vm_function) @exponentials_f32(%input: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %11 = constant.i32 3271294976 : reg<vm.value : f32>
  %12 = constant.i32 1115684864 : reg<vm.value : f32>
  %13 = constant.i32 0 : reg<vm.value : f32>
  %14 = constant.i32 528482304 : reg<vm.value : f32>
  %15 = constant.i32 1065353216 : reg<vm.value : f32>
  %16 = float.compare.f32 %input, %11, 3
  %17 = value.select %16, %12, %13 : reg<vm.value : f32>
  %18 = value.select %16, %14, %15 : reg<vm.value : f32>
  %19 = float.add.f32 %input, %17
  %20 = float.math.unary.f32 %19, 5
  %base_two = float.mul.f32 %20, %18
  %22 = constant.i32 1069066811 : reg<vm.value : f32>
  %23 = float.mul.f32 %input, %22
  %29 = float.compare.f32 %23, %11, 3
  %30 = value.select %29, %12, %13 : reg<vm.value : f32>
  %31 = value.select %29, %14, %15 : reg<vm.value : f32>
  %32 = float.add.f32 %23, %30
  %33 = float.math.unary.f32 %32, 5
  %natural = float.mul.f32 %33, %31
  return %base_two, %natural
}

