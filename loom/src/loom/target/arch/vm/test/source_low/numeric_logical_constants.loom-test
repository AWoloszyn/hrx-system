// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_logical_constants.loom-test
// RUN: emit source-low output=low

vm.target<core> @vm

func.def target(@vm) @logical_constants() -> (f32, f64, i1, i1) {
  %narrow = scalar.constant 1.25 : f32
  %wide = scalar.constant 4294967297.5 : f64
  %yes = scalar.constant true : i1
  %no = scalar.constant false : i1
  func.return %narrow, %wide, %yes, %no : f32, f64, i1, i1
}

// ----
low.func.def target<vm.core>(@vm) abi(vm_function) @logical_constants() -> (reg<vm.value : f32>, reg<vm.value : f64>, reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %narrow = constant.i32 1067450368 : reg<vm.value : f32>
  %wide = constant.i64 4751297606877446144 : reg<vm.value : f64>
  %yes = constant.i32 1 : reg<vm.value : i1>
  %no = constant.i32 0 : reg<vm.value : i1>
  return %narrow, %wide, %yes, %no
}

// ====

vm.target<core> @vm

func.def target(@vm) @boolean_logic(%a: i1, %b: i1) -> (i1, i1, i1) {
  %both = scalar.andi %a, %b : i1
  %either = scalar.ori %a, %b : i1
  %exclusive = scalar.xori %a, %b : i1
  func.return %both, %either, %exclusive : i1, i1, i1
}

// ----
low.func.def target<vm.core>(@vm) abi(vm_function) @boolean_logic(%a: reg<vm.value : i1>, %b: reg<vm.value : i1>) -> (reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %both = integer.and.i32 %a, %b : reg<vm.value : i1>
  %either = integer.or.i32 %a, %b : reg<vm.value : i1>
  %exclusive = integer.xor.i32 %a, %b : reg<vm.value : i1>
  return %both, %either, %exclusive
}
