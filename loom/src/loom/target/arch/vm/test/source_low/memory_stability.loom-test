low.kernel.def target<vm.core> workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @typed_read_with_incomparable_write(%source: reg<vm.ref : buffer>, %progress_unique: reg<vm.ref : buffer>, %destination: reg<vm.ref : buffer>) asm {
  %base = constant.i64 0
  %c1 = constant.i32 1
  %before = buffer.load %source, %base, %base, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store %progress_unique, %base, %base, %c1, 0, "i8.x1"
  %after = buffer.load %source, %base, %base, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store %destination, %base, %base, %before, 0, "i32.x1"
  %33 = constant.i64 4
  buffer.store %destination, %33, %33, %after, 0, "i32.x1"
  return
}
