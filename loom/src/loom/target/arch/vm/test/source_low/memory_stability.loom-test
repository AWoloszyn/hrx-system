// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_stability.loom-test
// RUN: emit source-low target=vm:core output=low

// A cooperating producer waits for all 32 acknowledgements before changing
// the payload and releasing publication. Depending the acknowledgement on the
// initial payload read orders that read before the producer write.
kernel.def @read_after_acquire_publication() {
  %c1 = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%native: buffer, %progress: buffer, %output: buffer) {
  %payload_aligned, %progress_aligned, %output_aligned = buffer.assume.alignment %native, %progress, %output {minimum_alignment = 4} : buffer, buffer, buffer
  %payload_unique, %progress_unique, %output_unique = buffer.assume.noalias %payload_aligned, %progress_aligned, %output_aligned : buffer, buffer, buffer
  %base = index.constant 0 : offset
  // ERROR@+1: TARGET/001 {op_name="kernel.workitem.id"}
  %lane = kernel.workitem.id<x> : index
  %pixels = buffer.view %payload_unique[%base] : buffer -> view<1xi32>
  %notice = buffer.view %progress_unique[%base] : buffer -> view<2xi32>
  %destination = buffer.view %output_unique[%base] : buffer -> view<32x2xi32>
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %before = view.load %pixels[0] : view<1xi32> -> i32
  %acknowledgement = scalar.addi %before, %c1 : i32
  view.atomic.reduce<addi> %acknowledgement, %notice[0] {ordering = release, scope = device} : i32, view<2xi32>
  scf.while {
    %seen = view.atomic.rmw<addi> %c0, %notice[1] {ordering = acquire, scope = device} : i32, view<2xi32> -> i32
    %pending = scalar.cmpi eq, %seen, %c0 : i32
    scf.condition %pending : i1
  } do {
    scf.yield
  }
  %after = view.load %pixels[0] : view<1xi32> -> i32
  view.store %before, %destination[%lane, 0] : i32, view<32x2xi32>
  view.store %after, %destination[%lane, 1] : i32, view<32x2xi32>
  kernel.return
}

// ====

kernel.def @constant_across_acquire() {
  %c1 = index.constant 1 : index
  %width = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%input: buffer, %progress: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %input_space = buffer.assume.memory_space<constant> %input : buffer
  %input_aligned, %progress_aligned, %output_aligned = buffer.assume.alignment %input_space, %progress, %output {minimum_alignment = 4} : buffer, buffer, buffer
  %source_unique, %progress_unique, %output_unique = buffer.assume.noalias %input_aligned, %progress_aligned, %output_aligned : buffer, buffer, buffer
  %source = buffer.view %source_unique[%base] : buffer -> view<1xi32>
  %notice = buffer.view %progress_unique[%base] : buffer -> view<1xi32>
  %destination = buffer.view %output_unique[%base] : buffer -> view<32x2xi32>
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %before = view.load %source[0] : view<1xi32> -> i32
  %seen = view.atomic.rmw<addi> %c0, %notice[0] {ordering = acquire, scope = device} : i32, view<1xi32> -> i32
  %after = view.load %source[0] : view<1xi32> -> i32
  view.store %before, %destination[%lane, 0] : i32, view<32x2xi32>
  view.store %after, %destination[%lane, 1] : i32, view<32x2xi32>
  kernel.return
}

// ----
low.kernel.def target<vm.core> workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @constant_across_acquire(%source: reg<vm.ref : buffer>, %notice: reg<vm.ref : buffer>, %destination: reg<vm.ref : buffer>) asm {
  %c0 = constant.i32 0
  %28 = constant.i64 0
  %before = buffer.load %source, %28, %28, 0, "i32.x1" : reg<vm.value : i32>
  %seen = buffer.atomic.rmw %notice, %28, %c0, "i32", "add.integer", "acquire", "device" : reg<vm.value : i32>
  %after = buffer.load %source, %28, %28, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store %destination, %28, %28, %before, 0, "i32.x1"
  %35 = constant.i64 4
  buffer.store %destination, %35, %35, %after, 0, "i32.x1"
  return
}

