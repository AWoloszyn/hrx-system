low.kernel.def target<vm.core> workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @typed_read_with_view_alias_write(%alias: reg<vm.ref : buffer>, %progress_unique: reg<vm.ref : buffer>, %destination: reg<vm.ref : buffer>) asm {
  %c1 = constant.i32 1
  %28 = constant.i64 0
  %before = buffer.load %alias, %28, %28, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store %alias, %28, %28, %c1, 0, "i32.x1"
  %after = buffer.load %alias, %28, %28, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store %destination, %28, %28, %before, 0, "i32.x1"
  %34 = constant.i64 4
  buffer.store %destination, %34, %34, %after, 0, "i32.x1"
  return
}

