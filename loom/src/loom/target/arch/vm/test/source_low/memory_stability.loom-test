low.kernel.def target<vm.core> workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @global_across_compare_exchange(%source: reg<vm.ref : buffer>, %notice: reg<vm.ref : buffer>, %destination: reg<vm.ref : buffer>) asm {
  %c0 = constant.i32 0
  %c1 = constant.i32 1
  %29 = constant.i64 0
  %before = buffer.load %source, %29, %29, 0, "i32.x1" : reg<vm.value : i32>
  %seen = buffer.atomic.cmpxchg %notice, %29, %c0, %c1, "acq_rel.acquire", "i32", "device" : reg<vm.value : i32>
  %after = buffer.load %source, %29, %29, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store %destination, %29, %29, %before, 0, "i32.x1"
  %36 = constant.i64 4
  buffer.store %destination, %36, %36, %after, 0, "i32.x1"
  return
}

