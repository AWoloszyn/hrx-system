// ----
low.kernel.def target<vm.core> workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @global_across_release(%source: reg<vm.ref : buffer>, %notice: reg<vm.ref : buffer>, %destination: reg<vm.ref : buffer>) asm {
  %c1 = constant.i32 1
  %27 = constant.i64 0
  %before = buffer.load %source, %27, %27, 0, "i32.x1" : reg<vm.value : i32>
  buffer.atomic.reduce %notice, %27, %c1, "i32", "add.integer", "release", "device"
  %after = buffer.load %source, %27, %27, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store %destination, %27, %27, %before, 0, "i32.x1"
  %33 = constant.i64 4
  buffer.store %destination, %33, %33, %after, 0, "i32.x1"
  return
