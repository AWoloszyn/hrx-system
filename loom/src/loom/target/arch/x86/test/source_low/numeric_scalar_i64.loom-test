x86.target<avx2> @target

func.def target(@target) @scalar_i64_compare_slt_if(%lhs: i64, %rhs: i64, %then_value: i32, %else_value: i32) -> (i32) {
  %cmp = scalar.cmpi slt, %lhs, %rhs : i64
  %result = scf.if %cmp -> (i32) {
    scf.yield %then_value : i32
  } else {
    scf.yield %else_value : i32
  }
  func.return %result : i32
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @scalar_i64_compare_slt_if(%lhs: reg<x86.gpr64>, %rhs: reg<x86.gpr64>, %then_value: reg<x86.gpr32>, %else_value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %cmp = cmp.slt.gpr64 %lhs, %rhs
  %14 = copy %else_value : reg<x86.gpr32> -> reg<x86.gpr32>
  %result = select.gpr32 %cmp, %then_value, %14
  return %result
}

