x86.target<avx2> @target

func.def target(@target) @wide_right_shift_constant(%values: vector<2xi64>) -> (i64, i64) {
  %value = vector.extract %values[1] : vector<2xi64> -> i64
  %count = scalar.constant 31 : i64
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  func.return %logical, %signed : i64, i64
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @wide_right_shift_constant(%values: reg<x86.xmm>) -> (reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %value = vpextrq.xmm %values, 1
  %11 = copy %value : reg<x86.gpr64> -> reg<x86.gpr64>
  %logical = shr.imm.gpr64 %11 {shift = 31}
  %13 = copy %value : reg<x86.gpr64> -> reg<x86.gpr64>
  %signed = sar.imm.gpr64 %13 {shift = 31}
  return %logical, %signed
}
