// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @wide_branch_carrier(%initial: offset, %iteration_count: i32) -> (offset) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %stride = index.constant 1 : offset
  cfg.br ^header(%iteration_count: i32, %initial: offset)
^header(%remaining: i32, %value: offset):
  %next_value = index.sub %value, %stride : offset
  %more = scalar.cmpi sgt, %remaining, %c0 : i32
  cfg.cond_br %more, ^body, ^exit
^body:
  %next_remaining = scalar.subi %remaining, %c1 : i32
  cfg.br ^header(%next_remaining: i32, %next_value: offset)
^exit:
  func.return %value : offset
}

// A proven-wide index seed must keep the complete carrier width after the CFG
// fact meet makes the header and recurrence result ranges unknown.
func.def target(@target) @wide_index_branch_carrier() -> (index) {
  %initial = index.constant 4294967303 : index
  %iteration_count = scalar.constant 3 : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %step = index.constant 1 : index
  cfg.br ^header(%iteration_count: i32, %initial: index)
^header(%remaining: i32, %value: index):
  %more = scalar.cmpi sgt, %remaining, %c0 : i32
  cfg.cond_br %more, ^body, ^exit
^body:
  %next_remaining = scalar.subi %remaining, %c1 : i32
  %next_value = index.sub %value, %step : index
  cfg.br ^header(%next_remaining: i32, %next_value: index)
^exit:
  func.return %value : index
}

// A structurally identical narrow component must retain the single-register
// scalar path.
func.def target(@target) @narrow_index_branch_carrier() -> (index) {
  %initial = index.constant 7 : index
  %iteration_count = scalar.constant 3 : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %step = index.constant 1 : index
  cfg.br ^header(%iteration_count: i32, %initial: index)
^header(%remaining: i32, %value: index):
  %more = scalar.cmpi sgt, %remaining, %c0 : i32
  cfg.cond_br %more, ^body, ^exit
^body:
  %next_remaining = scalar.subi %remaining, %c1 : i32
  %next_value = index.sub %value, %step : index
  cfg.br ^header(%next_remaining: i32, %next_value: index)
^exit:
  func.return %value : index
}

// Structured loop relations must preserve the same wide carrier decision
// through the condition, body, yield, and result boundaries.
func.def target(@target) @wide_index_while_carrier() -> (index) {
  %initial = index.constant 4294967303 : index
  %iteration_count = scalar.constant 3 : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %step = index.constant 1 : index
  %final_remaining, %final_value = scf.while(%remaining = %iteration_count : i32, %value = %initial : index) -> (i32, index) {
    %more = scalar.cmpi sgt, %remaining, %c0 : i32
    scf.condition %more, %remaining, %value : i1, i32, index
  } do(%remaining: i32, %value: index) {
    %next_remaining = scalar.subi %remaining, %c1 : i32
    %next_value = index.sub %value, %step : index
    scf.yield %next_remaining, %next_value : i32, index
  }
  func.return %final_value : index
}

// Select result facts preserve the wide alternative while lowering adapts the
// independently represented narrow payload at the operation boundary.
func.def target(@target) @wide_index_select_carrier(%condition: i1) -> (index) {
  %wide = index.constant 4294967303 : index
  %narrow = index.constant 7 : index
  %selected = scf.select %condition, %wide, %narrow : index
  func.return %selected : index
}

// A narrow argument widened for one select remains usable by an independently
// narrow address-domain cast.
func.def target(@target) @wide_select_narrow_reuse(%narrow: index, %condition: i1) -> (index, offset) where [range(%narrow, 0, 1023)] {
  %wide = index.constant 4294967303 : index
  %selected = scf.select %condition, %wide, %narrow : index
  %offset = index.cast %narrow : index to offset
  func.return %selected, %offset : index, offset
}

// A dynamic wide multiply-add has no scalar realization and must constrain its
// transported result to the vector-register alternative.
func.def target(@target) @wide_index_madd_carrier(%wide: index, %condition: i1) -> (index) where [range(%wide, 4294967296, 4294967396)] {
  %scale = index.constant 3 : index
  %low = index.constant 7 : index
  %result = index.madd %wide, %scale, %low : index
  %selected = scf.select %condition, %result, %wide : index
  func.return %selected : index
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_branch_carrier(%initial: reg<amdgpu.sgpr x2>, %iteration_count: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %c0 = s_mov_b32 0
  %stride = s_mov_b32 1
  %86 = slice %initial[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %87 = v_mov_b32_copy %86
  %88 = slice %initial[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %89 = v_mov_b32_copy %88
  %90 = concat(%87, %89) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^header(%iteration_count: reg<amdgpu.sgpr>, %90: reg<amdgpu.vgpr x2>)
^header(%remaining: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr x2>):
  %91 = v_mov_b32_copy %stride
  %92 = v_mov_b32 0
  %94 = slice %value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %95 = slice %value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %98, %99 = v_sub_co_u32 %94, %91
  %100, %101 = v_sub_co_ci_u32 %95, %92, %99
  %next_value = concat(%98, %100) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %more = s_cmp_gt_i32 %remaining, %c0
  low.cond_br %more, ^body, ^exit : reg<amdgpu.scc>
^body:
  %104 = s_mov_b32 4294967295
  %next_remaining = s_add_u32 %remaining, %104
  low.br ^header(%next_remaining: reg<amdgpu.sgpr>, %next_value: reg<amdgpu.vgpr x2>)
^exit:
  return %value
}

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_index_branch_carrier() -> (reg<amdgpu.vgpr x2>) asm {
  %109 = v_mov_b32 7
  %110 = v_mov_b32 1
  %initial = concat(%109, %110) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %iteration_count = s_mov_b32 3
  %c0 = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^header(%iteration_count: reg<amdgpu.sgpr>, %initial: reg<amdgpu.vgpr x2>)
^header(%remaining: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr x2>):
  %more = s_cmp_gt_i32 %remaining, %c0
  low.cond_br %more, ^body, ^exit : reg<amdgpu.scc>
^body:
  %116 = s_mov_b32 4294967295
  %next_remaining = s_add_u32 %remaining, %116
  %118 = v_mov_b32_copy %step
  %119 = v_mov_b32 0
  %121 = slice %value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %122 = slice %value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %125, %126 = v_sub_co_u32 %121, %118
  %127, %128 = v_sub_co_ci_u32 %122, %119, %126
  %next_value = concat(%125, %127) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^header(%next_remaining: reg<amdgpu.sgpr>, %next_value: reg<amdgpu.vgpr x2>)
^exit:
  return %value
}

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @narrow_index_branch_carrier() -> (reg<amdgpu.sgpr>) asm {
  %initial = s_mov_b32 7
  %iteration_count = s_mov_b32 3
  %c0 = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^header(%iteration_count: reg<amdgpu.sgpr>, %initial: reg<amdgpu.sgpr>)
^header(%remaining: reg<amdgpu.sgpr>, %value: reg<amdgpu.sgpr>):
  %more = s_cmp_gt_i32 %remaining, %c0
  low.cond_br %more, ^body, ^exit : reg<amdgpu.scc>
^body:
  %138 = s_mov_b32 4294967295
  %next_remaining = s_add_u32 %remaining, %138
  %next_value = s_sub_u32 %value, %step
  low.br ^header(%next_remaining: reg<amdgpu.sgpr>, %next_value: reg<amdgpu.sgpr>)
^exit:
  return %value
}

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_index_while_carrier() -> (reg<amdgpu.vgpr x2>) asm {
  %144 = v_mov_b32 7
  %145 = v_mov_b32 1
  %initial = concat(%144, %145) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %iteration_count = s_mov_b32 3
  %c0 = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^_bb1(%iteration_count: reg<amdgpu.sgpr>, %initial: reg<amdgpu.vgpr x2>)
^_bb1(%remaining: reg<amdgpu.sgpr>, %value: reg<amdgpu.vgpr x2>):
  %more = s_cmp_gt_i32 %remaining, %c0
  low.cond_br %more, ^_bb2, ^_bb3 : reg<amdgpu.scc>
^_bb2:
  %151 = s_mov_b32 4294967295
  %next_remaining = s_add_u32 %remaining, %151
  %153 = v_mov_b32_copy %step
  %154 = v_mov_b32 0
  %156 = slice %value[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %157 = slice %value[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %160, %161 = v_sub_co_u32 %156, %153
  %162, %163 = v_sub_co_ci_u32 %157, %154, %161
  %next_value = concat(%160, %162) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  low.br ^_bb1(%next_remaining: reg<amdgpu.sgpr>, %next_value: reg<amdgpu.vgpr x2>)
^_bb3:
  return %value
}

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_index_select_carrier(%condition: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>) asm {
  %167 = s_mov_b32 7
  %168 = s_mov_b32 1
  %171 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %172 = s_mov_b32 0
  %176 = s_cselect_b32 %167, %167, %171
  %179 = s_cselect_b32 %168, %172, %171
  %selected = concat(%176, %179) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %selected
}

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_select_narrow_reuse(%offset: reg<amdgpu.sgpr>, %condition: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>) where [range(%offset, 0, 1023)] asm {
  %185 = s_mov_b32 7
  %186 = s_mov_b32 1
  %188 = s_cmp_lg_i32_src1_inline %condition {rhs = 0}
  %189 = s_mov_b32 0
  %193 = s_cselect_b32 %185, %offset, %188
  %196 = s_cselect_b32 %186, %189, %188
  %selected = concat(%193, %196) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %selected, %offset
}

low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @wide_index_madd_carrier(%wide: reg<amdgpu.sgpr x2>, %condition: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x2>) where [range(%wide, 4294967296, 4294967396)] asm {
  %scale = s_mov_b32 3
  %low = s_mov_b32 7
  %203 = slice %wide[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %204 = v_mov_b32_copy %203
  %205 = slice %wide[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %206 = v_mov_b32_copy %205
  %208 = v_mov_b32_copy %scale
  %209 = v_mov_b32 0
  %215 = v_mul_lo_u32 %204, %208
  %216 = v_mul_hi_u32 %204, %208
  %217 = v_mul_lo_u32 %204, %209
  %218 = v_mul_lo_u32 %206, %208
  %219 = v_add_u32 %216, %217
  %220 = v_add_u32 %219, %218
  %222 = v_mov_b32_copy %low
  %229, %230 = v_add_co_u32 %215, %222
  %231, %232 = v_add_co_ci_u32 %220, %209, %230
  %237 = v_cndmask_b32 %204, %229, %condition
  %241 = v_cndmask_b32 %206, %231, %condition
  %selected = concat(%237, %241) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %selected
}
