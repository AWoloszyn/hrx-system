// TEMPLATE: loom/src/loom/test/corpus/source_low/layout_predicate_extract.loom-test
// RUN: emit source-low target=amdgpu:gfx942 output=low

// A singleton predicate vector and its only element share the same mask.
func.def @single_predicate(%input: vector<1xi1>) -> (i1) {
  %result = vector.extract %input[0] : vector<1xi1> -> i1
  func.return %result : i1
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @single_predicate(%result: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>) asm {
  return %result
}

// ====

func.def @predicate_lanes(%input: vector<4xi1>) -> (i1, i1) {
  %first = vector.extract %input[0] : vector<4xi1> -> i1
  %last = vector.extract %input[3] : vector<4xi1> -> i1
  func.return %first, %last : i1, i1
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @predicate_lanes(%input: reg<amdgpu.sgpr x8>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %8 = slice %input[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %9 = slice %input[1] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %first = concat(%8, %9) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %11 = slice %input[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %12 = slice %input[7] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %last = concat(%11, %12) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %first, %last
}

// ====

// Both consumers use the original comparison results.
func.def @comparison_lane(%lhs: vector<4xi32>, %rhs: vector<4xi32>) -> (vector<4xi1>, i1) {
  %mask = vector.cmpi slt, %lhs, %rhs : vector<4xi32> -> vector<4xi1>
  %last = vector.extract %mask[3] : vector<4xi1> -> i1
  func.return %mask, %last : vector<4xi1>, i1
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @comparison_lane(%lhs: reg<amdgpu.vgpr x4>, %rhs: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.sgpr x8>, reg<amdgpu.sgpr x2>) asm {
  %10 = slice %lhs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %11 = slice %rhs[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %12 = v_cmp_lt_i32 %10, %11
  %13 = slice %lhs[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %14 = slice %rhs[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %15 = v_cmp_lt_i32 %13, %14
  %16 = slice %lhs[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %17 = slice %rhs[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %18 = v_cmp_lt_i32 %16, %17
  %19 = slice %lhs[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %20 = slice %rhs[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %21 = v_cmp_lt_i32 %19, %20
  %mask = concat(%12, %15, %18, %21) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x8>
  %23 = slice %mask[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %24 = slice %mask[7] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %last = concat(%23, %24) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %mask, %last
}

// ====

func.def @select_lane(%input: vector<4xi1>, %lhs: i32, %rhs: i32) -> (i32) {
  %last = vector.extract %input[3] : vector<4xi1> -> i1
  %selected = scf.select %last, %lhs, %rhs : i32
  func.return %selected : i32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @select_lane(%input: reg<amdgpu.sgpr x8>, %lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %10 = slice %input[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %11 = slice %input[7] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %last = concat(%10, %11) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %13 = v_mov_b32_copy %lhs
  %14 = v_mov_b32_copy %rhs
  %selected = v_cndmask_b32 %14, %13, %last
  return %selected
}

// ====

// A CFG merge preserves every work item's predicate before the final select.
func.def @merged_predicate(%input: vector<4xi1>, %choose_first: i1, %lhs: i32, %rhs: i32) -> (i32) {
  cfg.cond_br %choose_first, ^first, ^last
^first:
  %first = vector.extract %input[0] : vector<4xi1> -> i1
  cfg.br ^merge(%first: i1)
^last:
  %last = vector.extract %input[3] : vector<4xi1> -> i1
  cfg.br ^merge(%last: i1)
^merge(%condition: i1):
  %selected = scf.select %condition, %lhs, %rhs : i32
  func.return %selected : i32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @merged_predicate(%input: reg<amdgpu.sgpr x8>, %choose_first: reg<amdgpu.sgpr>, %lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %15 = s_mov_b32 0
  %16 = s_cmp_lg_i32 %choose_first, %15
  low.cond_br %16, ^first, ^last : reg<amdgpu.scc>
^first:
  %17 = slice %input[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %18 = slice %input[1] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %first = concat(%17, %18) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  low.br ^merge(%first: reg<amdgpu.sgpr x2>)
^last:
  %20 = slice %input[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %21 = slice %input[7] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr>
  %last = concat(%20, %21) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  low.br ^merge(%last: reg<amdgpu.sgpr x2>)
^merge(%condition: reg<amdgpu.sgpr x2>):
  %23 = v_mov_b32_copy %lhs
  %24 = v_mov_b32_copy %rhs
  %selected = v_cndmask_b32 %24, %23, %condition
  return %selected
}
