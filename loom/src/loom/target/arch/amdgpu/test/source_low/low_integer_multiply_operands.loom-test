// RUN: pass low-select-operand-forms,low-cse,low-dce

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @multiply_gfx942_64(%vector: reg<amdgpu.vgpr>, %scalar: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) asm {
  %constant = v_mov_b32 64
  %low_left = v_mul_lo_u32 %constant, %vector
  %low_right = v_mul_lo_u32 %scalar, %constant
  %high_left = v_mul_hi_u32 %constant, %vector
  %high_right = v_mul_hi_u32 %scalar, %constant
  return %low_left, %low_right, %high_left, %high_right
}

