  %47 = s_mov_b32 822173696
  %48 = concat(%45, %46, %47) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %33 = v_mov_b32 0
  %seen = buffer_atomic_add_u32_rtn %33, %48, %30, %28
  s_waitcnt {vmcnt = 0}
  buffer_gl1_inv
  buffer_gl0_inv
  %after = s_load_dword %source, %28
  %37 = v_mov_b32_copy %before
  global_store_b32_saddr %30, %37, %destination
  %39 = v_mov_b32_copy %after
  global_store_b32_saddr %30, %39, %destination {offset = 4}
  return
}

