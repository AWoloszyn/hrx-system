  %41 = slice %notice[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %42 = slice %notice[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %43 = s_mov_b32 65535
  %44 = s_and_b32 %42, %43
