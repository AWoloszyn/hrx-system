// RUN: compile-report source-to-low,low-dce

amdgpu.target<gfx11-generic> @target

// The unique entry is textually after the latch. Counts use semantic nesting,
// so the header executes five times and the body store executes four times.
kernel.def target(@target) @reordered_counted_loop() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %loop_begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<4xi32>
  cfg.br ^preheader
^header(%position: index):
  %more = index.cmp slt, %position, %end : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %value = index.cast %position : index to i32
  view.store %value, %output_view[%loop_begin] : i32, view<4xi32>
  %next = index.add %position, %step : index
  cfg.br ^header(%next: index)
^exit:
  kernel.return
^preheader:
  cfg.br ^header(%loop_begin: index)
}

