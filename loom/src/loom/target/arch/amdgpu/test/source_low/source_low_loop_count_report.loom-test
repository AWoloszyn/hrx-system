// RUN: compile-report source-to-low,low-dce

amdgpu.target<gfx11-generic> @target

// A signed guard on offset still checks overflow at the 64-bit sign boundary.
kernel.def target(@target) @wide_signed_terminal_wraps() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %begin = index.constant 9223372036854775806 : offset
  %end = index.constant 9223372036854775807 : offset
  %step = index.constant 2 : offset
  %base = index.constant 0 : offset
  %position = index.constant 0 : index
  %output_view = buffer.view %output[%base] : buffer -> view<1xi64>
  cfg.br ^header(%begin: offset)
^header(%counter: offset):
  %more = index.cmp slt, %counter, %end : offset
  cfg.cond_br %more, ^body, ^exit
^body:
  %value = index.cast %counter : offset to i64
  view.store %value, %output_view[%position] : i64, view<1xi64>
  %next = index.add %counter, %step : offset
  cfg.br ^header(%next: offset)
^exit:
  kernel.return
}

