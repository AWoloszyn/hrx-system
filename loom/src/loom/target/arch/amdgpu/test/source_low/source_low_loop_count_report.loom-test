// RUN: compile-report source-to-low,low-dce

amdgpu.target<gfx11-generic> @target

// The unsigned view of -1 is above four, so the body never executes.
kernel.def target(@target) @unsigned_empty() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %begin = index.constant -1 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %position = index.constant 0 : index
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  cfg.br ^header(%begin: index)
^header(%counter: index):
  %more = index.cmp ult, %counter, %end : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %value = index.cast %counter : index to i32
  view.store %value, %output_view[%position] : i32, view<1xi32>
  %next = index.add %counter, %step : index
  cfg.br ^header(%next: index)
^exit:
  kernel.return
}

