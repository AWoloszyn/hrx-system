  %source = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %word = resource<hal_binding> {extent = 4, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %12 = storage {byte_alignment = 4, byte_length = 4} : low.storage<workgroup>
  %14 = v_mov_b32 0
  %value = global_load_b32_saddr %14, %source
  ds_write_b32 %14, %value
  s_wait_dscnt {dscnt = 0}
  global_atomic_add_u32_saddr %14, %value, %word {scope = 2}
  return
}

