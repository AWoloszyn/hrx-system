kernel.def @publish_release_reduce_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload: buffer, %signal: buffer, %result: buffer, %value: i32) {
  %origin = index.constant 0 : offset
  %payload_view = buffer.view %payload[%origin] : buffer -> view<1xi32>
  %signal_view = buffer.view %signal[%origin] : buffer -> view<1xi32>
  %result_view = buffer.view %result[%origin] : buffer -> view<2xi32>
  %increment = scalar.constant 1 : i32
  view.store %value, %payload_view[0] : i32, view<1xi32>
  view.atomic.reduce<addi> %increment, %signal_view[0] {ordering = release, scope = device} : i32, view<1xi32>
  kernel.return
}

