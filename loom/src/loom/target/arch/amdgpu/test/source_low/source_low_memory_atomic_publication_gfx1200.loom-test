  %29 = concat(%27, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %30 = v_mov_b32 1
  %32 = concat(%30, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %33 = concat(%32, %29) : (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) -> reg<amdgpu.vgpr x4>
  %old = flat_atomic_cmpswap_b64_rtn %26, %33 {scope = 2}
  s_wait_loadcnt {loadcnt = 0}
