// A generic CAS can complete in global or workgroup memory, including failure.
kernel.def @acquire_generic_compare_exchange() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%storage: buffer, %payload: buffer, %result: buffer) {
  %origin = index.constant 0 : offset
  %generic = buffer.assume.memory_space<generic> %storage : buffer
  %word = buffer.view %generic[%origin] : buffer -> view<1xi64>
  %payload_view = buffer.view %payload[%origin] : buffer -> view<1xi64>
  %result_view = buffer.view %result[%origin] : buffer -> view<2xi64>
  %expected = scalar.constant 0 : i64
  %replacement = scalar.constant 1 : i64
  %old = view.atomic.cmpxchg %expected, %replacement, %word[0] {failure_ordering = acquire, scope = device, success_ordering = acquire} : i64, view<1xi64> -> i64
  %observed = view.load %payload_view[0] : view<1xi64> -> i64
  view.store %observed, %result_view[1] : i64, view<2xi64>
  view.store %old, %result_view[0] : i64, view<2xi64>
  kernel.return
}

