// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_atomic_observations.loom
// RUN: emit source-low target=amdgpu:gfx1200 output=low

// Each observation transports all 64 bits through an interior view at device
// or system scope, preserving both words and the exact access footprint.
kernel.def @atomic_observation_bits() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%storage: buffer, %output: buffer, %value: i64) {
  %base = index.constant 8 : offset
  %output_base = index.constant 16 : offset
  %global = buffer.assume.memory_space<global> %storage : buffer
  %integer_whole = buffer.view %global[%base] : buffer -> view<8xi64>
  %integers = view.subview %integer_whole[1] : view<8xi64> -> view<6xi64>
  %results = buffer.view %output[%output_base] : buffer -> view<6xi64>
  %relaxed_integer = view.atomic.load %integers[0] {ordering = relaxed, scope = device} : view<6xi64> -> i64
  view.atomic.store %value, %integers[0] {ordering = relaxed, scope = device} : i64, view<6xi64>
  view.store %relaxed_integer, %results[0] : i64, view<6xi64>
  %acquired_integer = view.atomic.load %integers[1] {ordering = acquire, scope = device} : view<6xi64> -> i64
  view.atomic.store %value, %integers[1] {ordering = release, scope = device} : i64, view<6xi64>
  view.store %acquired_integer, %results[1] : i64, view<6xi64>
  %sequential_integer = view.atomic.load %integers[2] {ordering = seq_cst, scope = device} : view<6xi64> -> i64
  view.atomic.store %value, %integers[2] {ordering = seq_cst, scope = device} : i64, view<6xi64>
  view.store %sequential_integer, %results[2] : i64, view<6xi64>
  %relaxed_system = view.atomic.load %integers[3] {ordering = relaxed, scope = system} : view<6xi64> -> i64
  view.atomic.store %value, %integers[3] {ordering = relaxed, scope = system} : i64, view<6xi64>
  view.store %relaxed_system, %results[3] : i64, view<6xi64>
  %acquired_system = view.atomic.load %integers[4] {ordering = acquire, scope = system} : view<6xi64> -> i64
  view.atomic.store %value, %integers[4] {ordering = release, scope = system} : i64, view<6xi64>
  view.store %acquired_system, %results[4] : i64, view<6xi64>
  %sequential_system = view.atomic.load %integers[5] {ordering = seq_cst, scope = system} : view<6xi64> -> i64
  view.atomic.store %value, %integers[5] {ordering = seq_cst, scope = system} : i64, view<6xi64>
  view.store %sequential_system, %results[5] : i64, view<6xi64>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 2, direct_arg_count = 1, direct_arg_names = {arg0 = "value"}, direct_arg_offsets = [16], direct_arg_parameter_indices = [2], direct_arg_sizes = [8], parameter_count = 3, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @atomic_observation_bits(%value: reg<amdgpu.sgpr x2>) asm {
  %integer_whole = resource<hal_binding> {extent = 72, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %results = resource<hal_binding> {extent = 64, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %19 = v_mov_b32 0
  %relaxed_integer = global_load_b64_saddr<volatile> %19, %integer_whole {offset = 16, scope = 2}
  %21 = slice %value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22 = v_mov_b32_copy %21
  %23 = slice %value[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = v_mov_b32_copy %23
  %25 = concat(%22, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr<volatile> %19, %25, %integer_whole {offset = 16, scope = 2}
  global_store_b64_saddr %19, %relaxed_integer, %results {offset = 16}
  %acquired_integer = global_load_b64_saddr<volatile> %19, %integer_whole {offset = 24, scope = 2}
  s_wait_loadcnt {loadcnt = 0}
  global_inv {scope = 2}
  s_wait_dscnt {dscnt = 0}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  %34 = concat(%22, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr<volatile> %19, %34, %integer_whole {offset = 24, scope = 2}
  global_store_b64_saddr %19, %acquired_integer, %results {offset = 24}
  s_wait_dscnt {dscnt = 0}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  %sequential_integer = global_load_b64_saddr<volatile> %19, %integer_whole {offset = 32, scope = 2}
  s_wait_loadcnt {loadcnt = 0}
  global_inv {scope = 2}
  s_wait_dscnt {dscnt = 0}
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  %43 = concat(%22, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr<volatile> %19, %43, %integer_whole {offset = 32, scope = 2}
  global_store_b64_saddr %19, %sequential_integer, %results {offset = 32}
  %relaxed_system = global_load_b64_saddr<volatile> %19, %integer_whole {offset = 40, scope = 3}
  %52 = concat(%22, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr<volatile> %19, %52, %integer_whole {offset = 40, scope = 3}
  global_store_b64_saddr %19, %relaxed_system, %results {offset = 40}
  %acquired_system = global_load_b64_saddr<volatile> %19, %integer_whole {offset = 48, scope = 3}
  s_wait_loadcnt {loadcnt = 0}
  global_inv {scope = 3}
  s_wait_dscnt {dscnt = 0}
  global_wb {scope = 3}
  s_wait_storecnt {storecnt = 0}
  %61 = concat(%22, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr<volatile> %19, %61, %integer_whole {offset = 48, scope = 3}
  global_store_b64_saddr %19, %acquired_system, %results {offset = 48}
  s_wait_dscnt {dscnt = 0}
  global_wb {scope = 3}
  s_wait_storecnt {storecnt = 0}
  %sequential_system = global_load_b64_saddr<volatile> %19, %integer_whole {offset = 56, scope = 3}
  s_wait_loadcnt {loadcnt = 0}
  global_inv {scope = 3}
  s_wait_dscnt {dscnt = 0}
  global_wb {scope = 3}
  s_wait_storecnt {storecnt = 0}
  %70 = concat(%22, %24) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr<volatile> %19, %70, %integer_whole {offset = 56, scope = 3}
  global_store_b64_saddr %19, %sequential_system, %results {offset = 56}
  return
}
