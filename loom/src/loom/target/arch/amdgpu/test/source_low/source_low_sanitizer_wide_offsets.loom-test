  %9, %10 = s_add_u32_rhs_symbol_rel32_lo %7 {symbol = @iree_asan_config}
  %11, %12 = s_addc_u32_rhs_symbol_rel32_hi %8, %10 {symbol = @iree_asan_config}
  %13 = concat(%9, %11) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %14 = s_load_dwordx2_offset_only %13 {offset = 16}
  %15 = v_mov_b32 0
  %16 = v_mov_b32 128
  %17 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = slice %byte_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = slice %byte_offset[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21, %22 = s_add_co_u32 %17, %19
  %23, %24 = s_addc_u32 %18, %20, %22
  %28 = v_mov_b32_copy %21
  %29 = v_mov_b32_copy %23
  %31 = slice %14[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %32 = v_mov_b32_copy %31
  %33 = slice %14[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %34 = v_mov_b32_copy %33
  %38 = v_lshrrev_b32_lit %28, 3
  %39 = v_lshlrev_b32_lit %29, 29
  %40 = v_or_b32 %38, %39
  %41 = v_lshrrev_b32_lit %29, 3
  %47, %48 = v_add_co_u32 %32, %40
  %49, %50 = v_add_co_ci_u32 %34, %41, %48
  %51 = concat(%47, %49) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %52 = flat_load_u8 %51 {glc = 1, dlc = 1}
  s_waitcnt {vmcnt = 0}
  %54 = v_and_b32_lit %28, 7
  %55 = v_add_u32_lit %54, 3
  %56 = v_cmp_ne_i32 %52, %15
  %57 = v_cmp_ge_u32 %52, %16
  %58 = v_cmp_ge_u32 %55, %52
  %59 = s_and_b64 %56, %58
  %60 = s_or_b64 %57, %59
  %61 = v_mov_b32 3
  %68, %69 = v_add_co_u32 %28, %61
  %70, %71 = v_add_co_ci_u32 %29, %15, %69
  %80 = v_lshrrev_b32_lit %68, 3
  %81 = v_lshlrev_b32_lit %70, 29
  %82 = v_or_b32 %80, %81
  %83 = v_lshrrev_b32_lit %70, 3
  %89, %90 = v_add_co_u32 %32, %82
  %91, %92 = v_add_co_ci_u32 %34, %83, %90
  %93 = concat(%89, %91) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %94 = flat_load_u8 %93 {glc = 1, dlc = 1}
  s_waitcnt {vmcnt = 0}
  %96 = v_and_b32_lit %68, 7
  %97 = v_cmp_ne_i32 %94, %15
  %98 = v_cmp_ge_u32 %94, %16
  %99 = v_cmp_ge_u32 %96, %94
  %100 = s_and_b64 %97, %99
  %101 = s_or_b64 %98, %100
  %102 = s_or_b64 %60, %101
  %103 = slice %102[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %104 = s_mov_b32 0
  %105 = concat(%103, %104) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %114 = concat(%104, %104) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
