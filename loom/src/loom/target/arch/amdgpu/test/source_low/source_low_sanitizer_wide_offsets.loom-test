low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @sanitizer_wide_dynamic_offset(%byte_offset: reg<amdgpu.sgpr x2>) asm {
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %6 = s_getpc_b64
