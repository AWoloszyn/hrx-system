amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @unsigned_empty(%address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %begin = s_mov_b32 4294967295
  %end = s_mov_b32 4
  %step = s_mov_b32 1
  low.br ^header(%begin: reg<amdgpu.sgpr>)
^header(%counter: reg<amdgpu.sgpr>):
  %more = s_cmp_lt_u32 %counter, %end
  low.cond_br %more, ^body, ^exit : reg<amdgpu.scc>
^body:
  %value = v_mov_b32_copy %counter
  global_store_b32_saddr %address, %value, %output
  %next = s_add_u32 %counter, %step
  low.br ^header(%next: reg<amdgpu.sgpr>)
^exit:
  %final = v_mov_b32_copy %counter
  global_store_b32_saddr %address, %final, %output
  return
}

