// RUN: with-checks emit low-compile-report @signed_inclusive

// Signed inclusive bounds execute three body stores and one exit store.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @signed_inclusive(%address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %begin = s_mov_b32 4294967295
  %end = s_mov_b32 1
  %step = s_mov_b32 1
  low.br ^header(%begin: reg<amdgpu.sgpr>)
^header(%counter: reg<amdgpu.sgpr>):
  %more = s_cmp_le_i32 %counter, %end
  low.cond_br %more, ^body, ^exit : reg<amdgpu.scc>
^body:
  %value = v_mov_b32_copy %counter
  global_store_b32_saddr %address, %value, %output
  %next = s_add_u32 %counter, %step
  low.br ^header(%next: reg<amdgpu.sgpr>)
^exit:
  %final = v_mov_b32_copy %counter
  global_store_b32_saddr %address, %final, %output
  return
}

// ----
CHECK: COMPILE-REPORT: dynamic_instruction_mix * global_store=4 *

// ====

// RUN: with-checks emit low-compile-report @equality_guard

// Equality is not an upper-bound guard; the recognizer must leave it unknown.
amdgpu.target<gfx1151> @target

low.func.def target<amdgpu.rdna3_5.core>(@target) @equality_guard(%address: reg<amdgpu.vgpr>, %output: reg<amdgpu.sgpr x2>) asm {
  %begin = s_mov_b32 0
  %end = s_mov_b32 0
  %step = s_mov_b32 1
  low.br ^header(%begin: reg<amdgpu.sgpr>)
^header(%counter: reg<amdgpu.sgpr>):
  %more = s_cmp_eq_i32 %counter, %end
  low.cond_br %more, ^body, ^exit : reg<amdgpu.scc>
^body:
  %value = v_mov_b32_copy %counter
  global_store_b32_saddr %address, %value, %output
  %next = s_add_u32 %counter, %step
  low.br ^header(%next: reg<amdgpu.sgpr>)
^exit:
  %final = v_mov_b32_copy %counter
  global_store_b32_saddr %address, %final, %output
  return
}

// ----
CHECK: COMPILE-REPORT: static_instruction_mix * global_store=2 *
CHECK-NOT: COMPILE-REPORT: dynamic_instruction_mix *

