// RUN: emit source-low target=amdgpu:gfx942 output=low

func.def @signed_byte_term(%input: i8, %table: buffer) -> (i32) {
  %coordinate = index.cast %input : i8 to index
  %bias = index.constant 128 : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<256xi32>
  %value = view.load %view[%position] : view<256xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @signed_byte_term(%input: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {extent = 1024, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %12 = v_lshlrev_b32_src0_inline %input, 2
  %13 = v_ashrrev_i32_src0_inline %input, 30
  %14 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16, %17 = v_add_co_u32 %14, %12
  %18 = v_mov_b32_copy %15
  %19, %20 = v_addc_co_u32 %18, %13, %17
  %21 = concat(%16, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %22 = s_mov_b32_m0_imm 0
  %value = global_load_dword_vaddr %21, %22 {offset = 512}
  return %value
}

