  %bias = index.constant 1 : index
  %position = index.add %coordinate, %bias : index
  %view = buffer.view %table[%base] : buffer -> view<3x1073741824xi32>
  %value = view.load %view[%position, 0] : view<3x1073741824xi32> -> i32
  func.return %value : i32
}

