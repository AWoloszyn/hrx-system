  %view = resource<hal_binding> {extent = 262144, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %12 = s_mov_b32 131072
  %13 = s_mov_b32 0
  %15 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19, %20 = s_add_co_u32 %15, %12
  %21, %22 = s_addc_u32 %16, %13, %20
  %24 = v_lshlrev_b32_src0_inline %input, 2
  %25 = v_ashrrev_i32_src0_inline %input, 30
  %28, %29 = v_add_co_u32 %19, %24
  %30 = v_mov_b32_copy %21
  %31, %32 = v_addc_co_u32 %30, %25, %29
  %33 = concat(%28, %31) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %34 = s_mov_b32_m0_imm 0
  %value = global_load_dword_vaddr %33, %34
  return %value
}

