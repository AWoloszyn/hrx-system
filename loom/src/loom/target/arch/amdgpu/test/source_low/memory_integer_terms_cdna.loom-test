func.def @workgroup_signed_byte_term(%input: i8, %value: i32) -> (i32) {
  %coordinate = index.cast %input : i8 to index
  %bias = index.constant 128 : index
  %position = index.add %coordinate, %bias : index
  %length = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %scratch[%base] : buffer -> view<256xi32>
  view.store %value, %view[%position] : i32, view<256xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %view[%position] : view<256xi32> -> i32
  func.return %loaded : i32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @workgroup_signed_byte_term(%input: reg<amdgpu.vgpr>, %value: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %14 = storage {byte_alignment = 4, byte_length = 1024} : low.storage<workgroup>
  %16 = v_mov_b32_copy %value
  %17 = v_lshlrev_b32_src0_inline %input, 2
  ds_write_b32 %17, %16 {offset = 512}
  s_barrier
  %18 = v_lshlrev_b32_src0_inline %input, 2
  %loaded = ds_read_b32 %18 {offset = 512}
  return %loaded
}

