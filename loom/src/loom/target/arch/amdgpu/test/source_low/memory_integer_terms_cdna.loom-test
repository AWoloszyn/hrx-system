// ====

// The complete coordinate fits i32 although neither the i64 input nor its
// positive bias does. Workgroup arithmetic may project their low bits.
func.def @workgroup_wide_cancellation(%input: i64, %value: i32) -> (i32) {
  %bounded = scalar.assume %input [range(%input, -4294967296, -4294967169)] : i64
  %bias = scalar.constant 4294967296 : i64
  %ordinal = scalar.addi %bounded, %bias : i64
  %position = index.cast %ordinal : i64 to index
  %length = index.constant 512 : offset
  %scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %scratch[%base] : buffer -> view<128xi32>
  view.store %value, %view[%position] : i32, view<128xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %view[%position] : view<128xi32> -> i32
  func.return %loaded : i32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @workgroup_wide_cancellation(%bounded: reg<amdgpu.sgpr x2>, %value: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %15 = storage {byte_alignment = 4, byte_length = 512} : low.storage<workgroup>
  %17 = v_mov_b32_copy %value
  %18 = slice %bounded[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = v_mov_b32_copy %18
  %20 = v_lshlrev_b32_src0_inline %19, 2
  ds_write_b32 %20, %17
  s_barrier
  %21 = slice %bounded[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22 = v_mov_b32_copy %21
  %23 = v_lshlrev_b32_src0_inline %22, 2
  %loaded = ds_read_b32 %23
  return %loaded
}

// ====

// Adding a static displacement to a full-width offset can lose the analyzed
// range without losing representability in the native address carrier.
func.def @offset_with_static_displacement(%base: offset, %table: buffer) -> (i32) {
  %view = buffer.view %table[%base] : buffer -> view<2xi32>
  %value = view.load %view[1] : view<2xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @offset_with_static_displacement(%base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %8 = v_mov_b32 0
  %9 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %10 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %11 = slice %base[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %12 = slice %base[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %13, %14 = s_add_co_u32 %9, %11
  %15, %16 = s_addc_u32 %10, %12, %14
  %17 = concat(%13, %15) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %18 = s_mov_b32_m0_imm 0
  %value = global_load_dword_saddr %8, %17, %18 {offset = 4}
  return %value
}

