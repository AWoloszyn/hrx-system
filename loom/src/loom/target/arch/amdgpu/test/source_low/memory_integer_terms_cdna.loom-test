func.def @varying_predicate_term(%input: buffer, %table: buffer) -> (i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %sign_boundary = scalar.constant 0 : i32
  %negative = scalar.cmpi slt, %raw, %sign_boundary : i32
  %coordinate = index.cast %negative : i1 to index
  %bias = index.constant 1 : index
  %position = index.add %coordinate, %bias : index
  %view = buffer.view %table[%base] : buffer -> view<3xi32>
  %value = view.load %view[%position] : view<3xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @varying_predicate_term() -> (reg<amdgpu.vgpr>) asm {
  %source = resource<hal_binding> {extent = 4, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %view = resource<hal_binding> {extent = 12, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %16 = v_mov_b32 0
  %17 = s_mov_b32_m0_imm 0
  %raw = global_load_dword_saddr %16, %source, %17
  %negative = v_cmp_lt_i32_src1_inline %raw {rhs = 0}
  %21 = v_mov_b32 1
  %22 = v_cndmask_b32 %16, %21, %negative
  %23 = v_lshlrev_b32_src0_inline %22, 2
  %24 = s_mov_b32_m0_imm 0
  %value = global_load_dword_saddr %23, %view, %24 {offset = 4}
  return %value
}

