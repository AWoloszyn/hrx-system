  %bias = s_mov_b32 4294967168
  %position = s_add_u32 %coordinate, %bias
  %15 = v_mov_b32 0
  %16 = s_lshl_b32_rhs_inline %position, 2
  %17 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %18 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = s_mov_b32 0
  %20, %21 = s_add_co_u32 %17, %16
  %22, %23 = s_addc_u32 %18, %19, %21
  %24 = concat(%20, %22) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %25 = s_mov_b32_m0_imm 0
  %value = global_load_dword_saddr %15, %24, %25
