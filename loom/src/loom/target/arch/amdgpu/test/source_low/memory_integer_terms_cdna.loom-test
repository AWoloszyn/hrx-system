low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @workgroup_signed_halfword_term(%bounded: reg<amdgpu.vgpr>, %value: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %15 = storage {byte_alignment = 4, byte_length = 1024} : low.storage<workgroup>
