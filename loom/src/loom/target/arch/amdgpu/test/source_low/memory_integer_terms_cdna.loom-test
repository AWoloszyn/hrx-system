low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @uniform_comparison_term(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %view = resource<hal_binding> {extent = 12, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %sign_boundary = s_mov_b32 0
  %negative = s_cmp_lt_i32 %input, %sign_boundary
  %16 = v_mov_b32 0
  %18 = s_mov_b32 1
  %19 = s_cselect_b32 %18, %sign_boundary, %negative
  %20 = s_lshl_b32_rhs_inline %19, 2
  %21 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24, %25 = s_add_co_u32 %21, %20
  %26, %27 = s_addc_u32 %22, %sign_boundary, %25
  %28 = concat(%24, %26) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %29 = s_mov_b32_m0_imm 0
  %value = global_load_dword_saddr %16, %28, %29 {offset = 4}
  return %value
}

