  %51 = v_mov_b32_copy %35
  %52, %53 = v_addc_co_u32 %51, %46, %50
  %54 = concat(%49, %52) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
