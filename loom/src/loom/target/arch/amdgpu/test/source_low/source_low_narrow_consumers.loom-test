// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @narrow_comparison(%input: i32, %other: i32) -> (i32) {
  %small = scalar.trunci %input : i32 to i16
  %wide = scalar.extsi %small : i16 to i32
  %condition = scalar.cmpi slt, %wide, %other : i32
  %result = scf.select %condition, %wide, %other : i32
  func.return %result : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @narrow_comparison(%input: reg<amdgpu.sgpr>, %other: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %10 = v_mov_b32_copy %input
  %wide = v_bfe_i32_offset_width_inline %10 {offset = 0, width = 16}
  %12 = v_mov_b32_copy %other
  %condition = v_cmp_lt_i32 %wide, %12
  %result = v_cndmask_b32 %12, %wide, %condition
  return %result
}

// ====

amdgpu.target<gfx11-generic> @target

func.def target(@target) @uniform_word_arithmetic(%input: i32, %other: i32) -> (i32) {
  %sum = scalar.addi %input, %other : i32
  %result = scalar.muli %sum, %other : i32
  func.return %result : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @uniform_word_arithmetic(%input: reg<amdgpu.sgpr>, %other: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %sum = s_add_u32 %input, %other
  %result = s_mul_i32 %sum, %other
  return %result
}
