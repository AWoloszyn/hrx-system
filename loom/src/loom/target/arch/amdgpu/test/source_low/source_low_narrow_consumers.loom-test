// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @narrow_i8_extui_i64(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %8 = v_mov_b32_copy %input
  %small = v_bfe_i32_offset_width_inline %8 {offset = 0, width = 8}
  %10 = v_and_b32_lit %small, 255
  %11 = v_mov_b32 0
  %13 = s_mov_b32 1
  %14 = s_mov_b32 0
  %17 = v_mov_b32_copy %13
  %19 = v_mov_b32_copy %14
  %25, %26 = v_add_co_u32 %10, %17
  %27, %28 = v_add_co_ci_u32 %11, %19, %26
  %result = concat(%25, %27) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

