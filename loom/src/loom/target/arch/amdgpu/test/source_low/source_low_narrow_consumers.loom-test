// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @narrow_i8_extui_i32(%input: i32) -> (i32) {
  %small = scalar.trunci %input : i32 to i8
  %wide = scalar.extui %small : i8 to i32
  %c1 = scalar.constant 1 : i32
  %result = scalar.addi %wide, %c1 : i32
  func.return %result : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core>(@target) abi(hal_kernel) @narrow_i8_extui_i32(%input: reg<amdgpu.sgpr>) -> (reg<amdgpu.vgpr>) asm {
  %8 = v_mov_b32_copy %input
  %small = v_bfe_i32_offset_width_inline %8 {offset = 0, width = 8}
  %wide = v_and_b32_lit %small, 255
  %12 = v_mov_b32 1
  %result = v_add_u32 %wide, %12
  return %result
}

