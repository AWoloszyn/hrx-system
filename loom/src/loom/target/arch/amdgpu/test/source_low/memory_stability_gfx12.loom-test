// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_stability.loom-test
// RUN: emit source-low target=amdgpu:gfx1200 output=low

// A cooperating producer waits for all 32 acknowledgements before changing
// the payload and releasing publication. Depending the acknowledgement on the
// initial payload read orders that read before the producer write.
kernel.def @read_after_acquire_publication() {
  %c1 = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%native: buffer, %progress: buffer, %output: buffer) {
  %payload_aligned, %progress_aligned, %output_aligned = buffer.assume.alignment %native, %progress, %output {minimum_alignment = 4} : buffer, buffer, buffer
  %payload_unique, %progress_unique, %output_unique = buffer.assume.noalias %payload_aligned, %progress_aligned, %output_aligned : buffer, buffer, buffer
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %pixels = buffer.view %payload_unique[%base] : buffer -> view<1xi32>
  %notice = buffer.view %progress_unique[%base] : buffer -> view<2xi32>
  %destination = buffer.view %output_unique[%base] : buffer -> view<32x2xi32>
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %before = view.load %pixels[0] : view<1xi32> -> i32
  %acknowledgement = scalar.addi %before, %c1 : i32
  view.atomic.reduce<addi> %acknowledgement, %notice[0] {ordering = release, scope = device} : i32, view<2xi32>
  scf.while {
    %seen = view.atomic.rmw<addi> %c0, %notice[1] {ordering = acquire, scope = device} : i32, view<2xi32> -> i32
    %pending = scalar.cmpi eq, %seen, %c0 : i32
    scf.condition %pending : i1
  } do {
    scf.yield
  }
  %after = view.load %pixels[0] : view<1xi32> -> i32
  view.store %before, %destination[%lane, 0] : i32, view<32x2xi32>
  view.store %after, %destination[%lane, 1] : i32, view<32x2xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @read_after_acquire_publication() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %pixels = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %notice = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 8} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {index = 2, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %39 = v_mov_b32 0
  %before = global_load_b32_saddr %39, %pixels
  %41 = v_mov_b32 1
  %acknowledgement = v_add_u32 %before, %41
  global_atomic_add_u32_saddr %39, %acknowledgement, %notice {scope = 2}
  %48 = s_mov_b64_exec_read
  low.br ^_bb1
^_bb1:
  %seen = global_atomic_add_u32_rtn_saddr %39, %39, %notice {offset = 4, scope = 2}
  s_wait_loadcnt {loadcnt = 0}
  global_inv {scope = 2}
  %pending = v_cmp_eq_i32_src1_inline %seen {rhs = 0}
  %49, %50 = s_and_saveexec_b64 %pending
  low.cond_br %50, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb2:
  s_mov_b64_exec %48
  %51 = v_mov_b32 0
  %after = global_load_b32_saddr %51, %pixels
  %53 = v_lshlrev_b32_src0_inline %lane, 3
  global_store_b32_saddr %53, %before, %destination
  global_store_b32_saddr %53, %after, %destination {offset = 4}
  return
}

