  %destination = resource<hal_binding> {index = 2, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %28 = s_mov_b32 0
  %before = s_load_dword %source, %28
  %30 = v_mov_b32 0
  %seen = global_atomic_add_u32_rtn_saddr %30, %30, %notice {scope = 2}
  s_wait_loadcnt {loadcnt = 0}
  global_inv {scope = 2}
  %after = s_load_dword %source, %28
  %35 = v_mov_b32_copy %before
  global_store_b32_saddr %30, %35, %destination
  %37 = v_mov_b32_copy %after
  global_store_b32_saddr %30, %37, %destination {offset = 4}
  return
}

