  %input_aligned, %progress_aligned, %output_aligned = buffer.assume.alignment %input_space, %progress, %output {minimum_alignment = 4} : buffer, buffer, buffer
  %source_unique, %progress_unique, %output_unique = buffer.assume.noalias %input_aligned, %progress_aligned, %output_aligned : buffer, buffer, buffer
  %source = buffer.view %source_unique[%base] : buffer -> view<1xi32>
  %notice = buffer.view %progress_unique[%base] : buffer -> view<1xi32>
  %destination = buffer.view %output_unique[%base] : buffer -> view<32x2xi32>
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %before = view.load %source[0] : view<1xi32> -> i32
  buffer.store.i8 %c1, %progress[%base]
  %after = view.load %source[0] : view<1xi32> -> i32
  view.store %before, %destination[%lane, 0] : i32, view<32x2xi32>
  view.store %after, %destination[%lane, 1] : i32, view<32x2xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 3, resource_count = 3, resource_offsets = [0, 8, 16], resource_parameter_indices = [0, 1, 2], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @typed_read_with_incomparable_write() asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %progress_unique = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %destination = resource<hal_binding> {index = 2, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %27 = v_mov_b32 0
  %before = global_load_b32_saddr %27, %source
  %29 = v_mov_b32 1
  global_store_b8_saddr %27, %29, %progress_unique
  %after = global_load_b32_saddr %27, %source
  global_store_b32_saddr %27, %before, %destination
  global_store_b32_saddr %27, %after, %destination {offset = 4}
  return
}
