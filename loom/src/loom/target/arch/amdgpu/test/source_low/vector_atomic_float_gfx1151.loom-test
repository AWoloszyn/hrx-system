// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_vector_atomic_float.loom-test
// RUN: with-checks emit source-low target=amdgpu:gfx1151 output=low

func.def @vector_float_minimum(%input: buffer, %value: vector<2xf32>) -> (vector<2xf32>) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %view = buffer.view %global[%base] : buffer -> view<2xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %offsets = vector.iota %c0 step %c1 : vector<2xindex>
  %old = vector.atomic.rmw<minnumf> %value, %view[0][%offsets] {ordering = relaxed, scope = device} : vector<2xf32>, view<2xf32>, vector<2xindex>
  func.return %old : vector<2xf32>
}

// ----
CHECK: low.func.def *
CHECK-NOT: *vector.atomic.*
CHECK-NOT: *low.op<*
CHECK: *atomic_cmpswap*
CHECK: *atomic_cmpswap*
CHECK: *return *

// ====

func.def @masked_vector_float_minimum(%input: buffer, %value: vector<2xf32>, %mask_bits: vector<2xi32>, %passthrough: vector<2xf32>) -> (vector<2xf32>) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %view = buffer.view %global[%base] : buffer -> view<2xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %offsets = vector.iota %c0 step %c1 : vector<2xindex>
  %mask_zero = vector.constant 0 : vector<2xi32>
  %mask = vector.cmpi ne, %mask_bits, %mask_zero : vector<2xi32> -> vector<2xi1>
  %old = vector.atomic.rmw.mask<minimumf> %value, %view[0][%offsets], %mask, %passthrough {ordering = relaxed, scope = device} : vector<2xf32>, view<2xf32>, vector<2xindex>, vector<2xi1>, vector<2xf32>
  func.return %old : vector<2xf32>
}

// ----
CHECK: low.func.def *
CHECK-NOT: *vector.atomic.*
CHECK-NOT: *low.op<*
CHECK: *atomic_cmpswap*
CHECK: *atomic_cmpswap*
CHECK: *low.cond_br*
CHECK: *return *
