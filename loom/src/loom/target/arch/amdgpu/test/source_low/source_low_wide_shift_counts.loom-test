low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @wide_right_shift_uniform(%value: reg<amdgpu.sgpr x2>, %count: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %10 = slice %count[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %logical = s_lshr_b64 %value, %10
  %signed = s_ashr_i64 %value, %10
  return %logical, %signed
}

