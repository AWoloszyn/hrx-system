amdgpu.target<gfx1151> @target

func.def target(@target) @wide_right_shift_constant(%values: vector<2xi64>) -> (i64, i64) {
  %value = vector.extract %values[1] : vector<2xi64> -> i64
  %count = scalar.constant 31 : i64
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  func.return %logical, %signed : i64, i64
}

// ----
low.func.def target<amdgpu.rdna3_5.core>(@target) abi(hal_kernel) @wide_right_shift_constant(%values: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr x2>) asm {
  %10 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %11 = slice %values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %value = concat(%10, %11) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %13 = s_mov_b32 31
  %18 = v_lshrrev_b32_src0_inline %10, 31
  %19 = v_lshlrev_b32_src0_inline %11, 1
  %20 = v_or_b32 %18, %19
  %21 = v_lshrrev_b32_src0_inline %11, 31
  %logical = concat(%20, %21) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %signed = v_ashrrev_i64 %13, %value
  return %logical, %signed
}
