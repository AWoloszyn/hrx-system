// RUN: emit source-low target=amdgpu:gfx1151 output=low

// Floating observations and ordinary memory transport preserve representation
// bits, including NaN payloads and signed zero, without numeric conversions.
kernel.def @atomic_float_observation_bits() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%storage: buffer, %output: buffer, %value: i64) {
  %base = index.constant 8 : offset
  %output_base = index.constant 16 : offset
  %global = buffer.assume.memory_space<global> %storage : buffer
  %whole = buffer.view %global[%base] : buffer -> view<8xf64>
  %words = view.subview %whole[1] : view<8xf64> -> view<6xf64>
  %results = buffer.view %output[%output_base] : buffer -> view<7xf64>
  %floating_value = scalar.bitcast %value : i64 to f64
  %ordinary = view.load %words[0] : view<6xf64> -> f64
  view.store %ordinary, %results[6] : f64, view<7xf64>
  %relaxed_device = view.atomic.load %words[0] {ordering = relaxed, scope = device} : view<6xf64> -> f64
  view.atomic.store %floating_value, %words[0] {ordering = relaxed, scope = device} : f64, view<6xf64>
  view.store %relaxed_device, %results[0] : f64, view<7xf64>
  %acquired_device = view.atomic.load %words[1] {ordering = acquire, scope = device} : view<6xf64> -> f64
  view.atomic.store %floating_value, %words[1] {ordering = release, scope = device} : f64, view<6xf64>
  view.store %acquired_device, %results[1] : f64, view<7xf64>
  %sequential_device = view.atomic.load %words[2] {ordering = seq_cst, scope = device} : view<6xf64> -> f64
  view.atomic.store %floating_value, %words[2] {ordering = seq_cst, scope = device} : f64, view<6xf64>
  view.store %sequential_device, %results[2] : f64, view<7xf64>
  %relaxed_system = view.atomic.load %words[3] {ordering = relaxed, scope = system} : view<6xf64> -> f64
  view.atomic.store %floating_value, %words[3] {ordering = relaxed, scope = system} : f64, view<6xf64>
  view.store %relaxed_system, %results[3] : f64, view<7xf64>
  %acquired_system = view.atomic.load %words[4] {ordering = acquire, scope = system} : view<6xf64> -> f64
  view.atomic.store %floating_value, %words[4] {ordering = release, scope = system} : f64, view<6xf64>
  view.store %acquired_system, %results[4] : f64, view<7xf64>
  %sequential_system = view.atomic.load %words[5] {ordering = seq_cst, scope = system} : view<6xf64> -> f64
  view.atomic.store %floating_value, %words[5] {ordering = seq_cst, scope = system} : f64, view<6xf64>
  view.store %sequential_system, %results[5] : f64, view<7xf64>
  kernel.return
}

