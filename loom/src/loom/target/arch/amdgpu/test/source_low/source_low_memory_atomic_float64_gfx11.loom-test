  buffer_gl0_inv
  s_waitcnt {lgkmcnt = 0}
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
  %66 = concat(%27, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr<volatile> %21, %66, %whole {offset = 48}
  global_store_b64_saddr %21, %acquired_system, %results {offset = 48}
  s_waitcnt {lgkmcnt = 0}
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
