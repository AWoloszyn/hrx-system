  global_store_b64_saddr %21, %sequential_device, %results {offset = 32}
  %relaxed_system = global_load_b64_saddr<volatile> %21, %whole {offset = 40, glc = 1}
  %57 = concat(%27, %29) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b64_saddr<volatile> %21, %57, %whole {offset = 40}
  global_store_b64_saddr %21, %relaxed_system, %results {offset = 40}
  %acquired_system = global_load_b64_saddr<volatile> %21, %whole {offset = 48, glc = 1}
  s_waitcnt {vmcnt = 0}
