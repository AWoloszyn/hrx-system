  %whole = resource<hal_binding> {extent = 72, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %results = resource<hal_binding> {extent = 72, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %21 = v_mov_b32 0
  %ordinary = global_load_b64_saddr %21, %whole {offset = 16}
  global_store_b64_saddr %21, %ordinary, %results {offset = 64}
  %relaxed_device = global_load_b64_saddr<volatile> %21, %whole {offset = 16, glc = 1}
  %26 = slice %floating_value[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
