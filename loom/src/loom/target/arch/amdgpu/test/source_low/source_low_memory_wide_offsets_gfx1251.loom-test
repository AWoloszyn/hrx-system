low.kernel.def target<amdgpu.rdna4.gfx1251.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @wide_offset_loaded_lane() asm {
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %offset_view = resource<hal_binding> {index = 2, source_type = hal.buffer, extent = 512} : reg<amdgpu.sgpr x2>
  %17 = v_lshlrev_b32_src0_inline %lane, 3
  %byte_offset = global_load_b64_saddr %17, %offset_view
  %19 = slice %byte_offset[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %20 = slice %byte_offset[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %21 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23, %24 = v_add_co_u32 %21, %19
  %25 = v_mov_b32_copy %22
  %26, %27 = v_add_co_ci_u32 %25, %20, %24
  %28 = concat(%23, %26) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %loaded = global_load_b32_vaddr %28
  %30 = v_lshlrev_b32_src0_inline %lane, 2
  global_store_b32_saddr %30, %loaded, %output_view
  return
}

