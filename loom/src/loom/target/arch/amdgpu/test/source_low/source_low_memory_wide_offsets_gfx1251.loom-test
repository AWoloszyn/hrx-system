low.kernel.def target<amdgpu.rdna4.gfx1251.core>(@target) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @wide_offset_uniform(%byte_offset: reg<amdgpu.sgpr x2>) asm {
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 4} : reg<amdgpu.sgpr x2>
  %11 = v_mov_b32 0
  %12 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %13 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %14 = slice %byte_offset[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %15 = slice %byte_offset[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %16, %17 = s_add_co_u32 %12, %14
  %18, %19 = s_addc_u32 %13, %15, %17
  %20 = concat(%16, %18) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %loaded = global_load_b32_saddr %11, %20
  global_store_b32_saddr %11, %loaded, %output_view
  return
}

