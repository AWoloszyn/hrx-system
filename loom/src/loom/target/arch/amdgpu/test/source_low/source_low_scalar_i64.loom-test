low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_i64_bitwise_sgpr(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) asm {
  %and = s_and_b64 %lhs, %rhs
  %or = s_or_b64 %and, %lhs
  %xor = s_xor_b64 %or, %rhs
  return %and, %or, %xor
}

