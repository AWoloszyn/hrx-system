func.def @scalar_i32_control(%lhs: i32, %rhs: i32) -> (i32) {
  %product = scalar.muli %lhs, %rhs : i32
  %mixed = scalar.xori %product, %rhs : i32
  %less = scalar.cmpi slt, %lhs, %rhs : i32
  %selected = scf.select %less, %mixed, %product : i32
  func.return %selected : i32
}

// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @scalar_i32_control(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %product = s_mul_i32 %lhs, %rhs
  %mixed = s_xor_b32 %product, %rhs
  %less = s_cmp_lt_i32 %lhs, %rhs
  %selected = s_cselect_b32 %mixed, %product, %less
  return %selected
}

