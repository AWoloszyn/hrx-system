  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %13 = v_lshlrev_b32_src0_inline %tid, 2
  %14 = s_mov_b32_m0_imm 0
  %value = global_load_dword_saddr %13, %input_view, %14
  %16 = v_max_f32_dpp %value, %value {dpp_ctrl = 177}
  %17 = v_max_f32_dpp %16, %16 {dpp_ctrl = 78}
  %max = v_max_f32_dpp %17, %17 {dpp_ctrl = 321}
  %19 = v_lshlrev_b32_src0_inline %tid, 2
