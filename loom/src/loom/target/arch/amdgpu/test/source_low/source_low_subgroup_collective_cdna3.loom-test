// RUN: emit source-low output=low

amdgpu.target<gfx942> @target

// The bias load intentionally stays outside the lane0 branch. Cross-wave
// workgroup reduction narrows EXEC internally, and later all-lane memory
// operations must not reuse VGPR materializations produced under that narrowed
// participant set.
kernel.def target(@target) @workgroup_reduce_then_all_lane_bias_load() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %bias: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %leader_index = index.constant 0 : index
  %second_output = index.constant 1 : index
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %bias_global = buffer.assume.memory_space<global> %bias : buffer
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %input_noalias, %bias_noalias, %output_noalias = buffer.assume.noalias %input_global, %bias_global, %output_global : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<128xf32>
  %bias_view = buffer.view %bias_noalias[%base] : buffer -> view<1xbf16>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<2xf32>
  %value = view.load %input_view[%tid] : view<128xf32> -> f32
  %sum0 = kernel.workgroup.reduce<addf> %value : f32
  %sum1 = kernel.workgroup.reduce<addf> %value : f32
  %bias_bf16 = view.load %bias_view[%leader_index] : view<1xbf16> -> bf16
  %bias_f32 = scalar.extf %bias_bf16 : bf16 to f32
  %result0 = scalar.addf<reassoc|nnan|ninf|nsz> %sum0, %bias_f32 : f32
  %result1 = scalar.addf<reassoc|nnan|ninf|nsz> %sum1, %bias_f32 : f32
  %is_lane0 = index.cmp eq, %tid, %leader_index : index
  scf.if %is_lane0 {
    view.store %result0, %output_view[%leader_index] : f32, view<2xf32>
    view.store %result1, %output_view[%second_output] : f32, view<2xf32>
  }
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) workgroup_size(128, 1, 1) workgroup_count(1, 1, 1) @workgroup_reduce_then_all_lane_bias_load() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 512} : reg<amdgpu.sgpr x2>
  %bias_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 2} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 2, source_type = hal.buffer, extent = 8} : reg<amdgpu.sgpr x2>
  %30 = v_lshlrev_b32_src0_inline %tid, 2
  %31 = s_mov_b32_m0_imm 0
  %value = global_load_dword_saddr %30, %input_view, %31
  %33 = v_and_b32_src0_inline %tid, 63
  %34 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %35 = storage_address %34 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %36 = v_xor_b32_src0_inline %33, 32
  %37 = v_lshlrev_b32_src0_inline %36, 2
  %38 = ds_bpermute_b32 %37, %value
  %39 = v_add_f32 %value, %38
  %40 = v_xor_b32_src0_inline %33, 16
  %41 = v_lshlrev_b32_src0_inline %40, 2
  %42 = ds_bpermute_b32 %41, %39
  %43 = v_add_f32 %39, %42
  %44 = v_xor_b32_src0_inline %33, 8
  %45 = v_lshlrev_b32_src0_inline %44, 2
  %46 = ds_bpermute_b32 %45, %43
  %47 = v_add_f32 %43, %46
  %48 = v_xor_b32_src0_inline %33, 4
  %49 = v_lshlrev_b32_src0_inline %48, 2
  %50 = ds_bpermute_b32 %49, %47
  %51 = v_add_f32 %47, %50
  %52 = v_xor_b32_src0_inline %33, 2
  %53 = v_lshlrev_b32_src0_inline %52, 2
  %54 = ds_bpermute_b32 %53, %51
  %55 = v_add_f32 %51, %54
  %56 = v_xor_b32_src0_inline %33, 1
  %57 = v_lshlrev_b32_src0_inline %56, 2
  %58 = ds_bpermute_b32 %57, %55
  %59 = v_add_f32 %55, %58
  %60 = v_lshrrev_b32_src0_inline %tid, 6
  %61 = v_lshlrev_b32_src0_inline %60, 2
  %62 = v_mov_b32 1
  %63 = v_cmp_lt_u32 %33, %62
  %64, %65 = s_and_saveexec_b64 %63
  %66 = v_add_u32 %35, %61
  ds_write_b32 %66, %59
  s_mov_b64_exec %64
  s_barrier
  %67 = v_mov_b32 2
  %68 = v_cmp_lt_u32 %33, %67
  %69, %70 = s_and_saveexec_b64 %68
  %71 = v_lshlrev_b32_src0_inline %33, 2
  %72 = v_add_u32 %35, %71
  %73 = ds_read_b32 %72
  %74 = v_add_f32_dpp %73, %73 {dpp_ctrl = 177}
  s_mov_b64_exec %69
  %75 = v_mov_b32 0
  %sum0 = ds_bpermute_b32 %75, %74
  %77 = v_and_b32_src0_inline %tid, 63
  %78 = storage {byte_alignment = 4, byte_length = 8} : low.storage<workgroup>
  %79 = storage_address %78 : low.storage<workgroup> -> reg<amdgpu.vgpr>
  %80 = v_xor_b32_src0_inline %77, 32
  %81 = v_lshlrev_b32_src0_inline %80, 2
  %82 = ds_bpermute_b32 %81, %value
  %83 = v_add_f32 %value, %82
  %84 = v_xor_b32_src0_inline %77, 16
  %85 = v_lshlrev_b32_src0_inline %84, 2
  %86 = ds_bpermute_b32 %85, %83
  %87 = v_add_f32 %83, %86
  %88 = v_xor_b32_src0_inline %77, 8
  %89 = v_lshlrev_b32_src0_inline %88, 2
  %90 = ds_bpermute_b32 %89, %87
  %91 = v_add_f32 %87, %90
  %92 = v_xor_b32_src0_inline %77, 4
  %93 = v_lshlrev_b32_src0_inline %92, 2
  %94 = ds_bpermute_b32 %93, %91
  %95 = v_add_f32 %91, %94
  %96 = v_xor_b32_src0_inline %77, 2
  %97 = v_lshlrev_b32_src0_inline %96, 2
  %98 = ds_bpermute_b32 %97, %95
  %99 = v_add_f32 %95, %98
  %100 = v_xor_b32_src0_inline %77, 1
  %101 = v_lshlrev_b32_src0_inline %100, 2
  %102 = ds_bpermute_b32 %101, %99
  %103 = v_add_f32 %99, %102
  %104 = v_lshrrev_b32_src0_inline %tid, 6
  %105 = v_lshlrev_b32_src0_inline %104, 2
  %106 = v_mov_b32 1
  %107 = v_cmp_lt_u32 %77, %106
  %108, %109 = s_and_saveexec_b64 %107
  %110 = v_add_u32 %79, %105
  ds_write_b32 %110, %103
  s_mov_b64_exec %108
  s_barrier
  %111 = v_mov_b32 2
  %112 = v_cmp_lt_u32 %77, %111
  %113, %114 = s_and_saveexec_b64 %112
  %115 = v_lshlrev_b32_src0_inline %77, 2
  %116 = v_add_u32 %79, %115
  %117 = ds_read_b32 %116
  %118 = v_add_f32_dpp %117, %117 {dpp_ctrl = 177}
  s_mov_b64_exec %113
  %119 = v_mov_b32 0
  %sum1 = ds_bpermute_b32 %119, %118
  %121 = v_mov_b32 0
  %122 = s_mov_b32_m0_imm 0
  %bias_bf16 = global_load_d16_b16_saddr %121, %bias_view, %122
  %bias_f32 = v_lshlrev_b32_src0_16_low16 %bias_bf16
  %result0 = v_add_f32 %sum0, %bias_f32
  %result1 = v_add_f32 %sum1, %bias_f32
  %is_lane0 = v_cmp_eq_i32_src1_inline %tid {rhs = 0}
  %128, %129 = s_and_saveexec_b64 %is_lane0
  low.cond_br %129, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %130 = v_mov_b32 0
  %131 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %130, %result0, %output_view, %131
  %133 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %130, %result1, %output_view, %133 {offset = 4}
  low.br ^_bb2
^_bb2:
  s_mov_b64_exec %128
  return
}

// ====

amdgpu.target<gfx942> @target

kernel.def target(@target) @subgroup_shuffle_xor_f32_pair_cdna3() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xf32>
  %value = view.load %input_view[%tid] : view<64xf32> -> f32
  %offset = scalar.constant 1 : i32
  %width = scalar.constant 2 : i32
  %shuffle, %valid = kernel.subgroup.shuffle<xor> %value, %offset, %width : f32, i32, i32
  view.store %shuffle, %output_view[%tid] : f32, view<64xf32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.cdna3.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @subgroup_shuffle_xor_f32_pair_cdna3() asm {
  %tid = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer, extent = 256} : reg<amdgpu.sgpr x2>
  %16 = v_lshlrev_b32_src0_inline %tid, 2
  %17 = s_mov_b32_m0_imm 0
  %value = global_load_dword_saddr %16, %input_view, %17
  %shuffle = v_mov_b32_dpp %value {dpp_ctrl = 177}
  %22 = v_lshlrev_b32_src0_inline %tid, 2
  %23 = s_mov_b32_m0_imm 0
  global_store_dword_saddr %22, %shuffle, %output_view, %23
  return
}

