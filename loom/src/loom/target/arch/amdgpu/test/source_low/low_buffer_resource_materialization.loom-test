// ----
amdgpu.target<gfx1250> @target

low.kernel.def target<amdgpu.rdna4.gfx125x.core>(@target) workgroup_size(64, 1, 1) @extended_static_record(%binding: reg<amdgpu.sgpr x2>) asm {
  %2 = slice %binding[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %3 = slice %binding[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %4 = s_mov_b32 2
  %5 = s_mov_b32 1174405120
  %6 = s_or_b32 %3, %5
  %7 = s_mov_b32 0
  %8 = concat(%2, %6) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %descriptor = concat(%8, %4, %7) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  return
}

// ====

amdgpu.target<gfx1250> @target

low.kernel.def target<amdgpu.rdna4.gfx125x.core>(@target) workgroup_size(64, 1, 1) @extended_dynamic_record(%binding: reg<amdgpu.sgpr x2>, %extent: reg<amdgpu.sgpr>) {
  %descriptor = low.op<amdgpu.hal.buffer_descriptor.extent>(%binding, %extent) {cache_swizzle_stride = 0} : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  low.return
}

// ----
amdgpu.target<gfx1250> @target

low.kernel.def target<amdgpu.rdna4.gfx125x.core>(@target) workgroup_size(64, 1, 1) @extended_dynamic_record(%binding: reg<amdgpu.sgpr x2>, %extent: reg<amdgpu.sgpr>) asm {
  %3 = slice %binding[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %4 = slice %binding[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %5 = s_lshl_b32_rhs_inline %extent, 25
  %6 = s_or_b32 %4, %5
  %7 = s_lshr_b32_rhs_inline %extent, 7
  %8 = s_mov_b32 0
  %9 = concat(%3, %6) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %descriptor = concat(%9, %7, %8) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  return
}

