// RUN: pass amdgpu-materialize-hal-buffer-descriptors

amdgpu.target<gfx942> @target

low.kernel.def target<amdgpu.cdna3.core>(@target) workgroup_size(64, 1, 1) @legacy_record(%binding: reg<amdgpu.sgpr x2>) {
  %descriptor = low.op<amdgpu.hal.buffer_descriptor>(%binding) {cache_swizzle_stride = 0, extent = 16} : (reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x4>
  low.return
}

// ----
amdgpu.target<gfx942> @target

low.kernel.def target<amdgpu.cdna3.core>(@target) workgroup_size(64, 1, 1) @legacy_record(%binding: reg<amdgpu.sgpr x2>) asm {
  %2 = slice %binding[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %3 = slice %binding[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %4 = s_mov_b32 65535
  %5 = s_and_b32 %3, %4
  %6 = concat(%2, %5) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %7 = s_mov_b32 16
  %8 = s_mov_b32 159744
  %descriptor = concat(%6, %7, %8) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  return
}

