  %13 = v_mov_b32 0
  %14 = s_ashr_i32_rhs_inline %signed, 31
  %15 = concat(%signed, %14) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %16 = s_mov_b32 2
  %17 = s_lshl_b64 %15, %16
  %18 = slice %view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %19 = slice %view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %20 = slice %17[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %21 = slice %17[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %22, %23 = s_add_co_u32 %18, %20
  %24, %25 = s_addc_u32 %19, %21, %23
  %26 = concat(%22, %24) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %27 = s_mov_b32_m0_imm 0
  %value = global_load_dword_saddr %13, %26, %27 {offset = 512}
  return %value
}

