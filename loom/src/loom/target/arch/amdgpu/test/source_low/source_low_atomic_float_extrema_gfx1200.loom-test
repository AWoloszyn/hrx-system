func.def @workgroup_float_extrema(%initial: f32, %value: f32) -> (f32, f32, f32, f32) {
  %base = index.constant 0 : offset
  %bytes = index.constant 16 : offset
  %memory = buffer.alloca<workgroup> align(4) %bytes : buffer
  %view = buffer.view %memory[%base] : buffer -> view<4xf32>
  view.store %initial, %view[0] : f32, view<4xf32>
  view.store %initial, %view[1] : f32, view<4xf32>
  view.store %initial, %view[2] : f32, view<4xf32>
  view.store %initial, %view[3] : f32, view<4xf32>
  %minimumf = view.atomic.rmw<minimumf> %value, %view[0] {ordering = acq_rel, scope = workgroup} : f32, view<4xf32> -> f32
  %maximumf = view.atomic.rmw<maximumf> %value, %view[1] {ordering = acq_rel, scope = workgroup} : f32, view<4xf32> -> f32
  %minnumf = view.atomic.rmw<minnumf> %value, %view[2] {ordering = acq_rel, scope = workgroup} : f32, view<4xf32> -> f32
  %maxnumf = view.atomic.rmw<maxnumf> %value, %view[3] {ordering = acq_rel, scope = workgroup} : f32, view<4xf32> -> f32
  func.return %minimumf, %maximumf, %minnumf, %maxnumf : f32, f32, f32, f32
}

// ----
CHECK: low.func.def *
CHECK-NOT: *view.atomic.*
CHECK-NOT: *low.op<*
CHECK: *ds_cmpst_rtn_b32*
CHECK: * = v_cmp_ne_i32 *
CHECK: *ds_min_rtn_f32*
CHECK: *ds_max_rtn_f32*

// ====

func.def @global_float_add_scopes(%input: buffer, %value: f32) -> (f32, f32) {
  %base = index.constant 0 : offset
  %memory = buffer.assume.memory_space<global> %input : buffer
  %view = buffer.view %memory[%base] : buffer -> view<2xf32>
  %device = view.atomic.rmw<addf> %value, %view[0] {ordering = relaxed, scope = device} : f32, view<2xf32> -> f32
  %system = view.atomic.rmw<addf> %value, %view[1] {ordering = relaxed, scope = system} : f32, view<2xf32> -> f32
  func.return %device, %system : f32, f32
}

// ----
CHECK: low.func.def *
CHECK-NOT: *view.atomic.*
CHECK-NOT: *low.op<*
CHECK: *atomic_add*f32*_rtn*
CHECK: *atomic_cmpswap*_rtn*
CHECK: * = v_cmp_ne_i32 *
