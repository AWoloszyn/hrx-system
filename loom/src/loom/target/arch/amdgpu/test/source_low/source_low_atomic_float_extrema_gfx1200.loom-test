// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_atomic_float_extrema.loom-test
// RUN: with-checks emit source-low target=amdgpu:gfx1200 output=low

func.def @global_float_extrema(%input: buffer, %value: f32) -> (f32, f32, f32, f32) {
  %base = index.constant 0 : offset
  %memory = buffer.assume.memory_space<global> %input : buffer
  %view = buffer.view %memory[%base] : buffer -> view<4xf32>
  %minimumf = view.atomic.rmw<minimumf> %value, %view[0] {ordering = acq_rel, scope = device} : f32, view<4xf32> -> f32
  %maximumf = view.atomic.rmw<maximumf> %value, %view[1] {ordering = acq_rel, scope = device} : f32, view<4xf32> -> f32
  %minnumf = view.atomic.rmw<minnumf> %value, %view[2] {ordering = acq_rel, scope = device} : f32, view<4xf32> -> f32
  %maxnumf = view.atomic.rmw<maxnumf> %value, %view[3] {ordering = acq_rel, scope = device} : f32, view<4xf32> -> f32
  func.return %minimumf, %maximumf, %minnumf, %maxnumf : f32, f32, f32, f32
}

// ----
CHECK: low.func.def *
CHECK-NOT: *view.atomic.*
CHECK-NOT: *low.op<*
CHECK: *atomic_cmpswap*
CHECK: * = v_cmp_ne_i32 *
CHECK: *global_atomic_min_f32*
CHECK: *global_atomic_max_f32*
CHECK: *atomic_cmpswap*scope = 2*

// ====

