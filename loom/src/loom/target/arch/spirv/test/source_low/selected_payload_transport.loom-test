spirv.target<vulkan1_3> @target

// ERROR@+1: TARGET/089 {descriptor_set="spirv.logical.core", function_name="independent_predicate_payload", op_name="func.def"}
func.def public target(@target) @independent_predicate_payload(%input: vector<4xi32>, %left: i32, %right: i32, %scalar: i32) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i32
  %payload = scalar.assume %scalar [lt(%scalar, %selected)] : i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  func.return %carried : i32
}
