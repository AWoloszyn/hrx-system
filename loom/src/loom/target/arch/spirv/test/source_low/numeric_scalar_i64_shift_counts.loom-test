low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @wide_right_shift_uniform(%value: reg<spirv.id : i64>, %count: reg<spirv.id : i64>) -> (reg<spirv.id : i64>, reg<spirv.id : i64>) asm {
  %logical = OpShiftRightLogical.i64 %value, %count
  %signed = OpShiftRightArithmetic.i64 %value, %count
  return %logical, %signed
}

