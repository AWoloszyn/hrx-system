func.def @uniform_i8(%input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %source, %destination = buffer.assume.noalias %aligned, %output : buffer, buffer
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%c0] : buffer -> view<8xi8>
  %value = vector.load %source_view[0] : view<8xi8> -> vector<8xi8>
  %result = vector.addi %value, %value : vector<8xi8>
  %output_view = buffer.view %destination[%c0] : buffer -> view<8xi8>
  vector.store %result, %output_view[0] : vector<8xi8>, view<8xi8>
  func.return
}

