low.func.def target<spirv.logical.core> abi(shader_entry_point) @workgroup_predicate_term(%input: reg<spirv.id : i1>, %value: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %scratch = storage {byte_alignment = 4, byte_length = 12} : low.storage<workgroup>
  %view = storage_address %scratch : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %16 = OpConstant.i32 1 : reg<spirv.id>
  %17 = OpConstant.i32 0 : reg<spirv.id>
  %18 = OpSelect %input, %16, %17 : reg<spirv.id>
  %19 = OpConstant.i32 1 : reg<spirv.id : index>
  %20 = OpIAdd %18, %19 : reg<spirv.id>
  %21 = OpAccessChain.workgroup.i32.element_index %view, %20
  OpStore.workgroup.i32 %21, %value
  OpControlBarrier.workgroup.workgroup.acq_rel
  %22 = OpConstant.i32 1 : reg<spirv.id>
  %23 = OpConstant.i32 0 : reg<spirv.id>
  %24 = OpSelect %input, %22, %23 : reg<spirv.id>
  %25 = OpConstant.i32 1 : reg<spirv.id : index>
  %26 = OpIAdd %24, %25 : reg<spirv.id>
  %27 = OpAccessChain.workgroup.i32.element_index %view, %26
  %loaded = OpLoad.workgroup.i32 %27
  return %loaded
}

