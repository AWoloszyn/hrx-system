func.def @predicate_term(%input: i1, %table: buffer) -> (i32) {
  %coordinate = index.cast %input : i1 to index
  %bias = index.constant 1 : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<3xi32>
  %value = view.load %view[%position] : view<3xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @predicate_term(%input: reg<spirv.id : i1>, %table: reg<spirv.ptr.storage_buffer>) -> (reg<spirv.id : i32>) asm {
  %12 = OpConstant.offset64 1
  %13 = OpConstant.offset64 0
  %14 = OpSelect.offset64 %input, %12, %13
  %15 = OpConstant.offset64 4
  %16 = OpIMul.offset64 %14, %15
  %18 = OpIAdd.offset64 %16, %15
  %19 = OpPtrAccessChain.storage_buffer.i32.byte_offset %table, %18
  %value = OpLoad.storage_buffer.i32 %19
  return %value
}

// ====

func.def @workgroup_signed_byte_term(%input: i8, %value: i32) -> (i32) {
  %coordinate = index.cast %input : i8 to index
  %bias = index.constant 128 : index
  %position = index.add %coordinate, %bias : index
  %length = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %scratch[%base] : buffer -> view<256xi32>
  view.store %value, %view[%position] : i32, view<256xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %view[%position] : view<256xi32> -> i32
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @workgroup_signed_byte_term(%input: reg<spirv.id : i8>, %value: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %scratch = storage {byte_alignment = 4, byte_length = 1024} : low.storage<workgroup>
  %view = storage_address %scratch : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %16 = OpSConvert.i8.i32 %input : reg<spirv.id>
  %17 = OpConstant.i32 128 : reg<spirv.id : index>
  %18 = OpIAdd %16, %17 : reg<spirv.id>
  %19 = OpAccessChain.workgroup.i32.element_index %view, %18
  OpStore.workgroup.i32 %19, %value
  OpControlBarrier.workgroup.workgroup.acq_rel
  %20 = OpSConvert.i8.i32 %input : reg<spirv.id>
  %21 = OpConstant.i32 128 : reg<spirv.id : index>
  %22 = OpIAdd %20, %21 : reg<spirv.id>
  %23 = OpAccessChain.workgroup.i32.element_index %view, %22
  %loaded = OpLoad.workgroup.i32 %23
  return %loaded
}

