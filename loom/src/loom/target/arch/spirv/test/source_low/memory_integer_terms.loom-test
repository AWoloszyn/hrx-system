func.def @negative_static_bias(%input: i32, %table: buffer) -> (i32) {
  %bounded = scalar.assume %input [range(%input, 128, 255)] : i32
  %coordinate = index.cast %bounded : i32 to index
  %bias = index.constant -128 : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<128xi32>
  %value = view.load %view[%position] : view<128xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @negative_static_bias(%bounded: reg<spirv.id : i32>, %table: reg<spirv.ptr.storage_buffer>) -> (reg<spirv.id : i32>) asm {
  %coordinate = OpCopyObject.i32 %bounded : reg<spirv.id : index>
  %bias = OpConstant.i32 -128 : reg<spirv.id : index>
  %position = OpIAdd %coordinate, %bias : reg<spirv.id : index>
  %16 = OpSConvert.i32.offset64 %position
  %17 = OpConstant.offset64 4
  %18 = OpIMul.offset64 %16, %17
  %19 = OpPtrAccessChain.storage_buffer.i32.byte_offset %table, %18
  %value = OpLoad.storage_buffer.i32 %19
  return %value
}

