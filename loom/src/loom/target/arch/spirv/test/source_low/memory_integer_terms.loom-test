func.def @workgroup_predicate_term(%input: i1, %value: i32) -> (i32) {
  %coordinate = index.cast %input : i1 to index
  %bias = index.constant 1 : index
  %position = index.add %coordinate, %bias : index
  %length = index.constant 12 : offset
  %scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %base = index.constant 0 : offset
  %view = buffer.view %scratch[%base] : buffer -> view<3xi32>
  view.store %value, %view[%position] : i32, view<3xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %view[%position] : view<3xi32> -> i32
  func.return %loaded : i32
}

