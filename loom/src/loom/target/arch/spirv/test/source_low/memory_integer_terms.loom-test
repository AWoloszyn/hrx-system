// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_integer_terms.loom-test
// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low

func.def @signed_byte_term(%input: i8, %table: buffer) -> (i32) {
  %coordinate = index.cast %input : i8 to index
  %bias = index.constant 128 : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<256xi32>
  %value = view.load %view[%position] : view<256xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @signed_byte_term(%input: reg<spirv.id : i8>, %table: reg<spirv.ptr.storage_buffer>) -> (reg<spirv.id : i32>) asm {
  %12 = OpSConvert.i8.offset64 %input
  %13 = OpConstant.offset64 4
  %14 = OpIMul.offset64 %12, %13
  %15 = OpConstant.offset64 512
  %16 = OpIAdd.offset64 %14, %15
  %17 = OpPtrAccessChain.storage_buffer.i32.byte_offset %table, %16
  %value = OpLoad.storage_buffer.i32 %17
  return %value
}

