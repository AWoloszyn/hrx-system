low.func.def target<spirv.logical.core> abi(shader_entry_point) @workgroup_signed_halfword_term(%bounded: reg<spirv.id : i16>, %value: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %scratch = storage {byte_alignment = 4, byte_length = 1024} : low.storage<workgroup>
  %view = storage_address %scratch : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %17 = OpSConvert.i16.i32 %bounded : reg<spirv.id>
  %18 = OpConstant.i32 128 : reg<spirv.id : index>
  %19 = OpIAdd %17, %18 : reg<spirv.id>
  %20 = OpAccessChain.workgroup.i32.element_index %view, %19
  OpStore.workgroup.i32 %20, %value
  OpControlBarrier.workgroup.workgroup.acq_rel
  %21 = OpSConvert.i16.i32 %bounded : reg<spirv.id>
  %22 = OpConstant.i32 128 : reg<spirv.id : index>
  %23 = OpIAdd %21, %22 : reg<spirv.id>
  %24 = OpAccessChain.workgroup.i32.element_index %view, %23
  %loaded = OpLoad.workgroup.i32 %24
  return %loaded
}

