  %coordinate = index.cast %input : i16 to index
  %bias = index.constant 32768 : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<65536xi32>
  %value = view.load %view[%position] : view<65536xi32> -> i32
