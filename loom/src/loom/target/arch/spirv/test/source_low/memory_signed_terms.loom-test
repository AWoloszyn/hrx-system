func.def @signed_uniform_word(%input: i32, %table: buffer) -> (i32) {
  %signed = scalar.assume %input [range(%input, -128, 127)] : i32
  %bias = scalar.constant 128 : i32
  %ordinal = scalar.addi %signed, %bias : i32
  %position = index.cast %ordinal : i32 to index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<256xi32>
  %value = view.load %view[%position] : view<256xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @signed_uniform_word(%signed: reg<spirv.id : i32>, %table: reg<spirv.ptr.storage_buffer>) -> (reg<spirv.id : i32>) asm {
  %13 = OpSConvert.i32.offset64 %signed
  %14 = OpConstant.offset64 4
  %15 = OpIMul.offset64 %13, %14
  %16 = OpConstant.offset64 512
  %17 = OpIAdd.offset64 %15, %16
  %18 = OpPtrAccessChain.storage_buffer.i32.byte_offset %table, %17
  %value = OpLoad.storage_buffer.i32 %18
  return %value
}

