  %20 = scalar.constant 0 : i32
  %21 = scalar.cmpi ne, %a, %20 : i32
  %22 = scf.if %21 -> (i1) {
    %23 = scalar.constant 0 : i32
    %24 = scalar.cmpi ne, %b, %23 : i32
    %25 = scf.if %24 -> (i1) {
      scf.yield %24 : i1
    } else {
      %26 = scalar.constant 0 : i32
      %27 = scalar.cmpi ne, %c, %26 : i32
      %28 = scalar.constant 1 : i1
      %29 = scalar.xori %27, %28 : i1
      scf.yield %29 : i1
    }
    scf.yield %25 : i1
  } else {
    scf.yield %21 : i1
  }
  func.return %22 : i1
}

func.def public @guarded(%input: buffer, %input_byte_offset: offset, %index: i32, %length: i32) -> (i1) {
  %35 = scalar.cmpi ult, %index, %length : i32
  %36 = scf.if %35 -> (i1) {
    %37 = scalar.extui %index : i32 to i64
    %38 = scalar.constant 4 : i64
    %39 = scalar.muli %37, %38 : i64
    %40 = index.cast %input_byte_offset : offset to i64
    %41 = scalar.addi %40, %39 : i64
    %42 = scalar.assume %41 [range(%41, 0, 9223372036854775807)] : i64
    %43 = index.cast %42 : i64 to offset
    %44 = buffer.view %input[%43] : buffer -> view<1xi32>
    %45 = view.load %44[0] : view<1xi32> -> i32
    %46 = scalar.constant 0 : i32
    %47 = scalar.cmpi ne, %45, %46 : i32
    scf.yield %47 : i1
  } else {
    scf.yield %35 : i1
  }
  func.return %36 : i1
}

func.def public @scan(%input: buffer, %input_byte_offset: offset, %length: i32) -> (i32) {
  %index$52 = scalar.constant 0 : i32
  %index$55 = scf.while(%index = %index$52 : i32) -> (i32) {
    %56 = scalar.cmpi ult, %index, %length : i32
    %57 = scf.if %56 -> (i1) {
      %58 = scalar.extui %index : i32 to i64
      %59 = scalar.constant 4 : i64
      %60 = scalar.muli %58, %59 : i64
      %61 = index.cast %input_byte_offset : offset to i64
      %62 = scalar.addi %61, %60 : i64
      %63 = scalar.assume %62 [range(%62, 0, 9223372036854775807)] : i64
      %64 = index.cast %63 : i64 to offset
      %65 = buffer.view %input[%64] : buffer -> view<1xi32>
      %66 = view.load %65[0] : view<1xi32> -> i32
      %67 = scalar.constant 0 : i32
      %68 = scalar.cmpi ne, %66, %67 : i32
      scf.yield %68 : i1
    } else {
      scf.yield %56 : i1
    }
    scf.condition %57, %index : i1, i32
  } do(%index$54: i32) {
    %69 = scalar.constant 1 : i32
    %index$70 = scalar.addi %index$54, %69 : i32
    scf.yield %index$70 : i32
  }
  func.return %index$55 : i32
}

// ====
// RUN: roundtrip
// Conditional returns keep one structured function exit.
int guarded(const int* input, unsigned length) {
  if (length == 0u) {
    return 3;
  }
  return input[0u];
}
int nested(int x, int y) {
  if (x) {
    if (y) {
      return 2;
    }
    return 3;
  } else {
    return 4;
  }
}
int partial(int x, int y) {
  if (x) {
    if (y) {
      return 2;
    }
  } else {
    return 4;
  }
  return 3;
}
int state(int x, int y) {
  if (x < 0) {
    y += 10;
    return y;
  } else {
    y += 4;
  }
  {
    if (x == 0) {
      return y;
    }
    y += 2;
  }
  return y;
}
int convert_result(bool choose, float value) {
  if (choose) {
    return value;
  }
  return 7.5;
}
void store(int* output) { output[0u] = 7; }
void effect(int* output, bool choose) {
  if (choose) {
    return store(output);
  }
  output[0u] = 9;
}
void unreachable(int* output) {
  return;
  output[0u] = 10;
}
