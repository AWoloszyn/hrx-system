load("//build_tools/sanitizer:suppressions.bzl", "rocm_suppressions")
load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with", "loom_generated_file")
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

exports_files([
    "aiter_swiglu_f16.cpp",
    "flash_attention.cpp",
    "llama_rms_norm.cpp",
])

loom_check_test_suite(
    name = "compiler_test",
    srcs = [
        "assumptions.cxx-test",
        "check.cxx-test",
        "conditionals.cxx-test",
        "const.cxx-test",
        "control_invalid.cxx-test",
        "data_models.cxx-test",
        "enum_semantics.cxx-test",
        "enums.cxx-test",
        "enums_invalid.cxx-test",
        "frontend.cxx-test",
        "functions.cxx-test",
        "intrinsics_invalid.cxx-test",
        "launch.cxx-test",
        "launch_invalid.cxx-test",
        "layout_attributes.cxx-test",
        "locations.cxx-test",
        "loops.cxx-test",
        "macro_operators.cxx-test",
        "pointers.cxx-test",
        "scalar.cxx-test",
        "scalar_invalid.cxx-test",
        "schedule_lowering.cxx-test",
        "schedules.cxx-test",
        "schedules_invalid.cxx-test",
        "standards.cxx-test",
        "vectors.cxx-test",
        "vectors_invalid.cxx-test",
    ],
    data = [
        "aligned_layout.h",
        "enum_semantics.h",
        "locations.h",
        "packed_enums.h",
        "packed_layout.h",
        "record_layout.h",
    ],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)

# Each group retains independent mathematical references and imports its
# implementation through the same source path as handwritten check cases.
_HOST_GROUPS = {
    "assumption_functions": "assumptions.cpp",
    "comparison_functions": "comparison_functions.cpp",
    "constant_loop_functions": "constant_loops.cpp",
    "continue_functions": "structured_continue.cpp",
    "enum_functions": "enum_values.cpp",
    "increment_functions": "increment_values.cpp",
    "integer_functions": "integer_functions.cpp",
    "schedule_functions": "schedule_values.cpp",
    "shaped_intrinsic_values": "shaped_intrinsics.cpp",
    "vector_constructor_values": "vector_initializers.cpp",
    "vector_values": "vector_values.cpp",
}

_HOST_COMPATIBILITY = loom_config_compatible_with([
    "//loom/config/import:cxx",
    "//loom/config/target/arch:vm",
])

[
    loom_generated_file(
        name = group + "_cases_gen",
        testonly = True,
        args = [
            "host",
            "--group=" + group,
            "--source=$(location " + source + ")",
        ],
        generator = "//loom/py/loom/gen/test:cxx_kernel_cases",
        inputs = [source],
        output = group + "_cases.cc",
        output_flag = "--output",
        target_compatible_with = _HOST_COMPATIBILITY,
    )
    for group, source in _HOST_GROUPS.items()
]

[
    loom_test(
        name = group + "_test",
        srcs = [":" + group + "_cases.cc"],
        data = [source],
        target_compatible_with = _HOST_COMPATIBILITY,
    )
    for group, source in _HOST_GROUPS.items()
]

loom_check_test_suite(
    name = "vm_compiler_test",
    srcs = ["vm_lowering.cxx-test"],
    target_compatible_with = _HOST_COMPATIBILITY,
)

iree_execution_test_suite(
    name = "kernels_test",
    data = [
        "aiter_swiglu_f16.cpp",
        "assumptions.cpp",
        "constant_loops.cpp",
        "control_flow.cpp",
        "early_returns.cpp",
        "enum_values.cpp",
        "flash_attention.cpp",
        "increment_values.cpp",
        "integer_increment.cpp",
        "llama_rms_norm.cpp",
        "pointer_walk.cpp",
        "scheduled_sum.cpp",
        "shaped_intrinsics.cpp",
        "short_circuit.cpp",
        "structured_continue.cpp",
        "vector_depth.cpp",
        "vector_initializers.cpp",
        "vector_values.cpp",
        "//loom/src/loom/import/cxx:include/hip/hip_fp16.h",
        "//loom/src/loom/import/cxx:include/hip/hip_runtime.h",
        "//loom/src/loom/import/cxx:include/loomcxx/kernel.h",
        "//loom/src/loom/import/cxx:include/loomcxx/math.h",
        "//loom/src/loom/import/cxx:include/loomcxx/scalar.h",
    ],
    manifests = ["kernels.test.json"],
    sanitizer_suppressions = rocm_suppressions,
    tags = [
        "iree-run-requirement=runtime.resource.amd_gpu",
        "runtime-resource=amd-gpu",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
        "//loom/config/execute:amdgpu_hal",
    ]),
    tools = {
        "generate-cases": "//loom/py/loom/gen/test:cxx_kernel_cases",
        "iree-test-loom": "//loom/src/loom/tools/iree-test-loom",
        "loom-import-cxx": "//loom/src/loom/tools/loom-import-cxx",
    },
)
