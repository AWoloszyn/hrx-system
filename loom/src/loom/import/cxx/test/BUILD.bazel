exports_files([
    "aiter_swiglu_f16.cpp",
    "flash_attention.cpp",
    "llama_rms_norm.cpp",
])

loom_check_test_suite(
    name = "compiler_test",
    srcs = [
        "assumptions.cxx-test",
        "check.cxx-test",
        "conditionals.cxx-test",
        "const.cxx-test",
        "control_invalid.cxx-test",
        "data_models.cxx-test",
        "enum_semantics.cxx-test",
        "enums.cxx-test",
        "enums_invalid.cxx-test",
        "frontend.cxx-test",
        "functions.cxx-test",
        "intrinsics_invalid.cxx-test",
        "launch.cxx-test",
        "launch_invalid.cxx-test",
        "layout_attributes.cxx-test",
        "locations.cxx-test",
        "loops.cxx-test",
        "macro_operators.cxx-test",
        "pointers.cxx-test",
        "scalar.cxx-test",
        "scalar_invalid.cxx-test",
        "schedule_lowering.cxx-test",
        "schedules.cxx-test",
        "schedules_invalid.cxx-test",
        "standards.cxx-test",
        "vectors.cxx-test",
        "vectors_invalid.cxx-test",
    ],
    data = [
        "aligned_layout.h",
        "enum_semantics.h",
        "locations.h",
        "packed_enums.h",
        "packed_layout.h",
        "record_layout.h",
    ],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)

# Each group retains independent mathematical references and imports its
# implementation through the same source path as handwritten check cases.
_HOST_GROUPS = {
    "assumption_functions": "assumptions.cpp",
    "comparison_functions": "comparison_functions.cpp",
    "constant_loop_functions": "constant_loops.cpp",
    "continue_functions": "structured_continue.cpp",
    "enum_functions": "enum_values.cpp",
    "increment_functions": "increment_values.cpp",
    "integer_functions": "integer_functions.cpp",
    "schedule_functions": "schedule_values.cpp",
    "shaped_intrinsic_values": "shaped_intrinsics.cpp",
    "vector_constructor_values": "vector_initializers.cpp",
    "vector_values": "vector_values.cpp",
}

_HOST_COMPATIBILITY = loom_config_compatible_with([
    "//loom/config/import:cxx",
    "//loom/config/target/arch:vm",
])

[
    loom_generated_file(
        name = group + "_cases_gen",
        testonly = True,
        args = [
            "host",
            "--group=" + group,
            "--source=$(location " + source + ")",
        ],
        generator = "//loom/py/loom/gen/test:cxx_kernel_cases",
        inputs = [source],
        output = group + "_cases.cc",
        output_flag = "--output",
        target_compatible_with = _HOST_COMPATIBILITY,
    )
    for group, source in _HOST_GROUPS.items()
]

[
    loom_test(
        name = group + "_test",
        srcs = [":" + group + "_cases.cc"],
        data = [source],
        target_compatible_with = _HOST_COMPATIBILITY,
    )
    for group, source in _HOST_GROUPS.items()
]

loom_check_test_suite(
    name = "vm_compiler_test",
    srcs = ["vm_lowering.cxx-test"],
    target_compatible_with = _HOST_COMPATIBILITY,
)

# Source checks retain runtime fixture directories alongside the linked module.
_KERNEL_COMPATIBILITY = loom_config_compatible_with([
    "//loom/config/import:cxx",
    "//loom/config/execute:amdgpu_hal",
])

_CXX_AMDGPU_PROFILE = loom_execution_profile(
    name = "amdgpu",
    build_requirements = [
        TARGET_ARCH_AMDGPU,
        EMIT_AMDGPU,
        EXECUTE_IREE_HAL,
        HAL_AMDGPU,
    ],
    executor = "hardware",
    resource_group = "loom-amdgpu-tests",
    run_requirements = [AMDGPU_RESOURCE],
    runner_args = ["--device=amdgpu"],
    sanitizer_suppressions = rocm_suppressions,
    target_class = "gpu",
    target_family = "amdgpu",
)

