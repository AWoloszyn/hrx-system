_KERNEL_GROUPS = sorted({variant["group"]: None for variant in _KERNEL_VARIANTS.values()})

[
    loom_generated_file_family(
        name = group + "_checks_gen",
        testonly = True,
        args = [
            "kernel",
            "--group=" + group,
        ],
        generator = "//loom/py/loom/gen/test:cxx_kernel_cases",
        output_directories = [group + "_arrays"],
        output_flags = [
            "--output",
            "--arrays",
        ],
        outputs = [
            group + "_checks.loom",
            group + "_arrays",
        ],
        target_compatible_with = _KERNEL_COMPATIBILITY,
    )
    for group in _KERNEL_GROUPS
]

[
    loom_library(
        name = name + "_kernel",
        srcs = [variant["source"]],
        data = [
            "//loom/src/loom/import/cxx:include/hip/hip_fp16.h",
            "//loom/src/loom/import/cxx:include/hip/hip_runtime.h",
            "//loom/src/loom/import/cxx:include/loomcxx/kernel.h",
            "//loom/src/loom/import/cxx:include/loomcxx/math.h",
            "//loom/src/loom/import/cxx:include/loomcxx/scalar.h",
        ],
        input_options = variant["input_options"],
        tags = ["manual"],
        target_compatible_with = _KERNEL_COMPATIBILITY,
    )
    for name, variant in _KERNEL_VARIANTS.items()
]

[
    loom_test(
        name = name + "_source_test",
        srcs = [":" + variant["group"] + "_checks.loom"],
        args = variant["args"],
        data = [":" + variant["group"] + "_checks_gen"],
        execution_profile = _CXX_AMDGPU_PROFILE,
        target_compatible_with = _KERNEL_COMPATIBILITY,
        deps = [":" + name + "_kernel"],
    )
    for name, variant in _KERNEL_VARIANTS.items()
]

[
    loom_test(
        name = name + "_access_test",
        srcs = [":" + variant["group"] + "_checks.loom"],
        args = variant["args"] + [
            "--sanitizer=access",
            "--sanitizer-reporting=report-only",
        ],
        data = [":" + variant["group"] + "_checks_gen"],
        execution_profile = _CXX_AMDGPU_PROFILE,
        target_compatible_with = _KERNEL_COMPATIBILITY,
        deps = [":" + name + "_kernel"],
    )
    for name, variant in _KERNEL_VARIANTS.items()
    if variant["access_sanitizer"]
]

test_suite(
    name = "kernels_test",
    tests = [":" + name + "_source_test" for name in _KERNEL_VARIANTS] + [
        ":" + name + "_access_test"
        for name, variant in _KERNEL_VARIANTS.items()
        if variant["access_sanitizer"]
    ],
)

test_suite(
    name = "functions_test",
    tests = [":" + group + "_test" for group in _HOST_GROUPS],
)
