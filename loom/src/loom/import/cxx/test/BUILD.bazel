load("//loom/build_tools/bazel:defs.bzl", "loom_execution_profile", "loom_library", "loom_test")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")
load("//loom/requirements:defs.bzl", "EMIT_AMDGPU", "EXECUTE_IREE_HAL", "TARGET_ARCH_AMDGPU")
load("//runtime/requirements:defs.bzl", "AMDGPU_RESOURCE", "HAL_AMDGPU")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
