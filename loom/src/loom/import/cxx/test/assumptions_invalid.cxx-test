// RUN: verify
// Each unsupported tail rejects the whole conjunction.
// Signed bindings are not admitted.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other, int signed_value) {
  // ERROR@+1: LOWERING/059 "assume requires unsigned scalar bindings < constant bounds, optionally joined by &&"
  assume(other < 32u && (signed_value < 16));
}

// ====
// RUN: verify
// An exclusive upper bound must be positive.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < 0u));
}

// ====
// RUN: verify
// A negative bound is not admitted.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < -1));
}

// ====
// RUN: verify
// The bound must fit INT32_MAX.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < 2147483648u));
}

// ====
// RUN: verify
// A wide unsigned maximum is not a small bound.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < 0xffffffffffffffffULL));
}

// ====
// RUN: verify
// Division by zero is not a constant bound.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // WARNING@+2: PARSE/036 "invalid binary expression"
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < (1u / 0u)));
}

// ====
// RUN: verify
// A shift by the type width is not a constant bound.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // WARNING@+2: PARSE/036 "invalid binary expression"
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < (1u << 32)));
}

// ====
// RUN: verify
// Signed overflow is not a constant bound.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // WARNING@+2: PARSE/036 "invalid binary expression"
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < (2147483647 + 2147483647 + 4)));
}

// ====
// RUN: verify
// A runtime binding is not a constant bound.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < other));
}

// ====
// RUN: verify
// A comma expression cannot hide a call.
[[loom::assume]] void assume(bool);
unsigned opaque();
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < (opaque(), 16u)));
}

// ====
// RUN: verify
// A call is not a constant bound.
[[loom::assume]] void assume(bool);
unsigned opaque();
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < opaque()));
}

// ====
// RUN: verify
// A bound cannot mutate another binding.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < ++other));
}

// ====
// RUN: verify
// The constrained operand must be the original binding.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume requires unsigned scalar bindings < constant bounds, optionally joined by &&"
  assume(other < 32u && (value++ < 16u));
}

// ====
// RUN: verify
// An assignment is not a constant bound.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < (other = 16u)));
}

// ====
// RUN: verify
// Floating-point bounds are not admitted.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume requires unsigned scalar bindings < constant bounds, optionally joined by &&"
  assume(other < 32u && (value < 16.5f));
}

// ====
// RUN: verify
// Bounds use an exclusive comparison.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume requires unsigned scalar bindings < constant bounds, optionally joined by &&"
  assume(other < 32u && (value <= 16u));
}

// ====
// RUN: verify
// Disjunction cannot represent simultaneous bounds.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume requires unsigned scalar bindings < constant bounds, optionally joined by &&"
  assume(other < 32u && (value < 16u || other < 16u));
}

// ====
// RUN: verify
// A narrowing cast does not constrain the original binding.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume requires unsigned scalar bindings < constant bounds, optionally joined by &&"
  assume(other < 32u && ((unsigned char)value < 16u));
}

// ====
// RUN: verify
// Even an unselected call is outside the pure constant contract.
[[loom::assume]] void assume(bool);
unsigned opaque();
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && (value < (false ? opaque() : 16u)));
}

// ====
// RUN: verify
// A volatile read is not a constant bound.
[[loom::assume]] void assume(bool);
extern volatile unsigned bound;
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(other < 32u && value < bound);
}

// ====
// RUN: verify
// An overloaded comparison cannot constrain an unsigned binding.
[[loom::assume]] void assume(bool);
struct Bound {};
bool operator<(unsigned, Bound);
extern Bound bound;
void entry(unsigned value) {
  // ERROR@+1: LOWERING/059 "assume requires unsigned scalar bindings < constant bounds, optionally joined by &&"
  assume(value < bound);
}

// ====
// RUN: verify
// A bound cannot invoke overloaded arithmetic.
[[loom::assume]] void assume(bool);
struct Bound {};
unsigned operator+(Bound, unsigned);
extern Bound bound;
void entry(unsigned value) {
  // ERROR@+1: LOWERING/059 "assume upper bound requires a pure integer constant in [1, INT32_MAX] without calls or mutation"
  assume(value < (bound + 1u));
}
