// RUN: with-checks pass inline-callables,promote-private-fragments,canonicalize,cse,dce
// The source owns the temporary; shared promotion, after ordinary inlining,
// carries its mutated value out of the conditional without temporary memory.
[[loom::force_inline]] static void increment(unsigned* value) { ++*value; }
unsigned update(unsigned input, unsigned enabled) {
  unsigned value = input;
  if (enabled) increment(&value);
  return value;
}
// ----
CHECK: *scf.select* : i32
CHECK: *scalar.addi* : i32
CHECK-NOT: *buffer.alloca*
CHECK-NOT: *view.load*
CHECK-NOT: *view.store*

// ====
// RUN: with-checks roundtrip
// Byte layout and over-alignment belong to the declaration, not the pointer's
// first use. The output-only helper supplies the initial stored value.
[[loom::force_inline]] static void initialize(unsigned short* value) { *value = 7; }
unsigned output_parameter() {
  alignas(32) unsigned short value;
  initialize(&value);
  return value;
}
// ----
CHECK: *index.constant 2 : offset
CHECK: *buffer.alloca<private> align(32)*
CHECK: *buffer.view* -> view<1xi16>
CHECK: *scalar.extui* : i16 to i32

// ====
// RUN: with-checks pass canonicalize,cse,promote-private-fragments,dce
// Taking an address is not required for a volatile local to own real storage.
unsigned observations(unsigned input) {
  volatile unsigned value = input;
  (void)value;
  value = input + 1;
  return value;
}
// ----
CHECK: *buffer.alloca<private>*
CHECK: *view.load<volatile>*
CHECK: *view.store<volatile>*

// ====
// RUN: with-checks roundtrip
// Unevaluated addresses and source-discarded branches do not demand storage.
unsigned no_storage(unsigned value) {
  (void)sizeof(&value);
  if constexpr (false) (void)&value;
  return value + 1;
}
// ----
CHECK: *scalar.addi* : i32
CHECK-NOT: *buffer.alloca*
