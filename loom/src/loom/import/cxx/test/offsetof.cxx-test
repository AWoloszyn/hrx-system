// RUN: verify
// INPUT: cxx data-model=lp64
#include "offsetof_layout.h"

// ====
// RUN: verify
// INPUT: cxx data-model=llp64
#include "offsetof_layout.h"

// ====
// RUN: verify
// INPUT: cxx data-model=ilp32
#include "offsetof_layout.h"

// ====
// RUN: roundtrip
// INPUT: cxx
#include "offsetof_layout.h"
auto payload_offset() {
  return __builtin_offsetof(OffsetPacket, blocks[2].payload[1]);
}
// ----
func.def public @payload_offset() -> (i64) {
  %1 = scalar.constant 32 : i64
  func.return %1 : i64
}

// ====
// RUN: roundtrip
// INPUT: cxx data-model=lp64
// GNU offset queries permit constant subscripts beyond the declared extent.
// This exercises size_t arithmetic without allocating a large source object.
struct Packet { char bytes[1]; };
static_assert(__builtin_offsetof(Packet, bytes[0x100000005ULL]) == 0x100000005ULL);
auto large_offset() {
  return __builtin_offsetof(Packet, bytes[0x100000005ULL]);
}
// ----
func.def public @large_offset() -> (i64) {
  %1 = scalar.constant 4294967301 : i64
  func.return %1 : i64
}

// ====
// RUN: roundtrip
// INPUT: cxx data-model=llp64
// GNU offset queries permit constant subscripts beyond the declared extent.
// This exercises size_t arithmetic without allocating a large source object.
struct Packet { char bytes[1]; };
static_assert(__builtin_offsetof(Packet, bytes[0x100000005ULL]) == 0x100000005ULL);
auto large_offset() {
  return __builtin_offsetof(Packet, bytes[0x100000005ULL]);
}
// ----
func.def public @large_offset() -> (i64) {
  %1 = scalar.constant 4294967301 : i64
  func.return %1 : i64
}

// ====
// INPUT: cxx
struct Item { unsigned bits : 3; };
struct Packet { Item items[3]; };
// ERROR@+1: PARSE/036 "offsetof requires an addressable data member"
auto offset() { return __builtin_offsetof(Packet, items[1].bits); }

// ====
// INPUT: cxx
struct Item { unsigned value; };
struct Packet { Item items[3]; };
// ERROR@+1: PARSE/036 "no member named 'missing'"
auto offset() { return __builtin_offsetof(Packet, items[1].missing); }

// ====
// INPUT: cxx
struct Packet { unsigned values[3]; };
// ERROR@+1: PARSE/036 "offsetof member designator requires a record type"
auto offset() { return __builtin_offsetof(Packet, values[1].missing); }

// ====
// INPUT: cxx
struct Packet { unsigned* values; };
// ERROR@+1: PARSE/036 "offsetof subscript requires an array member"
auto offset() { return __builtin_offsetof(Packet, values[1]); }

// ====
// INPUT: cxx
struct Packet { unsigned values[3]; };
// ERROR@+1: PARSE/036 "negative offsetof indices are not supported"
auto offset() { return __builtin_offsetof(Packet, values[-1]); }

// ====
// INPUT: cxx
struct Packet { unsigned values[3]; };
// ERROR@+1: PARSE/036 "offsetof index must be an integral constant expression"
auto offset(unsigned index) { return __builtin_offsetof(Packet, values[index]); }

// ====
// INPUT: cxx data-model=ilp32
struct Packet { unsigned values[3]; };
// ERROR@+1: PARSE/036 "offsetof result exceeds source size_t"
auto offset() { return __builtin_offsetof(Packet, values[0x40000000ULL]); }

// ====
// INPUT: cxx data-model=lp64
struct Packet { unsigned values[3]; };
// ERROR@+1: PARSE/036 "offsetof result exceeds source size_t"
auto offset() { return __builtin_offsetof(Packet, values[0x4000000000000000ULL]); }

// ====
// RUN: roundtrip
// INPUT: cxx std=c23
struct Item { char tag; unsigned value; };
struct Packet { char tag; struct Item items[2]; };
unsigned long long offset(void) {
  return __builtin_offsetof(struct Packet, items[1].value);
}
// ----
func.def public @offset() -> (i64) {
  %1 = scalar.constant 16 : i64
  func.return %1 : i64
}

// ====
// INPUT: cxx
struct Packet { unsigned values[3]; };
// ERROR@+1: PARSE/036 "offsetof index must be an integral constant expression"
auto offset() { return __builtin_offsetof(Packet, values[1.5]); }

// ====
// INPUT: cxx
struct Item { static unsigned value; };
struct Packet { Item items[3]; };
// ERROR@+1: PARSE/036 "offsetof requires an addressable data member"
auto offset() { return __builtin_offsetof(Packet, items[1].value); }

// ====
// INPUT: cxx data-model=lp64
struct Item { char tag; char value; };
struct Packet { char prefix; Item items[1]; };
auto offset() {
  // ERROR@+1: PARSE/036 "offsetof result exceeds source size_t"
  return __builtin_offsetof(Packet, items[0x7fffffffffffffffULL].value);
}
