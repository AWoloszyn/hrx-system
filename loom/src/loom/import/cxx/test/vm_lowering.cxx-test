// RUN: emit source-low @entry target=vm:core output=low
// Imported source functions acquire target facts through specialization.
static unsigned helper(unsigned value) { return value + 1u; }
unsigned entry(unsigned value) { return helper(value); }

// ----
low.func.def public target<vm.core> abi(vm_function) @entry(%value: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %9 = low.func.call pure @helper(%value) : (reg<vm.value : i32>) -> (reg<vm.value : i32>)
  return %9
}

low.func.def target<vm.core> @helper(%value: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %12 = constant.i32 1
  %13 = integer.add.i32 %value, %12
  return %13
}
