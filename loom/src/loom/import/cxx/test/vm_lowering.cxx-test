// RUN: emit source-low @entry target=vm:core output=low
// Imported source functions acquire target facts through specialization.
static unsigned helper(unsigned value) { return value + 1u; }
unsigned entry(unsigned value) { return helper(value); }

// ----
low.func.def public target<vm.core> abi(vm_function) @entry(%value: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %9 = low.func.call pure @helper(%value) : (reg<vm.value : i32>) -> (reg<vm.value : i32>)
  return %9
}

low.func.def target<vm.core> @helper(%value: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %12 = constant.i32 1
  %13 = integer.add.i32 %value, %12
  return %13
}

// ====
// RUN: emit source-low @vector_control target=vm:core output=low
// Loop-carried vectors require target register support even when only a scalar
// result crosses the source function boundary.
typedef unsigned U4 __attribute__((vector_size(16)));

static U4 advance(U4 value, unsigned count) {
  while (count > 0u) {
    value += 3u;
    --count;
  }
  return value;
}

// ERROR@+3: TARGET/033 "source type vector<4xi32> has no target-low register mapping"
// ERROR@+2: TARGET/033 "source type vector<4xi32> has no target-low register mapping"
// ERROR@+1: TARGET/033 "source type vector<4xi32> has no target-low register mapping"
unsigned vector_control(unsigned input, unsigned count, unsigned lane) {
  // ERROR@+4: TARGET/001 "has no target-low contract for 'vector.splat'"
  // ERROR@+3: TARGET/001 "has no target-low contract for 'vector.insert'"
  // ERROR@+2: TARGET/001 "has no target-low contract for 'vector.insert'"
  // ERROR@+1: TARGET/001 "has no target-low contract for 'vector.insert'"
  U4 value = {input, 1u};
  U4 result = count ? advance(value, count) : value;
  for (unsigned i = 0; i < count; ++i) {
    // ERROR@+2: TARGET/001 "has no target-low contract for 'vector.constant'"
    // ERROR@+1: TARGET/001 "has no target-low contract for 'vector.addi'"
    result += 1u;
  }
  if (count > 2u) {
    // ERROR@+2: TARGET/001 "has no target-low contract for 'vector.constant'"
    // ERROR@+1: TARGET/001 "has no target-low contract for 'vector.xori'"
    result = ~result;
  }
  // ERROR@+1: TARGET/001 "has no target-low contract for 'vector.extract'"
  return result[lane];
}
