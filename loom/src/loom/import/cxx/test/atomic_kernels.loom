kernel.decl @atomic_tickets() launch(%counter: buffer, %slots: buffer)

check.case @contended_tickets {
  %counter = check.generate.fill value(37) : tensor<3xi32>
  %slots = check.generate.fill value(37) : tensor<258xi32>
  kernel.launch @atomic_tickets(%counter, %slots) : (tensor<3xi32>, tensor<258xi32>)
  %before_counter = check.tensor.view %counter offset(0) : tensor<3xi32> -> tensor<1xi32>
  %count = check.tensor.view %counter offset(4) : tensor<3xi32> -> tensor<1xi32>
  %after_counter = check.tensor.view %counter offset(8) : tensor<3xi32> -> tensor<1xi32>
  %before_slots = check.tensor.view %slots offset(0) : tensor<258xi32> -> tensor<1xi32>
  %claimed = check.tensor.view %slots offset(4) : tensor<258xi32> -> tensor<256xi32>
  %after_slots = check.tensor.view %slots offset(1028) : tensor<258xi32> -> tensor<1xi32>
  %guard = check.generate.fill value(37) : tensor<1xi32>
  %expected_count = check.generate.fill value(293) : tensor<1xi32>
  %expected_slots = check.generate.fill value(1) : tensor<256xi32>
  check.expect.bitwise actual(%before_counter) expected(%guard) : tensor<1xi32>
  check.expect.bitwise actual(%count) expected(%expected_count) : tensor<1xi32>
  check.expect.bitwise actual(%after_counter) expected(%guard) : tensor<1xi32>
  check.expect.bitwise actual(%before_slots) expected(%guard) : tensor<1xi32>
  check.expect.bitwise actual(%claimed) expected(%expected_slots) : tensor<256xi32>
  check.expect.bitwise actual(%after_slots) expected(%guard) : tensor<1xi32>
  check.expect.event<device> {count = 0, type = "asan_report"}
  check.return
}

kernel.decl @atomic_sequences() launch(%signed_words: buffer, %signed_wide: buffer, %unsigned_wide: buffer, %output: buffer)

check.case @integer_sequences {
  %signed_words = check.generate.fill value(37) : tensor<3xi32>
  %signed_wide = check.generate.fill value(37) : tensor<3xi64>
  %unsigned_wide = check.generate.fill value(37) : tensor<3xi64>
  %output = check.generate.fill value(37) : tensor<5xi32>
  kernel.launch @atomic_sequences(%signed_words, %signed_wide, %unsigned_wide, %output) : (tensor<3xi32>, tensor<3xi64>, tensor<3xi64>, tensor<5xi32>)
  %guard32 = check.generate.fill value(37) : tensor<1xi32>
  %value32 = check.generate.fill value(13) : tensor<1xi32>
  %guard64 = check.generate.fill value(37) : tensor<1xi64>
  %value64 = check.generate.fill value(13) : tensor<1xi64>
  %signed_words_0 = check.tensor.view %signed_words offset(0) : tensor<3xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%signed_words_0) expected(%guard32) : tensor<1xi32>
  %signed_words_1 = check.tensor.view %signed_words offset(4) : tensor<3xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%signed_words_1) expected(%value32) : tensor<1xi32>
  %signed_words_2 = check.tensor.view %signed_words offset(8) : tensor<3xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%signed_words_2) expected(%guard32) : tensor<1xi32>
  %signed_wide_0 = check.tensor.view %signed_wide offset(0) : tensor<3xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%signed_wide_0) expected(%guard64) : tensor<1xi64>
  %signed_wide_1 = check.tensor.view %signed_wide offset(8) : tensor<3xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%signed_wide_1) expected(%value64) : tensor<1xi64>
  %signed_wide_2 = check.tensor.view %signed_wide offset(16) : tensor<3xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%signed_wide_2) expected(%guard64) : tensor<1xi64>
  %unsigned_wide_0 = check.tensor.view %unsigned_wide offset(0) : tensor<3xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%unsigned_wide_0) expected(%guard64) : tensor<1xi64>
  %unsigned_wide_1 = check.tensor.view %unsigned_wide offset(8) : tensor<3xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%unsigned_wide_1) expected(%value64) : tensor<1xi64>
  %unsigned_wide_2 = check.tensor.view %unsigned_wide offset(16) : tensor<3xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%unsigned_wide_2) expected(%guard64) : tensor<1xi64>
  %output_before = check.tensor.view %output offset(0) : tensor<5xi32> -> tensor<1xi32>
  %results = check.tensor.view %output offset(4) : tensor<5xi32> -> tensor<1xi32>
  %wide_results = check.tensor.view %output offset(8) : tensor<5xi32> -> tensor<2xi32>
  %output_after = check.tensor.view %output offset(16) : tensor<5xi32> -> tensor<1xi32>
  %expected_results = check.generate.fill value(2047) : tensor<1xi32>
  %expected_wide_results = check.generate.fill value(2047) : tensor<2xi32>
  check.expect.bitwise actual(%output_before) expected(%guard32) : tensor<1xi32>
  check.expect.bitwise actual(%results) expected(%expected_results) : tensor<1xi32>
  check.expect.bitwise actual(%wide_results) expected(%expected_wide_results) : tensor<2xi32>
  check.expect.bitwise actual(%output_after) expected(%guard32) : tensor<1xi32>
  check.expect.event<device> {count = 0, type = "asan_report"}
  check.return
}

kernel.decl @atomic_unsigned() launch(%storage: buffer, %output: buffer)

check.case @unsigned_comparisons {
  %storage = check.generate.fill value(37) : tensor<3xi32>
  %output = check.generate.fill value(37) : tensor<6xi32>
  kernel.launch @atomic_unsigned(%storage, %output) : (tensor<3xi32>, tensor<6xi32>)
  %guard = check.generate.fill value(37) : tensor<1xi32>
  %value = check.generate.fill value(13) : tensor<1xi32>
  %high = check.generate.fill value(-2147483647) : tensor<1xi32>
  %storage_0 = check.tensor.view %storage offset(0) : tensor<3xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%storage_0) expected(%guard) : tensor<1xi32>
  %storage_1 = check.tensor.view %storage offset(4) : tensor<3xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%storage_1) expected(%value) : tensor<1xi32>
  %storage_2 = check.tensor.view %storage offset(8) : tensor<3xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%storage_2) expected(%guard) : tensor<1xi32>
  %output_0 = check.tensor.view %output offset(0) : tensor<6xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%output_0) expected(%guard) : tensor<1xi32>
  %output_1 = check.tensor.view %output offset(4) : tensor<6xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%output_1) expected(%guard) : tensor<1xi32>
  %output_2 = check.tensor.view %output offset(8) : tensor<6xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%output_2) expected(%guard) : tensor<1xi32>
  %output_3 = check.tensor.view %output offset(12) : tensor<6xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%output_3) expected(%high) : tensor<1xi32>
  %output_4 = check.tensor.view %output offset(16) : tensor<6xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%output_4) expected(%value) : tensor<1xi32>
  %output_5 = check.tensor.view %output offset(20) : tensor<6xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%output_5) expected(%guard) : tensor<1xi32>
  check.expect.event<device> {count = 0, type = "asan_report"}
  check.return
}

kernel.decl @atomic_workgroup_tickets() launch(%counts: buffer, %slots: buffer)

check.case @workgroup_tickets {
  %counts = check.generate.fill value(37) : tensor<10xi32>
  %slots = check.generate.fill value(37) : tensor<258xi32>
  kernel.launch @atomic_workgroup_tickets(%counts, %slots) : (tensor<10xi32>, tensor<258xi32>)
  %before_counts = check.tensor.view %counts offset(0) : tensor<10xi32> -> tensor<1xi32>
  %values = check.tensor.view %counts offset(4) : tensor<10xi32> -> tensor<8xi32>
  %after_counts = check.tensor.view %counts offset(36) : tensor<10xi32> -> tensor<1xi32>
  %before_slots = check.tensor.view %slots offset(0) : tensor<258xi32> -> tensor<1xi32>
  %claimed = check.tensor.view %slots offset(4) : tensor<258xi32> -> tensor<256xi32>
  %after_slots = check.tensor.view %slots offset(1028) : tensor<258xi32> -> tensor<1xi32>
  %guard = check.generate.fill value(37) : tensor<1xi32>
  %expected_counts = check.generate.fill value(32) : tensor<8xi32>
  %expected_slots = check.generate.fill value(1) : tensor<256xi32>
  check.expect.bitwise actual(%before_counts) expected(%guard) : tensor<1xi32>
  check.expect.bitwise actual(%values) expected(%expected_counts) : tensor<8xi32>
  check.expect.bitwise actual(%after_counts) expected(%guard) : tensor<1xi32>
  check.expect.bitwise actual(%before_slots) expected(%guard) : tensor<1xi32>
  check.expect.bitwise actual(%claimed) expected(%expected_slots) : tensor<256xi32>
  check.expect.bitwise actual(%after_slots) expected(%guard) : tensor<1xi32>
  check.expect.event<device> {count = 0, type = "asan_report"}
  check.return
}
