// RUN: with-checks pass canonicalize,cse,dce
#include <loomcxx/kernel.h>
using Float4 = float __attribute__((ext_vector_type(4)));

[[loom::force_inline]] static Float4 first(Float4 value) {
  return loom::subgroup_broadcast_first(value);
}

[[loom::kernel, loom::workgroup_size(32, 1, 1), loom::workgroup_count(1, 1, 1)]]
void entry(unsigned* output, unsigned long long* masks, Float4* vectors,
           Float4 value) {
  unsigned lane = loom::subgroup_lane_id();
  output[lane] = loom::subgroup_id() + loom::subgroup_count() +
                 loom::subgroup_size();
  masks[lane] = loom::subgroup_ballot(lane > 3);
  masks[lane + 32] = loom::subgroup_active_mask();
  output[lane + 32] = loom::subgroup_ballot<unsigned>(lane < 3);
  output[lane + 64] = loom::subgroup_active_mask<unsigned>();
  output[lane + 96] = loom::subgroup_any(lane == 7);
  output[lane + 128] = loom::subgroup_all(lane < 31);
  vectors[lane] = first(loom::subgroup_broadcast(value, 7));
  loom::barrier<loom::memory_space::global, loom::atomic::scope::subgroup,
                loom::atomic::ordering::acq_rel>();
}
// ----
// CHECK: *kernel.subgroup.lane.id*
// CHECK: *kernel.subgroup.id*
// CHECK: *kernel.subgroup.count*
// CHECK: *kernel.subgroup.size*
// CHECK: *kernel.subgroup.vote.ballot*-> i64
// CHECK: *kernel.subgroup.active.mask : i64
// CHECK: *kernel.subgroup.vote.ballot*-> i32
// CHECK: *kernel.subgroup.active.mask : i32
// CHECK: *kernel.subgroup.vote.any*
// CHECK: *kernel.subgroup.vote.all*
// CHECK: *kernel.subgroup.broadcast * : vector<4xf32>, i32
// CHECK: *kernel.barrier<global> scope(subgroup) ordering(acq_rel)
// CHECK: func.def inline @first*
// CHECK: *kernel.subgroup.broadcast.first * : vector<4xf32>

// ====
// Custom declarations and ordinary callable barriers use the same bindings.
[[loom::op("kernel.subgroup.vote.ballot")]] unsigned ready_mask(bool);
template <int Space, int Scope, int Ordering>
[[loom::op("kernel.barrier")]] void synchronize();
void workgroup_memory() { synchronize<2, 2, 3>(); }
[[loom::kernel]] void entry(unsigned* output, bool ready) {
  output[0] = ready_mask(ready);
  workgroup_memory();
}
// ----
// CHECK: func.def public @workgroup_memory() {
// CHECK: *kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
// CHECK: *kernel.subgroup.vote.ballot*-> i32

// ====
// Source transport retains a wide payload for the selected target to legalize.
#include <loomcxx/kernel.h>
[[loom::force_inline]] unsigned long long first(unsigned long long value) {
  return loom::subgroup_broadcast_first(value);
}
// ----
// CHECK: func.def public inline @first*
// CHECK: *kernel.subgroup.broadcast.first * : i64
