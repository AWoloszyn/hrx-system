// RUN: roundtrip
// INPUT: cxx
#include "packed_layout.h"
unsigned stride() { return sizeof(Block<unsigned>); }
unsigned payload() { return __builtin_offsetof(Block<unsigned>, words); }
unsigned alignment() { return alignof(Block<unsigned>); }
// ----
func.def public @stride() -> (i32) {
  %1 = scalar.constant 18 : i64
  %2 = scalar.trunci %1 : i64 to i32
  func.return %2 : i32
}

func.def public @payload() -> (i32) {
  %4 = scalar.constant 2 : i64
  %5 = scalar.trunci %4 : i64 to i32
  func.return %5 : i32
}

func.def public @alignment() -> (i32) {
  %7 = scalar.constant 1 : i64
  %8 = scalar.trunci %7 : i64 to i32
  func.return %8 : i32
}

// ====
// INPUT: cxx
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void aligned_array(unsigned* output) {
  [[loom::workgroup]] unsigned __attribute__((aligned(32))) values[4];
  values[0] = 7;
  output[0] = values[0];
}

// ----
kernel.def @aligned_array() {
  %1 = index.constant 1 : index
  %2 = index.constant 1 : index
  %3 = index.constant 1 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  kernel.launch.config workgroups(%1, %2, %3) workgroup_size(%4, %5, %6) : index
} launch(%output: buffer) {
  %output_byte_offset = index.constant 0 : offset
  %8 = index.constant 16 : offset
  %values = buffer.alloca<workgroup> align(32) %8 : buffer
  %values_byte_offset = index.constant 0 : offset
  %values_view = buffer.view %values[%values_byte_offset] : buffer -> view<4xi32>
  %12 = scalar.constant 7 : i32
  %13 = scalar.constant 0 : i32
  %14 = index.cast %13 : i32 to index
  view.store %12, %values_view[%14] : i32, view<4xi32>
  %15 = scalar.constant 0 : i32
  %16 = index.cast %15 : i32 to index
  %17 = view.load %values_view[%16] : view<4xi32> -> i32
  %18 = scalar.constant 0 : i32
  %19 = scalar.extsi %18 : i32 to i64
  %20 = scalar.constant 4 : i64
  %21 = scalar.muli %19, %20 : i64
  %22 = index.cast %output_byte_offset : offset to i64
  %23 = scalar.addi %22, %21 : i64
  %24 = scalar.assume %23 [range(%23, 0, 9223372036854775807)] : i64
  %25 = index.cast %24 : i64 to offset
  %26 = buffer.view %output[%25] : buffer -> view<1xi32>
  view.store %17, %26[0] : i32, view<1xi32>
  kernel.return
}
