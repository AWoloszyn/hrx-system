// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned opaque();
int entry(unsigned count) {
  int total = 0;
  // ERROR@+1: LOWERING/059 "loop scheduling expressions require pure values without calls, mutation, or overloaded operations"
