// Complete scalar observations from storage passed through the ordinary C++ ABI.

func.decl @atomic_i32(%storage: buffer, %origin: offset) -> (i32)

func.def @observe_i32() -> (i32, i32, i32, i32) {
  %bytes = index.constant 12 : offset
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  %origin = index.constant 0 : offset
  %view = buffer.view %storage[%origin] : buffer -> view<3xi32>
  %guard = scalar.constant 37 : i32
  view.store %guard, %view[0] : i32, view<3xi32>
  view.store %guard, %view[1] : i32, view<3xi32>
  view.store %guard, %view[2] : i32, view<3xi32>
  %passed = func.call @atomic_i32(%storage, %origin) : (buffer, offset) -> (i32)
  %before = view.load %view[0] : view<3xi32> -> i32
  %value = view.load %view[1] : view<3xi32> -> i32
  %after = view.load %view[2] : view<3xi32> -> i32
  func.return %passed, %before, %value, %after : i32, i32, i32, i32
}

check.case @sequence_i32 {
  %passed, %before, %value, %after = func.call @observe_i32() : () -> (i32, i32, i32, i32)
  %expected_passed = check.literal value(2047) : i32
  %guard = check.literal value(37) : i32
  %expected_value = check.literal value(13) : i32
  check.expect.equal actual(%passed) expected(%expected_passed) : i32
  check.expect.equal actual(%before) expected(%guard) : i32
  check.expect.equal actual(%value) expected(%expected_value) : i32
  check.expect.equal actual(%after) expected(%guard) : i32
  check.return
}

