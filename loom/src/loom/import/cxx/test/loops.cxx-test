    } else {
      %22 = scalar.extui %15 : i32 to i64
      %23 = scalar.constant 4 : i64
      %24 = scalar.muli %22, %23 : i64
      %25 = index.cast %input_byte_offset : offset to i64
      %26 = scalar.addi %25, %24 : i64
      %27 = scalar.assume %26 [range(%26, 0, 9223372036854775807)] : i64
      %28 = index.cast %27 : i64 to offset
      %29 = buffer.view %input[%28] : buffer -> view<1xi32>
      %30 = view.load %29[0] : view<1xi32> -> i32
      %total = scalar.addi %total$13, %30 : i32
      %32 = scalar.constant 1 : i1
      scf.yield %32, %total : i1, i32
    }
    scf.yield %total$20 : i32
  }
  %index$33 = scalar.constant 0 : i32
  %index$38, %total$39 = scf.while(%index$34 = %index$33 : i32, %total = %total$14 : i32) -> (i32, i32) {
    %40 = scalar.constant 1 : i32
    %index$41 = scalar.addi %index$34, %40 : i32
    %42 = scalar.cmpi ult, %index$34, %count : i32
    scf.condition %42, %index$41, %total : i1, i32, i32
  } do(%index: i32, %total$37: i32) {
