      %48 = scalar.constant 0 : i1
      scf.yield %48, %total$37 : i1, i32
    } else {
      %total = scalar.addi %total$37, %index : i32
      %50 = scalar.constant 1 : i1
      scf.yield %50, %total : i1, i32
    }
    scf.yield %index, %total$47 : i32, i32
  }
  %total$55, %index$56 = scf.while(%total$51 = %total$39 : i32, %index$52 = %index$38 : i32) -> (i32, i32) {
    %57 = scalar.andi %index$52, %choose : i32
