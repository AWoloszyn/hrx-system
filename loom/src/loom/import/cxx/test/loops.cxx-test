// RUN: roundtrip
// Pre and post test loops preserve scalar recurrences.
unsigned long long entry(unsigned count) {
  unsigned char narrow = 254;
  unsigned long long wide = 0;
  while (wide < count) {
    do {
      ++narrow;
      ++wide;
    } while (narrow < 2);
  }
  for (; wide < count + 2;) {
    ++wide;
  }
  return wide + narrow;
}
// ----
func.def public @entry(%count: i32) -> (i64) {
  %2 = scalar.constant 254 : i32
  %narrow$3 = scalar.trunci %2 : i32 to i8
  %4 = scalar.constant 0 : i32
  %wide$5 = scalar.extsi %4 : i32 to i64
  %narrow$10, %wide$11 = scf.while(%narrow = %narrow$3 : i8, %wide = %wide$5 : i64) -> (i8, i64) {
    %12 = scalar.extui %count : i32 to i64
    %13 = scalar.cmpi ult, %wide, %12 : i64
    scf.condition %13, %narrow, %wide : i1, i8, i64
  } do(%narrow$8: i8, %wide$9: i64) {
    %narrow$18, %wide$19 = scf.while(%narrow$14 = %narrow$8 : i8, %wide$15 = %wide$9 : i64) -> (i8, i64) {
      %20 = scalar.extui %narrow$14 : i8 to i32
      %21 = scalar.constant 1 : i32
      %22 = scalar.addi %20, %21 : i32
      %narrow$23 = scalar.trunci %22 : i32 to i8
      %24 = scalar.constant 1 : i64
      %wide$25 = scalar.addi %wide$15, %24 : i64
      %26 = scalar.extui %narrow$23 : i8 to i32
      %27 = scalar.constant 2 : i32
      %28 = scalar.cmpi slt, %26, %27 : i32
      scf.condition %28, %narrow$23, %wide$25 : i1, i8, i64
    } do(%narrow: i8, %wide: i64) {
      scf.yield %narrow, %wide : i8, i64
    }
    scf.yield %narrow$18, %wide$19 : i8, i64
  }
  %wide$31 = scf.while(%wide = %wide$11 : i64) -> (i64) {
    %32 = scalar.constant 2 : i32
    %33 = scalar.addi %count, %32 : i32
    %34 = scalar.extui %33 : i32 to i64
    %35 = scalar.cmpi ult, %wide, %34 : i64
    scf.condition %35, %wide : i1, i64
  } do(%wide$30: i64) {
    %36 = scalar.constant 1 : i64
    %wide$37 = scalar.addi %wide$30, %36 : i64
    scf.yield %wide$37 : i64
  }
  %38 = scalar.extui %narrow$10 : i8 to i32
  %39 = scalar.extsi %38 : i32 to i64
  %40 = scalar.addi %wide$31, %39 : i64
  func.return %40 : i64
}

// ====
// RUN: roundtrip
// Template loop schedules become explicit SSA operands.
template <unsigned Factor, unsigned Depth>
static int sum(unsigned count) {
  int total = 0;
  [[loom::unroll(Factor), loom::pipeline(Depth + 1),
    loom::schedule("interleaved")]]
  for (unsigned index = 0; index < count; ++index) {
    total += (int)index;
  }
  return total;
}
int entry(unsigned count) { return sum<3, 1>(count); }
// ----
func.def public @entry(%count: i32) -> (i32) {
  %2 = func.call @sum_3_1(%count) : (i32) -> (i32)
  func.return %2 : i32
}

func.def @sum_3_1(%count: i32) -> (i32) {
  %total$5 = scalar.constant 0 : i32
  %index = scalar.constant 0 : i32
  %7 = index.cast %index : i32 to offset
  %8 = index.cast %count : i32 to offset
  %9 = index.constant 1 : offset
  %10 = index.constant 2 : index
  %11 = index.constant 3 : index
  %total$14 = scf.for %index = [%7 to %8 step %9](%total$13 = %total$5 : i32) -> (i32) pipeline(%10) unroll(%11) schedule(interleaved) {
    %15 = index.cast %index : offset to i32
    %total$16 = scalar.addi %total$13, %15 : i32
    scf.yield %total$16 : i32
  }
  func.return %total$14 : i32
}

// ====
// RUN: roundtrip
// Continue retains counted schedules and conditional loop regions.
unsigned entry(const unsigned* input, unsigned count, unsigned choose) {
  unsigned total = 0;
  [[loom::unroll(3), loom::pipeline(2)]]
  for (unsigned index = 0; index < count; ++index) {
    if (index & choose) {
      continue;
    }
    total += input[index];
  }
  unsigned index = 0;
  while (index++ < count) {
    if (index & choose) {
      continue;
    }
    total += index;
  }
  do {
    if (index & choose) {
      continue;
    }
    total += index;
  } while (++index < count);
  return total;
}
// ----
