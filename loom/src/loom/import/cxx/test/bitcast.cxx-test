// ====
enum class Word : unsigned {};
using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
Bytes4 entry(Word value) { return __builtin_bit_cast(Bytes4, value); }

// ----
func.def public @entry(%value: i32) -> (vector<4xi8>) {
  %2 = vector.from_elements %value : vector<1xi32>
  %3 = vector.bitcast %2 : vector<1xi32> to vector<4xi8>
  func.return %3 : vector<4xi8>
}

// ====
bool entry(bool value) { return __builtin_bit_cast(bool, value); }

// ----
func.def public @entry(%value: i1) -> (i1) {
  func.return %value : i1
}

// ====
using Float8x4 = __float8_e4m3fn __attribute__((ext_vector_type(4)));
using Floats4 = float __attribute__((ext_vector_type(4)));
unsigned entry(unsigned bits, float factor) {
  auto packed = __builtin_bit_cast(Float8x4, bits);
  auto wide = __builtin_convertvector(packed, Floats4);
  auto scaled = __builtin_convertvector(wide * factor, Float8x4);
  return __builtin_bit_cast(unsigned, scaled);
}

// ----
func.def public @entry(%bits: i32, %factor: f32) -> (i32) {
  %3 = vector.from_elements %bits : vector<1xi32>
  %packed = vector.bitcast %3 : vector<1xi32> to vector<4xf8E4M3>
  %wide = vector.extf %packed : vector<4xf8E4M3> to vector<4xf32>
  %6 = vector.splat %factor : vector<4xf32>
  %7 = vector.mulf %wide, %6 : vector<4xf32>
  %scaled = vector.fptrunc %7 : vector<4xf32> to vector<4xf8E4M3>
  %9 = vector.bitcast %scaled : vector<4xf8E4M3> to vector<1xi32>
  %10 = vector.extract %9[0] : vector<1xi32> -> i32
  func.return %10 : i32
}
