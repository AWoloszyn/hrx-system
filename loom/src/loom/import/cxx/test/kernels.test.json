{
  "version": 1,
  "cases": [
    {
      "name": "early_returns preserve guarded helpers, live values and per-lane kernel exits",
      "steps": [
        {
          "name": "fixtures",
          "run": {
            "tool": "generate-cases",
            "args": [
              "{tmp}/fixtures"
            ]
          }
        },
        {
          "name": "import",
          "run": {
            "tool": "loom-import-cxx",
            "args": [
              "--builtin-includes=false",
              "--isystem={srcdir}/../include",
              "--root=early_returns",
              "--to=bc",
              "--output={tmp}/kernel.loombc",
              "{srcdir}/early_returns.cpp"
            ]
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "iree-test-loom",
            "args": [
              "{tmp}/fixtures/early_returns.loom",
              "--library={tmp}/kernel.loombc",
              "--device=amdgpu"
            ]
          },
          "stdout": {
            "contains": {
              "unordered": [
                "\"case_count\":5",
                "\"sample_count\":5",
                "\"failed_sample_count\":0",
                "\"skipped_case_count\":0",
                "\"planning_issue_count\":0"
              ]
            }
          }
        },
        {
          "name": "check returning guards with the device sanitizer",
          "run": {
            "tool": "iree-test-loom",
            "args": [
              "{tmp}/fixtures/early_returns.loom",
              "--library={tmp}/kernel.loombc",
              "--device=amdgpu",
              "--sanitizer=access",
              "--sanitizer-reporting=report-only"
            ]
          },
          "stdout": {
            "contains": {
              "unordered": [
                "\"case_count\":5",
                "\"sample_count\":5",
                "\"failed_sample_count\":0",
                "\"skipped_case_count\":0",
                "\"planning_issue_count\":0"
              ]
            }
          }
        }
      ]
    },
