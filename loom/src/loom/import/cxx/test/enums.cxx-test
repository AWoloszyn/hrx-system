// RUN: pass canonicalize,cse

enum class Kind : unsigned { solid, water, sky };
unsigned entry(Kind kind) { return kind == Kind::water ? 128u : 0u; }

// ----
func.def public @entry(%kind: i32) -> (i32) {
  %water = scalar.constant 1 : i32
  %3 = scalar.cmpi eq, %kind, %water : i32
  %5 = scalar.constant 128 : i32
  %6 = scalar.constant 0 : i32
  %7 = scf.select %3, %5, %6 : i32
  func.return %7 : i32
}

// ====

enum class Byte : unsigned char { high = 255 };
enum class SignedByte : signed char { low = -128 };
enum class Flag : bool { no, yes };
unsigned widen(Byte value) { return static_cast<unsigned>(value); }
int extend(SignedByte value) { return static_cast<int>(value); }
bool truth(Flag value) { return value == Flag::yes; }

// ----
func.def public @widen(%value: i8) -> (i32) {
  %2 = scalar.extui %value : i8 to i32
  func.return %2 : i32
}

func.def public @extend(%value: i8) -> (i32) {
  %5 = scalar.extsi %value : i8 to i32
  func.return %5 : i32
}

func.def public @truth(%value: i1) -> (i1) {
  func.return %value : i1
}

// ====

enum Inferred { minimum = -1, maximum = 0xffffffffu };
enum Full { full = 0xffffffffffffffffULL };
long long choose(bool condition) { return condition ? maximum : minimum; }
unsigned long long mask() { return full; }

// ----
func.def public @choose(%condition: i1) -> (i64) {
  %maximum = scalar.constant 4294967295 : i64
  %minimum = scalar.constant -1 : i64
  %7 = scf.select %condition, %maximum, %minimum : i64
  func.return %7 : i64
}

func.def public @mask() -> (i64) {
  %full = scalar.constant -1 : i64
  func.return %full : i64
}

// ====

template <class T, T Value>
static T step() {
  enum class Kind : T { first = Value, next };
  return T(Kind::next);
}
unsigned entry() { return step<unsigned char, 254>(); }

// ----
func.def public @entry() -> (i32) {
  %1 = func.call pure @step_unsigned_char_254() : () -> (i8)
  %2 = scalar.extui %1 : i8 to i32
  func.return %2 : i32
}

func.def @step_unsigned_char_254() -> (i8) {
  %next = scalar.constant -1 : i8
  func.return %next : i8
}

// ====
// RUN: pass canonicalize,cse
enum __attribute__((packed)) Byte { byte = 255 };
enum __attribute__((packed)) SignedByte { low = -128, high = 127 };
int add(Byte value) { return value + 1; }
int subtract(SignedByte value) { return value - 1; }
Byte load_next(const Byte* values) { return values[1]; }
void store_next(Byte* values, Byte value) { values[1] = value; }

// ----
func.def public @add(%value: i8) -> (i32) {
  %2 = scalar.extui %value : i8 to i32
  %3 = scalar.constant 1 : i32
  %4 = scalar.addi %2, %3 : i32
  func.return %4 : i32
}

func.def public @subtract(%value: i8) -> (i32) {
  %7 = scalar.extsi %value : i8 to i32
  %35 = scalar.constant -1 : i32
  %36 = scalar.addi %7, %35 : i32
  func.return %36 : i32
}

func.def public @load_next(%values: buffer, %values_byte_offset: offset) -> (i8) {
  %37 = scalar.constant 1 : i64
  %17 = index.cast %values_byte_offset : offset to i64
  %18 = scalar.addi %17, %37 : i64
  %19 = scalar.assume %18 [range(%18, 0, 9223372036854775807)] : i64
  %20 = index.cast %19 : i64 to offset
  %21 = buffer.view %values[%20] : buffer -> view<1xi8>
  %22 = view.load %21[0] : view<1xi8> -> i8
  func.return %22 : i8
}

func.def public @store_next(%values: buffer, %values_byte_offset: offset, %value: i8) {
  %38 = scalar.constant 1 : i64
  %30 = index.cast %values_byte_offset : offset to i64
  %31 = scalar.addi %30, %38 : i64
  %32 = scalar.assume %31 [range(%31, 0, 9223372036854775807)] : i64
  %33 = index.cast %32 : i64 to offset
  %34 = buffer.view %values[%33] : buffer -> view<1xi8>
  view.store %value, %34[0] : i8, view<1xi8>
  func.return
}
