// RUN: format bytecode

test.func @nested(%width: index, %height: index, %value: test.array<test.array<vector<[%width]xf32>>, metadata = {shape = vector<[%height]xf32>}>) {
  test.yield
}
low.func.decl target<test.low.core> @register_value(%width: reg<test.ptr : index>, %value: reg<test.ptr : vector<[%width]xf32>>)
test.func @type_attribute(%width: index, %value: f32) {
  %annotated = test.attrs %value {shape = #test.options<mode = fast, element_type = test.array<vector<[%width]xf32>>>} : f32
  test.yield
}

// ----
test.func @nested(%width: index, %height: index, %value: test.array<test.array<vector<[%width]xf32>>, metadata = {shape = vector<[%height]xf32>}>) {
  test.yield
}

low.func.decl target<test.low.core> @register_value(%width: reg<test.ptr : index>, %value: reg<test.ptr : vector<[%width]xf32>>)

test.func @type_attribute(%width: index, %value: f32) {
  %annotated = test.attrs %value {shape = #test.options<mode = fast, element_type = test.array<vector<[%width]xf32>>>} : f32
  test.yield
}
