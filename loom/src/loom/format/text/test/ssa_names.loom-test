// RUN: roundtrip

// Independent scopes retain their authored names, including nested shadowing.
func.def @first(%extent: index, %condition: i1) -> (index) {
  scf.if %condition {
    %extent = index.constant 4 : index
    test.use %extent : index
  }
  func.return %extent : index
}

func.def @second(%extent: index) -> (index) {
  func.return %extent : index
}

// ====

// RUN: roundtrip

// A block argument type can name a later argument in the same block.
func.def @forward_block_argument_type(%extent: index, %input: view<[%extent]xf32>) {
  cfg.br ^body(%input: view<[%extent]xf32>, %extent: index)
^body(%view: view<[%body_extent]xf32>, %body_extent: index):
  test.use %view : view<[%body_extent]xf32>
  func.return
}

// ====

// RUN: verify

func.def @unresolved_block_argument_type(%extent: index, %input: view<[%extent]xf32>) {
  cfg.br ^body(%input: view<[%extent]xf32>)
  // ERROR@+1: PARSE/001 "missing"
^body(%view: view<[%missing]xf32>):
  test.use %view : view<[%missing]xf32>
  func.return
}

// ====

// RUN: pass scf-to-cfg

// Flattening scopes must keep inner and outer references distinct.
func.def @flattened_scope(%extent: index, %condition: i1, %buffer: buffer, %offset: offset) -> (index) {
  scf.if %condition {
    %extent = index.constant 4 : index
    %window = buffer.view %buffer[%offset] : buffer -> view<[%extent]xf32>
    test.use %window : view<[%extent]xf32>
  }
  func.return %extent : index
}

// ----
func.def @flattened_scope(%extent$0: index, %condition: i1, %buffer: buffer, %offset: offset) -> (index) {
  cfg.cond_br %condition, ^_bb1, ^_bb2
^_bb1:
  %extent$5 = index.constant 4 : index
  %window = buffer.view %buffer[%offset] : buffer -> view<[%extent$5]xf32>
  test.use %window : view<[%extent$5]xf32>
  cfg.br ^_bb2
^_bb2:
  func.return %extent$0 : index
}

// ====

// CSE can capture an outer value whose name is shadowed at the replacement use.
// RUN: pass cse
func.def @captured_shadow(%condition: i1, %row: i32) {
  cfg.br ^define
^define:
  %extent = test.addi %row, %row : i32
  cfg.br ^use
^use:
  scf.if %condition {
    %local_extent = test.addi %row, %row : i32
    %extent = test.constant 4 : i32
    test.use %local_extent : i32
    test.use %extent : i32
  }
  func.return
}

// ----
func.def @captured_shadow(%condition: i1, %row: i32) {
  cfg.br ^define
^define:
  %extent$2 = test.addi %row, %row : i32
  cfg.br ^use
^use:
  scf.if %condition {
    %extent = test.constant 4 : i32
    test.use %extent$2 : i32
    test.use %extent : i32
  }
  func.return
}

// ====

// A capture in a deeper region must see through every intervening shadow.
// RUN: pass cse
func.def @nested_capture(%condition: i1) {
  %extent = index.constant 8 : index
  scf.if %condition {
    %local_extent = index.constant 8 : index
    %extent = index.constant 4 : index
    scf.if %condition {
      test.use %local_extent : index
      test.use %extent : index
    }
  }
  func.return
}

// ----
func.def @nested_capture(%condition: i1) {
  %extent$1 = index.constant 8 : index
  scf.if %condition {
    %extent = index.constant 4 : index
    scf.if %condition {
      test.use %extent$1 : index
      test.use %extent : index
    }
  }
  func.return
}

// ====

// Result types carry captured dimensions even without ordinary operand uses.
// RUN: pass cse
func.def @captured_result_type(%condition: i1, %buffer: buffer, %offset: offset) {
  %extent = index.constant 8 : index
  scf.if %condition {
    %local_extent = index.constant 8 : index
    %extent = index.constant 4 : index
    %view = buffer.view %buffer[%offset] : buffer -> view<[%local_extent]xf32>
    test.use %view : view<[%local_extent]xf32>
    test.use %extent : index
  }
  func.return
}

// ----
func.def @captured_result_type(%condition: i1, %buffer: buffer, %offset: offset) {
  %extent$3 = index.constant 8 : index
  scf.if %condition {
    %extent = index.constant 4 : index
    %view = buffer.view %buffer[%offset] : buffer -> view<[%extent$3]xf32>
    test.use %view : view<[%extent$3]xf32>
    test.use %extent : index
  }
  func.return
}

// ====

// An operand's type is printed in the user's scope, not its defining scope.
// RUN: pass cse
func.def @captured_operand_type(%condition: i1, %buffer: buffer, %offset: offset) {
  %extent = index.constant 8 : index
  %size = index.constant 8 : index
  %view = buffer.view %buffer[%offset] : buffer -> view<[%size]xf32>
  scf.if %condition {
    %extent = index.constant 4 : index
    test.use %view : view<[%size]xf32>
    test.use %extent : index
  }
  func.return
}

// ----
func.def @captured_operand_type(%condition: i1, %buffer: buffer, %offset: offset) {
  %extent$3 = index.constant 8 : index
  %view = buffer.view %buffer[%offset] : buffer -> view<[%extent$3]xf32>
  scf.if %condition {
    %extent = index.constant 4 : index
    test.use %view : view<[%extent$3]xf32>
    test.use %extent : index
  }
  func.return
}

// ====

// Predicate and nested type attributes retain the same captured identities.
// RUN: pass cse
func.def @captured_attributes(%condition: i1, %row: index, %value: f32) {
  %bound = index.constant 8 : index
  scf.if %condition {
    %local_bound = index.constant 8 : index
    %bound = index.constant 4 : index
    %constrained = test.assume %row [lt(%row, %local_bound)] : index
    %annotated = test.attrs %value {shape = {nested = #test.options<mode = fast, element_type = vector<[%local_bound]xf32>>}} : f32
    test.use %constrained, %annotated, %bound : index, f32, index
  }
  func.return
}

// ----
func.def @captured_attributes(%condition: i1, %row: index, %value: f32) {
  %bound$3 = index.constant 8 : index
  scf.if %condition {
    %bound = index.constant 4 : index
    %constrained = test.assume %row [lt(%row, %bound$3)] : index
    %annotated = test.attrs %value {shape = {nested = #test.options<mode = fast, element_type = vector<[%bound$3]xf32>>}} : f32
    test.use %constrained, %annotated, %bound : index, f32, index
  }
  func.return
}

// ====

// Induction arguments can shadow a value captured by a transformed loop body.
// RUN: pass cse
func.def @captured_under_argument(%start: index, %end: index, %step: index) {
  %extent = index.constant 8 : index
  scf.for %extent = [%start to %end step %step] {
    %local_extent = index.constant 8 : index
    test.use %local_extent, %extent : index, index
  }
  func.return
}

// ----
func.def @captured_under_argument(%start: index, %end: index, %step: index) {
  %extent$3 = index.constant 8 : index
  scf.for %extent = [%start to %end step %step] {
    test.use %extent$3, %extent : index, index
  }
  func.return
}

// ====

// RUN: roundtrip

// Projected signature arguments bind their own region's dimensions and encoding.
test.split_func @projected_shape(%extent: index, %layout: encoding, %input: tile<[%extent]xf32, %layout>) {
  test.use %input : tile<[%extent]xf32, %layout>
  test.yield
} launch {
  test.use %input : tile<[%extent]xf32, %layout>
  test.yield
}
