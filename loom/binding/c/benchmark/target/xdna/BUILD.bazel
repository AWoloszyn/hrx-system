load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_benchmark",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_benchmark(
    name = "compile_throughput_benchmark",
    srcs = ["compile_throughput_benchmark.cc"],
    args = [
        "--benchmark_filter=Smoke|BM_FfnGateUpQuadraticBF16/CompileAndEmit/.*/1/512/",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target:xdna_artifacts",
    ]),
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/benchmark:compile_throughput_benchmark_harness",
        "//loom/binding/c/benchmark:workload_compile_benchmark",
        "//loom/binding/c/benchmark/kernels:ffn_gate_up_smoke",
        "//loom/binding/c/target/amd/xdna",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)
