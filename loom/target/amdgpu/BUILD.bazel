load(
    "//loom/build_tools/amdgpu:target_config.bzl",
    "LOOM_AMDGPU_SUPPORTED_TARGETS",
)
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load(
    "//loom/build_tools/bazel:defs.bzl",
    "loom_amdgpu_target_profile",
)

package(default_visibility = ["//visibility:public"])

exports_files(["execution_profiles.bzl"])

[
    loom_amdgpu_target_profile(
        name = target,
        target = target,
        target_compatible_with = loom_config_compatible_with(["//loom/config/target:amdgpu_artifacts"]),
    )
    for target in LOOM_AMDGPU_SUPPORTED_TARGETS
]
